/* Proofs — the theorems of the fragment: each fun's type is its statement. */
place Proofs {
  statement Term

  /* if b then x else x = x: the kernel has no rule for it, the two cases prove it. */
  fun if_same(b: Boolean, x: Term): (if b then x else x) = x {
    return match b { true => clear, false => clear }
  }

  /* Different arms are distinct: a path between them gives a point of Empty. */
  fun code(b: Boolean): Type { return if b then Number else Empty }
  fun absurd(p: true = false): Empty { return transport((code, p) ↦ ap, 0) }
  fun is_yes(t: Term): Boolean {
    return match t { yes => true, no => false, var as n => false, ite as (c, u, v) => false }
  }
  fun yes_is_not_no(p: Term.yes = Term.no): Empty { return absurd((is_yes, p) ↦ ap) }
  fun is_ite(t: Term): Boolean {
    return match t { yes => false, no => false, var as n => false, ite as (c, u, v) => true }
  }
  fun ite_is_not_yes(c: Term, u: Term, v: Term, p: (c, u, v) ↪ ite = Term.yes): Empty {
    return absurd((is_ite, p) ↦ ap)
  }

  /* An arm is injective: its projections undo it. */
  fun cond_of(t: Term): Term {
    return match t { yes => t, no => t, var as n => t, ite as (c, u, v) => c }
  }
  fun ite_injective(a: Term, u: Term, v: Term, b: Term, x: Term, y: Term,
                    p: (a, u, v) ↪ ite = (b, x, y) ↪ ite): a = b {
    return (cond_of, p) ↦ ap
  }

  /* The size of a term, and what adding is. */
  fun plus(a: Nat, b: Nat): Nat {
    return match a { zero => b, succ as n => (n, b) ↦ plus ↪ succ }
  }
  fun one_more(n: Nat): Nat { return n ↪ succ }
  fun two_more(n: Nat): Nat { return n ↪ succ ↪ succ }
  fun plus_zero(n: Nat): plus(n, zero) = n {
    return match n { zero => clear, succ as m => (one_more, plus_zero(m)) ↦ ap }
  }
  fun plus_succ(a: Nat, b: Nat): plus(a, b ↪ succ) = plus(a, b) ↪ succ {
    return match a { zero => clear, succ as m => (one_more, plus_succ(m, b)) ↦ ap }
  }
  fun comm(a: Nat, b: Nat): plus(a, b) = plus(b, a) {
    return match a {
      zero => inv(plus_zero(b)),
      succ as m => concat((one_more, comm(m, b)) ↦ ap, inv(plus_succ(b, m)))
    }
  }
  fun assoc(a: Nat, b: Nat, c: Nat): plus(plus(a, b), c) = plus(a, plus(b, c)) {
    return match a { zero => clear, succ as m => (one_more, assoc(m, b, c)) ↦ ap }
  }
  fun size(t: Term): Nat {
    return match t {
      yes => zero ↪ succ, no => zero ↪ succ, var as n => zero ↪ succ,
      ite as (c, u, v) => plus(size(c), plus(size(u), size(v))) ↪ succ
    }
  }

  /* Adding is a congruence on each side. */
  fun plus_l(a: Nat, b: Nat, r: Nat, p: a = b): plus(a, r) = plus(b, r) {
    return (fun(x: Nat) => plus(x, r), p) ↦ ap
  }
  fun plus_r(r: Nat, a: Nat, b: Nat, p: a = b): plus(r, a) = plus(r, b) {
    return (fun(x: Nat) => plus(r, x), p) ↦ ap
  }
  /* Exchange of two summands. */
  fun mid(a: Nat, g: Nat, b: Nat): plus(a, plus(g, b)) = plus(g, plus(a, b)) {
    return concat(inv(assoc(a, g, b)), concat(plus_l(plus(a, g), plus(g, a), b, comm(a, g)), assoc(g, a, b)))
  }

  /* Termination: the size goes down at every step, by gap(d) + 1. */
  fun gap(d: Step): Nat {
    return match d {
      ifTrue as (u, v) => size(v) ↪ succ,
      ifFalse as (u, v) => size(u) ↪ succ,
      ifSame as (c, u) => plus(size(c), size(u)),
      inC as (e, u, v) => gap(e),
      inU as (c, e, v) => gap(e),
      inV as (c, u, e) => gap(e)
    }
  }
  fun decreases(d: Step): size(d ↦ Step.src) = plus(gap(d), size(d ↦ Step.tgt)) ↪ succ {
    return match d {
      ifTrue as (u, v) => (two_more, comm(size(u), size(v))) ↦ ap,
      ifFalse as (u, v) => clear,
      ifSame as (c, u) => (one_more, inv(assoc(size(c), size(u), size(u)))) ↦ ap,
      inC as (e, u, v) =>
        concat((one_more, plus_l(size(e ↦ Step.src), plus(gap(e), size(e ↦ Step.tgt)) ↪ succ,
                                 plus(size(u), size(v)), decreases(e))) ↦ ap,
        concat((two_more, assoc(gap(e), size(e ↦ Step.tgt), plus(size(u), size(v)))) ↦ ap,
               (one_more, inv(plus_succ(gap(e), plus(size(e ↦ Step.tgt), plus(size(u), size(v)))))) ↦ ap)),
      inU as (c, e, v) =>
        concat((one_more, plus_r(size(c), plus(size(e ↦ Step.src), size(v)),
                                 plus(plus(gap(e), size(e ↦ Step.tgt)) ↪ succ, size(v)),
                                 plus_l(size(e ↦ Step.src), plus(gap(e), size(e ↦ Step.tgt)) ↪ succ,
                                        size(v), decreases(e)))) ↦ ap,
        concat((one_more, plus_succ(size(c), plus(plus(gap(e), size(e ↦ Step.tgt)), size(v)))) ↦ ap,
        concat((two_more, plus_r(size(c), plus(plus(gap(e), size(e ↦ Step.tgt)), size(v)),
                                 plus(gap(e), plus(size(e ↦ Step.tgt), size(v))),
                                 assoc(gap(e), size(e ↦ Step.tgt), size(v)))) ↦ ap,
        concat((two_more, mid(size(c), gap(e), plus(size(e ↦ Step.tgt), size(v)))) ↦ ap,
               (one_more, inv(plus_succ(gap(e), plus(size(c), plus(size(e ↦ Step.tgt), size(v)))))) ↦ ap)))),
      inV as (c, u, e) =>
        concat((one_more, plus_r(size(c), plus(size(u), size(e ↦ Step.src)),
                                 plus(size(u), plus(gap(e), size(e ↦ Step.tgt)) ↪ succ),
                                 plus_r(size(u), size(e ↦ Step.src),
                                        plus(gap(e), size(e ↦ Step.tgt)) ↪ succ, decreases(e)))) ↦ ap,
        concat((one_more, plus_r(size(c), plus(size(u), plus(gap(e), size(e ↦ Step.tgt)) ↪ succ),
                                 plus(size(u), plus(gap(e), size(e ↦ Step.tgt))) ↪ succ,
                                 plus_succ(size(u), plus(gap(e), size(e ↦ Step.tgt))))) ↦ ap,
        concat((one_more, plus_succ(size(c), plus(size(u), plus(gap(e), size(e ↦ Step.tgt))))) ↦ ap,
        concat((two_more, plus_r(size(c), plus(size(u), plus(gap(e), size(e ↦ Step.tgt))),
                                 plus(gap(e), plus(size(u), size(e ↦ Step.tgt))),
                                 mid(size(u), gap(e), size(e ↦ Step.tgt)))) ↦ ap,
        concat((two_more, mid(size(c), gap(e), plus(size(u), size(e ↦ Step.tgt)))) ↦ ap,
               (one_more, inv(plus_succ(gap(e), plus(size(c), plus(size(u), size(e ↦ Step.tgt)))))) ↦ ap)))))
    }
  }

  /* Local confluence: every peak has a valley. */
  fun start_in_c(m: Move, u: Term, v: Term): (m, u, v) ↦ Move.in_c ↦ Move.start = (m ↦ Move.start, u, v) ↪ ite {
    return match m { still as t => clear, once as d => clear }
  }
  fun finish_in_c(m: Move, u: Term, v: Term): (m, u, v) ↦ Move.in_c ↦ Move.finish = (m ↦ Move.finish, u, v) ↪ ite {
    return match m { still as t => clear, once as d => clear }
  }
  fun start_in_u(c: Term, m: Move, v: Term): (c, m, v) ↦ Move.in_u ↦ Move.start = (c, m ↦ Move.start, v) ↪ ite {
    return match m { still as t => clear, once as d => clear }
  }
  fun finish_in_u(c: Term, m: Move, v: Term): (c, m, v) ↦ Move.in_u ↦ Move.finish = (c, m ↦ Move.finish, v) ↪ ite {
    return match m { still as t => clear, once as d => clear }
  }
  fun start_in_v(c: Term, u: Term, m: Move): (c, u, m) ↦ Move.in_v ↦ Move.start = (c, u, m ↦ Move.start) ↪ ite {
    return match m { still as t => clear, once as d => clear }
  }
  fun finish_in_v(c: Term, u: Term, m: Move): (c, u, m) ↦ Move.in_v ↦ Move.finish = (c, u, m ↦ Move.finish) ↪ ite {
    return match m { still as t => clear, once as d => clear }
  }
  fun same_source(p: Peak): p ↦ Peak.left ↦ Step.src = p ↦ Peak.right ↦ Step.src {
    return match p {
      rootT as u => clear, rootF as u => clear, trueU as (e, v) => clear, trueV as (u, e) => clear, falseU as (e, v) => clear, falseV as (u, e) => clear, sameC as (e, u) => clear, sameU as (c, e) => clear, sameV as (c, e) => clear, cU as (e, f, v) => clear, cV as (e, u, f) => clear, uV as (c, e, f) => clear,
      inCp as (p, u, v) => (fun(x: Term) => (x, u, v) ↪ ite, same_source(p)) ↦ ap,
      inUp as (c, p, v) => (fun(x: Term) => (c, x, v) ↪ ite, same_source(p)) ↦ ap,
      inVp as (c, u, p) => (fun(x: Term) => (c, u, x) ↪ ite, same_source(p)) ↦ ap,
      swap as p2 => inv(same_source(p2))
    }
  }
  fun left_starts(p: Peak): p ↦ Peak.l1 ↦ Move.start = p ↦ Peak.left ↦ Step.tgt {
    return match p {
      rootT as u => clear, rootF as u => clear, trueU as (e, v) => clear, trueV as (u, e) => clear, falseU as (e, v) => clear, falseV as (u, e) => clear, sameC as (e, u) => clear, sameU as (c, e) => clear, sameV as (c, e) => clear, cU as (e, f, v) => clear, cV as (e, u, f) => clear, uV as (c, e, f) => clear,
      inCp as (p, u, v) => concat(start_in_c(p ↦ Peak.l1, u, v), (fun(x: Term) => (x, u, v) ↪ ite, left_starts(p)) ↦ ap),
      inUp as (c, p, v) => concat(start_in_u(c, p ↦ Peak.l1, v), (fun(x: Term) => (c, x, v) ↪ ite, left_starts(p)) ↦ ap),
      inVp as (c, u, p) => concat(start_in_v(c, u, p ↦ Peak.l1), (fun(x: Term) => (c, u, x) ↪ ite, left_starts(p)) ↦ ap),
      swap as p2 => right_starts(p2)
    }
  }
  fun right_starts(p: Peak): p ↦ Peak.r1 ↦ Move.start = p ↦ Peak.right ↦ Step.tgt {
    return match p {
      rootT as u => clear, rootF as u => clear, trueU as (e, v) => clear, trueV as (u, e) => clear, falseU as (e, v) => clear, falseV as (u, e) => clear, sameC as (e, u) => clear, sameU as (c, e) => clear, sameV as (c, e) => clear, cU as (e, f, v) => clear, cV as (e, u, f) => clear, uV as (c, e, f) => clear,
      inCp as (p, u, v) => concat(start_in_c(p ↦ Peak.r1, u, v), (fun(x: Term) => (x, u, v) ↪ ite, right_starts(p)) ↦ ap),
      inUp as (c, p, v) => concat(start_in_u(c, p ↦ Peak.r1, v), (fun(x: Term) => (c, x, v) ↪ ite, right_starts(p)) ↦ ap),
      inVp as (c, u, p) => concat(start_in_v(c, u, p ↦ Peak.r1), (fun(x: Term) => (c, u, x) ↪ ite, right_starts(p)) ↦ ap),
      swap as p2 => left_starts(p2)
    }
  }
  fun left_links(p: Peak): p ↦ Peak.l1 ↦ Move.finish = p ↦ Peak.l2 ↦ Move.start {
    return match p {
      rootT as u => clear, rootF as u => clear, trueU as (e, v) => clear, trueV as (u, e) => clear, falseU as (e, v) => clear, falseV as (u, e) => clear, sameC as (e, u) => clear, sameU as (c, e) => clear, sameV as (c, e) => clear, cU as (e, f, v) => clear, cV as (e, u, f) => clear, uV as (c, e, f) => clear,
      inCp as (p, u, v) => concat(finish_in_c(p ↦ Peak.l1, u, v), concat((fun(x: Term) => (x, u, v) ↪ ite, left_links(p)) ↦ ap, inv(start_in_c(p ↦ Peak.l2, u, v)))),
      inUp as (c, p, v) => concat(finish_in_u(c, p ↦ Peak.l1, v), concat((fun(x: Term) => (c, x, v) ↪ ite, left_links(p)) ↦ ap, inv(start_in_u(c, p ↦ Peak.l2, v)))),
      inVp as (c, u, p) => concat(finish_in_v(c, u, p ↦ Peak.l1), concat((fun(x: Term) => (c, u, x) ↪ ite, left_links(p)) ↦ ap, inv(start_in_v(c, u, p ↦ Peak.l2)))),
      swap as p2 => right_links(p2)
    }
  }
  fun right_links(p: Peak): p ↦ Peak.r1 ↦ Move.finish = p ↦ Peak.r2 ↦ Move.start {
    return match p {
      rootT as u => clear, rootF as u => clear, trueU as (e, v) => clear, trueV as (u, e) => clear, falseU as (e, v) => clear, falseV as (u, e) => clear, sameC as (e, u) => clear, sameU as (c, e) => clear, sameV as (c, e) => clear, cU as (e, f, v) => clear, cV as (e, u, f) => clear, uV as (c, e, f) => clear,
      inCp as (p, u, v) => concat(finish_in_c(p ↦ Peak.r1, u, v), concat((fun(x: Term) => (x, u, v) ↪ ite, right_links(p)) ↦ ap, inv(start_in_c(p ↦ Peak.r2, u, v)))),
      inUp as (c, p, v) => concat(finish_in_u(c, p ↦ Peak.r1, v), concat((fun(x: Term) => (c, x, v) ↪ ite, right_links(p)) ↦ ap, inv(start_in_u(c, p ↦ Peak.r2, v)))),
      inVp as (c, u, p) => concat(finish_in_v(c, u, p ↦ Peak.r1), concat((fun(x: Term) => (c, u, x) ↪ ite, right_links(p)) ↦ ap, inv(start_in_v(c, u, p ↦ Peak.r2)))),
      swap as p2 => left_links(p2)
    }
  }
  fun valley_meets(p: Peak): p ↦ Peak.l2 ↦ Move.finish = p ↦ Peak.r2 ↦ Move.finish {
    return match p {
      rootT as u => clear, rootF as u => clear, trueU as (e, v) => clear, trueV as (u, e) => clear, falseU as (e, v) => clear, falseV as (u, e) => clear, sameC as (e, u) => clear, sameU as (c, e) => clear, sameV as (c, e) => clear, cU as (e, f, v) => clear, cV as (e, u, f) => clear, uV as (c, e, f) => clear,
      inCp as (p, u, v) => concat(finish_in_c(p ↦ Peak.l2, u, v), concat((fun(x: Term) => (x, u, v) ↪ ite, valley_meets(p)) ↦ ap, inv(finish_in_c(p ↦ Peak.r2, u, v)))),
      inUp as (c, p, v) => concat(finish_in_u(c, p ↦ Peak.l2, v), concat((fun(x: Term) => (c, x, v) ↪ ite, valley_meets(p)) ↦ ap, inv(finish_in_u(c, p ↦ Peak.r2, v)))),
      inVp as (c, u, p) => concat(finish_in_v(c, u, p ↦ Peak.l2), concat((fun(x: Term) => (c, u, x) ↪ ite, valley_meets(p)) ↦ ap, inv(finish_in_v(c, u, p ↦ Peak.r2)))),
      swap as p2 => inv(valley_meets(p2))
    }
  }
}
