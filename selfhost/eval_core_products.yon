// eval of the fragment WITHOUT binders (literals and products), written in Yon.
// Wildcard form: the stuck branches (one intention, "stays stuck") are a single
// `_ =>`. Oracle: Fst(Pair(20, 22)) -> 20.
place Term { this > TLit(Number) :U TPair(Term, Term) :U TFst(Term) :U TSnd(Term) }

fun motT(t: Term): Term { return hit(TLit, 0) }

fun motN(t: Term): Number { return 0 }
fun as_num(t: Term): Number {
  return hit_elim(motN, [ TLit(n) => n, _ => 0 ], t)
}

fun eval(t: Term): Term {
  return hit_elim(motT,
    [ TLit(n)      => hit(TLit, n),
      TPair(a, b)  => hit(TPair, eval(a), eval(b)),
      TFst(p)      => hit_elim(motT, [ TPair(a, b) => eval(a), _ => hit(TFst, eval(p)) ], eval(p)),
      TSnd(p)      => hit_elim(motT, [ TPair(a, b) => eval(b), _ => hit(TSnd, eval(p)) ], eval(p)) ], t)
}

fun main(): Number {
  r := eval(hit(TFst, hit(TPair, hit(TLit, 20), hit(TLit, 22))))
  return as_num(r) - 20
}
