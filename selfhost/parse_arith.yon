// Front end: an arithmetic parser in Yon, closing the chain text -> value.
// Recursive descent with precedence (* over +) as a catamorphism over TokList; the AST
// is the coproduct place Expr, the arithmetic eval another catamorphism Expr -> number.
// The lexer (Token/TokList/lex) is in the same file. The parser has no parenthesized
// factor. Oracle: "2+3*4" = 2 + (3*4) = 14 (precedence is the point, NOT 20).

// ── lexer ───────────────────────────────────────────────────────────────────
place Token { this > TNum Number :U TPlus :U TStar :U TLParen :U TRParen :U TEnd }
place TokList { this > TkNil :U TkCons Token TokList }

fun emit_at(s: Text, i: Number, len: Number, c: Number): TokList {
  return if c == 32 then lex_from(s, i + 1, len)
    else if c == 43 then (TPlus, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 42 then (TStar, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 40 then (TLParen, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 41 then (TRParen, lex_from(s, i + 1, len)) ↪ TkCons
    else if c >= 48 then (c - 48 ↪ TNum, lex_from(s, i + 1, len)) ↪ TkCons
    else lex_from(s, i + 1, len)
}
fun lex_from(s: Text, i: Number, len: Number): TokList {
  return if i >= len then (TEnd, TkNil) ↪ TkCons
    else emit_at(s, i, len, Text.char_at(s, i))
}
fun lex(s: Text): TokList { return lex_from(s, 0, Text.length(s)) }

// ── AST + parse result ───────────────────────────────────────────────────────
place Expr { this > ENum Number :U EAdd Expr Expr :U EMul Expr Expr }
place Parse { this > POk Expr TokList :U PErr }   // (tree, rest) or error

// ── tag-based peek on the TokList ───────────────────────────────────────────
fun tok_tag(t: Token): Number {
  return match t { TNum as n=>0, TPlus=>1, TStar=>2, TLParen=>3, TRParen=>4, TEnd=>5 }
}
fun tok_num(t: Token): Number {
  return match t { TNum as n=>n, TPlus=>0, TStar=>0, TLParen=>0, TRParen=>0, TEnd=>0 }
}
fun head_tag(l: TokList): Number {
  return match l { TkNil => 0 - 1, TkCons as (h, t) => tok_tag(h) }
}
fun head_num(l: TokList): Number {
  return match l { TkNil => 0, TkCons as (h, t) => tok_num(h) }
}
fun tail(l: TokList): TokList {
  return match l { TkNil => TkNil, TkCons as (h, t) => t }
}

// ── recursive-descent parser with precedence ────────────────────────────────

// factor := NUM
fun parse_factor(l: TokList): Parse {
  return if head_tag(l) == 0
    then (head_num(l) ↪ ENum, tail(l)) ↪ POk
    else PErr
}

// term := factor ('*' term)?
fun parse_term(l: TokList): Parse { return term_more(parse_factor(l)) }
fun term_more(p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) =>
        if head_tag(rest) == 2
        then combine_mul(left, parse_term(tail(rest)))
        else (left, rest) ↪ POk }
}
fun combine_mul(left: Expr, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (right, rest) => ((left, right) ↪ EMul, rest) ↪ POk }
}

// expr := term ('+' expr)?
fun parse_expr(l: TokList): Parse { return expr_more(parse_term(l)) }
fun expr_more(p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) =>
        if head_tag(rest) == 1
        then combine_add(left, parse_expr(tail(rest)))
        else (left, rest) ↪ POk }
}
fun combine_add(left: Expr, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (right, rest) => ((left, right) ↪ EAdd, rest) ↪ POk }
}

// arithmetic eval: catamorphism Expr -> number
fun eval_expr(e: Expr): Number {
  return match e { ENum as n    => n,
      EAdd as (a, b) => eval_expr(a) + eval_expr(b),
      EMul as (a, b) => eval_expr(a) * eval_expr(b) }
}

fun result_of(p: Parse): Number {
  return match p { PErr => 0 - 1, POk as (e, rest) => eval_expr(e) }
}

// ── oracle:  "2+3*4" = 2 + (3*4) = 14 ───────────────────────────────────────
fun src: Text {
  return Text.concat(
           Text.concat(Text.from_char(50), Text.from_char(43)),
           Text.concat(Text.concat(Text.from_char(51), Text.from_char(42)),
                         Text.from_char(52)))
}

fun main: Number {
  return result_of(parse_expr(lex(src))) - 14
}
