// shift / subst / beta / eval of the lambda core (de Bruijn), written in Yon.
// Wildcard form: shift/subst stay exhaustive (each constructor recurses in its own
// way), but the stuck branches of eval and the zero branches of as_num are a single
// `_ =>`. Oracle: (lam.0) 42 = 42, Fst((lam.0) Pair(20,22)) = 20.
place Term { this > TLit(Number) :U TVar(Number) :U TLam(Term) :U TApp(Term, Term) :U TPair(Term, Term) :U TFst(Term) :U TSnd(Term) }


fun shift(d: Number, c: Number, t: Term): Term {
  return match t { TLit(n)     => .-> TLit { _1 n },
      TVar(i)     => if i >= c then .-> TVar { _1 i + d } else .-> TVar { _1 i },
      TLam(b)     => .-> TLam { _1 shift(d, c + 1, b) },
      TApp(f, x)  => .-> TApp { _1 shift(d, c, f) _2 shift(d, c, x) },
      TPair(a, b) => .-> TPair { _1 shift(d, c, a) _2 shift(d, c, b) },
      TFst(p)     => .-> TFst { _1 shift(d, c, p) },
      TSnd(p)     => .-> TSnd { _1 shift(d, c, p) } }
}

fun subst(j: Number, s: Term, t: Term): Term {
  return match t { TLit(n)     => .-> TLit { _1 n },
      TVar(i)     => if i == j then s else .-> TVar { _1 i },
      TLam(b)     => .-> TLam { _1 subst(j + 1, shift(1, 0, s), b) },
      TApp(f, x)  => .-> TApp { _1 subst(j, s, f) _2 subst(j, s, x) },
      TPair(a, b) => .-> TPair { _1 subst(j, s, a) _2 subst(j, s, b) },
      TFst(p)     => .-> TFst { _1 subst(j, s, p) },
      TSnd(p)     => .-> TSnd { _1 subst(j, s, p) } }
}

fun beta(body: Term, arg: Term): Term {
  return shift(0 - 1, 0, subst(0, shift(1, 0, arg), body))
}

fun eval(t: Term): Term {
  return match t { TLit(n)     => .-> TLit { _1 n },
      TVar(i)     => .-> TVar { _1 i },
      TLam(b)     => .-> TLam { _1 b },
      TApp(f, x)  => match eval(f) { TLam(b) => eval(beta(b, eval(x))),
                         _       => .-> TApp { _1 eval(f) _2 eval(x) } },
      TPair(a, b) => .-> TPair { _1 eval(a) _2 eval(b) },
      TFst(p)     => match eval(p) { TPair(a, b) => eval(a), _ => .-> TFst { _1 eval(p) } },
      TSnd(p)     => match eval(p) { TPair(a, b) => eval(b), _ => .-> TSnd { _1 eval(p) } } }
}

fun as_num(t: Term): Number {
  return match t { TLit(n) => n, TVar(i) => i, _ => 0 }
}

fun main(): Number {
  id_lit   := eval(.-> TApp { _1 .-> TLam { _1 .-> TVar { _1 0 } } _2 .-> TLit { _1 42 } })
  fst_beta := eval(.-> TFst { _1 .-> TApp { _1 .-> TLam { _1 .-> TVar { _1 0 } } _2 .-> TPair { _1 .-> TLit { _1 20 } _2 .-> TLit { _1 22 } } } })
  return (as_num(id_lit) - 42) + (as_num(fst_beta) - 20)
}
