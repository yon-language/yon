/* A Yon0 surface compiler in Yon: source text -> Term -> MLIR.
 *
 * Over the bare arithmetic of compile_arith.yon, the front end reads the Yon
 * surface: a function with let-bindings and a return,
 *
 *   fun main(): number {
 *     x := 20
 *     y := 22
 *     return x + y
 *   }
 *
 * The lexer recognises multi-character keywords (fun/be/return/number), the
 * two-character `:=`, multi-digit numbers and lowercase identifiers; the parser
 * threads a de Bruijn name environment (from parse_scope) so `x := e` is read
 * as a TLet and a variable reference as a TVar index; the emitter is the gen of
 * emit_arith.yon (TLit/TAdd/TMul/TVar/TLet over an SSA environment). The emitted module exits 42 = (20 + 22)
 * mod 256. One AST (Term) shared by parser and emitter; no interpreter in the loop.
 *
 * Boundary: one function `fun main(): number { ... }`, lowercase identifiers,
 * + and * only, no calls.
 */

/* one shared AST: arithmetic + de Bruijn variables + let. */
place Term { this > TLit Number :U TAdd Term Term :U TMul Term Term :U TVar Number :U TLet Term Term }
/* tokens: literals, identifiers, the four keywords, `:=`, operators, punctuation. */
/* TKwBe is retired (a definition is `x := e`, with no keyword); it keeps
   its tag so every other token keeps its own. */
place Token { this > TNum Number :U TIdent Number :U TKwFun :U TKwBe :U TColonEq :U TKwReturn :U TKwNumber :U TPlus :U TStar :U TLParen :U TRParen :U TLBrace :U TRBrace :U TColon :U TEnd }
place TokList { this > TkNil :U TkCons Token TokList }
place Parse { this > POk Term TokList :U PErr }
/* SSA environment for the emitter: de Bruijn index -> ssa name. */
place SsaEnv { this > SeNil :U SeCons Text SsaEnv }
/* de Bruijn name environment for the parser: identifier hash, innermost first. */
place NameEnv { this > NEnvNil :U NEnvCons Number NameEnv }
/* result of gen: (result ssa, accumulated code, next counter). */
place EmitR { this > ER Text Text Number }

/* ---- hashing: keyword recognition and identifier identity share one hash ---- */
/* rolling hash over s[i..j): h' = h*31 + code. A keyword literal and the same word
 * in the source therefore hash to the same value. */
fun word_hash(s: Text, i: Number, j: Number, h: Number): Number {
  return if i >= j then h
    else word_hash(s, i + 1, j, h * 31 + Text.char_at(s, i))
}
fun hash_of(s: Text): Number { return word_hash(s, 0, Text.length(s), 0) }
fun kw_fun: Number    { return hash_of("fun") }
fun kw_return: Number { return hash_of("return") }
fun kw_number: Number { return hash_of("number") }

/* ---- lexer: Text -> TokList ---- */
/* end index of the lowercase-letter run [i..): first non-letter position (a=97,z=122). */
fun word_end(s: Text, i: Number, len: Number): Number {
  return if i >= len then i
    else if Text.char_at(s, i) >= 97 then
           (if Text.char_at(s, i) >= 123 then i else word_end(s, i + 1, len))
         else i
}
/* end index of the digit run [i..) (0=48,9=57). */
fun num_end(s: Text, i: Number, len: Number): Number {
  return if i >= len then i
    else if Text.char_at(s, i) >= 48 then
           (if Text.char_at(s, i) >= 58 then i else num_end(s, i + 1, len))
         else i
}
/* value of the digit run s[i..j) as a base-10 number. */
fun num_val(s: Text, i: Number, j: Number, acc: Number): Number {
  return if i >= j then acc
    else num_val(s, i + 1, j, acc * 10 + (Text.char_at(s, i) - 48))
}
/* a word hash -> its token: a keyword if it matches one, else an identifier. */
fun classify(h: Number): Token {
  return if h == kw_fun then TKwFun
    else if h == kw_return then TKwReturn
    else if h == kw_number then TKwNumber
    else h ↪ TIdent
}
fun lex_word(s: Text, i: Number, len: Number): TokList {
  j := word_end(s, i, len)
  return (classify(word_hash(s, i, j, 0)), lex_from(s, j, len)) ↪ TkCons
}
/* ':=' (a definition: "is defined as") or a lone ':' (peek the next char
   for '=' = 61). */
fun lex_colon(s: Text, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TColon, lex_from(s, i + 1, len)) ↪ TkCons
    else if Text.char_at(s, i + 1) == 61
    then (TColonEq, lex_from(s, i + 2, len)) ↪ TkCons
    else (TColon, lex_from(s, i + 1, len)) ↪ TkCons
}
fun lex_num(s: Text, i: Number, len: Number): TokList {
  j := num_end(s, i, len)
  return (num_val(s, i, j, 0) ↪ TNum, lex_from(s, j, len)) ↪ TkCons
}
/* punctuation and whitespace handled first; letters and digits delegate to the
 * multi-char scanners. '{' (123) '}' (125) ':' (58) are matched before the a-z
 * range check so they are not mistaken for letters. */
fun lex_at(s: Text, i: Number, len: Number, c: Number): TokList {
  return if c == 32 then lex_from(s, i + 1, len)             /* space */
    else if c == 10 then lex_from(s, i + 1, len)             /* newline */
    else if c == 9  then lex_from(s, i + 1, len)             /* tab */
    else if c == 43 then (TPlus, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 42 then (TStar, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 40 then (TLParen, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 41 then (TRParen, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 123 then (TLBrace, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 125 then (TRBrace, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 58 then lex_colon(s, i, len)               /* ':' or ':=' */
    else if c >= 97 then lex_word(s, i, len)                 /* a-z: keyword or ident */
    else if c >= 48 then lex_num(s, i, len)                  /* 0-9: number */
    else lex_from(s, i + 1, len)                             /* skip anything else */
}
fun lex_from(s: Text, i: Number, len: Number): TokList {
  return if i >= len then (TEnd, TkNil) ↪ TkCons
    else lex_at(s, i, len, Text.char_at(s, i))
}
fun lex(s: Text): TokList { return lex_from(s, 0, Text.length(s)) }

/* ---- token/list peeking (tags: Num0 Ident1 Fun2 Be3 ColonEq4 Return5 Number6
 * Plus7 Star8 LParen9 RParen10 LBrace11 RBrace12 Colon13 End14) ---- */
fun tok_tag(t: Token): Number {
  return match t {
    TNum as n=>0, TIdent as h=>1, TKwFun=>2, TKwBe=>3, TColonEq=>4, TKwReturn=>5,
    TKwNumber=>6, TPlus=>7, TStar=>8, TLParen=>9, TRParen=>10, TLBrace=>11,
    TRBrace=>12, TColon=>13, TEnd=>14 }
}
fun tok_num(t: Token): Number {
  return match t {
    TNum as n=>n, TIdent as h=>h, TKwFun=>0, TKwBe=>0, TColonEq=>0, TKwReturn=>0,
    TKwNumber=>0, TPlus=>0, TStar=>0, TLParen=>0, TRParen=>0, TLBrace=>0,
    TRBrace=>0, TColon=>0, TEnd=>0 }
}
fun head_tag(l: TokList): Number {
  return match l { TkNil => 0 - 1, TkCons as (h, t) => tok_tag(h) }
}
fun head_num(l: TokList): Number {
  return match l { TkNil => 0, TkCons as (h, t) => tok_num(h) }
}
fun tail(l: TokList): TokList {
  return match l { TkNil => TkNil, TkCons as (h, t) => t }
}

/* ---- de Bruijn name environment: identifier hash -> index (innermost = 0) ---- */
fun bump(k: Number): Number { return if k >= 0 then k + 1 else 0 - 1 }
fun lookup_name(name: Number, env: NameEnv): Number {
  return match env { NEnvNil => 0 - 1,
      NEnvCons as (h, rest) => if h == name then 0 else bump(lookup_name(name, rest)) }
}

/* ---- recursive-descent expression parser (threads the name environment) ---- */
/* factor := NUM | IDENT | '(' expr ')' */
fun parse_factor(l: TokList, env: NameEnv): Parse {
  return if head_tag(l) == 0 then (head_num(l) ↪ TLit, tail(l)) ↪ POk
    else if head_tag(l) == 1 then (lookup_name(head_num(l), env) ↪ TVar, tail(l)) ↪ POk
    else if head_tag(l) == 9 then close_paren(parse_expr(tail(l), env))
    else PErr
}
fun close_paren(p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (e, rest) => if head_tag(rest) == 10 then (e, tail(rest)) ↪ POk else PErr }
}
/* term := factor ('*' term)? */
fun parse_term(l: TokList, env: NameEnv): Parse { return term_more(parse_factor(l, env), env) }
fun term_more(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) => if head_tag(rest) == 8
                           then combine(8, left, parse_term(tail(rest), env))
                           else (left, rest) ↪ POk }
}
/* expr := term ('+' expr)? */
fun parse_expr(l: TokList, env: NameEnv): Parse { return expr_more(parse_term(l, env), env) }
fun expr_more(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) => if head_tag(rest) == 7
                           then combine(7, left, parse_expr(tail(rest), env))
                           else (left, rest) ↪ POk }
}
fun combine(op: Number, left: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (right, rest) =>
        (if op == 7 then (left, right) ↪ TAdd else (left, right) ↪ TMul, rest) ↪ POk }
}

/* ---- body parser: (IDENT ':=' expr)* 'return' expr ---- */
/* each `x := e` is read as TLet(e, <rest with x bound innermost>). */
fun parse_body(l: TokList, env: NameEnv): Parse {
  return if head_tag(l) == 1          /* IDENT */
    then parse_ident_stmt(l, env)
    else if head_tag(l) == 5          /* 'return' */
    then parse_expr(tail(l), env)
    else PErr
}
/* an IDENT starts a body item only as `IDENT ':='`, a definition */
fun parse_ident_stmt(l: TokList, env: NameEnv): Parse {
  return if head_tag(tail(l)) == 4 then parse_let(l, env) else PErr
}
fun parse_let(l: TokList, env: NameEnv): Parse {
  name := head_num(l)                    /* the IDENT */
  after_def := tail(tail(l))           /* skip IDENT, ':=' -> value */
  return build_let(parse_expr(after_def, env), name, env)
}
fun build_let(pv: Parse, name: Number, env: NameEnv): Parse {
  return match pv { PErr => PErr,
      POk as (val, rest) =>
        wrap_let(val, parse_body(rest, (name, env) ↪ NEnvCons)) }
}
fun wrap_let(val: Term, pb: Parse): Parse {
  return match pb { PErr => PErr,
      POk as (body, rest) => ((val, body) ↪ TLet, rest) ↪ POk }
}

/* ---- program parser: 'fun' IDENT '(' ')' ':' 'number' '{' body '}' ---- */
fun skip7(l: TokList): TokList {
  /* consume the fixed header of `fun main(): number {` (main has no params). */
  return tail(tail(tail(tail(tail(tail(tail(l)))))))
}
fun parse_program(l: TokList): Parse {
  return if head_tag(l) == 2          /* leading 'fun' */
    then parse_body(skip7(l), NEnvNil)
    else PErr
}
fun term_of(p: Parse): Term {
  return match p { PErr => 0 ↪ TLit, POk as (e, rest) => e }
}

/* ---- back end: gen (Term -> MLIR text) with an SSA environment ---- */
fun er_ssa(e: EmitR):  Text { return match e { ER as (s, c, n) => s } }
fun er_code(e: EmitR): Text { return match e { ER as (s, c, n) => c } }
fun er_ctr(e: EmitR):  Number { return match e { ER as (s, c, n) => n } }

fun lookup_ssa(i: Number, env: SsaEnv): Text {
  return match env { SeNil => "%vERR",
      SeCons as (h, rest) => if i == 0 then h else lookup_ssa(i - 1, rest) }
}

fun ssa_name(n: Number): Text { return Text.concat("%v", Text.from_int(n)) }
fun num_lit(k: Number): Text  { return Text.concat(Text.from_int(k), ".0") }
fun line(ssa: Text, rhs: Text): Text {
  return Text.concat(Text.concat(Text.concat("  ", ssa),
           Text.concat(" = ", rhs)), " : f64\n")
}

fun gen(t: Term, env: SsaEnv, n: Number): EmitR {
  return match t {
    TLit as k =>
      (ssa_name(n), line(ssa_name(n), Text.concat("arith.constant ", num_lit(k))), n + 1) ↪ ER,
    TVar as i => (lookup_ssa(i, env), "", n) ↪ ER,   /* already an ssa: no new line */
    TLet as (e1, body) => gen_let(e1, body, env, n),
    TAdd as (a, b) => gen_bin("arith.addf", a, b, env, n),
    TMul as (a, b) => gen_bin("arith.mulf", a, b, env, n)
  }
}
/* let: emit e1, push its ssa onto env, emit body in that env. */
fun gen_let(e1: Term, body: Term, env: SsaEnv, n: Number): EmitR {
  ea := gen(e1, env, n)
  eb := gen(body, (er_ssa(ea), env) ↪ SeCons, er_ctr(ea))
  return (er_ssa(eb), Text.concat(er_code(ea), er_code(eb)), er_ctr(eb)) ↪ ER
}
/* binop: emit a, then b (same env), then "<ssa> = <op> <sa>, <sb> : f64". */
fun gen_bin(op: Text, a: Term, b: Term, env: SsaEnv, n: Number): EmitR {
  ea := gen(a, env, n)
  eb := gen(b, env, er_ctr(ea))
  m  := er_ctr(eb)
  rhs := Text.concat(Text.concat(op, " "),
                 Text.concat(Text.concat(er_ssa(ea), ", "), er_ssa(eb)))
  return (ssa_name(m), Text.concat(Text.concat(er_code(ea), er_code(eb)),
                          line(ssa_name(m), rhs)), m + 1) ↪ ER
}

/* ---- module boilerplate ---- */
fun mod_prefix: Text {
  return "module {\n  func.func private @yon_rt_maybe_serve() -> ()\n  func.func @main() -> i32 {\n    func.call @yon_rt_maybe_serve() : () -> ()\n"
}
fun stubs: Text {
  return "  func.func @__yon_dispatch(%sel: f64, %a1: f64, %a2: f64, %a3: f64, %a4: f64) -> f64 {\n    %d = arith.constant -777.0 : f64\n    return %d : f64\n  }\n  func.func @__yon_closure_call(%clo: f64, %a1: f64, %a2: f64, %a3: f64, %a4: f64) -> f64 {\n    %c = arith.constant -777.0 : f64\n    return %c : f64\n  }\n}\n"
}
fun mod_suffix(result_ssa: Text, ctr: Number): Text {
  rss := ssa_name(ctr)
  return Text.concat(
    Text.concat("    ", Text.concat(rss,
      Text.concat(" = arith.fptosi ", Text.concat(result_ssa, " : f64 to i32\n")))),
    Text.concat(Text.concat("    return ", Text.concat(rss, " : i32\n  }\n")),
      stubs))
}

/* the Yon0 source (real newlines via \n), lexed and compiled by this program. */
fun src: Text {
  return "fun main(): number {\n  x := 20\n  y := 22\n  return x + y\n}\n"
}

fun main(): Number {
  /* full pipeline: source text -> tokens -> Term -> MLIR module -> file.
   * expected Term: TLet(20, TLet(22, TAdd(TVar 1, TVar 0))) -> emitted exit 42. */
  prog := term_of(parse_program(lex(src)))
  r := gen(prog, SeNil, 0)
  full := Text.concat(mod_prefix,
                  Text.concat(er_code(r),
                    mod_suffix(er_ssa(r), er_ctr(r))))
  _w := File.write_text(Text.concat(Args.get(1), "/out.mlir"), full)
  _p := Text.print(full)
  return Text.length(full)
}
