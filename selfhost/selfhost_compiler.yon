/* The file-driven Yon0 compiler, used by the differential oracle and the fixpoint.
 *
 * The compiler machinery of compile_rec.yon (lexer, recursive-descent parser,
 * de Bruijn scope, gen: Term -> MLIR, functions/calls/recursion), but instead of
 * a fixed source string it READS a Yon0 program from <dir>/in.yon and WRITES the
 * MLIR module to <dir>/out.mlir (File.read_text/write_text), where <dir> is its
 * first argument: every run works in a directory of its own, so two runs never
 * share a file.
 *
 * The differential oracle (regression/test_selfhost_differential.py) writes a
 * Yon0 program, compiles it BOTH with the OCaml reference `yonc` and with this
 * compiler-in-Yon, and asserts the two native programs exit with the SAME code.
 *
 * Yon0 covered: coproduct places `place X { this > A :U B .. }`, functions
 * `fun name(p, ..): T { (x := e)* return e }` with 0..N parameters, arithmetic
 * (+ - *, * over +), calls `name(..)` and qualified calls `Module.op(..)`,
 * `if e CMP e then e else e` with CMP one of == != < > <= >=, recursion, string
 * literals, injection `(e .. ↦ Arm)`, bare nullary arms, match. The subset is the one this file is written in:
 * regression/test_selfhost_fixpoint.py feeds it its own source.
 * A function name is emitted as `@fn_<hash>`; `main` is the i32 entry `@main`.
 * `+`/`-`/`*` are LEFT-associative: `a - b - c` = (a-b)-c, as the reference.
 */

/* one shared AST: arithmetic (+ - *), de Bruijn variables, let, comparison, if, call,
 * and algebraic data: THit builds a constructor, THitElim eliminates one. */
place Term { this > TLit Number :U TAdd Term Term :U TSub Term Term :U TMul Term Term :U TVar Number :U TLet Term Term :U TCmp Number Term Term :U TIf Term Term Term :U TCall Number Term :U TArgs Term Term :U TNoArg :U THit Number Term :U THitElim Term Term :U TBranch Number Number Term Term :U TBrNil :U TStrLit String :U TRtCall String Term }
/* TCall's second field and THit's are an argument spine: TArgs(head, rest) ... TNoArg.
 * THitElim's first field is a branch spine: TBranch(ctor-hash, body, rest) ... TBrNil.
 * Keeping these inside Term avoids mutually recursive place declarations. */
/* a top-level function: name hash, arity (0..N), body (params are TVar 0..N-1). */
place Fun { this > FnDef Number Number Term }
place FunList { this > FlNil :U FlCons Fun FunList }
place FunParse { this > FPOk Fun TokList :U FPErr }
/* constructor registry: constructor-name hash -> tag (its index in its place). */
place CtorReg { this > CrNil :U CrCons Number Number CtorReg }
place Program { this > Prog FunList CtorReg }
place IndRes { this > IR CtorReg TokList }
/* result of binding a branch's payloads: extended SSA env, emitted code, next counter. */
place BindRes { this > BR SsaEnv String Number }
/* tokens (tags: Num0 Ident1 Fun2 Be3 ColonEq4 Return5 Number6 If7 Then8 Else9
 * Plus10 Star11 EqEq12 LParen13 RParen14 LBrace15 RBrace16 Colon17 End18 Minus19
 * Comma20 Lt21 Gt22 Le23 Ge24 Ne25 LBracket27 RBracket28 Bar29 Arrow30
 * Place31 This32 ColonU33 Dot34 Str35 MapsTo36 Inj37; tag 26 is unused: it belonged to the retired
 * 'inductive' keyword). */
/* TKwBe is retired (a definition is `x := e`, with no keyword); it keeps
   its tag so every other token keeps its own. */
place Token { this > TNum Number :U TIdent Number :U TKwFun :U TKwBe :U TColonEq :U TKwReturn :U TKwNumber :U TKwIf :U TKwThen :U TKwElse :U TPlus :U TStar :U TEqEq :U TLParen :U TRParen :U TLBrace :U TRBrace :U TColon :U TEnd :U TMinus :U TComma :U TLt :U TGt :U TLe :U TGe :U TNe :U TLBracket :U TRBracket :U TBar :U TArrow :U TKwPlace :U TKwThis :U TColonU :U TDot :U TStr String :U TMapsTo :U TInj }
place TokList { this > TkNil :U TkCons Token TokList }
place Parse { this > POk Term TokList :U PErr }
/* SSA environment for the emitter: de Bruijn index -> ssa name. */
place SsaEnv { this > SeNil :U SeCons String SsaEnv }
/* de Bruijn name environment for the parser: identifier hash, innermost first. */
place NameEnv { this > NEnvNil :U NEnvCons Number NameEnv }
/* result of gen: (result ssa, accumulated code, next counter). */
place EmitR { this > ER String String Number }

/* ---- hashing: keyword recognition and identifier identity share one hash ---- */
/* keep a value below m by repeated subtraction (Yon0 has no '%' operator). */
fun mod_reduce(x: Number, m: Number): Number {
  return if x >= m then mod_reduce(x - m, m) else x
}
/* rolling hash over s[i..j): h' = (h*31 + code) mod 2000003. The modulus keeps the
 * hash an integer below 2^21, exact in an f64 whatever the length of the
 * identifier: h*31 of an unbounded hash would pass 2^53 and lose its low digits. */
fun word_hash(s: String, i: Number, j: Number, h: Number): Number {
  return if i >= j then h
    else word_hash(s, i + 1, j, mod_reduce(h * 31 + String.char_at(s, i), 2000003))
}
fun hash_of(s: String): Number { return word_hash(s, 0, String.length(s), 0) }
fun kw_fun(): Number    { return hash_of("fun") }
fun kw_return(): Number { return hash_of("return") }
fun kw_number(): Number { return hash_of("number") }
fun kw_if(): Number     { return hash_of("if") }
fun kw_then(): Number   { return hash_of("then") }
fun kw_else(): Number   { return hash_of("else") }
fun kw_place(): Number     { return hash_of("place") }
fun kw_this(): Number      { return hash_of("this") }
fun kw_match(): Number     { return hash_of("match") }

/* ---- lexer: String -> TokList ---- */
/* an identifier char: a-z (97-122), A-Z (65-90), 0-9 (48-57), or '_' (95).
 * Identifiers start with a letter or '_' (dispatched in lex_at) and continue on
 * any of these; constructor and type names are capitalised, so A-Z is required. */
fun word_char(c: Number): Number {
  return if c >= 97 then (if c >= 123 then 0 else 1)     /* a-z */
    else if c == 95 then 1                               /* _ */
    else if c >= 65 then (if c >= 91 then 0 else 1)      /* A-Z */
    else if c >= 48 then (if c >= 58 then 0 else 1)      /* 0-9 */
    else 0
}
fun word_end(s: String, i: Number, len: Number): Number {
  return if i >= len then i
    else if word_char(String.char_at(s, i)) == 1 then word_end(s, i + 1, len)
    else i
}
fun num_end(s: String, i: Number, len: Number): Number {
  return if i >= len then i
    else if String.char_at(s, i) >= 48 then
           (if String.char_at(s, i) >= 58 then i else num_end(s, i + 1, len))
         else i
}
fun num_val(s: String, i: Number, j: Number, acc: Number): Number {
  return if i >= j then acc
    else num_val(s, i + 1, j, acc * 10 + (String.char_at(s, i) - 48))
}
fun classify(h: Number): Token {
  return if h == kw_fun() then TKwFun
    else if h == kw_return() then TKwReturn
    else if h == kw_number() then TKwNumber
    else if h == kw_if() then TKwIf
    else if h == kw_then() then TKwThen
    else if h == kw_else() then TKwElse
    else if h == kw_place() then TKwPlace
    else if h == kw_this() then TKwThis
    else h ↪ TIdent
}
fun lex_word(s: String, i: Number, len: Number): TokList {
  j := word_end(s, i, len)
  return (classify(word_hash(s, i, j, 0)), lex_from(s, j, len)) ↪ TkCons
}
fun lex_num(s: String, i: Number, len: Number): TokList {
  j := num_end(s, i, len)
  return (num_val(s, i, j, 0) ↪ TNum, lex_from(s, j, len)) ↪ TkCons
}
/* string literal: scan to the closing '"' (code 34). Backslash (92) escapes the
 * next char, so a '\"' inside the literal does not end it. */
fun str_end(s: String, i: Number, len: Number): Number {
  return if i >= len then i
    else if String.char_at(s, i) == 92 then str_end(s, i + 2, len)   /* skip escaped char */
    else if String.char_at(s, i) == 34 then i                        /* closing quote */
    else str_end(s, i + 1, len)
}
/* the char an escape denotes: \n -> 10, \t -> 9, \" -> 34, \\ -> 92, else literal. */
fun escape_char(c: Number): Number {
  return if c == 110 then 10
    else if c == 116 then 9
    else if c == 34 then 34
    else if c == 92 then 92
    else c
}
/* build the literal content [i, j), interpreting backslash escapes. yonc does
 * this at lex time, so the self-host MUST too: otherwise its own "...\n..."
 * literals capture a raw backslash-n and the frontend fixpoint breaks (stage-2
 * emits a literal backslash-n where stage-1 emitted a newline). */
fun str_content(s: String, i: Number, j: Number, acc: String): String {
  return if i >= j then acc
    else if String.char_at(s, i) == 92 then
      str_content(s, i + 2, j, String.concat(acc, String.from_char(escape_char(String.char_at(s, i + 1)))))
    else str_content(s, i + 1, j, String.concat(acc, String.from_char(String.char_at(s, i))))
}
/* i is at the char AFTER the opening quote. */
fun lex_str(s: String, i: Number, len: Number): TokList {
  j := str_end(s, i, len)
  return (str_content(s, i, j, "") ↪ TStr, lex_from(s, j + 1, len)) ↪ TkCons
}
fun lex_eq(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TEnd, TkNil) ↪ TkCons
    else if String.char_at(s, i + 1) == 61
    then (TEqEq, lex_from(s, i + 2, len)) ↪ TkCons          /* '==' */
    else if String.char_at(s, i + 1) == 62
    then (TArrow, lex_from(s, i + 2, len)) ↪ TkCons         /* '=>' */
    else lex_from(s, i + 1, len)
}
/* '<' or '<=' (peek the next char for '='). */
fun lex_lt(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TLt, lex_from(s, i + 1, len)) ↪ TkCons
    else if String.char_at(s, i + 1) == 61
    then (TLe, lex_from(s, i + 2, len)) ↪ TkCons
    else (TLt, lex_from(s, i + 1, len)) ↪ TkCons
}
/* '>' or '>='. */
/* the third byte tells them apart: ↦ is E2 86 A6, ↪ is E2 86 AA. */
fun lex_arrow(s: String, i: Number, len: Number): TokList {
  return if String.char_at(s, i + 2) == 166 then (TMapsTo, lex_from(s, i + 3, len)) ↪ TkCons
    else (TInj, lex_from(s, i + 3, len)) ↪ TkCons
}
fun lex_gt(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TGt, lex_from(s, i + 1, len)) ↪ TkCons
    else if String.char_at(s, i + 1) == 61
    then (TGe, lex_from(s, i + 2, len)) ↪ TkCons
    else (TGt, lex_from(s, i + 1, len)) ↪ TkCons
}
/* ':U' (the union operator), ':=' (a definition: "is defined as") or a lone
   ':' (peek the next char: 'U' = 85, '=' = 61). */
fun lex_colon(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TColon, lex_from(s, i + 1, len)) ↪ TkCons
    else if String.char_at(s, i + 1) == 85
    then (TColonU, lex_from(s, i + 2, len)) ↪ TkCons
    else if String.char_at(s, i + 1) == 61
    then (TColonEq, lex_from(s, i + 2, len)) ↪ TkCons
    else (TColon, lex_from(s, i + 1, len)) ↪ TkCons
}
/* '!=' (a lone '!' is not a Yon0 token, so skip it). */
fun lex_ne(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TEnd, TkNil) ↪ TkCons
    else if String.char_at(s, i + 1) == 61
    then (TNe, lex_from(s, i + 2, len)) ↪ TkCons
    else lex_from(s, i + 1, len)
}
/* '/' begins a comment: '/*' block or '//' line; a lone '/' is skipped. */
fun lex_slash(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then lex_from(s, i + 1, len)
    else if String.char_at(s, i + 1) == 42 then skip_block(s, i + 2, len)   /* '/*' */
    else if String.char_at(s, i + 1) == 47 then skip_line(s, i + 2, len)    /* '//' */
    else lex_from(s, i + 1, len)
}
/* skip a block comment until the closing star-then-slash. */
fun skip_block(s: String, i: Number, len: Number): TokList {
  return if i + 1 >= len then (TEnd, TkNil) ↪ TkCons            /* unterminated */
    else if String.char_at(s, i) == 42 then                                /* star */
           (if String.char_at(s, i + 1) == 47 then lex_from(s, i + 2, len)  /* slash: comment ends */
            else skip_block(s, i + 1, len))
         else skip_block(s, i + 1, len)
}
/* skip a line comment until the next newline. */
fun skip_line(s: String, i: Number, len: Number): TokList {
  return if i >= len then (TEnd, TkNil) ↪ TkCons
    else if String.char_at(s, i) == 10 then lex_from(s, i + 1, len)
    else skip_line(s, i + 1, len)
}
fun lex_at(s: String, i: Number, len: Number, c: Number): TokList {
  return if c == 32 then lex_from(s, i + 1, len)             /* space */
    else if c == 10 then lex_from(s, i + 1, len)             /* newline */
    else if c == 9  then lex_from(s, i + 1, len)             /* tab */
    else if c == 43 then (TPlus, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 45 then (TMinus, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 42 then (TStar, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 61 then lex_eq(s, i, len)                   /* '=' -> '==' */
    else if c == 60 then lex_lt(s, i, len)                   /* '<' -> '<' or '<=' */
    else if c == 62 then lex_gt(s, i, len)                   /* '>' -> '>' or '>=' */
    else if c == 33 then lex_ne(s, i, len)                   /* '!' -> '!=' */
    else if c == 47 then lex_slash(s, i, len)                /* '/' -> comment */
    else if c == 40 then (TLParen, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 41 then (TRParen, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 123 then (TLBrace, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 125 then (TRBrace, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 58 then lex_colon(s, i, len)                /* ':' -> ':', ':U' or ':=' */
    else if c == 44 then (TComma, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 91 then (TLBracket, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 93 then (TRBracket, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 226 then lex_arrow(s, i, len)               /* the arrows, in UTF-8 */
    else if c == 124 then (TBar, lex_from(s, i + 1, len)) ↪ TkCons
    else if c == 46 then (TDot, lex_from(s, i + 1, len)) ↪ TkCons  /* '.' */
    else if c == 34 then lex_str(s, i + 1, len)              /* '"' -> string literal */
    else if c >= 97 then lex_word(s, i, len)                 /* a-z: keyword or ident */
    else if c == 95 then lex_word(s, i, len)                 /* _ : leading-underscore ident */
    else if c >= 65 then                                     /* A-Z: capitalised ident */
           (if c >= 91 then lex_from(s, i + 1, len) else lex_word(s, i, len))
    else if c >= 48 then lex_num(s, i, len)                  /* 0-9: number */
    else lex_from(s, i + 1, len)                             /* skip anything else */
}
fun lex_from(s: String, i: Number, len: Number): TokList {
  return if i >= len then (TEnd, TkNil) ↪ TkCons
    else lex_at(s, i, len, String.char_at(s, i))
}
fun lex(s: String): TokList { return lex_from(s, 0, String.length(s)) }

/* ---- token/list peeking ---- */
fun tok_tag(t: Token): Number {
  return match t {
    TNum as n=>0, TIdent as h=>1, TKwFun=>2, TKwBe=>3, TColonEq=>4, TKwReturn=>5,
    TKwNumber=>6, TKwIf=>7, TKwThen=>8, TKwElse=>9, TPlus=>10, TStar=>11,
    TEqEq=>12, TLParen=>13, TRParen=>14, TLBrace=>15, TRBrace=>16, TColon=>17,
    TEnd=>18, TMinus=>19, TComma=>20,
    TLt=>21, TGt=>22, TLe=>23, TGe=>24, TNe=>25,
    TLBracket=>27, TRBracket=>28, TBar=>29, TArrow=>30,
    TKwPlace=>31, TKwThis=>32, TColonU=>33, TDot=>34, TStr as sh=>35, TMapsTo=>36, TInj=>37 }
}
fun tok_num(t: Token): Number {
  return match t {
    TNum as n=>n, TIdent as h=>h, TKwFun=>0, TKwBe=>0, TColonEq=>0, TKwReturn=>0,
    TKwNumber=>0, TKwIf=>0, TKwThen=>0, TKwElse=>0, TPlus=>0, TStar=>0,
    TEqEq=>0, TLParen=>0, TRParen=>0, TLBrace=>0, TRBrace=>0, TColon=>0,
    TEnd=>0, TMinus=>0, TComma=>0,
    TLt=>0, TGt=>0, TLe=>0, TGe=>0, TNe=>0,
    TLBracket=>0, TRBracket=>0, TBar=>0, TArrow=>0,
    TKwPlace=>0, TKwThis=>0, TColonU=>0, TDot=>0, TStr as sh=>0, TMapsTo=>0, TInj=>0 }
}
fun head_tag(l: TokList): Number {
  return match l { TkNil => 0 - 1, TkCons as (h, t) => tok_tag(h) }
}
fun head_num(l: TokList): Number {
  return match l { TkNil => 0, TkCons as (h, t) => tok_num(h) }
}
fun tail(l: TokList): TokList {
  return match l { TkNil => TkNil, TkCons as (h, t) => t }
}

/* ---- de Bruijn name environment: identifier hash -> index (innermost = 0) ---- */
fun bump(k: Number): Number { return if k >= 0 then k + 1 else 0 - 1 }
fun lookup_name(name: Number, env: NameEnv): Number {
  return match env { NEnvNil => 0 - 1,
      NEnvCons as (h, rest) => if h == name then 0 else bump(lookup_name(name, rest)) }
}

/* ---- recursive-descent expression parser (threads the name environment) ---- */
/* factor := NUM | IDENT | IDENT '(' expr ')' | '(' expr ')'
 *         | 'if' expr '==' expr 'then' expr 'else' expr
 * an identifier followed by '(' is a call; otherwise it is a variable. */
fun parse_factor(l: TokList, env: NameEnv): Parse {
  return if head_tag(l) == 0 then (head_num(l) ↪ TLit, tail(l)) ↪ POk
    else if head_tag(l) == 35 then (head_str(l) ↪ TStrLit, tail(l)) ↪ POk  /* string literal */
    else if head_tag(l) == 1 then
      (if head_num(l) == kw_match() then parse_match(tail(l), env)     /* match e { .. } */
       else if head_tag(tail(l)) == 34 then parse_qcall(head_num(l), l, env)  /* Module.op(..) */
       else if head_tag(tail(l)) == 13 then parse_call(head_num(l), tail(l), env)  /* call */
       else name_or_arm(head_num(l), tail(l), env))         /* variable or nullary arm */
    else if head_tag(l) == 13 then close_paren(parse_expr(tail(l), env), env)  /* '(' */
    else if head_tag(l) == 7 then parse_if(tail(l), env)                   /* 'if' */
    else PErr
}
/* call := (already have callee hash) '(' (expr (',' expr)*)? ')'
 * the arguments parse into a spine TArgs(a, TArgs(b, ... TNoArg)). */
fun parse_call(callee: Number, l: TokList, env: NameEnv): Parse {
  return call_with_args(callee, parse_args(tail(l), env))
}
fun parse_args(l: TokList, env: NameEnv): Parse {
  return if head_tag(l) == 14                            /* ')' -> no arguments */
    then (TNoArg, tail(l)) ↪ POk
    else args_cons(parse_expr(l, env), env)
}
fun args_cons(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (arg, rest) =>
        if head_tag(rest) == 20                          /* ',' -> more args */
          then args_prepend(arg, parse_args(tail(rest), env))
        else if head_tag(rest) == 14                     /* ')' -> last arg */
          then ((arg, TNoArg) ↪ TArgs, tail(rest)) ↪ POk
        else PErr }
}
fun args_prepend(arg: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (rest_spine, rest) => ((arg, rest_spine) ↪ TArgs, rest) ↪ POk }
}
fun call_with_args(callee: Number, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (spine, rest) => ((callee, spine) ↪ TCall, rest) ↪ POk }
}
/* '(' e ')' is e; '(' e ',' .. ')' is a tuple, an argument spine for the pipe that
 * follows it. */
fun close_paren(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (e, rest) => if head_tag(rest) == 14 then (e, tail(rest)) ↪ POk
        else if head_tag(rest) == 20 then args_prepend(e, parse_args(tail(rest), env))
        else PErr }
}
/* term := factor ('*' factor)*  -- left-associative (loop, not right recursion). */
fun parse_term(l: TokList, env: NameEnv): Parse { return term_more(parse_factor(l, env), env) }
fun term_more(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) => if head_tag(rest) == 11
                           then term_more(combine(11, left, parse_factor(tail(rest), env)), env)
                           else (left, rest) ↪ POk }
}
/* expr := term (('+' | '-') term)*  -- left-associative, so `a - b - c` = (a-b)-c,
 * as the reference. */
fun parse_sum(l: TokList, env: NameEnv): Parse { return expr_more(parse_term(l, env), env) }
/* expr := sum ('↦' name)*: the arithmetic binds tighter. The name is a fun or an arm,
 * which the emitter tells apart; a tuple spreads into the arguments. */
fun parse_expr(l: TokList, env: NameEnv): Parse { return pipe_more(parse_sum(l, env), env) }
fun pipe_more(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) => if head_tag(rest) == 36 then pipe_more(((head_num(tail(rest)), pipe_args(left)) ↪ TCall, tail(tail(rest))) ↪ POk, env)
        else if head_tag(rest) == 37 then pipe_more(((head_num(tail(rest)), pipe_args(left)) ↪ THit, tail(tail(rest))) ↪ POk, env)
        else (left, rest) ↪ POk }
}
fun pipe_args(e: Term): Term {
  return match e { TArgs as (a, more) => e, _ => (e, TNoArg) ↪ TArgs }
}
fun expr_more(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (left, rest) => if head_tag(rest) == 10
                           then expr_more(combine(10, left, parse_term(tail(rest), env)), env)
                           else if head_tag(rest) == 19
                           then expr_more(combine(19, left, parse_term(tail(rest), env)), env)
                           else (left, rest) ↪ POk }
}
fun combine(op: Number, left: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (right, rest) =>
        (mk_binop(op, left, right), rest) ↪ POk }
}
fun mk_binop(op: Number, left: Term, right: Term): Term {
  return if op == 10 then (left, right) ↪ TAdd
    else if op == 19 then (left, right) ↪ TSub
    else (left, right) ↪ TMul
}

/* a name bound in scope is a variable; any other is a nullary arm. */
fun name_or_arm(name: Number, rest: TokList, env: NameEnv): Parse {
  i := lookup_name(name, env)
  return if i == 0 - 1 then ((name, TNoArg) ↪ THit, rest) ↪ POk
    else (i ↪ TVar, rest) ↪ POk
}
/* match e { C0 => e0, C1 as x => e1, .. } -- the branch list drives a tag switch.
 * l is after the keyword. */
fun parse_match(l: TokList, env: NameEnv): Parse {
  return match_after_scrut(parse_expr(l, env), env)
}
fun match_after_scrut(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (scrut, rest) => if head_tag(rest) == 15         /* '{' opens the branches */
                            then match_after_branches(scrut, parse_branches(tail(rest), env))
                            else PErr }
}
fun match_after_branches(scrut: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (brs, rest) => if head_tag(rest) == 16           /* '}' closes the branches */
                          then ((brs, scrut) ↪ THitElim, tail(rest)) ↪ POk
                          else PErr }
}
/* branches := (Ctor '=>' expr) (',' Ctor '=>' expr)*  (a pattern may bind payloads). */
fun parse_branches(l: TokList, env: NameEnv): Parse {
  return if head_tag(l) == 16                            /* '}' -> empty (unexpected) */
    then (TBrNil, l) ↪ POk
    else parse_one_branch(l, env)
}
fun parse_one_branch(l: TokList, env: NameEnv): Parse {
  ctor := head_num(l)                              /* the constructor pattern */
  after := tail(l)
  return if head_tag(after) == 1                         /* 'as' -> payload binders */
    then (if head_tag(tail(after)) == 13                 /* 'as' '(' a ',' b ')' */
            then branch_with_binders(ctor, parse_params(tail(tail(after)), env, 0), env)
            else branch_with_binders(ctor,
                   ((head_num(tail(after)), env) ↪ NEnvCons, 1, tail(tail(after))) ↪ PR, env))
    else if head_tag(after) == 30                        /* '=>' -> nullary pattern */
    then branch_after_arrow(ctor, 0, parse_expr(tail(after), env), env)
    else PErr
}
/* the binders are parsed with parse_params (like function parameters), pushed onto
 * a branch-local env; the body is parsed in that env, the following branches in the
 * outer env (binders are scoped to their own branch body). */
fun branch_with_binders(ctor: Number, pr: ParamRes, outer: NameEnv): Parse {
  return match pr { PR as (env2, arity, rest) =>
        if head_tag(rest) == 30                           /* '=>' */
          then branch_after_arrow(ctor, arity, parse_expr(tail(rest), env2), outer)
          else PErr }
}
fun branch_after_arrow(ctor: Number, arity: Number, p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (body, rest) =>
        if head_tag(rest) == 20                           /* ',' -> more branches */
          then br_prepend(ctor, arity, body, parse_branches(tail(rest), env))
        else if head_tag(rest) == 16                      /* '}' -> last branch (keep '}') */
          then ((ctor, arity, body, TBrNil) ↪ TBranch, rest) ↪ POk
        else PErr }
}
fun br_prepend(ctor: Number, arity: Number, body: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (rest_brs, rest) => ((ctor, arity, body, rest_brs) ↪ TBranch, rest) ↪ POk }
}

/* if := 'if' expr CMP expr 'then' expr 'else' expr, CMP one of == != < > <= >=.
 * cmp_op maps a comparison token tag to an op code (or -1 if not a comparison). */
fun cmp_op(tag: Number): Number {
  return if tag == 12 then 0        /* == -> oeq */
    else if tag == 25 then 1        /* != -> one */
    else if tag == 21 then 2        /* <  -> olt */
    else if tag == 22 then 3        /* >  -> ogt */
    else if tag == 23 then 4        /* <= -> ole */
    else if tag == 24 then 5        /* >= -> oge */
    else 0 - 1
}
fun parse_if(l: TokList, env: NameEnv): Parse {
  return if_after_lhs(parse_expr(l, env), env)
}
fun if_after_lhs(p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (a, rest) => if cmp_op(head_tag(rest)) >= 0
                        then if_after_cmp(a, cmp_op(head_tag(rest)), parse_expr(tail(rest), env), env)
                        else PErr }
}
fun if_after_cmp(a: Term, op: Number, p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (b, rest) => if head_tag(rest) == 8
                        then if_after_then((op, a, b) ↪ TCmp, parse_expr(tail(rest), env), env)
                        else PErr }
}
fun if_after_then(cond: Term, p: Parse, env: NameEnv): Parse {
  return match p { PErr => PErr,
      POk as (thenE, rest) => if head_tag(rest) == 9
                            then if_after_else(cond, thenE, parse_expr(tail(rest), env))
                            else PErr }
}
fun if_after_else(cond: Term, thenE: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk as (elseE, rest) => ((cond, thenE, elseE) ↪ TIf, rest) ↪ POk }
}

/* ---- body parser: (IDENT ':=' expr)* 'return' expr ---- */
fun parse_body(l: TokList, env: NameEnv): Parse {
  return if head_tag(l) == 1
    then parse_ident_stmt(l, env)
    else if head_tag(l) == 5
    then parse_expr(tail(l), env)
    else PErr
}
/* an IDENT starts a body item only as `IDENT ':='`, a definition */
fun parse_ident_stmt(l: TokList, env: NameEnv): Parse {
  return if head_tag(tail(l)) == 4 then parse_let(l, env) else PErr
}
fun parse_let(l: TokList, env: NameEnv): Parse {
  name := head_num(l)
  after_def := tail(tail(l))
  return build_let(parse_expr(after_def, env), name, env)
}
fun build_let(pv: Parse, name: Number, env: NameEnv): Parse {
  return match pv { PErr => PErr,
      POk as (val, rest) =>
        wrap_let(val, parse_body(rest, (name, env) ↪ NEnvCons)) }
}
fun wrap_let(val: Term, pb: Parse): Parse {
  return match pb { PErr => PErr,
      POk as (body, rest) => ((val, body) ↪ TLet, rest) ↪ POk }
}

/* ---- function parser: 'fun' IDENT '(' (IDENT (',' IDENT)*)? ')' ':' 'number' '{' body '}' ---- */
/* a parsed parameter list: the de Bruijn env (params pushed in order), the arity,
 * and the token list positioned right after the ')'. */
place ParamRes { this > PR NameEnv Number TokList }
/* skip an optional ': Type' annotation after a parameter name (one type token). */
fun skip_param_type(l: TokList): TokList {
  return if head_tag(l) == 17 then tail(tail(l)) else l   /* ':' Type */
}
/* parse the parameters starting right after '(': push each onto env, count arity. */
fun parse_params(l: TokList, env: NameEnv, count: Number): ParamRes {
  return if head_tag(l) == 14                          /* ')' -> done */
    then (env, count, tail(l)) ↪ PR
    else if head_tag(l) == 1                            /* IDENT -> a parameter */
    then params_more((head_num(l), env) ↪ NEnvCons, count + 1, skip_param_type(tail(l)))
    else (env, count, l) ↪ PR                         /* malformed -> stop */
}
fun params_more(env: NameEnv, count: Number, l: TokList): ParamRes {
  return if head_tag(l) == 20                           /* ',' -> more */
    then parse_params(tail(l), env, count)
    else if head_tag(l) == 14                           /* ')' -> done */
    then (env, count, tail(l)) ↪ PR
    else (env, count, l) ↪ PR
}
/* consume ':' 'number' '{' = 3 tokens (the ')' is already consumed), landing on the body. */
fun skip_after_params(l: TokList): TokList {
  return tail(tail(tail(l)))
}
fun parse_fundef(l: TokList): FunParse {
  name := head_num(tail(l))            /* IDENT after 'fun' */
  after_lparen := tail(tail(tail(l)))  /* skip fun, IDENT, '(' -> at params or ')' */
  return fundef_with_params(name, parse_params(after_lparen, NEnvNil, 0))
}
fun fundef_with_params(name: Number, pr: ParamRes): FunParse {
  return match pr { PR as (env, arity, rest) =>
        fundef_body(name, arity, env, skip_after_params(rest)) }
}
fun fundef_body(name: Number, arity: Number, env: NameEnv, l: TokList): FunParse {
  return close_fundef(name, arity, parse_body(l, env))
}
fun close_fundef(name: Number, arity: Number, p: Parse): FunParse {
  return match p { PErr => FPErr,
      POk as (body, rest) => ((name, arity, body) ↪ FnDef, tail(rest)) ↪ FPOk }
}
/* ---- coproduct arm parsing (shared registry builder: arm tag = its index) ---- */
/* skip an optional '(type, ..)' after an arm name (the arg types are not
 * needed in the registry; hit reads its arity from the call, patterns from binders). */
fun skip_to_rparen(l: TokList): TokList {
  return if head_tag(l) == 14 then tail(l)              /* ')' -> consume */
    else if head_tag(l) == 18 then l                    /* TEnd -> stop */
    else skip_to_rparen(tail(l))
}
/* the payload of an arm: its types, up to ':U' or '}'. */
fun skip_ctor_types(l: TokList): TokList {
  return if head_tag(l) == 1 then skip_ctor_types(tail(l)) else l
}
/* ---- coproduct place declarations: 'place' NAME '{' 'this' '>' Arm (':U' Arm)* '}' ---- */
/* The canonical named coproduct. Registry builder for the arms (arm tag =
 * its index); only the surface differs: braces + 'this >' head, ':U' separators. */
fun parse_place(l: TokList, reg: CtorReg): IndRes {
  /* l at 'place'; skip place, NAME, '{', 'this', '>' -> at the first arm. */
  return parse_arms(tail(tail(tail(tail(tail(l))))), reg, 0)
}
/* consume the closing '}' (16) and return the registry + the rest. */
fun close_place(reg: CtorReg, l: TokList): IndRes {
  return if head_tag(l) == 16 then (reg, tail(l)) ↪ IR
    else (reg, l) ↪ IR
}
fun parse_arms(l: TokList, reg: CtorReg, tag: Number): IndRes {
  return if head_tag(l) == 1                             /* an arm identifier */
    then arms_more((head_num(l), tag, reg) ↪ CrCons, skip_ctor_types(tail(l)), tag + 1)
    else close_place(reg, l)
}
fun arms_more(reg: CtorReg, l: TokList, tag: Number): IndRes {
  return if head_tag(l) == 33                            /* ':U' -> another arm */
    then parse_arms(tail(l), reg, tag)
    else close_place(reg, l)                             /* at '}' */
}

/* ---- top level: a sequence of place declarations and functions ---- */
fun parse_items(l: TokList, reg: CtorReg): Program {
  return if head_tag(l) == 31                            /* 'place' (block coproduct) */
    then items_after_ind(parse_place(l, reg))
    else if head_tag(l) == 2                              /* 'fun' */
    then cons_item(parse_fundef(l), reg)
    else (FlNil, reg) ↪ Prog                      /* end of items */
}
fun items_after_ind(ir: IndRes): Program {
  return match ir { IR as (reg2, rest) => parse_items(rest, reg2) }
}
fun cons_item(fp: FunParse, reg: CtorReg): Program {
  return match fp { FPErr => (FlNil, reg) ↪ Prog,
      FPOk as (f, rest) => prepend_fun(f, parse_items(rest, reg)) }
}
fun prepend_fun(f: Fun, prog: Program): Program {
  return match prog { Prog as (funs, reg) => ((f, funs) ↪ FlCons, reg) ↪ Prog }
}

/* registry lookup: constructor-name hash -> tag. */
fun tag_of(hash: Number, reg: CtorReg): Number {
  return match reg { CrNil => 0,
      CrCons as (h, t, rest) => if h == hash then t else tag_of(hash, rest) }
}
/* is this term the empty branch spine? */
fun is_brnil(t: Term): Number {
  return match t { TBrNil => 1, _ => 0 }
}

/* ---- back end: gen (Term -> MLIR text) with an SSA environment ---- */
fun er_ssa(e: EmitR):  String { return match e { ER as (s, c, n) => s } }
fun er_code(e: EmitR): String { return match e { ER as (s, c, n) => c } }
fun er_ctr(e: EmitR):  Number { return match e { ER as (s, c, n) => n } }

fun lookup_ssa(i: Number, env: SsaEnv): String {
  return match env { SeNil => "%vERR",
      SeCons as (h, rest) => if i == 0 then h else lookup_ssa(i - 1, rest) }
}

fun ssa_name(n: Number): String { return String.concat("%v", String.from_int(n)) }
fun num_lit(k: Number): String  { return String.concat(String.from_int(k), ".0") }
fun fn_symbol(h: Number): String { return String.concat("fn_", String.from_int(h)) }
fun line(ssa: String, rhs: String): String {
  return String.concat(String.concat(String.concat("  ", ssa),
           String.concat(" = ", rhs)), " : f64\n")
}
fun line_raw(ssa: String, rhs: String): String {
  return String.concat(String.concat(String.concat("  ", ssa),
           String.concat(" = ", rhs)), "\n")
}

/* the arith.cmpf predicate for a comparison op code (0..5). The trailing comma
 * is part of the emitted text, matching gen_bin's "op <a>, <b>" shape. */
fun cmp_pred(op: Number): String {
  return if op == 0 then "arith.cmpf oeq,"
    else if op == 1 then "arith.cmpf one,"
    else if op == 2 then "arith.cmpf olt,"
    else if op == 3 then "arith.cmpf ogt,"
    else if op == 4 then "arith.cmpf ole,"
    else "arith.cmpf oge,"
}
fun gen(t: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  return match t {
    TLit as k =>
      (ssa_name(n), line(ssa_name(n), String.concat("arith.constant ", num_lit(k))), n + 1) ↪ ER,
    TVar as i => (lookup_ssa(i, env), "", n) ↪ ER,
    TLet as (e1, body) => gen_let(e1, body, env, n, reg),
    TAdd as (a, b) => gen_bin("arith.addf", a, b, env, n, reg),
    TSub as (a, b) => gen_bin("arith.subf", a, b, env, n, reg),
    TMul as (a, b) => gen_bin("arith.mulf", a, b, env, n, reg),
    TCmp as (op, a, b) => gen_bin(cmp_pred(op), a, b, env, n, reg),
    TIf as (c, thenT, elseT) => gen_if(c, thenT, elseT, env, n, reg),
    TCall as (callee, spine) => gen_call(callee, spine, env, n, reg),
    THit as (ctor, spine) => gen_hit(ctor, spine, env, n, reg),
    THitElim as (brs, scrut) => gen_hitelim(brs, scrut, env, n, reg),
    /* spine and branch nodes are only walked by their own emitters, never alone. */
    TArgs as (a, b) => ("%vERR", "", n) ↪ ER,
    TNoArg      => ("%vERR", "", n) ↪ ER,
    TBranch as (c, ar, a, b) => ("%vERR", "", n) ↪ ER,
    TBrNil      => ("%vERR", "", n) ↪ ER,
    TStrLit as s  => gen_strlit(s, n),
    TRtCall as (sym, spine) => gen_rtcall(sym, spine, env, n, reg)
  }
}
fun gen_let(e1: Term, body: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ea := gen(e1, env, n, reg)
  eb := gen(body, (er_ssa(ea), env) ↪ SeCons, er_ctr(ea), reg)
  return (er_ssa(eb), String.concat(er_code(ea), er_code(eb)), er_ctr(eb)) ↪ ER
}
fun gen_bin(op: String, a: Term, b: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ea := gen(a, env, n, reg)
  eb := gen(b, env, er_ctr(ea), reg)
  m  := er_ctr(eb)
  rhs := String.concat(String.concat(op, " "),
                 String.concat(String.concat(er_ssa(ea), ", "), er_ssa(eb)))
  return (ssa_name(m), String.concat(String.concat(er_code(ea), er_code(eb)),
                          line(ssa_name(m), rhs)), m + 1) ↪ ER
}
/* count the arguments in a spine. */
fun spine_count(spine: Term): Number {
  return match spine { TNoArg => 0, TArgs as (a, rest) => 1 + spine_count(rest), _ => 0 }
}
/* the "(f64, f64, ...)" operand-type list for a call of arity k. */
fun call_sig(k: Number, i: Number): String {
  return if i >= k then ""
    else if i == k - 1 then "f64"
    else String.concat("f64, ", call_sig(k, i + 1))
}
/* emit each argument (threading the counter + code), returning ER whose ssa field
 * is the comma-joined list of argument ssas. */
fun gen_args(spine: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  return match spine { TNoArg => ("", "", n) ↪ ER,
      TArgs as (a, rest) => gen_args_cons(a, rest, env, n, reg),
      _ => ("", "", n) ↪ ER }
}
fun gen_args_cons(a: Term, rest: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ea := gen(a, env, n, reg)
  er := gen_args(rest, env, er_ctr(ea), reg)
  joined := if String.length(er_ssa(er)) == 0 then er_ssa(ea)
                  else String.concat(String.concat(er_ssa(ea), ", "), er_ssa(er))
  return (joined, String.concat(er_code(ea), er_code(er)), er_ctr(er)) ↪ ER
}
/* call: emit the arguments, then "<ssa> = func.call @fn_<callee>(<args>) : (<sig>) -> f64". */
fun gen_call(callee: Number, spine: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ea  := gen_args(spine, env, n, reg)
  m   := er_ctr(ea)
  cnt := spine_count(spine)
  rhs := String.concat("func.call @",
                 String.concat(fn_symbol(callee),
                   String.concat("(", String.concat(er_ssa(ea),
                     String.concat(") : (",
                       String.concat(call_sig(cnt, 0), ") -> f64"))))))
  return (ssa_name(m), String.concat(er_code(ea), line_raw(ssa_name(m), rhs)), m + 1) ↪ ER
}
fun gen_if(c: Term, thenT: Term, elseT: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ec := gen(c, env, n, reg)
  et := gen(thenT, env, er_ctr(ec), reg)
  ee := gen(elseT, env, er_ctr(et), reg)
  m  := er_ctr(ee)
  head := String.concat(String.concat("  ", ssa_name(m)),
                  String.concat(" = scf.if ", String.concat(er_ssa(ec), " -> (f64) {\n")))
  then_part := String.concat(er_code(et),
                       String.concat("    scf.yield ", String.concat(er_ssa(et), " : f64\n")))
  else_part := String.concat(er_code(ee),
                       String.concat("    scf.yield ", String.concat(er_ssa(ee), " : f64\n")))
  code := String.concat(er_code(ec),
                  String.concat(head,
                    String.concat(then_part,
                      String.concat("  } else {\n",
                        String.concat(else_part, "  }\n")))))
  return (ssa_name(m), code, m + 1) ↪ ER
}
/* the merkle runtime calls as rhs strings (fed to line_raw). */
fun leaf_call(a: String): String {
  return String.concat("func.call @yon_rt_merkle_leaf(", String.concat(a, ") : (f64) -> f64"))
}
fun label_call(a: String): String {
  return String.concat("func.call @yon_rt_merkle_label(", String.concat(a, ") : (f64) -> f64"))
}
fun node2_call(t: String, a: String, b: String): String {
  return String.concat("func.call @yon_rt_merkle_node2(",
    String.concat(t, String.concat(", ", String.concat(a, String.concat(", ",
      String.concat(b, ") : (f64, f64, f64) -> f64"))))))
}
/* the index must be an SSA operand, not a literal (func.call takes SSA operands). */
fun child_call(nd: String, idx_ssa: String): String {
  return String.concat("func.call @yon_rt_merkle_child(",
    String.concat(nd, String.concat(", ", String.concat(idx_ssa, ") : (f64, f64) -> f64"))))
}
fun is_noarg(t: Term): Number {
  return match t { TNoArg => 1, _ => 0 }
}
/* leaf(k) for a constant tag k: emits the constant and the leaf call. */
fun gen_leaf_const(k: Number, n: Number): EmitR {
  tc := ssa_name(n)
  lf := ssa_name(n + 1)
  code := String.concat(line(tc, String.concat("arith.constant ", num_lit(k))),
                              line_raw(lf, leaf_call(tc)))
  return (lf, code, n + 2) ↪ ER
}
/* leaf(val_ssa): wrap an already-computed value ssa. */
fun gen_leaf_of(val_ssa: String, n: Number): EmitR {
  lf := ssa_name(n)
  return (lf, line_raw(lf, leaf_call(val_ssa)), n + 1) ↪ ER
}
/* the inner spine: leaf(0) if empty, else node2(0, leaf(head), spine(rest)). */
fun gen_inner_spine(spine: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  return match spine { TNoArg => gen_leaf_const(0, n),
      TArgs as (a, rest) => gen_spine_cons(0, a, rest, env, n, reg),
      _ => ("%vERR", "", n) ↪ ER }
}
/* node2(node_tag, leaf(gen a), gen_inner_spine(rest)) -- one spine cell. A child
 * of a node is always a node handle: the argument (a number, or a nested-sum
 * handle: Yon0 does not tell them apart) enters as a leaf whose label is its
 * exact f64, and is read back with label(). */
fun gen_spine_cons(node_tag: Number, a: Term, rest: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ea  := gen(a, env, n, reg)                         /* the value/handle */
  lv  := ssa_name(er_ctr(ea))                        /* leaf(value) */
  inner := gen_inner_spine(rest, env, er_ctr(ea) + 1, reg)
  tc := ssa_name(er_ctr(inner))                      /* node tag constant */
  nd := ssa_name(er_ctr(inner) + 1)                  /* the node2 handle */
  code := String.concat(er_code(ea),
    String.concat(line_raw(lv, leaf_call(er_ssa(ea))),
      String.concat(er_code(inner),
        String.concat(line(tc, String.concat("arith.constant ", num_lit(node_tag))),
          line_raw(nd, node2_call(tc, lv, er_ssa(inner)))))))
  return (nd, code, er_ctr(inner) + 2) ↪ ER
}
/* injection into an arm: nullary -> leaf(tag); with args -> node2(tag, leaf(a0), spine(rest)). */
fun gen_hit(ctor: Number, spine: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  tag := tag_of(ctor, reg)
  return if is_noarg(spine) == 1
    then gen_leaf_const(tag, n)
    else gen_hit_payload(tag, spine, env, n, reg)
}
fun gen_hit_payload(tag: Number, spine: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  return match spine { TArgs as (a0, rest) => gen_spine_cons(tag, a0, rest, env, n, reg),
      _ => ("%vERR", "", n) ↪ ER }
}
/* match: read the scrutinee tag with label(), then a tag switch over branches. */
/* accessors on BindRes. */
fun br_env(b: BindRes):  SsaEnv { return match b { BR as (e, c, n) => e } }
fun br_code(b: BindRes): String { return match b { BR as (e, c, n) => c } }
fun br_n(b: BindRes):    Number { return match b { BR as (e, c, n) => n } }
/* bind k payloads projected from the scrutinee: payload j = label(child(tail_j, 0)),
 * tail_0 = scrut, tail_{j+1} = child(tail_j, 1). Binds them innermost-last onto env. */
fun gen_bind(tail_ssa: String, j: Number, k: Number, env: SsaEnv, n: Number): BindRes {
  return if j >= k then (env, "", n) ↪ BR
    else gen_bind_one(tail_ssa, j, k, env, n)
}
fun gen_bind_one(tail_ssa: String, j: Number, k: Number, env: SsaEnv, n: Number): BindRes {
  idx0 := ssa_name(n)          /* constant 0 (child index) */
  pl := ssa_name(n + 1)        /* the payload's leaf = child(tail, 0) */
  idx1 := ssa_name(n + 2)      /* constant 1 (child index) */
  nt := ssa_name(n + 3)        /* next tail = child(tail, 1) */
  pn := ssa_name(n + 4)        /* payload = label(leaf) */
  code0 := String.concat(
    line(idx0, "arith.constant 0.0"),
    String.concat(line_raw(pl, child_call(tail_ssa, idx0)),
      String.concat(line(idx1, "arith.constant 1.0"),
        String.concat(line_raw(nt, child_call(tail_ssa, idx1)),
          line_raw(pn, label_call(pl))))))
  rest := gen_bind(nt, j + 1, k, (pn, env) ↪ SeCons, n + 5)
  return (br_env(rest), String.concat(code0, br_code(rest)), br_n(rest)) ↪ BR
}
/* bind the branch payloads, then emit the body (the unconditional last branch). */
fun gen_branch_body(arity: Number, body: Term, scrut_ssa: String, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  bind := gen_bind(scrut_ssa, 0, arity, env, n)
  eb   := gen(body, br_env(bind), br_n(bind), reg)
  return (er_ssa(eb), String.concat(br_code(bind), er_code(eb)), er_ctr(eb)) ↪ ER
}
fun gen_hitelim(brs: Term, scrut: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  es := gen(scrut, env, n, reg)
  sc := er_ssa(es)                               /* the scrutinee handle */
  tl := ssa_name(er_ctr(es))                     /* tag = label(scrut) */
  lcode := line_raw(tl, label_call(sc))
  chain := gen_br_chain(brs, tl, sc, env, er_ctr(es) + 1, reg)
  return (er_ssa(chain), String.concat(er_code(es), String.concat(lcode, er_code(chain))), er_ctr(chain)) ↪ ER
}
fun gen_br_chain(brs: Term, t_ssa: String, scrut_ssa: String, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  return match brs { TBrNil => ("%vERR", "", n) ↪ ER,
      TBranch as (ctor, arity, body, rest) => gen_br_one(ctor, arity, body, rest, t_ssa, scrut_ssa, env, n, reg),
      _ => ("%vERR", "", n) ↪ ER }
}
fun gen_br_one(ctor: Number, arity: Number, body: Term, rest: Term, t_ssa: String, scrut_ssa: String, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  return if is_brnil(rest) == 1
    then gen_branch_body(arity, body, scrut_ssa, env, n, reg)   /* last: unconditional */
    else gen_br_if(ctor, arity, body, rest, t_ssa, scrut_ssa, env, n, reg)
}
fun gen_br_if(ctor: Number, arity: Number, body: Term, rest: Term, t_ssa: String, scrut_ssa: String, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  tag := tag_of(ctor, reg)
  tc  := ssa_name(n)
  cc  := ssa_name(n + 1)
  cmpcode := String.concat(
    line(tc, String.concat("arith.constant ", num_lit(tag))),
    line(cc, String.concat("arith.cmpf oeq, ",
      String.concat(t_ssa, String.concat(", ", tc)))))
  eb := gen_branch_body(arity, body, scrut_ssa, env, n + 2, reg)
  er := gen_br_chain(rest, t_ssa, scrut_ssa, env, er_ctr(eb), reg)
  m  := er_ctr(er)
  head := String.concat(String.concat("  ", ssa_name(m)),
                  String.concat(" = scf.if ", String.concat(cc, " -> (f64) {\n")))
  then_part := String.concat(er_code(eb),
                       String.concat("    scf.yield ", String.concat(er_ssa(eb), " : f64\n")))
  else_part := String.concat(er_code(er),
                       String.concat("    scf.yield ", String.concat(er_ssa(er), " : f64\n")))
  ifcode := String.concat(head,
                    String.concat(then_part,
                      String.concat("  } else {\n",
                        String.concat(else_part, "  }\n"))))
  return (ssa_name(m), String.concat(cmpcode, ifcode), m + 1) ↪ ER
}

/* ---- top-level function emission ---- */
fun argname(i: Number): String { return String.concat("%arg", String.from_int(i)) }
/* the SSA env for a body of arity k: cons %arg0 first (deepest) .. %arg(k-1) last,
 * so lookup_ssa(de Bruijn i) lands on the right %arg (params pushed in order). */
fun arg_env(k: Number, i: Number, env: SsaEnv): SsaEnv {
  return if i >= k then env
    else arg_env(k, i + 1, (argname(i), env) ↪ SeCons)
}
/* the "%arg0: f64, %arg1: f64, ..." parameter signature for arity k. */
fun arg_sig(k: Number, i: Number): String {
  return if i >= k then ""
    else if i == k - 1 then String.concat(argname(i), ": f64")
    else String.concat(String.concat(argname(i), ": f64, "), arg_sig(k, i + 1))
}
/* a non-main function: func.func @fn_<name>(%arg0: f64, ...) -> f64 { body ; return }.
 * the k parameters are TVar 0..k-1 in the body (%arg0..%arg(k-1)). */
fun gen_fundef_text(name: Number, arity: Number, body: Term, reg: CtorReg): String {
  env := arg_env(arity, 0, SeNil)
  eb  := gen(body, env, 0, reg)
  sig := String.concat(String.concat("(", arg_sig(arity, 0)), ") -> f64 {\n")
  return String.concat(
    String.concat(String.concat("  func.func @", fn_symbol(name)), sig),
    String.concat(er_code(eb),
      String.concat(String.concat("    return ", er_ssa(eb)), " : f64\n  }\n")))
}
/* emit every function except main (main is emitted as the i32 entry, below). */
/* Whole-program emission is the hot path: a naive concat fold interns a
 * growing prefix at every step (O(N^2) over the total output). Bump-append
 * each function's text into a Buffer (its own mmap arena) and intern ONCE
 * at finish -> O(N). gen_funs keeps its String signature. */
fun gen_funs_into(buf: Buffer, fs: FunList, main_hash: Number, reg: CtorReg): Buffer {
  return match fs { FlNil => buf,
      FlCons as (f, rest) =>
        gen_funs_into(Buffer.append(buf, gen_one_fun(f, main_hash, reg)), rest, main_hash, reg) }
}
fun gen_funs(fs: FunList, main_hash: Number, reg: CtorReg): String {
  return Buffer.finish(gen_funs_into(Buffer.make(0), fs, main_hash, reg))
}
fun gen_one_fun(f: Fun, main_hash: Number, reg: CtorReg): String {
  return match f { FnDef as (name, arity, body) =>
        if name == main_hash then "" else gen_fundef_text(name, arity, body, reg) }
}
/* find main's body (the entry Term). */
fun fun_name(f: Fun): Number { return match f { FnDef as (name, arity, body) => name } }
fun fun_body(f: Fun): Term { return match f { FnDef as (name, arity, body) => body } }
fun main_body(fs: FunList, main_hash: Number): Term {
  return match fs { FlNil => 0 ↪ TLit,
      FlCons as (f, rest) =>
        if fun_name(f) == main_hash then fun_body(f) else main_body(rest, main_hash) }
}

/* ---- strings and qualified/runtime calls (String.op) ---- */
/* the String payload of a TStr token (empty for any other token). */
fun tok_str(t: Token): String {
  return match t {
    TNum as n=>"", TIdent as h=>"", TKwFun=>"", TKwBe=>"", TColonEq=>"", TKwReturn=>"",
    TKwNumber=>"", TKwIf=>"", TKwThen=>"", TKwElse=>"", TPlus=>"", TStar=>"",
    TEqEq=>"", TLParen=>"", TRParen=>"", TLBrace=>"", TRBrace=>"", TColon=>"",
    TEnd=>"", TMinus=>"", TComma=>"", TLt=>"", TGt=>"", TLe=>"", TGe=>"", TNe=>"",
    TLBracket=>"", TRBracket=>"", TBar=>"", TArrow=>"", TKwPlace=>"", TKwThis=>"",
    TColonU=>"", TDot=>"", TStr as sh=>sh, TMapsTo=>"", TInj=>"" }
}
fun head_str(l: TokList): String {
  return match l { TkNil => "", TkCons as (h, t) => tok_str(h) }
}
/* map (module, op) name hashes to the runtime symbol (mirrors yonc's stdlib). */
fun rt_string_symbol(op: Number): String {
  return if op == hash_of("length") then "yon_rt_string_length"
    else if op == hash_of("char_at") then "yon_rt_string_char_at"
    else if op == hash_of("concat") then "yon_rt_string_concat"
    else if op == hash_of("from_int") then "yon_rt_string_from_int"
    else if op == hash_of("from_char") then "yon_rt_string_from_char"
    else if op == hash_of("substring") then "yon_rt_string_substring"
    else if op == hash_of("print") then "yon_rt_string_print"
    else ""
}
fun rt_file_symbol(op: Number): String {
  return if op == hash_of("read_text") then "yon_rt_file_read_text"
    else if op == hash_of("write_text") then "yon_rt_file_write_text"
    else if op == hash_of("append_text") then "yon_rt_file_append_text"
    else ""
}
fun rt_args_symbol(op: Number): String {
  return if op == hash_of("get") then "yon_rt_args_get"
    else ""
}
fun rt_buffer_symbol(op: Number): String {
  return if op == hash_of("make") then "yon_rt_buffer_new"
    else if op == hash_of("append") then "yon_rt_buffer_append"
    else if op == hash_of("finish") then "yon_rt_buffer_finish"
    else ""
}
fun rt_symbol(m: Number, op: Number): String {
  return if m == hash_of("String") then rt_string_symbol(op)
    else if m == hash_of("File") then rt_file_symbol(op)
    else if m == hash_of("Buffer") then rt_buffer_symbol(op)
    else if m == hash_of("Args") then rt_args_symbol(op)
    else ""
}
/* qualified call: MODULE '.' OP '(' args ')'. l at MODULE (an ident). */
fun qcall_with_args(sym: String, p: Parse): Parse {
  return match p { PErr => PErr,
    POk as (spine, rest) => ((sym, spine) ↪ TRtCall, rest) ↪ POk }
}
fun drop_dummy_spine(p: Parse): Parse {
  return match p { PErr => PErr,
    POk as (spine, rest) => (TNoArg, rest) ↪ POk }
}
fun parse_qcall(modh: Number, l: TokList, env: NameEnv): Parse {
  oph := head_num(tail(tail(l)))                           /* op ident hash */
  sym := rt_symbol(modh, oph)
  args := parse_args(tail(tail(tail(tail(l)))), env)       /* skip MODULE . OP ( */
  /* Buffer.make(0): the surface takes a dummy arg (nullary-call convention),
   * but the runtime symbol is 0-ary — drop the parsed dummy so the call
   * emits as @yon_rt_buffer_new(). */
  return if modh == hash_of("Buffer")
    then if oph == hash_of("make")
      then qcall_with_args(sym, drop_dummy_spine(args))
      else qcall_with_args(sym, args)
    else qcall_with_args(sym, args)
}
/* string literal -> from_char/concat chain. Strings are content-addressed, so
 * this interns to the SAME handle as yonc's global+string_lit: the differential
 * oracle (exit codes) stays green without a module-level global. */
fun gen_char(code: Number, n: Number): EmitR {
  c1 := ssa_name(n)
  c2 := ssa_name(n + 1)
  return (c2, String.concat(
      line_raw(c1, String.concat("arith.constant ", num_lit(code))),
      line_raw(c2, String.concat("func.call @yon_rt_string_from_char(",
                     String.concat(c1, ") : (f64) -> f64")))), n + 2) ↪ ER
}
fun gen_str_step(s: String, i: Number, len: Number, acc_ssa: String, acc_code: String, ec: EmitR): EmitR {
  cat := ssa_name(er_ctr(ec))
  code2 := String.concat(acc_code, String.concat(er_code(ec),
    line_raw(cat, String.concat("func.call @yon_rt_string_concat(",
      String.concat(acc_ssa, String.concat(", ",
        String.concat(er_ssa(ec), ") : (f64, f64) -> f64")))))))
  return gen_str_from(s, i + 1, len, cat, code2, er_ctr(ec) + 1)
}
fun gen_str_from(s: String, i: Number, len: Number, acc_ssa: String, acc_code: String, n: Number): EmitR {
  return if i >= len then (acc_ssa, acc_code, n) ↪ ER
    else gen_str_step(s, i, len, acc_ssa, acc_code, gen_char(String.char_at(s, i), n))
}
fun gen_strlit_ne(s: String, len: Number, ec: EmitR): EmitR {
  return gen_str_from(s, 1, len, er_ssa(ec), er_code(ec), er_ctr(ec))
}
fun gen_strlit(s: String, n: Number): EmitR {
  len := String.length(s)
  return if len == 0 then gen_char(0, n)
    else gen_strlit_ne(s, len, gen_char(String.char_at(s, 0), n))
}
/* a runtime/qualified call by symbol name (like gen_call, but the callee is a
 * literal symbol string, not @fn_<hash>). */
fun gen_rtcall(sym: String, spine: Term, env: SsaEnv, n: Number, reg: CtorReg): EmitR {
  ea  := gen_args(spine, env, n, reg)
  m   := er_ctr(ea)
  cnt := spine_count(spine)
  rhs := String.concat("func.call @",
                 String.concat(sym,
                   String.concat("(", String.concat(er_ssa(ea),
                     String.concat(") : (",
                       String.concat(call_sig(cnt, 0), ") -> f64"))))))
  return (ssa_name(m), String.concat(er_code(ea), line_raw(ssa_name(m), rhs)), m + 1) ↪ ER
}
/* string runtime functions as external declarations (resolved from yon_rt.o). */
fun string_stubs(): String {
  return String.concat("  func.func private @yon_rt_string_from_char(f64) -> f64\n",
    String.concat("  func.func private @yon_rt_string_concat(f64, f64) -> f64\n",
    String.concat("  func.func private @yon_rt_string_length(f64) -> f64\n",
    String.concat("  func.func private @yon_rt_string_char_at(f64, f64) -> f64\n",
    String.concat("  func.func private @yon_rt_string_from_int(f64) -> f64\n",
    String.concat("  func.func private @yon_rt_string_substring(f64, f64, f64) -> f64\n",
    String.concat("  func.func private @yon_rt_string_print(f64) -> f64\n",
    String.concat("  func.func private @yon_rt_file_read_text(f64) -> f64\n",
    String.concat("  func.func private @yon_rt_file_write_text(f64, f64) -> f64\n",
    String.concat("  func.func private @yon_rt_file_append_text(f64, f64) -> f64\n",
                  "  func.func private @yon_rt_args_get(f64) -> f64\n"))))))))))
}

/* ---- module boilerplate ---- */
fun mod_head(): String {
  return "module {\n  func.func private @yon_rt_maybe_serve() -> ()\n"
}
fun main_head(): String {
  return "  func.func @main() -> i32 {\n    func.call @yon_rt_maybe_serve() : () -> ()\n"
}
fun stubs(): String {
  return "  func.func @__yon_dispatch(%sel: f64, %a1: f64, %a2: f64, %a3: f64, %a4: f64) -> f64 {\n    %d = arith.constant -777.0 : f64\n    return %d : f64\n  }\n  func.func @__yon_closure_call(%clo: f64, %a1: f64, %a2: f64, %a3: f64, %a4: f64) -> f64 {\n    %c = arith.constant -777.0 : f64\n    return %c : f64\n  }\n}\n"
}
fun main_tail(result_ssa: String, ctr: Number): String {
  rss := ssa_name(ctr)
  return String.concat(
    String.concat("    ", String.concat(rss,
      String.concat(" = arith.fptosi ", String.concat(result_ssa, " : f64 to i32\n")))),
    String.concat("    return ", String.concat(rss, " : i32\n  }\n")))
}
/* the merkle runtime functions as EXTERNAL declarations (no body); the linker
 * resolves them to the real XLeech2 implementation in yon_rt.o. hit/hit_elim call
 * these yon_rt_merkle_* symbols directly (this is what yonc's own emit does). */
/* Buffer runtime functions as external declarations (resolved from yon_rt.o). */
fun buffer_stubs(): String {
  return String.concat("  func.func private @yon_rt_buffer_new() -> f64\n",
    String.concat("  func.func private @yon_rt_buffer_append(f64, f64) -> f64\n",
                  "  func.func private @yon_rt_buffer_finish(f64) -> f64\n"))
}
fun merkle_stubs(): String {
  return "  func.func private @yon_rt_merkle_leaf(f64) -> f64\n  func.func private @yon_rt_merkle_node2(f64, f64, f64) -> f64\n  func.func private @yon_rt_merkle_label(f64) -> f64\n  func.func private @yon_rt_merkle_child(f64, f64) -> f64\n"
}

fun main(): Number {
  /* file-driven compiler: read a Yon0 source, compile it, write the MLIR module,
   * both in the directory given as the first argument. The differential oracle
   * writes the input there and feeds the output back to the backend, so this
   * same tool compiles any Yon0 program (not a fixed one). */
  dir    := Args.get(1)
  source := File.read_text(String.concat(dir, "/in.yon"))
  prog   := parse_items(lex(source), CrNil)
  funs   := prog_funs(prog)
  reg    := prog_reg(prog)
  mh     := hash_of("main")
  helpers := gen_funs(funs, mh, reg)
  rmain  := gen(main_body(funs, mh), SeNil, 0, reg)
  full   := String.concat(mod_head(),
                    String.concat(merkle_stubs(),
                    String.concat(string_stubs(),
                    String.concat(buffer_stubs(),
                      String.concat(helpers,
                        String.concat(main_head(),
                          String.concat(er_code(rmain),
                            String.concat(main_tail(er_ssa(rmain), er_ctr(rmain)),
                              stubs()))))))))
  _w := File.write_text(String.concat(dir, "/out.mlir"), full)
  return String.length(full)
}
/* accessors on the parsed Program. */
fun prog_funs(p: Program): FunList {
  return match p { Prog as (funs, reg) => funs }
}
fun prog_reg(p: Program): CtorReg {
  return match p { Prog as (funs, reg) => reg }
}
