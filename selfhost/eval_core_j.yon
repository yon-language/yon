// Id / TRefl / J in the lambda core, written in Yon.
// Wildcard form: the diagonal beta J(c, d, TRefl a) ~> d a is the only live branch of
// TJ; everything else stays stuck via `_ =>`. shift/subst stay exhaustive.
// Oracle: J(_, lam.0, TRefl 7) = 7  (as the OCaml kernel, j_computes.yon).
place Term { this > TLit Number :U TVar Number :U TLam Term :U TApp Term Term :U TPair Term Term :U TFst Term :U TSnd Term :U TRefl Term :U TJ Term Term Term }


fun shift(d: Number, c: Number, t: Term): Term {
  return match t { TLit as n     => n ↪ TLit,
      TVar as i     => if i >= c then i + d ↪ TVar else i ↪ TVar,
      TLam as b     => shift(d, c + 1, b) ↪ TLam,
      TApp as (f, x)  => (shift(d, c, f), shift(d, c, x)) ↪ TApp,
      TPair as (a, b) => (shift(d, c, a), shift(d, c, b)) ↪ TPair,
      TFst as p     => shift(d, c, p) ↪ TFst,
      TSnd as p     => shift(d, c, p) ↪ TSnd,
      TRefl as a    => shift(d, c, a) ↪ TRefl,
      TJ as (mo, ba, pa) => (shift(d, c, mo), shift(d, c, ba), shift(d, c, pa)) ↪ TJ }
}

fun subst(j: Number, s: Term, t: Term): Term {
  return match t { TLit as n     => n ↪ TLit,
      TVar as i     => if i == j then s else i ↪ TVar,
      TLam as b     => subst(j + 1, shift(1, 0, s), b) ↪ TLam,
      TApp as (f, x)  => (subst(j, s, f), subst(j, s, x)) ↪ TApp,
      TPair as (a, b) => (subst(j, s, a), subst(j, s, b)) ↪ TPair,
      TFst as p     => subst(j, s, p) ↪ TFst,
      TSnd as p     => subst(j, s, p) ↪ TSnd,
      TRefl as a    => subst(j, s, a) ↪ TRefl,
      TJ as (mo, ba, pa) => (subst(j, s, mo), subst(j, s, ba), subst(j, s, pa)) ↪ TJ }
}

fun beta(body: Term, arg: Term): Term {
  return shift(0 - 1, 0, subst(0, shift(1, 0, arg), body))
}

fun eval(t: Term): Term {
  return match t { TLit as n     => n ↪ TLit,
      TVar as i     => i ↪ TVar,
      TLam as b     => b ↪ TLam,
      TApp as (f, x)  => match eval(f) { TLam as b => eval(beta(b, eval(x))), _ => (eval(f), eval(x)) ↪ TApp },
      TPair as (a, b) => (eval(a), eval(b)) ↪ TPair,
      TFst as p     => match eval(p) { TPair as (a, b) => eval(a), _ => eval(p) ↪ TFst },
      TSnd as p     => match eval(p) { TPair as (a, b) => eval(b), _ => eval(p) ↪ TSnd },
      TRefl as a    => eval(a) ↪ TRefl,
      TJ as (mo, ba, pa) => match eval(pa) { TRefl as a => eval((ba, a) ↪ TApp),
                         _        => (mo, ba, eval(pa)) ↪ TJ } }
}

fun as_num(t: Term): Number {
  return match t { TLit as n => n, TVar as i => i, _ => 0 }
}

fun main(): Number {
  r := eval((0 ↪ TLit, 0 ↪ TVar ↪ TLam, 7 ↪ TLit ↪ TRefl) ↪ TJ)
  return as_num(r) - 7
}
