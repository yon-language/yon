// Id / TRefl / J in the lambda core, written in Yon.
// Wildcard form: the diagonal beta J(c, d, TRefl a) ~> d a is the only live branch of
// TJ; everything else stays stuck via `_ =>`. shift/subst stay exhaustive.
// Oracle: J(_, lam.0, TRefl 7) = 7  (as the OCaml kernel, j_computes.yon).
place Term { this > TLit Number :U TVar Number :U TLam Term :U TApp Term Term :U TPair Term Term :U TFst Term :U TSnd Term :U TRefl Term :U TJ Term Term Term }


fun shift(d: Number, c: Number, t: Term): Term {
  return match t { TLit(n)     => n |> TLit,
      TVar(i)     => if i >= c then i + d |> TVar else i |> TVar,
      TLam(b)     => shift(d, c + 1, b) |> TLam,
      TApp(f, x)  => (shift(d, c, f), shift(d, c, x)) |> TApp,
      TPair(a, b) => (shift(d, c, a), shift(d, c, b)) |> TPair,
      TFst(p)     => shift(d, c, p) |> TFst,
      TSnd(p)     => shift(d, c, p) |> TSnd,
      TRefl(a)    => shift(d, c, a) |> TRefl,
      TJ(mo, ba, pa) => (shift(d, c, mo), shift(d, c, ba), shift(d, c, pa)) |> TJ }
}

fun subst(j: Number, s: Term, t: Term): Term {
  return match t { TLit(n)     => n |> TLit,
      TVar(i)     => if i == j then s else i |> TVar,
      TLam(b)     => subst(j + 1, shift(1, 0, s), b) |> TLam,
      TApp(f, x)  => (subst(j, s, f), subst(j, s, x)) |> TApp,
      TPair(a, b) => (subst(j, s, a), subst(j, s, b)) |> TPair,
      TFst(p)     => subst(j, s, p) |> TFst,
      TSnd(p)     => subst(j, s, p) |> TSnd,
      TRefl(a)    => subst(j, s, a) |> TRefl,
      TJ(mo, ba, pa) => (subst(j, s, mo), subst(j, s, ba), subst(j, s, pa)) |> TJ }
}

fun beta(body: Term, arg: Term): Term {
  return shift(0 - 1, 0, subst(0, shift(1, 0, arg), body))
}

fun eval(t: Term): Term {
  return match t { TLit(n)     => n |> TLit,
      TVar(i)     => i |> TVar,
      TLam(b)     => b |> TLam,
      TApp(f, x)  => match eval(f) { TLam(b) => eval(beta(b, eval(x))), _ => (eval(f), eval(x)) |> TApp },
      TPair(a, b) => (eval(a), eval(b)) |> TPair,
      TFst(p)     => match eval(p) { TPair(a, b) => eval(a), _ => eval(p) |> TFst },
      TSnd(p)     => match eval(p) { TPair(a, b) => eval(b), _ => eval(p) |> TSnd },
      TRefl(a)    => eval(a) |> TRefl,
      TJ(mo, ba, pa) => match eval(pa) { TRefl(a) => eval((ba, a) |> TApp),
                         _        => (mo, ba, eval(pa)) |> TJ } }
}

fun as_num(t: Term): Number {
  return match t { TLit(n) => n, TVar(i) => i, _ => 0 }
}

fun main(): Number {
  r := eval((0 |> TLit, 0 |> TVar |> TLam, 7 |> TLit |> TRefl) |> TJ)
  return as_num(r) - 7
}
