// Id / TRefl / J in the lambda core, written in Yon.
// Wildcard form: the diagonal beta J(c, d, TRefl a) ~> d a is the only live branch of
// TJ; everything else stays stuck via `_ =>`. shift/subst stay exhaustive.
// Oracle: J(_, lam.0, TRefl 7) = 7  (as the OCaml kernel, j_computes.yon).
place Term { this > TLit(Number) :U TVar(Number) :U TLam(Term) :U TApp(Term, Term) :U TPair(Term, Term) :U TFst(Term) :U TSnd(Term) :U TRefl(Term) :U TJ(Term, Term, Term) }


fun shift(d: Number, c: Number, t: Term): Term {
  return match t { TLit(n)     => .-> TLit { _1 n },
      TVar(i)     => if i >= c then .-> TVar { _1 i + d } else .-> TVar { _1 i },
      TLam(b)     => .-> TLam { _1 shift(d, c + 1, b) },
      TApp(f, x)  => .-> TApp { _1 shift(d, c, f) _2 shift(d, c, x) },
      TPair(a, b) => .-> TPair { _1 shift(d, c, a) _2 shift(d, c, b) },
      TFst(p)     => .-> TFst { _1 shift(d, c, p) },
      TSnd(p)     => .-> TSnd { _1 shift(d, c, p) },
      TRefl(a)    => .-> TRefl { _1 shift(d, c, a) },
      TJ(mo, ba, pa) => .-> TJ { _1 shift(d, c, mo) _2 shift(d, c, ba) _3 shift(d, c, pa) } }
}

fun subst(j: Number, s: Term, t: Term): Term {
  return match t { TLit(n)     => .-> TLit { _1 n },
      TVar(i)     => if i == j then s else .-> TVar { _1 i },
      TLam(b)     => .-> TLam { _1 subst(j + 1, shift(1, 0, s), b) },
      TApp(f, x)  => .-> TApp { _1 subst(j, s, f) _2 subst(j, s, x) },
      TPair(a, b) => .-> TPair { _1 subst(j, s, a) _2 subst(j, s, b) },
      TFst(p)     => .-> TFst { _1 subst(j, s, p) },
      TSnd(p)     => .-> TSnd { _1 subst(j, s, p) },
      TRefl(a)    => .-> TRefl { _1 subst(j, s, a) },
      TJ(mo, ba, pa) => .-> TJ { _1 subst(j, s, mo) _2 subst(j, s, ba) _3 subst(j, s, pa) } }
}

fun beta(body: Term, arg: Term): Term {
  return shift(0 - 1, 0, subst(0, shift(1, 0, arg), body))
}

fun eval(t: Term): Term {
  return match t { TLit(n)     => .-> TLit { _1 n },
      TVar(i)     => .-> TVar { _1 i },
      TLam(b)     => .-> TLam { _1 b },
      TApp(f, x)  => match eval(f) { TLam(b) => eval(beta(b, eval(x))), _ => .-> TApp { _1 eval(f) _2 eval(x) } },
      TPair(a, b) => .-> TPair { _1 eval(a) _2 eval(b) },
      TFst(p)     => match eval(p) { TPair(a, b) => eval(a), _ => .-> TFst { _1 eval(p) } },
      TSnd(p)     => match eval(p) { TPair(a, b) => eval(b), _ => .-> TSnd { _1 eval(p) } },
      TRefl(a)    => .-> TRefl { _1 eval(a) },
      TJ(mo, ba, pa) => match eval(pa) { TRefl(a) => eval(.-> TApp { _1 ba _2 a }),
                         _        => .-> TJ { _1 mo _2 ba _3 eval(pa) } } }
}

fun as_num(t: Term): Number {
  return match t { TLit(n) => n, TVar(i) => i, _ => 0 }
}

fun main(): Number {
  r := eval(.-> TJ { _1 .-> TLit { _1 0 } _2 .-> TLam { _1 .-> TVar { _1 0 } } _3 .-> TRefl { _1 .-> TLit { _1 7 } } })
  return as_num(r) - 7
}
