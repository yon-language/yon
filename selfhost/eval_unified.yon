// One Term, one eval (de Bruijn lambda + arithmetic).
// Wildcard form: add_vals/mul_vals compute only on two TLit, everything else is a
// single `_ => stuck`; shift/subst stay exhaustive. Oracle: (lam. x+x) 21 = 42.
place Term { this > TLit(Number) :U TVar(Number) :U TLam(Term) :U TApp(Term, Term) :U TAdd(Term, Term) :U TMul(Term, Term) }

fun motT(t: Term): Term { return hit(TLit, 0) }

fun shift(d: Number, c: Number, t: Term): Term {
  return hit_elim(motT,
    [ TLit(n)     => hit(TLit, n),
      TVar(i)     => if i >= c then hit(TVar, i + d) else hit(TVar, i),
      TLam(b)     => hit(TLam, shift(d, c + 1, b)),
      TApp(f, x)  => hit(TApp, shift(d, c, f), shift(d, c, x)),
      TAdd(a, b)  => hit(TAdd, shift(d, c, a), shift(d, c, b)),
      TMul(a, b)  => hit(TMul, shift(d, c, a), shift(d, c, b)) ], t)
}
fun subst(j: Number, s: Term, t: Term): Term {
  return hit_elim(motT,
    [ TLit(n)     => hit(TLit, n),
      TVar(i)     => if i == j then s else hit(TVar, i),
      TLam(b)     => hit(TLam, subst(j + 1, shift(1, 0, s), b)),
      TApp(f, x)  => hit(TApp, subst(j, s, f), subst(j, s, x)),
      TAdd(a, b)  => hit(TAdd, subst(j, s, a), subst(j, s, b)),
      TMul(a, b)  => hit(TMul, subst(j, s, a), subst(j, s, b)) ], t)
}
fun beta(body: Term, arg: Term): Term {
  return shift(0 - 1, 0, subst(0, shift(1, 0, arg), body))
}

// sum of two ALREADY evaluated values: computes on two TLit, otherwise stuck
fun add_vals(x: Term, y: Term): Term {
  return hit_elim(motT,
    [ TLit(nx) => hit_elim(motT,
        [ TLit(ny) => hit(TLit, nx + ny), _ => hit(TAdd, hit(TLit, nx), y) ], y),
      _ => hit(TAdd, x, y) ], x)
}
fun mul_vals(x: Term, y: Term): Term {
  return hit_elim(motT,
    [ TLit(nx) => hit_elim(motT,
        [ TLit(ny) => hit(TLit, nx * ny), _ => hit(TMul, hit(TLit, nx), y) ], y),
      _ => hit(TMul, x, y) ], x)
}

fun eval(t: Term): Term {
  return hit_elim(motT,
    [ TLit(n)     => hit(TLit, n),
      TVar(i)     => hit(TVar, i),
      TLam(b)     => hit(TLam, b),
      TApp(f, x)  => hit_elim(motT,
                       [ TLam(b) => eval(beta(b, eval(x))),
                         _       => hit(TApp, eval(f), eval(x)) ], eval(f)),
      TAdd(a, b)  => add_vals(eval(a), eval(b)),
      TMul(a, b)  => mul_vals(eval(a), eval(b)) ], t)
}

fun motN(t: Term): Number { return 0 }
fun as_num(t: Term): Number {
  return hit_elim(motN, [ TLit(n) => n, TVar(i) => i, _ => 0 ], t)
}

// ORACLE: (lam. var0 + var0) 21  ->  21 + 21  ->  42
fun main(): Number {
  be r := eval(hit(TApp,
                      hit(TLam, hit(TAdd, hit(TVar, 0), hit(TVar, 0))),
                      hit(TLit, 21)))
  return as_num(r) - 42
}
