// One Term, one eval (de Bruijn lambda + arithmetic).
// Wildcard form: add_vals/mul_vals compute only on two TLit, everything else is a
// single `_ => stuck`; shift/subst stay exhaustive. Oracle: (lam. x+x) 21 = 42.
place Term { this > TLit Number :U TVar Number :U TLam Term :U TApp Term Term :U TAdd Term Term :U TMul Term Term }


fun shift(d: Number, c: Number, t: Term): Term {
  return match t { TLit(n)     => n |> TLit,
      TVar(i)     => if i >= c then i + d |> TVar else i |> TVar,
      TLam(b)     => shift(d, c + 1, b) |> TLam,
      TApp(f, x)  => (shift(d, c, f), shift(d, c, x)) |> TApp,
      TAdd(a, b)  => (shift(d, c, a), shift(d, c, b)) |> TAdd,
      TMul(a, b)  => (shift(d, c, a), shift(d, c, b)) |> TMul }
}
fun subst(j: Number, s: Term, t: Term): Term {
  return match t { TLit(n)     => n |> TLit,
      TVar(i)     => if i == j then s else i |> TVar,
      TLam(b)     => subst(j + 1, shift(1, 0, s), b) |> TLam,
      TApp(f, x)  => (subst(j, s, f), subst(j, s, x)) |> TApp,
      TAdd(a, b)  => (subst(j, s, a), subst(j, s, b)) |> TAdd,
      TMul(a, b)  => (subst(j, s, a), subst(j, s, b)) |> TMul }
}
fun beta(body: Term, arg: Term): Term {
  return shift(0 - 1, 0, subst(0, shift(1, 0, arg), body))
}

// sum of two ALREADY evaluated values: computes on two TLit, otherwise stuck
fun add_vals(x: Term, y: Term): Term {
  return match x { TLit(nx) => match y { TLit(ny) => nx + ny |> TLit, _ => (nx |> TLit, y) |> TAdd },
      _ => (x, y) |> TAdd }
}
fun mul_vals(x: Term, y: Term): Term {
  return match x { TLit(nx) => match y { TLit(ny) => nx * ny |> TLit, _ => (nx |> TLit, y) |> TMul },
      _ => (x, y) |> TMul }
}

fun eval(t: Term): Term {
  return match t { TLit(n)     => n |> TLit,
      TVar(i)     => i |> TVar,
      TLam(b)     => b |> TLam,
      TApp(f, x)  => match eval(f) { TLam(b) => eval(beta(b, eval(x))),
                         _       => (eval(f), eval(x)) |> TApp },
      TAdd(a, b)  => add_vals(eval(a), eval(b)),
      TMul(a, b)  => mul_vals(eval(a), eval(b)) }
}

fun as_num(t: Term): Number {
  return match t { TLit(n) => n, TVar(i) => i, _ => 0 }
}

// ORACLE: (lam. var0 + var0) 21  ->  21 + 21  ->  42
fun main(): Number {
  r := eval(((0 |> TVar, 0 |> TVar) |> TAdd |> TLam, 21 |> TLit) |> TApp)
  return as_num(r) - 42
}
