// Yon-in-Yon, seed 6: a LEXER closes the front of the pipeline.
//
// text -> tokens -> AST -> value, entirely in Yon. `lex` scans the source string one
// char at a time and emits a token cons-list; that feeds the same parse (a fold over
// the token stream) and eval (a catamorphism on the content-addressed AST) as the
// earlier seeds. This is the "Lexer: a stream fold" row of the design, on real text
// rather than hand-built tokens.
//
// Scope (a seed, not the production lexer): single-digit numbers, operators + and *,
// no whitespace/parens. Input "2+3*4" -> [NUM2,+,NUM3,*,NUM4] -> left-assoc (2+3)*4 = 20.

// --- AST + eval (the catamorphism) ---
fun mk_lit(n: number): MerkleTree { return MerkleTree.node2(1, MerkleTree.leaf(n), MerkleTree.leaf(0)) }
fun eval(e: MerkleTree): number {
  be t holds MerkleTree.label(e)
  return if t == 1 then MerkleTree.label(MerkleTree.child(e, 0))
    else if t == 2 then eval(MerkleTree.child(e, 0)) + eval(MerkleTree.child(e, 1))
    else eval(MerkleTree.child(e, 0)) * eval(MerkleTree.child(e, 1))
}

// --- tokens (content-addressed): kind 1 = NUM(value), 2 = '+', 3 = '*' ---
fun tok_num(v: number): MerkleTree { return MerkleTree.node2(1, MerkleTree.leaf(v), MerkleTree.leaf(0)) }
fun tok_op(kind: number): MerkleTree { return MerkleTree.node2(kind, MerkleTree.leaf(0), MerkleTree.leaf(0)) }
fun toks_nil(): MerkleTree { return MerkleTree.leaf(0 - 1) }
fun toks_cons(tok: MerkleTree, rest: MerkleTree): MerkleTree { return MerkleTree.node2(0, tok, rest) }
fun is_nil(l: MerkleTree): number { return if MerkleTree.label(l) == (0 - 1) then 1 else 0 }
fun tok_val(tok: MerkleTree): number { return MerkleTree.label(MerkleTree.child(tok, 0)) }

// --- lexer: char codes '+' = 43, '*' = 42, digits '0'..'9' = 48..57 ---
fun char_to_tok(c: number): MerkleTree {
  return if c == 43 then tok_op(2)          // '+'
    else if c == 42 then tok_op(3)          // '*'
    else tok_num(c - 48)                     // a digit
}
fun lex_from(src: String, i: number, n: number): MerkleTree {
  return if i == n then toks_nil()
    else toks_cons(char_to_tok(String.char_at(src, i)), lex_from(src, i + 1, n))
}
fun lex(src: String): MerkleTree { return lex_from(src, 0, String.length(src)) }

// --- parser: left-assoc fold over the token stream (op kind = AST tag) ---
fun parse_loop(toks: MerkleTree, acc: MerkleTree): MerkleTree {
  return if is_nil(toks) == 1 then acc
    else parse_loop(
           MerkleTree.child(MerkleTree.child(toks, 1), 1),
           MerkleTree.node2(
             MerkleTree.label(MerkleTree.child(toks, 0)),
             acc,
             mk_lit(tok_val(MerkleTree.child(MerkleTree.child(toks, 1), 0)))))
}
fun parse(toks: MerkleTree): MerkleTree {
  return parse_loop(MerkleTree.child(toks, 1), mk_lit(tok_val(MerkleTree.child(toks, 0))))
}

fun main(): number {
  be src holds "2+3*4"
  return eval(parse(lex(src)))
}
