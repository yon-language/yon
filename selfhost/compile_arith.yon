/* A full arithmetic compiler in Yon: text -> Term -> MLIR.
 *
 * It joins a front and a back end:
 *   front (parse_arith.yon): text -> tokens -> AST, recursive descent with
 *                            precedence (* over +).
 *   back  (emit_arith.yon):  AST -> MLIR text, the gen catamorphism.
 * The result is a real (tiny) compiler: it lexes and parses a source string into
 * a Term, generates a full MLIR module, writes it to a file; the backend then
 * compiles+runs it. Source "2+3*4" = 2 + (3*4) = 14 -> the emitted program exits
 * 14. One AST (Term) shared by parser and emitter; no interpreter in the loop.
 */

/* one shared AST for both parser and emitter. */
place Term { this > TLit Number :U TAdd Term Term :U TMul Term Term }
place Token { this > TNum Number :U TPlus :U TStar :U TLParen :U TRParen :U TEnd }
place TokList { this > TkNil :U TkCons Token TokList }
place Parse { this > POk Term TokList :U PErr }
/* result of gen: (result ssa, accumulated code, next counter). */
place EmitR { this > ER String String Number }

/* ---- lexer: String -> TokList ---- */
fun lex_at(s: String, i: Number, len: Number, c: Number): TokList {
  return if c == 32 then lex_from(s, i + 1, len)
    else if c == 43 then .-> TkCons { _1 TPlus _2 lex_from(s, i + 1, len) }
    else if c == 42 then .-> TkCons { _1 TStar _2 lex_from(s, i + 1, len) }
    else if c >= 48 then .-> TkCons { _1 .-> TNum { _1 c - 48 } _2 lex_from(s, i + 1, len) }
    else lex_from(s, i + 1, len)
}
fun lex_from(s: String, i: Number, len: Number): TokList {
  return if i >= len then .-> TkCons { _1 TEnd _2 TkNil }
    else lex_at(s, i, len, String.char_at(s, i))
}
fun lex(s: String): TokList { return lex_from(s, 0, String.length(s)) }

/* ---- token/list peeking ---- */
fun tok_tag(t: Token): Number {
  return match t { TNum(n)=>0, TPlus=>1, TStar=>2, TLParen=>3, TRParen=>4, TEnd=>5 }
}
fun tok_num(t: Token): Number {
  return match t { TNum(n)=>n, TPlus=>0, TStar=>0, TLParen=>0, TRParen=>0, TEnd=>0 }
}
fun head_tag(l: TokList): Number {
  return match l { TkNil => 0 - 1, TkCons(h, t) => tok_tag(h) }
}
fun head_num(l: TokList): Number {
  return match l { TkNil => 0, TkCons(h, t) => tok_num(h) }
}
fun tail(l: TokList): TokList {
  return match l { TkNil => TkNil, TkCons(h, t) => t }
}

/* ---- recursive-descent parser: TokList -> Parse (builds Term) ---- */
/* factor := NUM */
fun parse_factor(l: TokList): Parse {
  return if head_tag(l) == 0
    then .-> POk { _1 .-> TLit { _1 head_num(l) } _2 tail(l) }
    else PErr
}
/* term := factor ('*' term)? */
fun parse_term(l: TokList): Parse { return term_more(parse_factor(l)) }
fun term_more(p: Parse): Parse {
  return match p { PErr => PErr,
      POk(left, rest) =>
        if head_tag(rest) == 2
        then combine_mul(left, parse_term(tail(rest)))
        else .-> POk { _1 left _2 rest } }
}
fun combine_mul(left: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk(right, rest) => .-> POk { _1 .-> TMul { _1 left _2 right } _2 rest } }
}
/* expr := term ('+' expr)? */
fun parse_expr(l: TokList): Parse { return expr_more(parse_term(l)) }
fun expr_more(p: Parse): Parse {
  return match p { PErr => PErr,
      POk(left, rest) =>
        if head_tag(rest) == 1
        then combine_add(left, parse_expr(tail(rest)))
        else .-> POk { _1 left _2 rest } }
}
fun combine_add(left: Term, p: Parse): Parse {
  return match p { PErr => PErr,
      POk(right, rest) => .-> POk { _1 .-> TAdd { _1 left _2 right } _2 rest } }
}
/* extract the Term from a successful parse (TLit 0 on error). */
fun term_of(p: Parse): Term {
  return match p { PErr => .-> TLit { _1 0 }, POk(e, rest) => e }
}

/* ---- back end: gen (Term -> MLIR text) ---- */
fun er_ssa(e: EmitR):  String { return match e { ER(s, c, n) => s } }
fun er_code(e: EmitR): String { return match e { ER(s, c, n) => c } }
fun er_ctr(e: EmitR):  Number { return match e { ER(s, c, n) => n } }

fun ssa_name(n: Number): String { return String.concat("%v", String.from_int(n)) }
fun num_lit(k: Number): String  { return String.concat(String.from_int(k), ".0") }
fun line(ssa: String, rhs: String): String {
  return String.concat(String.concat(String.concat("  ", ssa),
           String.concat(" = ", rhs)), " : f64\n")
}

fun gen(t: Term, n: Number): EmitR {
  return match t {
    TLit(k) =>
      .-> ER { _1 ssa_name(n) _2 line(ssa_name(n), String.concat("arith.constant ", num_lit(k))) _3 n + 1 },
    TAdd(a, b) => gen_bin("arith.addf", a, b, n),
    TMul(a, b) => gen_bin("arith.mulf", a, b, n)
  }
}
fun gen_bin(op: String, a: Term, b: Term, n: Number): EmitR {
  ea := gen(a, n)
  eb := gen(b, er_ctr(ea))
  m  := er_ctr(eb)
  rhs := String.concat(String.concat(op, " "),
                 String.concat(String.concat(er_ssa(ea), ", "), er_ssa(eb)))
  return .-> ER { _1 ssa_name(m) _2 String.concat(String.concat(er_code(ea), er_code(eb)),
                          line(ssa_name(m), rhs)) _3 m + 1 }
}

/* ---- module boilerplate ---- */
fun mod_prefix(): String {
  return "module {\n  func.func private @yon_rt_maybe_serve() -> ()\n  func.func @main() -> i32 {\n    func.call @yon_rt_maybe_serve() : () -> ()\n"
}
fun stubs(): String {
  return "  func.func @__yon_dispatch(%sel: f64, %a1: f64, %a2: f64, %a3: f64, %a4: f64) -> f64 {\n    %d = arith.constant -777.0 : f64\n    return %d : f64\n  }\n  func.func @__yon_closure_call(%clo: f64, %a1: f64, %a2: f64, %a3: f64, %a4: f64) -> f64 {\n    %c = arith.constant -777.0 : f64\n    return %c : f64\n  }\n}\n"
}
fun mod_suffix(result_ssa: String, ctr: Number): String {
  rss := ssa_name(ctr)
  return String.concat(
    String.concat("    ", String.concat(rss,
      String.concat(" = arith.fptosi ", String.concat(result_ssa, " : f64 to i32\n")))),
    String.concat(String.concat("    return ", String.concat(rss, " : i32\n  }\n")),
      stubs()))
}

fun main(): Number {
  /* the whole pipeline: source text -> tokens -> Term -> MLIR module -> file. */
  prog := term_of(parse_expr(lex("2+3*4")))     /* 2 + (3*4) = 14 */
  r := gen(prog, 0)
  full := String.concat(mod_prefix(),
                  String.concat(er_code(r),
                    mod_suffix(er_ssa(r), er_ctr(r))))
  _w := File.write_text(String.concat(Args.get(1), "/out.mlir"), full)
  _p := String.print(full)
  return String.length(full)
}
