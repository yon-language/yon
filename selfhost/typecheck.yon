// Yon-in-Yon, seed 3: a type synthesizer for the object language.
//
// `infer` is a CATAMORPHISM into the algebra of TYPES (NUMBER, BOOL, ERROR): the
// elaborate/typecheck phase of the design, "a morphism into the classifying topos".
// A well-typed term synthesizes its type object; an ill-typed one collapses to ERROR
// (it has no global element of any type). The judgement commutes with subterms, which
// is exactly the naturality the design asks a pass to satisfy.
//
// HONEST scope: this is MONOMORPHIC synthesis (a fold into a 3-element type set), not
// Hindley-Milner. No type variables, no unification, no polymorphism; that is the
// frontend's hm_infer.ml and the next refinement. What it does show, on silicon, is the
// pass as a type-valued catamorphism, checked two-sided (accepts good, rejects bad).
//
// types: NUMBER=1, BOOL=2, ERROR=0.
// AST tags: 1=Lit(number), 2=Add, 3=Mul, 4=Bool, 5=Lt(a,b):bool, 6=If(c, PAIR(t,e)).
// NB If uses NESTED node2 (cond, node2(0,then,else)), not node3: MerkleTree.child on a
// node3 at index 2 returns a sentinel at runtime (a real arity limit of the accessor),
// so binary spines are the safe encoding for arity > 2.

fun mk_lit(n: number): MerkleTree { return MerkleTree.node2(1, MerkleTree.leaf(n), MerkleTree.leaf(0)) }
fun mk_bool(b: number): MerkleTree { return MerkleTree.node2(4, MerkleTree.leaf(b), MerkleTree.leaf(0)) }
fun mk_add(a: MerkleTree, b: MerkleTree): MerkleTree { return MerkleTree.node2(2, a, b) }
fun mk_lt(a: MerkleTree, b: MerkleTree): MerkleTree { return MerkleTree.node2(5, a, b) }
fun mk_if(c: MerkleTree, th: MerkleTree, el: MerkleTree): MerkleTree {
  return MerkleTree.node2(6, c, MerkleTree.node2(0, th, el))
}

fun infer(e: MerkleTree): number {
  be t holds MerkleTree.label(e)
  return if t == 1 then 1                          // Lit : NUMBER
    else if t == 4 then 2                          // Bool : BOOL
    else if t == 2 then                            // Add : NUMBER when both NUMBER
      (if infer(MerkleTree.child(e, 0)) == 1
       then (if infer(MerkleTree.child(e, 1)) == 1 then 1 else 0) else 0)
    else if t == 3 then                            // Mul : NUMBER when both NUMBER
      (if infer(MerkleTree.child(e, 0)) == 1
       then (if infer(MerkleTree.child(e, 1)) == 1 then 1 else 0) else 0)
    else if t == 5 then                            // Lt : BOOL when both NUMBER
      (if infer(MerkleTree.child(e, 0)) == 1
       then (if infer(MerkleTree.child(e, 1)) == 1 then 2 else 0) else 0)
    else                                           // If : cond BOOL and both branches agree
      (if infer(MerkleTree.child(e, 0)) == 2
       then (if infer(MerkleTree.child(MerkleTree.child(e, 1), 0))
                == infer(MerkleTree.child(MerkleTree.child(e, 1), 1))
             then infer(MerkleTree.child(MerkleTree.child(e, 1), 0)) else 0) else 0)
}

fun main(): number {
  // well-typed: if (2 < 3) then 10 else 20  ->  NUMBER (1)
  be prog_ok holds mk_if(mk_lt(mk_lit(2), mk_lit(3)), mk_lit(10), mk_lit(20))
  // ill-typed: 2 + true  ->  ERROR (0)
  be prog_bad holds mk_add(mk_lit(2), mk_bool(1))
  return infer(prog_ok) * 100 + infer(prog_bad)
}
