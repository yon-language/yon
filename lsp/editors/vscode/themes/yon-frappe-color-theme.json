  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#737994", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted.double.yon"],
      "settings": { "foreground": "#a6d189" } },
    { "scope": ["constant.character.escape"],
      "settings": { "foreground": "#f2d5cf" } },
    { "scope": ["constant.numeric", "constant.numeric.yon"],
      "settings": { "foreground": "#ef9f76" } },
    { "scope": ["constant.language", "constant.language.yon"],
      "settings": { "foreground": "#ef9f76" } },

    { "scope": ["keyword.control", "keyword.control.yon"],
      "settings": { "foreground": "#ca9ee6" } },
    { "scope": ["storage", "storage.type", "storage.type.yon"],
      "settings": { "foreground": "#ca9ee6" } },
    { "scope": ["keyword.other.binding.yon"],
      "settings": { "foreground": "#e78284" } },
    { "scope": ["keyword.operator.word.yon"],
      "settings": { "foreground": "#81c8be" } },
    { "scope": ["keyword.operator", "keyword.operator.yon", "keyword.operator.intuitionistic.yon"],
      "settings": { "foreground": "#99d1db" } },
    { "scope": ["keyword.other.hott.yon"],
      "settings": { "foreground": "#81c8be", "fontStyle": "italic" } },

    { "scope": ["support.type", "support.type.primitive.yon", "entity.name.type", "entity.name.type.yon"],
      "settings": { "foreground": "#e5c890" } },
    { "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": { "foreground": "#8caaee" } },
    { "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#c6d0f5" } },
    { "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#a5adce" } }
  ]
}
