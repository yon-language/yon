#!/usr/bin/env bash
# yon-stage1 -- the self-hosted (stage 1) compile path.
#
# Compiles a Yon0 source with the compiler WRITTEN IN YON (selfhost_compiler.yon,
# itself built by stage 0), then lowers the emitted MLIR with the stage-0 backend.
# So: stage 0 builds this compiler once; this compiler emits the MLIR; stage 0's
# backend (topos-opt -> LLVM -> native) turns that MLIR into an executable.
#
# stage 1 understands Yon0 ONLY (arithmetic + - *, fun, be/return, if/then/else,
# ==, single-argument calls, recursion). A program outside Yon0 produces no MLIR
# (or MLIR the backend rejects); use `yon build --rooted` for full Yon.
#
# Note: the compiler-in-Yon currently reads/writes fixed /tmp paths (Yon's argv
# access has friction), so this wrapper is single-build-at-a-time.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
YONC="$HERE/yonc"
SRC="$HERE/../selfhost/selfhost_compiler.yon"
COMPILER="${YON_STAGE1_BIN:-/tmp/yon-stage1-compiler}"   # cached stage-1 binary
IN="/tmp/yon_selfhost_in.yon"                            # the tool's fixed input
OUT_MLIR="/tmp/yon_selfhost_out.mlir"                    # the tool's fixed output

die() { echo "yon-stage1: $*" >&2; exit 2; }

file=""; out="a.out"
while [ $# -gt 0 ]; do
  case "$1" in
    -o)   out="$2"; shift 2 ;;
    -o*)  out="${1#-o}"; shift ;;
    -*)   shift ;;                # ignore other flags for now
    *)    file="$1"; shift ;;
  esac
done
[ -n "$file" ] || die "missing source file"
[ -f "$file" ] || die "no such file: $file"

# Build the stage-1 compiler (the compiler-in-Yon) with stage 0, cached by mtime.
if [ ! -x "$COMPILER" ] || [ "$SRC" -nt "$COMPILER" ]; then
  "$YONC" "$SRC" -o "$COMPILER" >/dev/null
fi

# Run it: it reads IN and emits the MLIR module to OUT_MLIR.
cp "$file" "$IN"
rm -f "$OUT_MLIR"
"$COMPILER" >/dev/null 2>&1 || true
[ -f "$OUT_MLIR" ] || \
  die "the compiler-in-Yon produced no MLIR (is '$file' within Yon0? use 'yon build --rooted' for full Yon)"

# Lower the emitted MLIR with the stage-0 backend.
exec "$YONC" "$OUT_MLIR" -o "$out"
