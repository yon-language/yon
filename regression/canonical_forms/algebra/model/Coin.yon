place Coin uses algebra BooleanOr, Turn, Pick {
  this > Heads :U Tails
  fun op(a: Coin, b: Coin): Coin { return match a { Heads => Heads, Tails => b } }
  fun unit: Coin { return Tails }
  fun pick(a: Coin, b: Coin): Coin { return op(a, b) }
  fun flip(a: Coin): Coin { return match a { Heads => Tails, Tails => Heads } }
}
