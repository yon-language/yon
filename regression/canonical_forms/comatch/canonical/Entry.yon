// The co-mediatrice pattern: `Opened { initial balance as b }` reads an arm that is a
// place by the names of its fields, the mirror of the mediatrice literal
// `.-> P { field v }`. Exercises pat_field (both spellings: bare field and
// `field as name`).
place Opened { initial Number balance Number }
place Closed { moment Number }
place Account { this > Opened :U Closed }

place Entry {
  fun read(a: Account): Number {
    return match a {
      Opened { initial balance as b } => initial + b,
      Closed { moment } => moment
    }
  }
  fun open: Account { return .-> Opened { initial 30 balance 2 } }
  fun closed: Account { return .-> Closed { moment 10 } }
  fun main: Number {
    return read(open) + read(closed)
  }
}
