// quote(c, a) : El(c). The code `number` decodes (el_decode) to the carrier
// number, but the inhabitant "text" has type text. The EQuote case in infer
// rejects via Dispatcher.type_equal: "inhabitant has type text but El(number)
// carrier is number" -> exit 3.
fun main(): Number {
  be q holds quote(Number, "text")
  return 0
}
