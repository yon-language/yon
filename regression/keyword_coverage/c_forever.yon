// coverage: the `forever { }` non-terminating loop statement (forever_stmt,
// desugars to __forever(body)) compiles: the emit exits 0. Coverage counts code,
// not comments, so this file is the keyword's exercise.
//
place Entry {
  fun spin(): Number visits Output {
    forever {
      be _ := String.print("tick")
    }
  }
  fun main(): Number { return 0 }
}

