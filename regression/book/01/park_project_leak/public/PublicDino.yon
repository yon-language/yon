// LEAK variant — public record tries to carry individual identity on the
// cohort-quotient. Expected: REJECTED (place-level sheaf gate), same as the
// inline park_leak_reject.yon which is already gated green.
fun bucket_of(c: number): number { return c }
place PublicDino {
  cohort number
  individual_id number
}
view LegalLens of PublicDino {
  show bucket = bucket_of(cohort)
}
