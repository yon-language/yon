// Book ch.1 — the allowed shape.
// The full animal lives in the BASE world Park: Science sees everything.
// The public/legal world is Park up to cohort; a record there may carry ONLY
// cohort-invariant data, and a view must factor through cohort. This satisfies
// the sheaf condition. Modeled on regression/yon_tests/prove/sheaf_quotient_view_ok.yon
// Expected: compiles, exit 0.
world Park { Dino is Species }

place Dinosaur in Park {
  individual_id Number
  cohort Number
  heart_rate Number
}

world PublicPark = Park / cohort

place PublicDino in PublicPark {
  cohort Number
}

fun bucket_of(c: Number): Number { return c }

view LegalLens of PublicDino {
  show bucket = bucket_of(cohort)
}

fun main(): Number { return 0 }
