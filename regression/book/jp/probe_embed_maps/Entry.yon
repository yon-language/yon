place Entry { }

// PART B probe: which map turns a 12-bit character vector into a type-2 point so
// that XSimplex.of2 reflects the vector's BIT pattern (not its byte address)?
//
// Anchor v0 = 0; comparison vectors at known Hamming distance from v0:
//   v0 = 0      v1 = 1 (Hamming 1)   v2 = 7 (Hamming 3)
//   v3 = 63 (Hamming 6)              v4 = 4095 (Hamming 12, all bits set)
//
// Candidate maps (Leech.embed(bits, mode), nearest type-2 via the quantizer):
//   mode 0  duplicate : bit k -> coords 2k,2k+1 = +-1                (all 24 coords)
//   mode 1  golay     : bits -> Golay 24-bit codeword -> +-1 signs
//   mode 2  sparse    : 12 coords +-1, 12 coords 0
// Baseline (cheap, surface-callable today): Leech.co0_canonical (a canonicalizer,
// expected to COLLAPSE distinct vectors or reject -> of2 = 0 / -1).
//
// What to read per block: the 5 embedded xcoords show DISTINCTNESS (equal values
// = collapse); the 4 of2 classes (Hamming 1/3/6/12) show whether of2 RESOLVES
// bit-distance (a grown / varied spread = Hamming survives; all 0 = collapsed;
// all -1 = not type-2). A map passes iff embeds are distinct AND of2 spreads.
//
// Stdout layout (36 ints), four 9-line blocks (mode0, mode1, mode2, baseline):
//   e0 e1 e2 e3 e4            -- the 5 embedded xcoords
//   of2(e0,e1) of2(e0,e2) of2(e0,e3) of2(e0,e4)   -- classes at Hamming 1/3/6/12

fun main(): Number visits Output {
  // mode 0 — duplicate
  be a0 holds Leech.embed(0, 0)
  be a1 holds Leech.embed(1, 0)
  be a2 holds Leech.embed(7, 0)
  be a3 holds Leech.embed(63, 0)
  be a4 holds Leech.embed(4095, 0)
  // mode 1 — golay
  be b0 holds Leech.embed(0, 1)
  be b1 holds Leech.embed(1, 1)
  be b2 holds Leech.embed(7, 1)
  be b3 holds Leech.embed(63, 1)
  be b4 holds Leech.embed(4095, 1)
  // mode 2 — sparse
  be c0 holds Leech.embed(0, 2)
  be c1 holds Leech.embed(1, 2)
  be c2 holds Leech.embed(7, 2)
  be c3 holds Leech.embed(63, 2)
  be c4 holds Leech.embed(4095, 2)
  // baseline — co0_canonical (cheap, today)
  be d0 holds Leech.co0_canonical(0)
  be d1 holds Leech.co0_canonical(1)
  be d2 holds Leech.co0_canonical(7)
  be d3 holds Leech.co0_canonical(63)
  be d4 holds Leech.co0_canonical(4095)

  be _a0 holds Output.print(String.from_int(a0))
  be _a1 holds Output.print(String.from_int(a1))
  be _a2 holds Output.print(String.from_int(a2))
  be _a3 holds Output.print(String.from_int(a3))
  be _a4 holds Output.print(String.from_int(a4))
  be _af1 holds Output.print(String.from_int(XSimplex.of2(a0, a1)))
  be _af2 holds Output.print(String.from_int(XSimplex.of2(a0, a2)))
  be _af3 holds Output.print(String.from_int(XSimplex.of2(a0, a3)))
  be _af4 holds Output.print(String.from_int(XSimplex.of2(a0, a4)))

  be _b0 holds Output.print(String.from_int(b0))
  be _b1 holds Output.print(String.from_int(b1))
  be _b2 holds Output.print(String.from_int(b2))
  be _b3 holds Output.print(String.from_int(b3))
  be _b4 holds Output.print(String.from_int(b4))
  be _bf1 holds Output.print(String.from_int(XSimplex.of2(b0, b1)))
  be _bf2 holds Output.print(String.from_int(XSimplex.of2(b0, b2)))
  be _bf3 holds Output.print(String.from_int(XSimplex.of2(b0, b3)))
  be _bf4 holds Output.print(String.from_int(XSimplex.of2(b0, b4)))

  be _c0 holds Output.print(String.from_int(c0))
  be _c1 holds Output.print(String.from_int(c1))
  be _c2 holds Output.print(String.from_int(c2))
  be _c3 holds Output.print(String.from_int(c3))
  be _c4 holds Output.print(String.from_int(c4))
  be _cf1 holds Output.print(String.from_int(XSimplex.of2(c0, c1)))
  be _cf2 holds Output.print(String.from_int(XSimplex.of2(c0, c2)))
  be _cf3 holds Output.print(String.from_int(XSimplex.of2(c0, c3)))
  be _cf4 holds Output.print(String.from_int(XSimplex.of2(c0, c4)))

  be _d0 holds Output.print(String.from_int(d0))
  be _d1 holds Output.print(String.from_int(d1))
  be _d2 holds Output.print(String.from_int(d2))
  be _d3 holds Output.print(String.from_int(d3))
  be _d4 holds Output.print(String.from_int(d4))
  be _df1 holds Output.print(String.from_int(XSimplex.of2(d0, d1)))
  be _df2 holds Output.print(String.from_int(XSimplex.of2(d0, d2)))
  be _df3 holds Output.print(String.from_int(XSimplex.of2(d0, d3)))
  be _df4 holds Output.print(String.from_int(XSimplex.of2(d0, d4)))
  return 0
}
