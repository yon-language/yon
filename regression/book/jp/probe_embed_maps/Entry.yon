place Entry {
  fun main(): Number visits Output {
    // mode 0 — duplicate
    a0 := Leech.embed(0, 0)
    a1 := Leech.embed(1, 0)
    a2 := Leech.embed(7, 0)
    a3 := Leech.embed(63, 0)
    a4 := Leech.embed(4095, 0)
    // mode 1 — golay
    b0 := Leech.embed(0, 1)
    b1 := Leech.embed(1, 1)
    b2 := Leech.embed(7, 1)
    b3 := Leech.embed(63, 1)
    b4 := Leech.embed(4095, 1)
    // mode 2 — sparse
    c0 := Leech.embed(0, 2)
    c1 := Leech.embed(1, 2)
    c2 := Leech.embed(7, 2)
    c3 := Leech.embed(63, 2)
    c4 := Leech.embed(4095, 2)
    // baseline — co0_canonical (cheap, today)
    d0 := Leech.co0_canonical(0)
    d1 := Leech.co0_canonical(1)
    d2 := Leech.co0_canonical(7)
    d3 := Leech.co0_canonical(63)
    d4 := Leech.co0_canonical(4095)

    _a0 := Output.print(String.from_int(a0))
    _a1 := Output.print(String.from_int(a1))
    _a2 := Output.print(String.from_int(a2))
    _a3 := Output.print(String.from_int(a3))
    _a4 := Output.print(String.from_int(a4))
    _af1 := Output.print(String.from_int(XSimplex.of2(a0, a1)))
    _af2 := Output.print(String.from_int(XSimplex.of2(a0, a2)))
    _af3 := Output.print(String.from_int(XSimplex.of2(a0, a3)))
    _af4 := Output.print(String.from_int(XSimplex.of2(a0, a4)))

    _b0 := Output.print(String.from_int(b0))
    _b1 := Output.print(String.from_int(b1))
    _b2 := Output.print(String.from_int(b2))
    _b3 := Output.print(String.from_int(b3))
    _b4 := Output.print(String.from_int(b4))
    _bf1 := Output.print(String.from_int(XSimplex.of2(b0, b1)))
    _bf2 := Output.print(String.from_int(XSimplex.of2(b0, b2)))
    _bf3 := Output.print(String.from_int(XSimplex.of2(b0, b3)))
    _bf4 := Output.print(String.from_int(XSimplex.of2(b0, b4)))

    _c0 := Output.print(String.from_int(c0))
    _c1 := Output.print(String.from_int(c1))
    _c2 := Output.print(String.from_int(c2))
    _c3 := Output.print(String.from_int(c3))
    _c4 := Output.print(String.from_int(c4))
    _cf1 := Output.print(String.from_int(XSimplex.of2(c0, c1)))
    _cf2 := Output.print(String.from_int(XSimplex.of2(c0, c2)))
    _cf3 := Output.print(String.from_int(XSimplex.of2(c0, c3)))
    _cf4 := Output.print(String.from_int(XSimplex.of2(c0, c4)))

    _d0 := Output.print(String.from_int(d0))
    _d1 := Output.print(String.from_int(d1))
    _d2 := Output.print(String.from_int(d2))
    _d3 := Output.print(String.from_int(d3))
    _d4 := Output.print(String.from_int(d4))
    _df1 := Output.print(String.from_int(XSimplex.of2(d0, d1)))
    _df2 := Output.print(String.from_int(XSimplex.of2(d0, d2)))
    _df3 := Output.print(String.from_int(XSimplex.of2(d0, d3)))
    _df4 := Output.print(String.from_int(XSimplex.of2(d0, d4)))
    return 0
  }
}

// PART B probe: which map turns a 12-bit character vector into a type-2 point so
// that XSimplex.of2 reflects the vector's BIT pattern (not its byte address)?
//
// Anchor v0 = 0; comparison vectors at known Hamming distance from v0:
//   v0 = 0      v1 = 1 (Hamming 1)   v2 = 7 (Hamming 3)
//   v3 = 63 (Hamming 6)              v4 = 4095 (Hamming 12, all bits set)
//
// Candidate maps (Leech.embed(bits, mode), nearest type-2 via the quantizer):
//   mode 0  duplicate : bit k -> coords 2k,2k+1 = +-1                (all 24 coords)
//   mode 1  golay     : bits -> Golay 24-bit codeword -> +-1 signs
//   mode 2  sparse    : 12 coords +-1, 12 coords 0
// Baseline (cheap, surface-callable today): Leech.co0_canonical (a canonicalizer,
// expected to COLLAPSE distinct vectors or reject -> of2 = 0 / -1).
//
// What to read per block: the 5 embedded xcoords show DISTINCTNESS (equal values
// = collapse); the 4 of2 classes (Hamming 1/3/6/12) show whether of2 RESOLVES
// bit-distance (a grown / varied spread = Hamming survives; all 0 = collapsed;
// all -1 = not type-2). A map passes iff embeds are distinct AND of2 spreads.
//
// Stdout layout (36 ints), four 9-line blocks (mode0, mode1, mode2, baseline):
//   e0 e1 e2 e3 e4            -- the 5 embedded xcoords
//   of2(e0,e1) of2(e0,e2) of2(e0,e3) of2(e0,e4)   -- classes at Hamming 1/3/6/12

