place Entry {
  fun main(): Number visits Output {
    be cw := VoyagerList.seal(1445)
    be _1 := Output.print(String.from_int(VoyagerList.open(VoyagerList.corrupt(cw, 1))))
    be _2 := Output.print(String.from_int(VoyagerList.open(VoyagerList.corrupt(cw, 2))))
    be _3 := Output.print(String.from_int(VoyagerList.open(VoyagerList.corrupt(cw, 3))))
    be _4 := Output.print(String.from_int(VoyagerList.open(VoyagerList.corrupt(cw, 4))))
    be _5 := Output.print(String.from_int(VoyagerList.open(VoyagerList.corrupt(cw, 5))))
    be _6 := Output.print(String.from_int(VoyagerList.open(VoyagerList.corrupt(cw, 6))))

    be mut := VoyagerList.open(VoyagerList.corrupt(cw, 6))

    be l0 := VoyagerList.empty()
    be l1 := VoyagerList.append(l0, 1445)
    be l2 := VoyagerList.append(l1, 1445)
    be l3 := VoyagerList.append(l2, mut)
    be l4 := VoyagerList.append(l3, 100)
    be l5 := VoyagerList.append(l4, 200)
    be _sz := Output.print(String.from_int(VoyagerList.size(l5)))

    be _o1 := Output.print(String.from_int(Leech.m24_orbit(Leech.embed(1445, 3))))
    be _o2 := Output.print(String.from_int(Leech.m24_orbit(Leech.embed(mut, 3))))
    be _o3 := Output.print(String.from_int(Leech.m24_orbit(Leech.embed(100, 3))))
    be _o4 := Output.print(String.from_int(Leech.m24_orbit(Leech.embed(200, 3))))
    return 0
  }
}

// 2.3 — the mutation, and the three notions of count.
//
// THE MUTATION (the bridge from 2.2): Golay (24,12,8) corrects up to 3 flipped
// bits. PAST the radius it does not error -- it decodes SILENTLY to a different
// valid gene. That is the mutation: the correction that should have kept the gene
// pure instead births a new one, in silence. ("life finds a way", made precise.)
// We seal gene 1445 and open it back through k = 1..6 flipped bits, to SEE the
// edge: where Golay stops correcting (-> 1445) and starts mutating (-> != 1445).
//
// THE THREE COUNTS (identity vs class, one spine): a population of five appends
//   [1445, 1445(dup), the mutant, 100, 200]
//   * VoyagerList.size = EVENTS (every append, no dedup)
//   * distinct exact genes = INDIVIDUALS (XSet would dedup by exact point)
//   * distinct orbits      = CLASSES    (XRelSet would dedup by orbit -> the COLLAPSE)
// The orbits below (linear embed, mode 3) let the harness derive individuals vs
// classes. The mutant is a new INDIVIDUAL (List/XSet see it); whether its orbit
// collides (XRelSet blind) is what the numbers show.
//
// Stdout (13 ints):
//  [1-6]  open(corrupt(seal(1445), k)) for k=1..6   (1445 = corrected; else = mutation)
//  [7]    VoyagerList.size of the 5-append population (events = 5)
//  [8-11] m24_orbit(embed(g,3)) for g in [1445, mutant(k=6), 100, 200]  (the classes)

