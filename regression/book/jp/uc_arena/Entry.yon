place Entry {
  fun main(): Number visits Output {
    be a holds Arena.empty()
    a = Arena.put(a, 1536, 42)
    a = Arena.put(a, 1280, 7)
    be _1 holds Output.print(String.from_int(Arena.get(a, 1536)))
    be _2 holds Output.print(String.from_int(Arena.occupied(a, 1536)))
    be _3 holds Output.print(String.from_int(Arena.orbit(a, 1536)))
    be _4 holds Output.print(String.from_int(Arena.same_orbit(a, 1536, 1280)))
    be _5 holds Output.print(String.from_int(Arena.same_orbit(a, 1536, 16778752)))
    a = Arena.fuse(a, 1536, 99, 7)
    be _6 holds Output.print(String.from_int(Arena.fusion_count(a, 1536)))
    return 0
  }
}

// USE CASE — the ARENA: store specimens at lattice addresses, know their kind,
// record a CERTIFIED fusion of two lineages. 1536, 1280 are type-2 points;
// 1536 ~ 1280 share an M24 orbit, 16778752 (=-1536) does not (cf. arena_basic).
// Stdout: [1] get(1536)=42, [2] occupied(1536)=1, [3] orbit(1536),
//   [4] same_orbit(1536,1280)=1 (same kind), [5] same_orbit(1536,16778752)=0,
//   [6] fusion_count after one fuse = 1.

