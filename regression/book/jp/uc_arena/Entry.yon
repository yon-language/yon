place Entry {
  fun orbit_at(n: Number): Number {
    return match LatticePoint.of_coordinate(n) {
      LatticePoint as q => LatticePoint.orbit(q), DomainError as d => 0 - 1 }
  }
  fun display(p: LatticePoint, q: LatticePoint): Number visits Output {
    be a := Arena.empty()
    a = Arena.put(a, p, 42)
    a = Arena.put(a, q, 7)
    be _1 := Output.print(String.from_int(match Arena.get(a, p) { Found(v) => v, Absent => 0 }))
    be _2 := Output.print(String.from_int(if Arena.occupied(a, p) then 1 else 0))
    be _3 := Output.print(String.from_int(LatticePoint.orbit(p)))
    be _4 := Output.print(String.from_int(if LatticePoint.orbit(p) == LatticePoint.orbit(q) then 1 else 0))
    be _5 := Output.print(String.from_int(if LatticePoint.orbit(p) == orbit_at(16778752) then 1 else 0))
    a = Arena.fuse(a, p, 99, 7)
    be _6 := Output.print(String.from_int(Arena.fusion_count(a, p)))
    return 0
  }
  fun main(): Number visits Output {
    return match LatticePoint.of_coordinate(1536) {
      LatticePoint as p => (match LatticePoint.of_coordinate(1280) {
        LatticePoint as q => display(p, q), DomainError as d => 1 }),
      DomainError as d => 1 }
  }
}

// USE CASE — the ARENA: store specimens at lattice addresses, know their kind,
// record a CERTIFIED fusion of two lineages. 1536, 1280 are type-2 points
// (LatticePoint.of_coordinate makes them points);
// 1536 ~ 1280 share an M24 orbit, 16778752 (=-1536) does not (cf. arena_basic).
// Stdout: [1] get(1536)=42, [2] occupied(1536)=1, [3] orbit(1536),
//   [4] orbit(1536) == orbit(1280) = 1 (same kind), [5] orbit(1536) == orbit(16778752) = 0,
//   [6] fusion_count after one fuse = 1.

