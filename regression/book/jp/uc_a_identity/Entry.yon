place Entry {
  fun main(): Number visits Output {
    mut h := HashSet.empty()
    h <- HashSet.add(h, 1445)
    h <- HashSet.add(h, 1445)
    h <- HashSet.add(h, 2361)
    h <- HashSet.add(h, 100)
    h <- HashSet.add(h, 200)
    _1 := Output.print(String.from_int(HashSet.size(h)))

    mut x := XSet.empty()
    x <- XSet.add(x, Leech.embed(1445, 0))
    x <- XSet.add(x, Leech.embed(1445, 0))
    x <- XSet.add(x, Leech.embed(2361, 0))
    x <- XSet.add(x, Leech.embed(100, 0))
    x <- XSet.add(x, Leech.embed(200, 0))
    _2 := Output.print(String.from_int(XSet.size(x)))
    return 0
  }
}

// USE CASE A — "is this exact dinosaur already here?" (identity / dedup).
// Inventory receives 5 genomes: [1445, 1445(dup), 2361, 100, 200] -> 4 distinct.
//   FNV (HashSet): exact dedup of raw values, any type -> 4.
//   Leech (XSet): genomes must be MAPPED to type-2 (embed mode 0), which collapses
//   same-popcount values -> fewer than 4. FNV is the exact content-address here.
// Stdout: [1] HashSet.size (expect 4), [2] XSet.size (<= 4, the collapse).

