place Entry {
  fun main(): Number visits Output {
    be w0 holds XTower.width(0)
    be w1 holds XTower.width(1)
    be w2 holds XTower.width(2)
    be w3 holds XTower.width(3)
    be dep holds XTower.depth()
    be c0 holds XTower.class(1536, 0)
    be c2 holds XTower.class(1536, 2)
    be sb_same holds XTower.same_branch(1536, 1280, 2)
    be sb_diff holds XTower.same_branch(1536, 16778752, 2)

    be _0 holds Output.print(String.from_int(w0))
    be _1 holds Output.print(String.from_int(w1))
    be _2 holds Output.print(String.from_int(w2))
    be _3 holds Output.print(String.from_int(w3))
    be _4 holds Output.print(String.from_int(dep))
    be _5 holds Output.print(String.from_int(c0))
    be _6 holds Output.print(String.from_int(c2))
    be _7 holds Output.print(String.from_int(sb_same))
    be _8 holds Output.print(String.from_int(sb_diff))

    be f0 holds if w0 == 1 then 0 else 1
    be f1 holds if w1 == 3 then 0 else 1
    be f2 holds if w2 == 12 then 0 else 1
    be f3 holds if w3 == 196560 then 0 else 1
    be f4 holds if dep == 4 then 0 else 1
    be f5 holds if c0 == 0 then 0 else 1
    be f6 holds if sb_same == 1 then 0 else 1
    be f7 holds if sb_diff == 0 then 0 else 1
    return f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7
  }
}

// XTower surface-exposure functional gate. Returns 0 (exit 0) iff every check
// holds; the process exit code IS the number of failed checks.
//
// XTower is the nested stabilizer tower Co0 superset N superset M24 superset id.
// Asserted (build-stable facts):
//   width(0..3) = 1 / 3 / 12 / 196560   -- the tower's level widths (theorems)
//   depth()     = 4                      -- YON_XTOWER_DEPTH
//   class(1536, 0) = 0                   -- level 0 is the single root class
//   same_branch(1536, 1280, 2)     = 1   -- same M24 orbit (cf. examples/arena_basic.yon)
//   same_branch(1536, 16778752, 2) = 0   -- different orbit (16778752 = -1536)
// Printed but NOT asserted: class(1536, 2) -- the level-2 M24 LABEL is not
// build-canonical (the orbit-id table is assigned per build), so we pin the
// PARTITION (same_branch) and validity, never a specific label value.
//
// Stdout (one int per line): width0,width1,width2,width3, depth, class0, class2,
// same_branch(same), same_branch(diff). Exit code: number of failed checks (0 = all pass).

