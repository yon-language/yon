place Entry {
  fun main(): Number visits Output {
    w0 := XTower.width(0)
    w1 := XTower.width(1)
    w2 := XTower.width(2)
    w3 := XTower.width(3)
    dp := XTower.depth()
    s0 := XTower.same_branch(1536, 1536, 0)
    s1 := XTower.same_branch(1536, 1536, 1)
    s2 := XTower.same_branch(1536, 1536, 2)
    s3 := XTower.same_branch(1536, 1536, 3)
    d0 := XTower.same_branch(1536, 1280, 0)
    d1 := XTower.same_branch(1536, 1280, 1)
    d2 := XTower.same_branch(1536, 1280, 2)
    d3 := XTower.same_branch(1536, 1280, 3)
    c0 := XTower.class(1536, 0)

    _1 := Output.print(String.from_int(w0))
    _2 := Output.print(String.from_int(w1))
    _3 := Output.print(String.from_int(w2))
    _4 := Output.print(String.from_int(w3))
    _5 := Output.print(String.from_int(dp))
    _6 := Output.print(String.from_int(s0))
    _7 := Output.print(String.from_int(s1))
    _8 := Output.print(String.from_int(s2))
    _9 := Output.print(String.from_int(s3))
    _10 := Output.print(String.from_int(d0))
    _11 := Output.print(String.from_int(d1))
    _12 := Output.print(String.from_int(d2))
    _13 := Output.print(String.from_int(d3))
    _14 := Output.print(String.from_int(c0))

    f := (if w0 == 1 then 0 else 1)
             + (if w1 == 3 then 0 else 1)
             + (if w2 == 12 then 0 else 1)
             + (if w3 == 196560 then 0 else 1)
             + (if dp == 4 then 0 else 1)
             + (if s0 == 1 then 0 else 1)
             + (if s1 == 1 then 0 else 1)
             + (if s2 == 1 then 0 else 1)
             + (if s3 == 1 then 0 else 1)
             + (if d0 == 1 then 0 else 1)
             + (if d1 == 1 then 0 else 1)
             + (if d2 == 1 then 0 else 1)
             + (if d3 == 0 then 0 else 1)
             + (if c0 == 0 then 0 else 1)
    return f
  }
}

// XTower functional contract — SELF-CHECKING. Return = number of failed checks;
// exit 0 means the contract holds. XTower is a TRUE refinement Co0 superset N
// superset M24 superset id, so same_branch is MONOTONE non-increasing as the level
// rises. Gated values (regression run): widths 1/3/12/196560, depth 4; self =
// 1,1,1,1; (1536,1280) dial = 1,1,1,0 (same M24 family, split only at id);
// class(1536,0) = 0.
//
// Stdout (the 14 observed values); exit code = failures.

