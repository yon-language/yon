place Entry {
  fun cls(f: XRelFrame, p: LatticePoint): LatticePoint { return XRelFrame.canon(f, p) }
  fun contract(p: LatticePoint, q: LatticePoint, m: LatticePoint): Number visits Output {
    // the frame by 1536: a class is the type against 1536
    f := XRelFrame.refine(XRelFrame.whole(), p)

    // XRelSet — dedup by class: the set holds canon(f, x)
    mut r := XRelSet.empty()
    r <- XRelSet.add(r, cls(f, p))
    r <- XRelSet.add(r, cls(f, p))
    v1 := XRelSet.size(r)                 // a class, deduped -> 1
    r <- XRelSet.add(r, cls(f, q))
    v2 := XRelSet.size(r)                 // 1280 is a different class -> 2
    r <- XRelSet.add(r, cls(f, m))
    v3 := XRelSet.size(r)                 // 16778752 is 1536's class -> still 2

    // XRelMap — key = class, not specimen: the map is keyed by canon(f, x)
    mm := XRelMap.set(XRelMap.empty(), cls(f, p), 100)
    v4 := match XRelMap.get(mm, cls(f, p)) { Found(v) => v, Absent => 0 }   // exact point -> 100
    v5 := match XRelMap.get(mm, cls(f, q)) { Found(v) => v, Absent => 0 }   // different class -> Absent (0)
    v6 := match XRelMap.get(mm, cls(f, m)) { Found(v) => v, Absent => 0 }   // same class (antipode) -> 100

    // XSimplex — classify relations
    v7 := XSimplex.of2(1536, 1280)
    v8 := XSimplex.of2(1280, 1536)        // symmetric -> v8 == v7
    v9 := XSimplex.omega(1536, 1280, 16778752)   // -1/0/+1
    mut acc := XSimplex.empty()
    acc <- XSimplex.add(acc, 1536, 1280)
    acc <- XSimplex.add(acc, 1280, 16778752)
    v10 := XSimplex.size(acc)             // 2 edges
    v11 := XSimplex.dominant(acc)

    _1 := Output.print(String.from_int(v1))
    _2 := Output.print(String.from_int(v2))
    _3 := Output.print(String.from_int(v3))
    _4 := Output.print(String.from_int(v4))
    _5 := Output.print(String.from_int(v5))
    _6 := Output.print(String.from_int(v6))
    _7 := Output.print(String.from_int(v7))
    _8 := Output.print(String.from_int(v8))
    _9 := Output.print(String.from_int(v9))
    _10 := Output.print(String.from_int(v10))
    _11 := Output.print(String.from_int(v11))

    fails := (if v1 == 1 then 0 else 1)
             + (if v2 == 2 then 0 else 1)
             + (if v3 == 2 then 0 else 1)
             + (if v4 == 100 then 0 else 1)
             + (if v5 == 100 then 1 else 0)        // FAIL if a different class hit
             + (if v6 == 100 then 0 else 1)
             + (if v7 == v8 then 0 else 1)          // of2 symmetric
             + (if v9 == 1 then 0 else 1)
             + (if v10 == 2 then 0 else 1)
    return fails
  }
  fun main(): Number visits Output {
    return match LatticePoint.of_coordinate(1536) {
      LatticePoint as p => (match LatticePoint.of_coordinate(1280) {
        LatticePoint as q => (match LatticePoint.of_coordinate(16778752) {
          LatticePoint as m => contract(p, q, m), DomainError as d => 99 }),
        DomainError as d => 99 }),
      DomainError as d => 99 }
  }
}

// XRelSet / XRelMap / XSimplex functional contracts — SELF-CHECKING. Return =
// number of failed checks; exit 0 means all three contracts hold. The points
// 1536, 1280, 16778752 (=-1536). XRelSet and XRelMap hold classes of the frame
// refined from whole by 1536 (XRelFrame.canon): a frame made from references
// never parts a point from its negative, so 1536 ~ 16778752, and 1280 lies in
// another class. XSimplex still takes raw coordinates. Gated values
// (regression run): 1, 2, 2, 100, 0, 100, 1, 1, 1, 2, 1.
//
// Stdout (the 11 observed values); exit code = failures.

