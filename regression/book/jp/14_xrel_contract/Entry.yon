place Entry {
  fun main(): Number visits Output {
    // XRelSet — dedup by orbit class
    be r := XRelSet.empty()
    be _r0 := XRelSet.add_ref(r, 1536)
    r = XRelSet.add(r, 1536)
    r = XRelSet.add(r, 1536)
    be v1 := XRelSet.size(r)                 // a class, deduped -> 1
    r = XRelSet.add(r, 1280)
    be v2 := XRelSet.size(r)                 // 1280 is a different class -> 2
    r = XRelSet.add(r, 16778752)
    be v3 := XRelSet.size(r)                 // 16778752 is 1536's class -> still 2

    // XRelMap — key = class, not specimen
    be m := XRelMap.empty()
    be _m0 := XRelMap.add_ref(m, 1536)
    m = XRelMap.insert(m, 1536, 100)
    be v4 := match XRelMap.get(m, 1536) { Found(v) => v, Absent => 0 }      // exact point -> 100
    be v5 := match XRelMap.get(m, 1280) { Found(v) => v, Absent => 0 }      // different class -> Absent (0)
    be v6 := match XRelMap.get(m, 16778752) { Found(v) => v, Absent => 0 }  // same class (antipode) -> 100

    // XSimplex — classify relations
    be v7 := XSimplex.of2(1536, 1280)
    be v8 := XSimplex.of2(1280, 1536)        // symmetric -> v8 == v7
    be v9 := XSimplex.omega(1536, 1280, 16778752)   // -1/0/+1
    be acc := XSimplex.empty()
    acc = XSimplex.add(acc, 1536, 1280)
    acc = XSimplex.add(acc, 1280, 16778752)
    be v10 := XSimplex.size(acc)             // 2 edges
    be v11 := XSimplex.dominant(acc)

    be _1 := Output.print(String.from_int(v1))
    be _2 := Output.print(String.from_int(v2))
    be _3 := Output.print(String.from_int(v3))
    be _4 := Output.print(String.from_int(v4))
    be _5 := Output.print(String.from_int(v5))
    be _6 := Output.print(String.from_int(v6))
    be _7 := Output.print(String.from_int(v7))
    be _8 := Output.print(String.from_int(v8))
    be _9 := Output.print(String.from_int(v9))
    be _10 := Output.print(String.from_int(v10))
    be _11 := Output.print(String.from_int(v11))

    be f := (if v1 == 1 then 0 else 1)
             + (if v2 == 2 then 0 else 1)
             + (if v3 == 2 then 0 else 1)
             + (if v4 == 100 then 0 else 1)
             + (if v5 == 100 then 1 else 0)        // FAIL if a different class hit
             + (if v6 == 100 then 0 else 1)
             + (if v7 == v8 then 0 else 1)          // of2 symmetric
             + (if v9 == 1 then 0 else 1)
             + (if v10 == 2 then 0 else 1)
    return f
  }
}

// XRelSet / XRelMap / XSimplex functional contracts — SELF-CHECKING. Return =
// number of failed checks; exit 0 means all three contracts hold. Raw type-2
// points 1536, 1280, 16778752 (=-1536). The class equivalence is the sign-orbit
// (Leech.same_orbit): 1536 ~ 16778752, 1536 not~ 1280. Gated values (regression
// run): 1, 2, 2, 100, 0, 100, 1, 1, 1, 2, 1.
//
// Stdout (the 11 observed values); exit code = failures.

