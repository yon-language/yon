place Entry { }
// §8b The clade reader — a CONSTRUCTED meaning on the lattice. Encode each dinosaur
// as a trait bitvector (bit 0 bipedal, 1 feathered, 2 carnivore, 3 crested,
// 4 armored) and place it with the LINEAR gcode embed (Leech.embed mode 3).
// Leech.pair_subtype then reads the Golay subtype-CLASS of the distinguishing
// characters (the symmetric difference a^b, the synapomorphy set): a genuine
// function of which-traits-differ, coarser than the exact set. It separates "same
// clade" (0) from "distinct" (nonzero) and resolves many character-differences,
// though two distinct synapomorphy sets can land in the same class.
//
//   R  = {bipedal}                      = 1
//   V  = {bipedal,feathered,carnivore}  = 7    Deinonychus D = 7 (same clade)
//   S  = {crested}                      = 8    SV = S + {feathered,carnivore} = 14
//   X  = R + {feathered,armored}        = 19
//   R^V = 6 = {feathered,carnivore};  S^SV = 6  -> same synapomorphy => same class.
//   R^X = 18 = {feathered,armored}              -> a different class.
//
// SELF-CHECKING. Return = number of failed laws; exit 0 = the construction holds.
// Stdout: sVD, sRV, sSSV, sRX  (the four observed subtype classes).
fun main(): number visits Output {
  be R  holds Leech.embed(1, 3)
  be V  holds Leech.embed(7, 3)
  be D  holds Leech.embed(7, 3)
  be S  holds Leech.embed(8, 3)
  be SV holds Leech.embed(14, 3)
  be X  holds Leech.embed(19, 3)

  be sVD  holds Leech.pair_subtype(V, D)    // identical clade -> 0 distinguishing traits
  be sRV  holds Leech.pair_subtype(R, V)    // distinguished by {feathered,carnivore}
  be sSSV holds Leech.pair_subtype(S, SV)   // also {feathered,carnivore}
  be sRX  holds Leech.pair_subtype(R, X)    // distinguished by {feathered,armored}

  be _1 holds Output.print(String.from_int(sVD))
  be _2 holds Output.print(String.from_int(sRV))
  be _3 holds Output.print(String.from_int(sSSV))
  be _4 holds Output.print(String.from_int(sRX))

  be f holds (if sVD == 0 then 0 else 1)      // identical trait-set -> nothing distinguishes them
           + (if sRV == sSSV then 0 else 1)    // same synapomorphy set -> same class (function of a^b)
           + (if sRV == 0 then 1 else 0)       // genuinely distinct animals -> nonzero
           + (if sRV == sRX then 1 else 0)     // a different synapomorphy -> a different class (it resolves)
  return f
}
