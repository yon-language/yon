// Wire throughput bench, PRODUCER. Pushes N messages onto a shared-memory wire (channel
// 9), then closes it. Bare `fun main` (no place): the cross-Space wire scenarios run in
// this form. Paired with dash.yon, which times receiving the N messages. Requires IPC/SHM.
fun main(): Number {
  w := Wire.make_shm(9, 1)
  mut k := 0
  while k < 200000 do {
    _s := Wire.produce_shm(w, k)
    k <- k + 1
  }
  _z := Wire.close_shm(w)
  return 0
}
