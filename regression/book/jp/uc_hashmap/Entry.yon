place Entry {
  fun main(): Number visits Output {
    be m holds HashMap.empty()
    m = HashMap.set(m, 1445, 1)
    m = HashMap.set(m, 1280, 2)
    be _1 holds Output.print(String.from_int(HashMap.get(m, 1445)))
    be _2 holds Output.print(String.from_int(if HashMap.has(m, 9999) then 1 else 0))
    be _3 holds Output.print(String.from_int(HashMap.size(m)))
    return 0
  }
}
// §1b HashMap (FNV) — "tag each genome with a species id, any key type, O(1)".
// Stdout: [1] get(1445)=1, [2] has(9999)=0 (absent), [3] size=2.
