place Entry {
  fun main(): Number visits Output {
    o := Leech.embed(1445, 0)
    m := Leech.embed(2361, 0)
    t := Leech.embed(100, 0)

    _0 := Output.print(String.from_int(XTower.same_branch(o, m, 0)))
    _1 := Output.print(String.from_int(XTower.same_branch(o, m, 1)))
    _2 := Output.print(String.from_int(XTower.same_branch(o, m, 2)))
    _3 := Output.print(String.from_int(XTower.same_branch(o, m, 3)))

    _4 := Output.print(String.from_int(XTower.same_branch(o, t, 0)))
    _5 := Output.print(String.from_int(XTower.same_branch(o, t, 1)))
    _6 := Output.print(String.from_int(XTower.same_branch(o, t, 2)))
    _7 := Output.print(String.from_int(XTower.same_branch(o, t, 3)))

    _8  := Output.print(String.from_int(XTower.class(o, 0)))
    _9  := Output.print(String.from_int(XTower.class(o, 1)))
    _10 := Output.print(String.from_int(XTower.class(o, 2)))
    _11 := Output.print(String.from_int(XTower.class(o, 3)))

    _12 := Output.print(String.from_int(XTower.width(0)))
    _13 := Output.print(String.from_int(XTower.width(1)))
    _14 := Output.print(String.from_int(XTower.width(2)))
    _15 := Output.print(String.from_int(XTower.width(3)))
    return 0
  }
}

// XTower = the DIAL of equality. same_branch(a, b, level) asks "are a and b the
// same?" at a grain you turn: level 0 = Co0 (all one), level 2 = M24 (XRelSet's
// classes), level 3 = id (XSet's individuals, the exact MPHF index). The collapse
// is MONOTONE up the tower (M24 subset N subset Co0), so turning toward Co0 only
// ever loses individuals, never gains. Hammond's blind spot is fixing the dial at
// Co0 and never turning it; the exact count was always there at id.
//
// Three content-addressed genes (embed mode 0 = the heap's map):
//   orig = 1445   mutant = 2361 (the k=5 silent Golay mutation)   other = 100
//
// Stdout (16 ints):
//  [1-4]   same_branch(orig, mutant, level)  level 0,1,2,3   -- does the dial reveal the mutant?
//  [5-8]   same_branch(orig, other,  level)  level 0,1,2,3
//  [9-12]  xtower_class(orig, level)         level 0,1,2,3   -- orig's class at each grain
//  [13-16] xtower_width(level)               level 0,1,2,3   -- 1 / 3 / 12 / 196560 (the dial's range)

