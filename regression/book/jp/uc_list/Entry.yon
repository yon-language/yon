place Entry {
  fun first(l: List<Number>): Number { return match List.head(l) { Found as v => v, Absent => 0 } }
  fun rest(l: List<Number>): List<Number> { return match List.tail(l) { Found as t => t, Absent => l } }
  fun main(): Number visits Output {
    mut l := List.empty
    l <- List.cons(1207, l)
    l <- List.cons(1280, l)
    l <- List.cons(1445, l)
    _1 := Output.print(Text.from_int(List.length(l)))
    _2 := Output.print(Text.from_int(first(l)))
    _3 := Output.print(Text.from_int(first(rest(l))))
    _4 := Output.print(Text.from_int(first(List.reverse(l))))
    _5 := Output.print(Text.from_int(List.length(rest(l))))
    return 0
  }
}
// §3b List — "the descent chain". A functional cons-list: cons prepends the newest
// generation, head = newest, tail = the ancestors, length = generations, reverse =
// oldest-first. Stdout: [1] length=3, [2] head=1445 (newest hatchling),
// [3] head(tail)=1280 (its parent), [4] head(reverse)=1207 (the founder),
// [5] length(tail)=2 (the ancestry behind the newest).
