place Entry {
  fun main(): Number visits Output {
    mut v := Vec.empty()
    v <- Vec.push(v, 1445)
    v <- Vec.push(v, 1280)
    v <- Vec.push(v, 1445)
    _1 := Output.print(String.from_int(Vec.size(v)))
    _2 := Output.print(String.from_int(Vec.get(v, 0)))
    v <- Vec.set(v, 1, 9999)
    _3 := Output.print(String.from_int(Vec.get(v, 1)))
    return 0
  }
}
// §4 Vec — "count the individuals, indexed". push keeps every entry (events, no dedup);
// get/set are O(1) indexed. Stdout: [1] size=3 (1445,1280,1445 dup kept), [2] get(0)=1445,
// [3] after set(1,9999): get(1)=9999.
