place Entry {
  fun main(): Number visits Output {
    kn      := XTower.width(3)
    m24n    := XTower.width(2)
    cls     := Leech.m24_orbit(1536)
    a := Leech.embed(100247, 0)
    b := Leech.embed(100247, 0)
    c := Leech.embed(555, 0)
    set0 := XSet.empty()
    set1 := XSet.add(set0, a)
    set2 := XSet.add(set1, b)
    set3 := XSet.add(set2, c)
    _1 := Output.print(String.from_int(kn))
    _2 := Output.print(String.from_int(m24n))
    _3 := Output.print(String.from_int(cls))
    _4 := Output.print(String.from_int(XSet.size(set3)))
    return 0
  }
}
// §2.1 The Leech lattice — the SECOND content-addressing engine. The address space is
// a FIXED finite set: exactly 196,560 type-2 points — the kissing number in 24
// dimensions, a theorem the build re-derives (test_leech_theta.ml). They fall into 12
// M24 symmetry classes. Each point gets a PERFECT 18-bit address: the MPHF, a bijection
// to [0,196560), zero collisions, no byte-compare ever (test_mphf.c). Two genomes that
// land on the same point share one address; distinct points are distinct addresses.
// Stdout: [1] 196560 (the whole space), [2] 12 (M24 classes), [3] a point's class in
// 0..11, [4] 2 (two distinct genomes -> two distinct perfect addresses, the dup gone).
