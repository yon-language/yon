place Entry {
  fun main(): Number visits Output {
    p0 := 1536
    p1 := 1280
    p2 := Leech.xi_apply(1536)
    p3 := Leech.xi_apply(1280)
    p4 := Leech.co0_step(1536)
    p5 := Leech.transport_apply(1536, 1280)
    p6 := Leech.sign_canonical(1536, 1365)

    _0 := Output.print(String.from_int(Leech.m24_orbit(p0)))
    _1 := Output.print(String.from_int(Leech.m24_orbit(p1)))
    _2 := Output.print(String.from_int(Leech.m24_orbit(p2)))
    _3 := Output.print(String.from_int(Leech.m24_orbit(p3)))
    _4 := Output.print(String.from_int(Leech.m24_orbit(p4)))
    _5 := Output.print(String.from_int(Leech.m24_orbit(p5)))
    _6 := Output.print(String.from_int(Leech.m24_orbit(p6)))

    _7  := Output.print(String.from_int(XSimplex.of2(p0, p1)))
    _8  := Output.print(String.from_int(XSimplex.of2(p0, p2)))
    _9  := Output.print(String.from_int(XSimplex.of2(p0, p3)))
    _10 := Output.print(String.from_int(XSimplex.of2(p0, p4)))
    _11 := Output.print(String.from_int(XSimplex.of2(p0, p5)))
    _12 := Output.print(String.from_int(XSimplex.of2(p0, p6)))

    _13 := Output.print(String.from_int(XSimplex.of2(p1, p2)))
    _14 := Output.print(String.from_int(XSimplex.of2(p2, p4)))
    _15 := Output.print(String.from_int(XSimplex.of2(p4, p5)))
    _16 := Output.print(String.from_int(XSimplex.of2(p3, p6)))
    _17 := Output.print(String.from_int(XSimplex.of2(p2, p3)))
    return 0
  }
}

// DISCOVERY probe (not a book asset): find genuinely distinct type-2 points that
// spread across several of2 relation-classes, so the dino set isn't {antipode,
// same-class}. Each generator below is known to return a type-2 xcoord; we filter
// validity by m24_orbit (196560 = not type-2) and read the class spread.
//
// Candidates (p0 = anchor 1536):
//   p0 = 1536
//   p1 = 1280
//   p2 = xi(1536)
//   p3 = xi(1280)
//   p4 = co0_step(1536)
//   p5 = transport_apply(1536, 1280)
//   p6 = sign_canonical(1536, 1365)     // 1365 = 0x555
//
// Output order (one integer per line):
//   orbit p0..p6                                   (7 lines: 196560 = invalid)
//   of2(p0,p1), of2(p0,p2), of2(p0,p3),
//   of2(p0,p4), of2(p0,p5), of2(p0,p6)             (6 lines: class spread from anchor)
//   of2(p1,p2), of2(p2,p4), of2(p4,p5), of2(p3,p6) (4 lines: cross-pairs)
//   of2(p2,p3)                                     (1 line: xi-invariance check vs of2(p0,p1))

