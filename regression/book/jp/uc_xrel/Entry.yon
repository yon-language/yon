place Entry {
  fun orbit_at(n: Number): Number {
    return match LatticePoint.of_coordinate(n) {
      LatticePoint as q => LatticePoint.orbit(q), DomainError as d => 0 - 1 }
  }
  fun display(p: LatticePoint, q: LatticePoint): Number visits Output {
    mut a := XRelMap.empty()
    a <- XRelMap.set(a, p, 42)
    a <- XRelMap.set(a, q, 7)
    _1 := Output.print(String.from_int(match XRelMap.get(a, p) { Found(v) => v, Absent => 0 }))
    _2 := Output.print(String.from_int(if XRelMap.has(a, p) then 1 else 0))
    _3 := Output.print(String.from_int(LatticePoint.orbit(p)))
    _4 := Output.print(String.from_int(if LatticePoint.orbit(p) == LatticePoint.orbit(q) then 1 else 0))
    _5 := Output.print(String.from_int(if LatticePoint.orbit(p) == orbit_at(16778752) then 1 else 0))
    return 0
  }
  fun main(): Number visits Output {
    return match LatticePoint.of_coordinate(1536) {
      LatticePoint as p => (match LatticePoint.of_coordinate(1280) {
        LatticePoint as q => display(p, q), DomainError as d => 1 }),
      DomainError as d => 1 }
  }
}

// USE CASE — specimens at lattice addresses, and their kind: an XRelMap keyed
// by LatticePoint, its nodes in the Leech heap. 1536, 1280 are type-2 points
// (LatticePoint.of_coordinate makes them points); 1536 ~ 1280 share an M24
// orbit, 16778752 (=-1536) does not (cf. examples/xrel_points).
// Stdout: [1] get(1536)=42, [2] has(1536)=1, [3] orbit(1536),
//   [4] orbit(1536) == orbit(1280) = 1 (same kind), [5] orbit(1536) == orbit(16778752) = 0.
