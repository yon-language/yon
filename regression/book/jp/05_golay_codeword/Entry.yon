place Entry {
  fun main(): Number visits Output {
    be data holds 1445
    be cw   holds VoyagerList.seal(data)        // the 24-bit Golay codeword
    be bad  holds VoyagerList.corrupt(cw, 2)    // 2 bits flipped
    be readback holds VoyagerList.open(bad)         // decoded readback
    be _1 holds Output.print(String.from_int(data))
    be _2 holds Output.print(String.from_int(cw))
    be _3 holds Output.print(String.from_int(bad))
    be _4 holds Output.print(String.from_int(readback))
    return 0
  }
}

// Exposes the raw Golay codeword (the new surface builtins VoyagerList.seal/open/corrupt).
// Prints, in order:  data  codeword  corrupted-codeword  recovered
// Expected:          1445  <cw>      <cw with 2 bits flipped>  1445
// The viz reads cw and bad to render the 24 real bits and the 2 real flips, then the decode.
