place Entry {
  fun main(): Number visits Output {
    data := 1445
    cw   := VoyagerList.seal(data)        // the 24-bit Golay codeword
    bad  := VoyagerList.corrupt(cw, 2)    // 2 bits flipped
    readback := VoyagerList.open(bad)         // decoded readback
    _1 := Output.print(String.from_int(data))
    _2 := Output.print(String.from_int(cw))
    _3 := Output.print(String.from_int(bad))
    _4 := Output.print(String.from_int(readback))
    return 0
  }
}

// Exposes the raw Golay codeword (the new surface builtins VoyagerList.seal/open/corrupt).
// Prints, in order:  data  codeword  corrupted-codeword  recovered
// Expected:          1445  <cw>      <cw with 2 bits flipped>  1445
// The viz reads cw and bad to render the 24 real bits and the 2 real flips, then the decode.
