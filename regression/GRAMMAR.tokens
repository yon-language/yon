# Definitions (`let` regular expressions)
DEFINITION	digit	['0'-'9']
DEFINITION	alpha	['a'-'z' 'A'-'Z' '_']
DEFINITION	alnum	alpha | digit
DEFINITION	ident_start	['a'-'z' '_']
DEFINITION	upper_start	['A'-'Z']
DEFINITION	alnum_id	['a'-'z' 'A'-'Z' '0'-'9' '_']
DEFINITION	ws	[' ' '\t' '\r']

# Cases (rule <tab> pattern <tab> fields)
CASE	raw_token	ws+	does=skips the lexeme
CASE	raw_token	'\n'	reads=statement	writes=statement	does=counts a line | skips the lexeme
CASE	raw_token	"//" [^ '\n']*	does=skips the lexeme
CASE	raw_token	"/*"	does=reads on in the rule block_comment | skips the lexeme
CASE	raw_token	digit+ '.' digit+ as n	gives=NUM_LIT
CASE	raw_token	digit+ as n	gives=NUM_LIT	writes=Surface_ast.exact_int_literals (the text of an integer literal, by its site)
CASE	raw_token	'"'	gives=STR_LIT	does=reads on in the rule string_lit
CASE	raw_token	"<="	gives=LEQ
CASE	raw_token	"<-"	gives=LARROW
CASE	raw_token	">="	gives=GEQ
CASE	raw_token	"!="	gives=NEQ
CASE	raw_token	"=="	gives=EQEQ
CASE	raw_token	"&&?"	gives=AMPAMPQ
CASE	raw_token	"||?"	gives=PIPEPIPEQ
CASE	raw_token	"=>?"	gives=FATARROWQ
CASE	raw_token	"<=>"	gives=LRARROW
CASE	raw_token	"!?"	gives=BANGQ
CASE	raw_token	"&?"	gives=AMPQ
CASE	raw_token	"|?"	gives=PIPEQ
CASE	raw_token	"^?"	gives=CARETQ
CASE	raw_token	"~?"	gives=TILDEQ
CASE	raw_token	"&&"	gives=AMPAMP
CASE	raw_token	"||"	gives=PIPEPIPE
CASE	raw_token	"|->" | "↦"	gives=MAPSTO
CASE	raw_token	">->" | "↪"	gives=INJ
CASE	raw_token	"|>"	gives=PIPEGT
CASE	raw_token	"=>"	gives=FATARROW
CASE	raw_token	"on" [' ' '\t']+ "error"	gives=ON_ERROR
CASE	raw_token	".->"	gives=DOTARROW
CASE	raw_token	"->"	gives=ARROW
CASE	raw_token	'@'	gives=ATSIGN
CASE	raw_token	'['	gives=LBRACKET
CASE	raw_token	']'	gives=RBRACKET
CASE	raw_token	'!'	gives=BANG
CASE	raw_token	'&'	gives=AMP
CASE	raw_token	'^'	gives=CARET
CASE	raw_token	'~'	gives=TILDE
CASE	raw_token	"++"	gives=PLUSPLUS
CASE	raw_token	'+'	gives=PLUS
CASE	raw_token	'-'	gives=MINUS
CASE	raw_token	'*'	gives=STAR
CASE	raw_token	'/'	gives=SLASH
CASE	raw_token	'%'	gives=PERCENT
CASE	raw_token	'<' upper_start alnum_id* (',' ' '* upper_start alnum_id*)* '>' '('	gives=LT_TYPE_ARGS | LT	reads=the input ahead (it reads past the lexeme and gives the rest back) | the character before the lexeme
CASE	raw_token	'<'	gives=LT
CASE	raw_token	'>'	gives=GT
CASE	raw_token	'='	gives=EQEQ | EQ	reads=statement
CASE	raw_token	'|'	gives=PIPE
CASE	raw_token	'.'	gives=DOT
CASE	raw_token	','	gives=COMMA	reads=statement	writes=statement
CASE	raw_token	":U"	gives=COLON_U
CASE	raw_token	":="	gives=COLONEQ
CASE	raw_token	':'	gives=COLON
CASE	raw_token	'('	gives=LPAREN	reads=statement	writes=statement
CASE	raw_token	')'	gives=RPAREN	reads=statement	writes=statement
CASE	raw_token	'{'	gives=LBRACE
CASE	raw_token	'}'	gives=RBRACE
CASE	raw_token	"Type_" (digit+ as n)	gives=TYPE_LEVEL
CASE	raw_token	(alpha alnum_id* "::" alpha alnum_id* ("::" alpha alnum_id*)*) as s	gives=QIDENT
CASE	raw_token	(alpha alnum_id*) as s	gives=IDENT | a keyword of the table	reads=statement	writes=statement
CASE	raw_token	"Π"	gives=PI
CASE	raw_token	"Σ"	gives=SIGMA
CASE	raw_token	"∀"	gives=FORALL	writes=statement
CASE	raw_token	"∃"	gives=EXISTS	writes=statement
CASE	raw_token	"≠"	gives=NEQ
CASE	raw_token	"∧"	gives=AMPAMPQ
CASE	raw_token	"∨"	gives=PIPEPIPEQ
CASE	raw_token	"→"	gives=FATARROWQ
CASE	raw_token	"¬"	gives=BANGQ
CASE	raw_token	"↔"	gives=IFFQ
CASE	raw_token	"∈"	refuses=∈ is not a symbol of Yon: the type of a quantifier follows a colon, `∀x : T`
CASE	raw_token	eof	gives=EOF	writes=statement
CASE	raw_token	(['\xc2'-'\xdf'] ['\x80'-'\xbf'] | ['\xe0'-'\xef'] ['\x80'-'\xbf'] ['\x80'-'\xbf'] | ['\xf0'-'\xf4'] ['\x80'-'\xbf'] ['\x80'-'\xbf'] ['\x80'-'\xbf']) as u	refuses=unexpected character `%s` (U+%04X)
CASE	raw_token	_ as c	refuses=unexpected character %c | unexpected byte \x%02X
CASE	block_comment	"*/"
CASE	block_comment	'\n'	does=counts a line | goes on in block_comment
CASE	block_comment	eof	refuses=unterminated comment
CASE	block_comment	_	does=goes on in block_comment
CASE	string_lit	'"'	gives=STR_LIT	does=gives the text read so far
CASE	string_lit	'\\' '"'	does=goes on in string_lit
CASE	string_lit	'\\' '\\'	does=goes on in string_lit
CASE	string_lit	'\\' 'n'	does=goes on in string_lit
CASE	string_lit	'\\' 't'	does=goes on in string_lit
CASE	string_lit	'\n'	does=counts a line | goes on in string_lit
CASE	string_lit	eof	refuses=unterminated string
CASE	string_lit	_ as c	does=goes on in string_lit

# States (the refs of the lexer and of its wrapper, with their first value)
STATE	statement	Outside
STATE	token: owner	None
STATE	token: in_clause	false
STATE	token: type_follows	false
STATE	token: binder	None
STATE	token: type_body	false
STATE	token: previous	EOF
STATE	token: previous_previous	EOF
STATE	token: previous_line	0
STATE	token: held	[]
STATE	token: lexed_to	Lexing.dummy_pos

# Context: each case that can give more than one token, or reads or writes a state, by the
# name of its rule and its pattern, with its code; then the wrapper `token`, by function
CONTEXT	raw_token '\n'	reads=statement	writes=statement	does=counts a line | skips the lexeme	code=Lexing.new_line lexbuf; (if !statement = Line 0 then statement := Outside); raw_token lexbuf
CONTEXT	raw_token digit+ as n	gives=NUM_LIT	writes=Surface_ast.exact_int_literals (the text of an integer literal, by its site)	code=let p = Lexing.lexeme_start_p lexbuf in Hashtbl.replace Surface_ast.exact_int_literals (p.Lexing.pos_fname, p.Lexing.pos_lnum, p.Lexing.pos_cnum - p.Lexing.pos_bol) n; NUM_LIT (float_of_string n)
CONTEXT	raw_token '<' upper_start alnum_id* (',' ' '* upper_start alnum_id*)* '>' '('	gives=LT_TYPE_ARGS | LT	reads=the input ahead (it reads past the lexeme and gives the rest back) | the character before the lexeme	code=let n = Lexing.lexeme_end lexbuf - Lexing.lexeme_start lexbuf - 1 in lexbuf.Lexing.lex_curr_pos <- lexbuf.Lexing.lex_curr_pos - n; lexbuf.Lexing.lex_curr_p <- { lexbuf.Lexing.lex_curr_p with Lexing.pos_cnum = lexbuf.Lexing.lex_curr_p.Lexing.pos_cnum - n }; let at = lexbuf.Lexing.lex_start_pos in let after_a_name = at > 0 && (match Bytes.get lexbuf.Lexing.lex_buffer (at - 1) with | 'a' .. 'z' | 'A' .. 'Z' | '0' .. '9' | '_' -> true | _ -> false) in if after_a_name then LT_TYPE_ARGS else LT
CONTEXT	raw_token '='	gives=EQEQ | EQ	reads=statement	code=(match !statement with | Inside _ | Line _ -> EQEQ | _ -> EQ)
CONTEXT	raw_token ','	gives=COMMA	reads=statement	writes=statement	code=(if !statement = Bound then statement := Line 0); COMMA
CONTEXT	raw_token '('	gives=LPAREN	reads=statement	writes=statement	code=(match !statement with | Bound -> statement := Inside 1 | Inside k -> statement := Inside (k + 1) | Line k -> statement := Line (k + 1) | _ -> ()); LPAREN
CONTEXT	raw_token ')'	gives=RPAREN	reads=statement	writes=statement	code=(match !statement with | Inside 1 -> statement := Outside | Inside k -> statement := Inside (k - 1) | Line k when k > 0 -> statement := Line (k - 1) | _ -> ()); RPAREN
CONTEXT	raw_token (alpha alnum_id*) as s	gives=IDENT | a keyword of the table	reads=statement	writes=statement	code=(if !statement = Variable then statement := Bound); ident_or_keyword s
CONTEXT	raw_token "∀"	gives=FORALL	writes=statement	code=statement := Variable; FORALL
CONTEXT	raw_token "∃"	gives=EXISTS	writes=statement	code=statement := Variable; EXISTS
CONTEXT	raw_token eof	gives=EOF	writes=statement	code=reset_statement (); EOF
CONTEXT	function ident_or_keyword	code=try Hashtbl.find keyword_table s with Not_found -> IDENT s
CONTEXT	function reset_statement	writes=statement	code=statement := Outside
CONTEXT	token	when !type_follows && (type_follows := false; path_ahead lexbuf !previous_line)	gives=PATH_TYPE	reads=type_follows | previous_line | the tokens ahead to the end of the line (path_ahead)	writes=type_follows
CONTEXT	token.finish	on=COLON | WHERE	writes=type_follows	code=type_follows := true
CONTEXT	token.finish	when !previous = TYPE_KW && !previous_previous = COLON	on=LBRACE	reads=previous | previous_previous	writes=type_body	code=type_body := true
CONTEXT	token.finish	when !type_body	on=RETURN	reads=type_body	writes=type_follows | type_body	code=type_body := false; type_follows := true
CONTEXT	token.finish	on=RBRACE	writes=type_body	code=type_body := false
CONTEXT	token.finish	on=PI | SIGMA	writes=binder	code=binder := Some 0
CONTEXT	token.finish	when !binder <> None	on=LPAREN | LT	reads=binder	writes=binder	code=binder := Option.map succ !binder
CONTEXT	token.finish	when !binder <> None	on=RPAREN | GT	reads=binder	writes=binder	code=binder := Option.map pred !binder
CONTEXT	token.finish	when !binder = Some 0	on=COMMA	reads=binder	writes=type_follows | binder	code=binder := None; type_follows := true
CONTEXT	token.finish	on=every token	writes=previous | previous_previous | previous_line	code=previous_previous := !previous; previous := t; previous_line := line
CONTEXT	token	when (match tok, !previous with IDENT _, LAW -> true | _ -> false)	gives=the token read, through finish	reads=previous | the token read	writes=statement
CONTEXT	token	when !previous_previous = LAW && line = !previous_line && (match tok with | IDENT _ | NUM_LIT _ | STR_LIT _ | BOOL_LIT _ | LPAREN | CLEAR -> true | _ -> false)	gives=LAW_STATEMENT	reads=previous_previous | previous_line | the line of the token | the token read	writes=previous | previous_previous	does=gives the token read back, for the next call
CONTEXT	token	when tok = GT && !previous = THIS	reads=previous | the token read	writes=in_clause
CONTEXT	token	when not !in_clause	gives=the token read, through finish	reads=in_clause	writes=in_clause
CONTEXT	token, inside the clause `this >`	when COLON_U	gives=the token read, through finish
CONTEXT	token, inside the clause `this >`	when _ when !previous = COLON_U || (!previous = GT && !previous_previous = THIS && line > !previous_line)	gives=the token read, through finish	reads=previous | previous_previous | previous_line | the line of the token
CONTEXT	token, inside the clause `this >`	when _ when line > !previous_line	gives=ARMS_END	reads=previous_line | the line of the token	writes=in_clause | previous	does=gives the token read back, for the next call
CONTEXT	token, inside the clause `this >`	when IDENT _ | BOOL_LIT _ | LT | GT | COMMA | LPAREN | RPAREN | ARROW | IN | COLON | EQ	gives=the token read, through finish
CONTEXT	token, inside the clause `this >`	when _	gives=ARMS_END	writes=in_clause | previous	does=gives the token read back, for the next call
CONTEXT	function lex_one	code=if !lexed_to != Lexing.dummy_pos then lexbuf.Lexing.lex_curr_p <- !lexed_to; let t = raw_token lexbuf in lexed_to := lexbuf.Lexing.lex_curr_p; { t; start_p = lexbuf.Lexing.lex_start_p; curr_p = lexbuf.Lexing.lex_curr_p }
CONTEXT	function path_ahead	code=let at i = match List.nth_opt !held i with | Some p -> p | None -> let p = lex_one lexbuf in held := !held @ [p]; p in let rec scan i depth opening met = let p = at i in if p.start_p.Lexing.pos_lnum > line then false else match p.t with | PI | SIGMA when i = 0 -> false | EQ when depth = 0 -> true | EQ when opening && depth = 1 -> scan (i + 1) depth opening true | LPAREN -> scan (i + 1) (depth + 1) (i = 0 || opening) met | RPAREN when opening && depth = 1 && met -> (at (i + 1)).t = AMPAMPQ | RPAREN -> depth > 0 && scan (i + 1) (depth - 1) (opening && depth > 1) met | EOF -> false | LBRACE | RBRACE | COMMA | COLONEQ | WHERE | FORALL | EXISTS when depth = 0 -> false | _ -> scan (i + 1) depth opening met in scan 0 0 false false
CONTEXT	function token	code=(match !owner with | Some l when l == lexbuf -> () | _ -> owner := Some lexbuf; in_clause := false; type_follows := false; binder := None; type_body := false; previous := EOF; previous_previous := EOF; held := []; lexed_to := Lexing.dummy_pos); let virtual_token v = previous_previous := !previous; previous := v; v in if !type_follows && (type_follows := false; path_ahead lexbuf !previous_line) then virtual_token PATH_TYPE else begin let p = match !held with | p :: rest -> held := rest; p | [] -> lex_one lexbuf in lexbuf.Lexing.lex_start_p <- p.start_p; lexbuf.Lexing.lex_curr_p <- p.curr_p; let tok = p.t in let line = p.start_p.Lexing.pos_lnum in let put_back () = held := p :: !held in let finish t = (match t with | COLON | WHERE -> type_follows := true | LBRACE when !previous = TYPE_KW && !previous_previous = COLON -> type_body := true | RETURN when !type_body -> type_body := false; type_follows := true | RBRACE -> type_body := false | PI | SIGMA -> binder := Some 0 | LPAREN | LT when !binder <> None -> binder := Option.map succ !binder | RPAREN | GT when !binder <> None -> binder := Option.map pred !binder | COMMA when !binder = Some 0 -> binder := None; type_follows := true | _ -> ()); previous_previous := !previous; previous := t; previous_line := line; t in if (match tok, !previous with IDENT _, LAW -> true | _ -> false) then begin statement := Line 0; finish tok end else if !previous_previous = LAW && line = !previous_line && (match tok with | IDENT _ | NUM_LIT _ | STR_LIT _ | BOOL_LIT _ | LPAREN | CLEAR -> true | _ -> false) then begin put_back (); previous_previous := EOF; previous := LAW_STATEMENT; LAW_STATEMENT end else if not !in_clause then begin if tok = GT && !previous = THIS then in_clause := true; finish tok end else match tok with | COLON_U -> finish tok | _ when !previous = COLON_U || (!previous = GT && !previous_previous = THIS && line > !previous_line) -> finish tok | _ when line > !previous_line -> in_clause := false; put_back (); previous := ARMS_END; ARMS_END | IDENT _ | BOOL_LIT _ | LT | GT | COMMA | LPAREN | RPAREN | ARROW | IN | COLON | EQ -> finish tok | _ -> in_clause := false; put_back (); previous := ARMS_END; ARMS_END end

# Refused by the lexer (a case that raises Lexer_error)
REFUSED	raw_token "∈"	∈ is not a symbol of Yon: the type of a quantifier follows a colon, `∀x : T`
REFUSED	raw_token (['\xc2'-'\xdf'] ['\x80'-'\xbf'] | ['\xe0'-'\xef'] ['\x80'-'\xbf'] ['\x80'-'\xbf'] | ['\xf0'-'\xf4'] ['\x80'-'\xbf'] ['\x80'-'\xbf'] ['\x80'-'\xbf']) as u	unexpected character `%s` (U+%04X)
REFUSED	raw_token _ as c	unexpected character %c
REFUSED	raw_token _ as c	unexpected byte \x%02X
REFUSED	block_comment eof	unterminated comment
REFUSED	string_lit eof	unterminated string
