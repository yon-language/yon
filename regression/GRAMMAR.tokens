# Precedence names (parser.mly %left/%right/%nonassoc, not tokens: no case gives them)
PRECEDENCE	CLAUSE_END

# Keywords (keyword_table: a name the identifier case reads is looked up here)
KEYWORD	import	IMPORT
KEYWORD	internal	INTERNAL
KEYWORD	proof	PROOF
KEYWORD	place	PLACE
KEYWORD	this	THIS
KEYWORD	space	SPACE
KEYWORD	nat	NAT
