  fun forget(a: Term, b: Term, p: a = b): Number { return 0 }
  fun same(d: Step): Step { return d }
  proof fun not_var(d1: Step, d2: Step, q: (d1 ↦ Step.src) = (d2 ↦ Step.src), u: Term, v: Term, u2: Term, v2: Term): Number {
    return match same(d1) { ifTrue as (a, b) => forget(yes, no, ite_injective(yes, a, b, no, u2, v2, q)),
      ifFalse as (a, b) => 0, ifSame as (a, b) => 0,
      inC as (a, b, c) => 0, inU as (a, b, c) => 0, inV as (a, b, c) => 0 }
  }
