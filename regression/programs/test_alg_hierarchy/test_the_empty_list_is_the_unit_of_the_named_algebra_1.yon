fun concat_all<T uses Monoid>(xs: List<T>): T {
  return match xs {
    Nil => T.unit,
    Cons as (h, t) => T.op(h, concat_all<T>(t))
  }
}
fun three(a: Int64, b: Int64, c: Int64): List<Int64> {
  return List.cons(a, List.cons(b, List.cons(c, List.empty)))
}
fun none: List<Int64> { return List.empty }
fun sum_of_none: Int64 { return concat_all<Additive>(none) }
fun product_of_none: Int64 { return concat_all<Multiplicative>(none) }
