place Entry {
  fun main(): Number visits Output {
    be h := Space.make(Vec.empty())
    be i := Space.make(0)
    iter 1000000 do { be k := Space.get(i)
                 be _ := Space.set(h, Vec.push(Space.get(h), k))
                 be _2 := Space.set(i, k + 1) }
    be _p := Output.print(String.from_int(Vec.size(Space.get(h))))
    return 0
  }
}
