place Entry {
  fun main(): Number visits Output {
    be t1 := MerkleTree.node2(0, MerkleTree.leaf(1445), MerkleTree.leaf(1280))
    be t2 := MerkleTree.node2(0, MerkleTree.leaf(1445), MerkleTree.leaf(1280))
    be acc := Space.make(0)
    iter 10000000 do { be _ := Space.set(acc, Space.get(acc) + (if MerkleTree.equal(t1, t2) then 1 else 0)) }
    be _p := Output.print(String.from_int(Space.get(acc)))
    return 0
  }
}
