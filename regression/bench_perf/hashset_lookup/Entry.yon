place Entry {
  fun main(): Number visits Output {
    be s := HashSet.add(HashSet.add(HashSet.empty(), 42), 7)
    be acc := Space.make(0)
    iter 10000000 do { be _ := Space.set(acc, Space.get(acc) + (if HashSet.contains(s, 42) then 1 else 0)) }
    be _p := Output.print(String.from_int(Space.get(acc)))
    return 0
  }
}
