place Entry {
  fun main(): Number visits Output {
    s := HashSet.add(HashSet.add(HashSet.empty(), 42), 7)
    acc := Space.make(0)
    iter 10000000 do { _ := Space.set(acc, Space.get(acc) + (if HashSet.contains(s, 42) then 1 else 0)) }
    _p := Output.print(String.from_int(Space.get(acc)))
    return 0
  }
}
