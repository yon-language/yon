place Entry { }
fun build(seed: text, doublings: number): text {
  be s holds Space.make(seed)
  iter doublings do { be _ holds Space.set(s, String.concat(Space.get(s), Space.get(s))) }
  return Space.get(s)
}
fun main(): number visits Output {
  be big holds build("x", 15)
  be acc holds Space.make(0)
  iter 10000000 do { be _ holds Space.set(acc, Space.get(acc) + (if String.equal(big, big) then 7 else 0)) }
  be _p holds Output.print(String.from_int(Space.get(acc)))
  return 0
}
