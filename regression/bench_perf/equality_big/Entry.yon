place Entry {
  fun build(seed: Text, doublings: Number): Text {
    be s := Space.make(seed)
    iter doublings do { be _ := Space.set(s, String.concat(Space.get(s), Space.get(s))) }
    return Space.get(s)
  }
  fun main(): Number visits Output {
    be big := build("x", 15)
    be acc := Space.make(0)
    iter 10000000 do { be _ := Space.set(acc, Space.get(acc) + (if String.equal(big, big) then 7 else 0)) }
    be _p := Output.print(String.from_int(Space.get(acc)))
    return 0
  }
}
