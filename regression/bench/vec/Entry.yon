place Entry {
  fun timed_push(n: Number): Number visits Output {
    vc := Space.make(Vec.empty())
    i := Space.make(0)
    t0 := Time.now_ns(0)
    iter n do { k := Space.get(i)
                _ := Space.set(vc, Vec.push(Space.get(vc), k))
                _2 := Space.set(i, k + 1) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_push_base(n: Number): Number visits Output {
    i := Space.make(0)
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter n do { k := Space.get(i)
                _ := Space.set(acc, k)
                _2 := Space.set(i, k + 1) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun build_vec(n: Number): Number {
    vc := Space.make(Vec.empty())
    i := Space.make(0)
    iter n do { k := Space.get(i)
                _ := Space.set(vc, Vec.push(Space.get(vc), k))
                _2 := Space.set(i, k + 1) }
    return Space.get(vc)
  }
  fun timed_get(v: Number, m: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter m do { h := Vec.get(v, 42)
                _ := Space.set(acc, Space.get(acc) + h) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_get_base(m: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter m do { _ := Space.set(acc, Space.get(acc) + 42) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun min2(f0: Number, f1: Number): Number { return if f0 < f1 then f0 else f1 }
  fun main(): Number visits Output {
    n := 100000
    // push throughput: min over a few reps, net of baseline
    psh := Space.make(timed_push(n))
    iter 4 do { _ := Space.set(psh, min2(Space.get(psh), timed_push(n))) }
    pshb := Space.make(timed_push_base(n))
    iter 4 do { _ := Space.set(pshb, min2(Space.get(pshb), timed_push_base(n))) }
    v := build_vec(n)
    sz := Vec.size(v)
    m := 1000000
    gt := Space.make(timed_get(v, m))
    iter 11 do { _ := Space.set(gt, min2(Space.get(gt), timed_get(v, m))) }
    gtb := Space.make(timed_get_base(m))
    iter 11 do { _ := Space.set(gtb, min2(Space.get(gtb), timed_get_base(m))) }
    _1 := Output.print(String.from_int(sz))                                  // final_size = N
    _2 := Output.print(String.from_int((Space.get(psh) - Space.get(pshb)))) // push net ns for N
    _3 := Output.print(String.from_int(Vec.get(v, 42)))                      // get guard (=42)
    _4 := Output.print(String.from_int((Space.get(gt) - Space.get(gtb))))    // get net ns for M
    return 0
  }
}
// BENCHMARK — Vec (indexed dynamic array): push throughput + get latency.
// PUSH: thread the vec handle through a Space cell, push N entries, time it net of a
// baseline loop (same cell-threading, no push). GET: build a vec of N once, then time
// M get() probes (min-of-K, baseline-subtracted) like the equality bench.
// DCE guard: final size / accumulated get-value are printed.
//
// Stdout schema (4 ints): final_size, push_net_ns_per_N, get_acc, get_net_ns_per_M
//   push: N = 100000 (net/N = ns/push) ; get: M = 1000000, K = 11 reps (net/M = ns/get).
