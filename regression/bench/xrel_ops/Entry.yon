place Entry {
  fun warm(): Number visits Output { _ := point_mark(0) return 0 }
  fun mn(a: Number, b: Number): Number { return if a < b then a else b }
  /* the address generation every loop shares: the k-th point of the shell */
  fun point_mark(k: Number): Number {
    return match LatticePoint.at_index(k % 196560) { LatticePoint as p => 1, DomainError as d => 0 }
  }
  fun put_k(a: XRelMap<LatticePoint, Number>, k: Number): XRelMap<LatticePoint, Number> {
    return match LatticePoint.at_index(k % 196560) {
      LatticePoint as p => XRelMap.set(a, p, 7), DomainError as d => a }
  }
  fun get_k(a: XRelMap<LatticePoint, Number>, k: Number): Number {
    return match LatticePoint.at_index(k % 196560) {
      LatticePoint as p => (match XRelMap.get(a, p) { Found as x => x, Absent => 0 }),
      DomainError as d => 0 }
  }
  fun orbit_k(k: Number): Number {
    return match LatticePoint.at_index(k % 196560) {
      LatticePoint as p => LatticePoint.orbit(p), DomainError as d => 0 - 1 }
  }
  fun lp1(n: Number): Number visits Output {
    mut acc := 0
    mut i := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                acc <- acc + point_mark(k)
                i <- k + 1 }
    return Time.now_ns(0) - t0
  }
  fun lp2(n: Number): Number visits Output {
    mut acc := 0
    mut i := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                acc <- acc + point_mark(k) + point_mark(k + 1)
                i <- k + 1 }
    return Time.now_ns(0) - t0
  }
  fun put_loop(n: Number): Number visits Output {
    mut a := XRelMap.empty
    mut i := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                a <- put_k(a, k)
                i <- k + 1 }
    return Time.now_ns(0) - t0
  }
  fun get_loop(n: Number): Number visits Output {
    mut a := XRelMap.empty
    mut i := 0
    iter n do { k := i
                a <- put_k(a, k)
                i <- k + 1 }
    mut acc := 0
    mut j := 0
    t0 := Time.now_ns(0)
    iter n do { k := j
                acc <- acc + get_k(a, k)
                j <- k + 1 }
    return Time.now_ns(0) - t0
  }
  fun so_loop(n: Number): Number visits Output {
    mut acc := 0
    mut j := 0
    t0 := Time.now_ns(0)
    iter n do { k := j
                acc <- acc + (if orbit_k(k) == orbit_k(k + 1) then 1 else 0)
                j <- k + 1 }
    return Time.now_ns(0) - t0
  }
  fun min_put(n: Number): Number visits Output {
    mut m := put_loop(n)
    iter 2 do { m <- mn(m, put_loop(n)) }
    return m
  }
  fun min_lp1(n: Number): Number visits Output {
    mut m := lp1(n)
    iter 2 do { m <- mn(m, lp1(n)) }
    return m
  }
  fun net_put(n: Number): Number visits Output { return (min_put(n) - min_lp1(n)) / n }
  fun main(): Number visits Output {
    _w := warm()
    _a := Output.print(Text.from_int(net_put(2000)))
    _b := Output.print(Text.from_int(net_put(5000)))
    _c := Output.print(Text.from_int(net_put(10000)))
    _d := Output.print(Text.from_int(net_put(20000)))
    n := 20000
    lpm := min_lp1(n)
    mut getm := get_loop(n)
    iter 2 do { getm <- mn(getm, get_loop(n)) }
    _e := Output.print(Text.from_int((getm - lpm) / n))
    mut lp2m := lp2(n)
    iter 2 do { lp2m <- mn(lp2m, lp2(n)) }
    mut som := so_loop(n)
    iter 2 do { som <- mn(som, so_loop(n)) }
    _f := Output.print(Text.from_int((som - lp2m) / n))
    return 0
  }
}
// BENCHMARK — the XRelMap ops on LatticePoint keys (a persistent trie in the
// Leech heap), each net of an EXACT-TWIN
// baseline, in-process. The op's loop and its twin both make the lattice point the
// same way — LatticePoint.at_index(k mod 196560) — and only the op performs the
// operation. The subtraction removes the cost of making the point, leaving the op
// alone. min-over-reps excludes the one-time mmgroup table init (~200 ms on the
// first point / first set), which a subprocess op/base harness at small N cannot
// subtract and which otherwise masquerades as a per-op cost.
//
// put (XRelMap.set) is measured at four N to show it is bounded in the map's fill:
// the route of a point is its 18-bit index on the shell, so a set copies at most 18
// nodes of the path and a get walks at most 18 levels, whatever N. get and the
// orbit comparison are
// measured at the largest N. The comparison reads TWO points' orbits (an orbit is a
// property of the point), so its twin makes two points.
//
// Stdout schema (6 ints, ns/op): put@2k, put@5k, put@10k, put@20k, get@20k,
// orbit(k) == orbit(k+1) @20k
