place Entry {
  fun intern_distinct(n: Number): Number visits Output {
    acc := Space.make(0)
    i := Space.make(0)
    t0 := Time.now_ns(0)
    iter n do { k := Space.get(i)
                s := String.from_int(k)
                _ := Space.set(acc, Space.get(acc) + String.length(s))
                _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun intern_same(n: Number): Number visits Output {
    acc := Space.make(0)
    i := Space.make(0)
    t0 := Time.now_ns(0)
    iter n do { k := Space.get(i)
                s := String.from_int(7)
                _ := Space.set(acc, Space.get(acc) + String.length(s))
                _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun main(): Number visits Output {
    _g := Output.print(String.from_int(1000000))
    d100k := intern_distinct(100000)
    d1m := intern_distinct(1000000)
    s1m := intern_same(1000000)
    _1 := Output.print(String.from_int(d100k / 100000))
    _2 := Output.print(String.from_int(d1m / 1000000))
    _3 := Output.print(String.from_int(s1m / 1000000))
    return 0
  }
}
// BENCHMARK — the content-addressed (FNV) heap and its expansion. A heap holds one
// generation of slots; distinct content past a generation chains into a successor heap
// (the [YON-XHEAP] "chain extended" event), so interning is unbounded. Distinct content
// takes a fresh slot each time; identical content dedups to one slot. We intern strings
// (String.from_int(k)) and measure ns/intern: distinct below one generation (100k), and
// distinct across several generations (1M, which chains ~5 times) to show expansion is
// amortized O(1); and identical content (dedup) for contrast.
// Stdout schema (4 ints): guard(=1000000), distinct@100k ns, distinct@1M ns, same@1M ns
