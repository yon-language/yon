place Entry {
  fun timed_insert(n: Number): Number visits Output {
    be mapc := Space.make(HashMap.empty())
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(mapc, HashMap.set(Space.get(mapc), k, k + 1))
                be _2 := Space.set(i, k + 1) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_insert_base(n: Number): Number visits Output {
    be i := Space.make(0)
    be acc := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(acc, k + 1)
                be _2 := Space.set(i, k + 1) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun build_map(n: Number): HashMap<Number, Number> {
    be mapc := Space.make(HashMap.empty())
    be i := Space.make(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(mapc, HashMap.set(Space.get(mapc), k, k + 1))
                be _2 := Space.set(i, k + 1) }
    return Space.get(mapc)
  }
  fun timed_get(mp: HashMap<Number, Number>, m: Number): Number visits Output {
    be acc := Space.make(0)
    be t0 := Time.now_ns(0)
    iter m do { be v := (match HashMap.get(mp, 42) { Found(x) => x, Absent => 0 })
                be _ := Space.set(acc, Space.get(acc) + v) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_get_base(m: Number): Number visits Output {
    be acc := Space.make(0)
    be t0 := Time.now_ns(0)
    iter m do { be _ := Space.set(acc, Space.get(acc) + 1) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun min2(f0: Number, f1: Number): Number { return if f0 < f1 then f0 else f1 }
  fun main(): Number visits Output {
    be n := 100000
    // insert throughput: min over a few reps, net of baseline
    be ins := Space.make(timed_insert(n))
    iter 4 do { be _ := Space.set(ins, min2(Space.get(ins), timed_insert(n))) }
    be insb := Space.make(timed_insert_base(n))
    iter 4 do { be _ := Space.set(insb, min2(Space.get(insb), timed_insert_base(n))) }
    be mp := build_map(n)
    be sz := HashMap.size(mp)
    be m := 1000000
    be gk := Space.make(timed_get(mp, m))
    iter 11 do { be _ := Space.set(gk, min2(Space.get(gk), timed_get(mp, m))) }
    be gkb := Space.make(timed_get_base(m))
    iter 11 do { be _ := Space.set(gkb, min2(Space.get(gkb), timed_get_base(m))) }
    be _1 := Output.print(String.from_int(sz))                                  // final_size = N
    be _2 := Output.print(String.from_int((Space.get(ins) - Space.get(insb)))) // insert net ns for N
    be _3 := Output.print(String.from_int((match HashMap.get(mp, 42) { Found(x) => x, Absent => 0 })))                // get value guard (==43)
    be _4 := Output.print(String.from_int((Space.get(gk) - Space.get(gkb))))   // get net ns for M
    return 0
  }
}
// BENCHMARK — HashMap (FNV content-addressing): insert throughput + get latency.
// INSERT: thread the map handle through a Space cell, set N distinct key->value
// pairs (key=i, value=i+1), time it net of a baseline loop (same cell-threading,
// no set). GET: build a map of N once, then time M get() probes of a present key
// (min-of-K, baseline-subtracted) like the equality bench.
// DCE guard: final size + a get value are accumulated into a Space cell and printed.
//
// Stdout schema (4 ints): final_size, insert_net_ns_per_N, get_value, get_net_ns_per_M
//   [1] final_size          = HashMap.size after N sets   (== N = 100000)
//   [2] insert_net_ns_per_N = min insert-loop ns net of baseline, for N sets
//                             (divide by N=100000 => ns/insert)
//   [3] get_value           = HashMap.get(map, 42) guard  (== 43; must be nonzero)
//   [4] get_net_ns_per_M    = min get-loop ns net of baseline, for M gets
//                             (divide by M=1000000 => ns/get)
//   N = 100000 (inserts) ; M = 1000000 (gets), K = 11 reps.
