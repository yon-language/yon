place Entry {
  // The size of the work: as written, or divided by YON_BENCH_DIV, so the gate
  // checks the values on a small run and the measurement runs the full one.
  fun scaled(n: Number): Number {
    return if Env.has("YON_BENCH_DIV")
           then Number.floor(n / String.parse_number(Env.get("YON_BENCH_DIV")))
           else n
  }
  fun timed_insert(n: Number): Number visits Output {
    mut mapc := HashMap.empty
    mut i := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                mapc <- HashMap.set(mapc, k, k + 1)
                i <- k + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_insert_base(n: Number): Number visits Output {
    mut i := 0
    mut acc := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                acc <- k + 1
                i <- k + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun build_map(n: Number): HashMap<Number, Number> {
    mut mapc := HashMap.empty
    mut i := 0
    iter n do { k := i
                mapc <- HashMap.set(mapc, k, k + 1)
                i <- k + 1 }
    return mapc
  }
  fun timed_get(mp: HashMap<Number, Number>, m: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter m do { v := (match HashMap.get(mp, 42) { Found as x => x, Absent => 0 })
                acc <- acc + v }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_get_base(m: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter m do { acc <- acc + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun min2(f0: Number, f1: Number): Number { return if f0 < f1 then f0 else f1 }
  fun main(): Number visits Output {
    n := scaled(100000)
    // insert throughput: min over a few reps, net of baseline
    mut ins := timed_insert(n)
    iter 4 do { ins <- min2(ins, timed_insert(n)) }
    mut insb := timed_insert_base(n)
    iter 4 do { insb <- min2(insb, timed_insert_base(n)) }
    mp := build_map(n)
    sz := HashMap.size(mp)
    m := scaled(1000000)
    mut gk := timed_get(mp, m)
    iter 11 do { gk <- min2(gk, timed_get(mp, m)) }
    mut gkb := timed_get_base(m)
    iter 11 do { gkb <- min2(gkb, timed_get_base(m)) }
    _1 := Output.print(String.from_int(sz))                                  // final_size = N
    _2 := Output.print(String.from_int((ins - insb))) // insert net ns for N
    _3 := Output.print(String.from_int((match HashMap.get(mp, 42) { Found as x => x, Absent => 0 })))                // get value guard (==43)
    _4 := Output.print(String.from_int((gk - gkb)))   // get net ns for M
    return 0
  }
}
// BENCHMARK — HashMap (FNV content-addressing): insert throughput + get latency.
// INSERT: thread the map handle through a Space cell, set N distinct key->value
// pairs (key=i, value=i+1), time it net of a baseline loop (same cell-threading,
// no set). GET: build a map of N once, then time M get() probes of a present key
// (min-of-K, baseline-subtracted) like the equality bench.
// DCE guard: final size + a get value are accumulated into a Space cell and printed.
//
// Stdout schema (4 ints): final_size, insert_net_ns_per_N, get_value, get_net_ns_per_M
//   [1] final_size          = HashMap.size after N sets   (== N = 100000)
//   [2] insert_net_ns_per_N = min insert-loop ns net of baseline, for N sets
//                             (divide by N=100000 => ns/insert)
//   [3] get_value           = HashMap.get(map, 42) guard  (== 43; must be nonzero)
//   [4] get_net_ns_per_M    = min get-loop ns net of baseline, for M gets
//                             (divide by M=1000000 => ns/get)
//   N = 100000 (inserts) ; M = 1000000 (gets), K = 11 reps.
