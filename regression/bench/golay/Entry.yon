place Entry {
  fun timed_base(iters: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter iters do { _ := Space.set(acc, Space.get(acc) + 1) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_seal(g: Number, iters: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter iters do { _ := Space.set(acc, Space.get(acc) + VoyagerList.seal(g)) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_open(cw: Number, iters: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter iters do { _ := Space.set(acc, Space.get(acc) + VoyagerList.open(VoyagerList.corrupt(cw, 2))) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun acc_open(cw: Number, iters: Number): Number visits Output {
    acc := Space.make(0)
    iter iters do { _ := Space.set(acc, Space.get(acc) + VoyagerList.open(VoyagerList.corrupt(cw, 2))) }
    return Space.get(acc)
  }
  fun min2(a: Number, b: Number): Number { return if a < b then a else b }
  fun min_of(f0: Number, fseed: Number, reps: Number): Number { return fseed }
  fun main(): Number visits Output {
    g := 1445
    cw := VoyagerList.seal(g)
    n := 1000000
    reps := 11
    // recovered guard: open a few, average must be the gene 1445
    guard := (acc_open(cw, 1000) / 1000)
    base := Space.make(timed_base(n))
    iter reps do { _ := Space.set(base, min2(Space.get(base), timed_base(n))) }
    sl := Space.make(timed_seal(g, n))
    iter reps do { _ := Space.set(sl, min2(Space.get(sl), timed_seal(g, n))) }
    op := Space.make(timed_open(cw, n))
    iter reps do { _ := Space.set(op, min2(Space.get(op), timed_open(cw, n))) }
    _g := Output.print(String.from_int(guard))                        // 1445 = correction works
    _1 := Output.print(String.from_int(Space.get(sl) - Space.get(base)))
    _2 := Output.print(String.from_int(Space.get(op) - Space.get(base)))
    return 0
  }
}
// BENCHMARK — VoyagerList / Golay (24,12,8): seal (encode) + corrected open (decode).
// seal(g) carries a 12-bit gene as a 24-bit codeword; open(corrupt(cw,2)) decodes a
// 2-bit-damaged word back to the original gene (distance 8 corrects up to 3 errors).
// Both are pure number->number; timed M calls, min-of-K, baseline-subtracted. The
// DCE guard accumulates the recovered gene (= 1445 each), proving the correction ran.
//
// Schema (3 ints): recovered_guard, seal_net_ns, open_net_ns   (net ns for M=1e6 calls)
