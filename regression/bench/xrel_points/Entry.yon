place Entry {
  // The size of the work: as written, or divided by YON_BENCH_DIV, so the gate
  // checks the values on a small run and the measurement runs the full one.
  fun scaled(n: Number): Number {
    return if Env.has("YON_BENCH_DIV")
           then Number.floor(n / String.parse_number(Env.get("YON_BENCH_DIV")))
           else n
  }
  fun min2(f0: Number, f1: Number): Number { return if f0 < f1 then f0 else f1 }
  fun put_at(a: XRelMap<LatticePoint, Number>, addr: Number, v: Number): XRelMap<LatticePoint, Number> {
    return match LatticePoint.of_coordinate(addr) {
      LatticePoint as p => XRelMap.set(a, p, v), DomainError as d => a }
  }
  fun point_cost(addr: Number): Number {
    return match LatticePoint.of_coordinate(addr) {
      LatticePoint as p => 1, DomainError as d => 0 }
  }
  fun timed_put(n: Number): Number visits Output {
    be ac := Space.make(XRelMap.empty())
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be addr := Leech.embed(k, 1)
                be _ := Space.set(ac, put_at(Space.get(ac), addr, k + 1))
                be _2 := Space.set(i, k + 1) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_put_base(n: Number): Number visits Output {
    be acc := Space.make(0)
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be addr := Leech.embed(k, 1)
                be _ := Space.set(acc, point_cost(addr))
                be _2 := Space.set(i, k + 1) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun build_map(n: Number): XRelMap<LatticePoint, Number> {
    be ac := Space.make(XRelMap.empty())
    be i := Space.make(0)
    iter n do { be k := Space.get(i)
                be addr := Leech.embed(k, 1)
                be _ := Space.set(ac, put_at(Space.get(ac), addr, k + 1))
                be _2 := Space.set(i, k + 1) }
    return Space.get(ac)
  }
  fun timed_get(a: XRelMap<LatticePoint, Number>, addr: LatticePoint, m: Number): Number visits Output {
    be acc := Space.make(0)
    be t0 := Time.now_ns(0)
    iter m do { be _ := Space.set(acc, Space.get(acc) + (match XRelMap.get(a, addr) { Found(x) => x, Absent => 0 })) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_get_base(m: Number): Number visits Output {
    be acc := Space.make(0)
    be t0 := Time.now_ns(0)
    iter m do { be _ := Space.set(acc, Space.get(acc) + 1) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun same_kind(x: LatticePoint, y: LatticePoint): Number {
    return if LatticePoint.orbit(x) == LatticePoint.orbit(y) then 1 else 0
  }
  fun timed_so(x: LatticePoint, y: LatticePoint, m: Number): Number visits Output {
    be acc := Space.make(0)
    be t0 := Time.now_ns(0)
    iter m do { be _ := Space.set(acc, Space.get(acc) + same_kind(x, y)) }
    be t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun so_hits(x: LatticePoint, y: LatticePoint, m: Number): Number {
    be acc := Space.make(0)
    be i := Space.make(0)
    iter m do { be _ := Space.set(acc, Space.get(acc) + same_kind(x, y))
                be _2 := Space.set(i, Space.get(i) + 1) }
    return Space.get(acc)
  }
  fun min_put(reps: Number, n: Number): Number visits Output {
    be m := Space.make(timed_put(n))
    iter reps do { be _ := Space.set(m, min2(Space.get(m), timed_put(n))) }
    return Space.get(m)
  }
  fun min_put_base(reps: Number, n: Number): Number visits Output {
    be m := Space.make(timed_put_base(n))
    iter reps do { be _ := Space.set(m, min2(Space.get(m), timed_put_base(n))) }
    return Space.get(m)
  }
  fun min_get(a: XRelMap<LatticePoint, Number>, addr: LatticePoint, reps: Number, m: Number): Number visits Output {
    be mm := Space.make(timed_get(a, addr, m))
    iter reps do { be _ := Space.set(mm, min2(Space.get(mm), timed_get(a, addr, m))) }
    return Space.get(mm)
  }
  fun min_get_base(reps: Number, m: Number): Number visits Output {
    be mm := Space.make(timed_get_base(m))
    iter reps do { be _ := Space.set(mm, min2(Space.get(mm), timed_get_base(m))) }
    return Space.get(mm)
  }
  fun min_so(x: LatticePoint, y: LatticePoint, reps: Number, m: Number): Number visits Output {
    be mm := Space.make(timed_so(x, y, m))
    iter reps do { be _ := Space.set(mm, min2(Space.get(mm), timed_so(x, y, m))) }
    return Space.get(mm)
  }
  fun run(a0: LatticePoint, x: LatticePoint, y: LatticePoint): Number visits Output {
    be n := scaled(2000)           // put calls (land on ~2000 distinct type-2 points)
    be mg := scaled(1000000)       // get iterations (cheap op)
    be mso := scaled(200000)       // orbit-comparison iterations
    be reps_w := 4          // build-throughput reps
    be reps_r := 11         // read-latency reps

    be a := build_map(n)

    // put throughput, baseline-subtracted
    be put_net := (min_put(reps_w, n) - min_put_base(reps_w, n))
    // get latency, baseline-subtracted
    be get_net := (min_get(a, a0, reps_r, mg) - min_get_base(reps_r, mg))
    // orbit comparison latency, baseline-subtracted (same baseline shape, Mso iters)
    be so_net := (min_so(x, y, reps_r, mso) - min_get_base(reps_r, mso))

    be _1 := Output.print(String.from_int((match XRelMap.get(a, a0) { Found(v) => v, Absent => 0 })))
    be _2 := Output.print(String.from_int(if XRelMap.has(a, a0) then 1 else 0))
    be _3 := Output.print(String.from_int(put_net))
    be _4 := Output.print(String.from_int(get_net))
    be _5 := Output.print(String.from_int(so_net))
    be _6 := Output.print(String.from_int(so_hits(x, y, mso)))
    return 0
  }
  fun main(): Number visits Output {
    // a fixed valid address, and two known same-orbit type-2 points (from
    // uc_xrel: 1536 ~ 1280)
    return match LatticePoint.of_coordinate(Leech.embed(0, 1)) {
      LatticePoint as a0 => (match LatticePoint.of_coordinate(1536) {
        LatticePoint as x => (match LatticePoint.of_coordinate(1280) {
          LatticePoint as y => run(a0, x, y), DomainError as d => 1 }),
        DomainError as d => 1 }),
      DomainError as d => 1 }
  }
}
// BENCHMARK — XRelMap keyed by LatticePoint (a persistent trie in the Leech
// heap, routed by the point's index on the shell): set throughput +
// get latency, and the latency of comparing the orbits of two points.
//
// ADDRESSES. The keys are LatticePoints, made only where they are
// points: every address is routed through Leech.embed(i, mode) — the quantizer
// that snaps a bit pattern to the nearest type-2 point — and made a point by
// LatticePoint.of_coordinate. NOTE: embed is many-to-one; over i in [0..100000)
// the distinct-address ceiling measured is mode0=1664, mode1=4096, mode2=384. We
// use mode 1 (widest, 4096 distinct points). N=2000 puts therefore land on ~2000
// distinct type-2 addresses (below the 4096 ceiling, so essentially all
// distinct — no significant overwrite). The put baseline makes the same point
// (of_coordinate) without the put, so the net is the put alone.
//
// COSTS. The three measurements get different iteration counts:
//   XRelMap.set        : a persistent insert (copies the path, at most 18
//                        nodes) => N=2000 sets, 4 reps.
//   XRelMap.get        : a walk of at most 18 levels => Mg=1e6 iters, 11 reps
//                        (min-of-K).
//   orbit(x) == orbit(y): the orbit is a property of the point, read from its
//                        precomputed M24 orbit => Mso=2e5 iters, 11 reps.
// All three are baseline-subtracted (loop+cell-threading overhead removed). DCE
// guard: get-values and orbit-comparison hits are accumulated and printed.
//
// Stdout schema (6 ints):
//   [1] get_guard     = XRelMap.get(a, A0)            (a real stored value)
//   [2] has_guard     = XRelMap.has(a, A0)            (=1, the key is there)
//   [3] put_net_ns    = min ns for N=2000 put calls, baseline-subtracted (/2000 = ns/put)
//   [4] get_net_ns    = min ns for Mg=1e6 get calls, baseline-subtracted (/1e6 = ns/get)
//   [5] so_net_ns     = min ns for Mso=2e5 orbit comparisons, base-subtracted (/2e5 = ns/op)
//   [6] so_guard      = accumulated orbit-comparison hits over Mso (DCE guard, = Mso)
