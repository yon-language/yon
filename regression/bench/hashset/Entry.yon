place Entry {
  // The size of the work: as written, or divided by YON_BENCH_DIV, so the gate
  // checks the values on a small run and the measurement runs the full one.
  fun scaled(n: Number): Number {
    return if Env.has("YON_BENCH_DIV")
           then Number.floor(n / String.parse_number(Env.get("YON_BENCH_DIV")))
           else n
  }
  fun timed_insert(n: Number): Number visits Output {
    mut setc := HashSet.empty
    mut i := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                setc <- HashSet.add(setc, k)
                i <- k + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_insert_base(n: Number): Number visits Output {
    mut i := 0
    mut acc := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                acc <- k
                i <- k + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun build_set(n: Number): HashSet<Number> {
    mut setc := HashSet.empty
    mut i := 0
    iter n do { k := i
                setc <- HashSet.add(setc, k)
                i <- k + 1 }
    return setc
  }
  fun timed_lookup(s: HashSet<Number>, m: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter m do { h := (if HashSet.contains(s, 42) then 1 else 0)
                acc <- acc + h }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_lookup_base(m: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter m do { acc <- acc + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun min2(f0: Number, f1: Number): Number { return if f0 < f1 then f0 else f1 }
  fun main(): Number visits Output {
    n := scaled(100000)
    // insert throughput: min over a few reps, net of baseline
    mut ins := timed_insert(n)
    iter 4 do { ins <- min2(ins, timed_insert(n)) }
    mut insb := timed_insert_base(n)
    iter 4 do { insb <- min2(insb, timed_insert_base(n)) }
    s := build_set(n)
    sz := HashSet.size(s)
    m := scaled(1000000)
    mut lk := timed_lookup(s, m)
    iter 11 do { lk <- min2(lk, timed_lookup(s, m)) }
    mut lkb := timed_lookup_base(m)
    iter 11 do { lkb <- min2(lkb, timed_lookup_base(m)) }
    _1 := Output.print(String.from_int(sz))                                  // final_size = N
    _2 := Output.print(String.from_int((ins - insb))) // insert net ns for N
    _3 := Output.print(String.from_int(if HashSet.contains(s, 42) then 1 else 0)) // hit guard
    _4 := Output.print(String.from_int((lk - lkb)))    // lookup net ns for M
    return 0
  }
}
// BENCHMARK — HashSet (FNV content-addressing): insert throughput + lookup latency.
// INSERT: thread the set handle through a Space cell, add N distinct keys, time it
// net of a baseline loop (same cell-threading, no add). LOOKUP: build a set of N once,
// then time M has() probes (min-of-K, baseline-subtracted) like the equality bench.
// DCE guard: final size / hit-count are printed.
//
// Stdout schema (4 ints): final_size, insert_net_ns_per_N, hits, lookup_net_ns_per_M
//   insert: N = 100000 ; lookup: M = 1000000, K = 11 reps.
