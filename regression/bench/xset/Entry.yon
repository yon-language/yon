place Entry {
  fun build_xset(lo: Number, n: Number): Number {
    s := Space.make(XSet.empty())
    i := Space.make(0)
    iter n do { _ := Space.set(s, XSet.add(Space.get(s), Leech.point(lo + Space.get(i))))
                _2 := Space.set(i, Space.get(i) + 1) }
    return Space.get(s)
  }
  fun build_hset(lo: Number, n: Number): HashSet<Number> {
    s := Space.make(HashSet.empty())
    i := Space.make(0)
    iter n do { _ := Space.set(s, HashSet.add(Space.get(s), lo + Space.get(i)))
                _2 := Space.set(i, Space.get(i) + 1) }
    return Space.get(s)
  }
  fun batch_xinter(a: Number, b: Number, batch: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter batch do { _ := Space.set(acc, Space.get(acc) + XSet.size(XSet.intersect(a, b))) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun batch_xunion(a: Number, b: Number, batch: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter batch do { _ := Space.set(acc, Space.get(acc) + XSet.size(XSet.union(a, b))) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun batch_hinter(a: HashSet<Number>, b: HashSet<Number>, batch: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter batch do { _ := Space.set(acc, Space.get(acc) + HashSet.size(HashSet.intersect(a, b))) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun batch_hunion(a: HashSet<Number>, b: HashSet<Number>, batch: Number): Number visits Output {
    acc := Space.make(0)
    t0 := Time.now_ns(0)
    iter batch do { _ := Space.set(acc, Space.get(acc) + HashSet.size(HashSet.union(a, b))) }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun main(): Number visits Output {
    n := 2000
    batch := 100
    xa := build_xset(0, n)
    xb := build_xset(1000, n)
    ha := build_hset(0, n)
    hb := build_hset(1000, n)
    _g1 := Output.print(String.from_int(XSet.size(XSet.intersect(xa, xb))))   // ~1000 overlap
    _g2 := Output.print(String.from_int(XSet.size(XSet.union(xa, xb))))        // ~3000
    _1 := Output.print(String.from_int(batch_xinter(xa, xb, batch)))
    _2 := Output.print(String.from_int(batch_xunion(xa, xb, batch)))
    _3 := Output.print(String.from_int(batch_hinter(ha, hb, batch)))
    _4 := Output.print(String.from_int(batch_hunion(ha, hb, batch)))
    return 0
  }
}
// BENCHMARK — XSet bit-parallel set algebra vs HashSet.
// XSet is a fixed 196,560-bit bitmap: intersect/union are a bit-AND/OR over ~3072
// machine words, INDEPENDENT of set size N. HashSet intersect/union iterate elements
// (O(N)). Build A,B (overlap ~N/2) as XSets over distinct Leech.point(i) AND as
// HashSets over the same integers, then time a BATCH of intersect/union calls each.
// NOTE: the XSet pool is bounded (256 sets, no reclamation), so allocating ops are
// timed once over a small BATCH=100 (each op is microseconds, so the loop overhead is
// negligible and no min-of-K is needed). contains() is read-only, timed min-of-K.
//
// Schema (6 ints): inter_sz_guard, union_sz_guard,
//   xset_inter_ns_per100, xset_union_ns_per100, hash_inter_ns_per100, hash_union_ns_per100
