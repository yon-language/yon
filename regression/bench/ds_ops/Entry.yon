place Entry {
  // The size of the work: as written, or divided by YON_BENCH_DIV, so the gate
  // checks the values on a small run and the measurement runs the full one.
  fun scaled(n: Number): Number {
    return if Env.has("YON_BENCH_DIV")
           then Number.floor(n / String.parse_number(Env.get("YON_BENCH_DIV")))
           else n
  }
  fun mn(a: Number, b: Number): Number { return if a < b then a else b }
  fun warm(): Number visits Output {
    be l := Space.make(List.empty(0))
    be _a := Space.set(l, List.cons(Space.get(l), 1))
    be m := Space.make(HashMap.empty())
    be _b := Space.set(m, HashMap.set(Space.get(m), 1, 1))
    be s := Space.make(HashSet.empty())
    be _c := Space.set(s, HashSet.add(Space.get(s), 1))
    return 0
  }
  fun twin(n: Number): Number visits Output {
    be acc := Space.make(0)
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(acc, Space.get(acc) + k)
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun cons_loop(n: Number): Number visits Output {
    be l := Space.make(List.empty(0))
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(l, List.cons(Space.get(l), k))
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun set_loop(n: Number): Number visits Output {
    be m := Space.make(HashMap.empty())
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(m, HashMap.set(Space.get(m), k, k))
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun add_loop(n: Number): Number visits Output {
    be s := Space.make(HashSet.empty())
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(s, HashSet.add(Space.get(s), k))
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun mtwin(n: Number): Number visits Output {
    be x := Space.make(twin(n))
    iter 2 do { be _ := Space.set(x, mn(Space.get(x), twin(n))) }
    return Space.get(x)
  }
  fun min_cons(n: Number): Number visits Output {
    be x := Space.make(cons_loop(n))
    iter 2 do { be _ := Space.set(x, mn(Space.get(x), cons_loop(n))) }
    return (Space.get(x) - mtwin(n)) / n
  }
  fun min_set(n: Number): Number visits Output {
    be x := Space.make(set_loop(n))
    iter 2 do { be _ := Space.set(x, mn(Space.get(x), set_loop(n))) }
    return (Space.get(x) - mtwin(n)) / n
  }
  fun min_add(n: Number): Number visits Output {
    be x := Space.make(add_loop(n))
    iter 2 do { be _ := Space.set(x, mn(Space.get(x), add_loop(n))) }
    return (Space.get(x) - mtwin(n)) / n
  }
  fun main(): Number visits Output {
    be _w := warm()
    be _1 := Output.print(String.from_int(min_cons(scaled(10000))))
    be _2 := Output.print(String.from_int(min_cons(scaled(100000))))
    be _3 := Output.print(String.from_int(min_set(scaled(10000))))
    be _4 := Output.print(String.from_int(min_set(scaled(100000))))
    be _5 := Output.print(String.from_int(min_add(scaled(100000))))
    return 0
  }
}
// BENCHMARK — heap-backed structure builders, net of an EXACT-TWIN (Space-threading)
// baseline, in-process, min-over-reps. The subprocess harness mismeasures these: every op
// that puts on the content-addressed heap pays a one-time g_yon_heap creation
// (ds_ensure_init -> yon_xheap_create) the Space-only baselines never pay; at the small N
// a cons list allows (~196,560, one generation) that one-time cost smears into the per-op
// (it inflated cons to ~204 ns in subprocess timing). min-over-reps drops the init; the
// exact twin removes the loop/threading; what remains is the op.
//
// cons content-addresses one cell each (flat in N). set content-addresses each
// (key,value) entry on the heap AND probes it back across heap generations, so it GROWS
// with the map (10k vs 100k here; ~340 ns by 1M, see the artifact). add stores inline in
// the directory (no heap), the flat contrast proving set's growth is the content-addressed
// entry path, not the directory. N capped at 100k to bound the non-reclaiming heap.
// Stdout schema (5 ints, ns/op): cons@10k cons@100k set@10k set@100k add@100k
