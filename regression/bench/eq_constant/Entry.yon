place Entry {
  fun timed_base(iters: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter iters do { acc <- acc + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_eq(a: Text, b: Text, iters: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter iters do { e := (if Text.equal(a, b) then 1 else 0)
                    acc <- acc + e }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun min_base(reps: Number, iters: Number): Number visits Output {
    mut m := timed_base(iters)
    iter reps do { t := timed_base(iters)
                   m <- if t < m then t else m }
    return m
  }
  fun min_eq(a: Text, b: Text, reps: Number, iters: Number): Number visits Output {
    mut m := timed_eq(a, b, iters)
    iter reps do { t := timed_eq(a, b, iters)
                   m <- if t < m then t else m }
    return m
  }
  fun build(seed: Text, doublings: Number): Text {
    mut s := seed
    iter doublings do { s <- Text.concat(s, s) }
    return s
  }
  fun main(): Number visits Output {
    s1   := "x"
    s1k  := build("x", 10)
    s32k := build("x", 15)
    reps := 15
    n := 1000000
    base := min_base(reps, n)
    _l1 := Output.print(Text.from_int(Text.length(s1)))
    _l2 := Output.print(Text.from_int(Text.length(s1k)))
    _l3 := Output.print(Text.from_int(Text.length(s32k)))
    _n1 := Output.print(Text.from_int(min_eq(s1, s1, reps, n) - base))
    _n2 := Output.print(Text.from_int(min_eq(s1k, s1k, reps, n) - base))
    _n3 := Output.print(Text.from_int(min_eq(s32k, s32k, reps, n) - base))
    return 0
  }
}
// BENCHMARK — content-addressed equality is O(1) in string length.
// Text.equal compares two heap addresses (one integer compare), so it costs the
// same at 1 char and at 32,768 chars. Method: time 1e6 equal() calls, take the MIN
// over 15 reps (least-interrupted run = true cost), and subtract the MIN of an
// identical loop+accumulator baseline. The accumulator is printed (=1000000) so
// LLVM cannot elide the work. Strings of 1/1024/32768 chars built by doubling.
//
// Stdout schema (6 ints): len_1, len_1k, len_32k, net_1, net_1k, net_32k
//   net_* = min ns for 1e6 equal() calls, baseline-subtracted (/1e6 = ns/call).
