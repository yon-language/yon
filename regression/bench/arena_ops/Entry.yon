place Entry {
  fun warm(): Number visits Output { be _ := point_mark(0) return 0 }
  fun mn(a: Number, b: Number): Number { return if a < b then a else b }
  /* the address generation every loop shares: the k-th point of the shell */
  fun point_mark(k: Number): Number {
    return match LatticePoint.at_index(k % 196560) { LatticePoint as p => 1, DomainError as d => 0 }
  }
  fun put_k(a: Arena<Number>, k: Number): Arena<Number> {
    return match LatticePoint.at_index(k % 196560) {
      LatticePoint as p => Arena.put(a, p, 7), DomainError as d => a }
  }
  fun get_k(a: Arena<Number>, k: Number): Number {
    return match LatticePoint.at_index(k % 196560) {
      LatticePoint as p => (match Arena.get(a, p) { Found(x) => x, Absent => 0 }),
      DomainError as d => 0 }
  }
  fun orbit_k(k: Number): Number {
    return match LatticePoint.at_index(k % 196560) {
      LatticePoint as p => LatticePoint.orbit(p), DomainError as d => 0 - 1 }
  }
  fun lp1(n: Number): Number visits Output {
    be acc := Space.make(0)
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(acc, Space.get(acc) + point_mark(k))
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun lp2(n: Number): Number visits Output {
    be acc := Space.make(0)
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(acc, Space.get(acc) + point_mark(k) + point_mark(k + 1))
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun put_loop(n: Number): Number visits Output {
    be a := Space.make(Arena.empty())
    be i := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(a, put_k(Space.get(a), k))
                be _2 := Space.set(i, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun get_loop(n: Number): Number visits Output {
    be a := Space.make(Arena.empty())
    be i := Space.make(0)
    iter n do { be k := Space.get(i)
                be _ := Space.set(a, put_k(Space.get(a), k))
                be _2 := Space.set(i, k + 1) }
    be acc := Space.make(0)
    be j := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(j)
                be _ := Space.set(acc, Space.get(acc) + get_k(Space.get(a), k))
                be _2 := Space.set(j, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun so_loop(n: Number): Number visits Output {
    be acc := Space.make(0)
    be j := Space.make(0)
    be t0 := Time.now_ns(0)
    iter n do { be k := Space.get(j)
                be _ := Space.set(acc, Space.get(acc) + (if orbit_k(k) == orbit_k(k + 1) then 1 else 0))
                be _2 := Space.set(j, k + 1) }
    return Time.now_ns(0) - t0
  }
  fun min_put(n: Number): Number visits Output {
    be m := Space.make(put_loop(n))
    iter 2 do { be _ := Space.set(m, mn(Space.get(m), put_loop(n))) }
    return Space.get(m)
  }
  fun min_lp1(n: Number): Number visits Output {
    be m := Space.make(lp1(n))
    iter 2 do { be _ := Space.set(m, mn(Space.get(m), lp1(n))) }
    return Space.get(m)
  }
  fun net_put(n: Number): Number visits Output { return (min_put(n) - min_lp1(n)) / n }
  fun main(): Number visits Output {
    be _w := warm()
    be _a := Output.print(String.from_int(net_put(2000)))
    be _b := Output.print(String.from_int(net_put(5000)))
    be _c := Output.print(String.from_int(net_put(10000)))
    be _d := Output.print(String.from_int(net_put(20000)))
    be n := 20000
    be lpm := min_lp1(n)
    be getm := Space.make(get_loop(n))
    iter 2 do { be _ := Space.set(getm, mn(Space.get(getm), get_loop(n))) }
    be _e := Output.print(String.from_int((Space.get(getm) - lpm) / n))
    be lp2m := Space.make(lp2(n))
    iter 2 do { be _ := Space.set(lp2m, mn(Space.get(lp2m), lp2(n))) }
    be som := Space.make(so_loop(n))
    iter 2 do { be _ := Space.set(som, mn(Space.get(som), so_loop(n))) }
    be _f := Output.print(String.from_int((Space.get(som) - Space.get(lp2m)) / n))
    return 0
  }
}
// BENCHMARK — the Arena (Leech type-2 store) ops, each net of an EXACT-TWIN
// baseline, in-process. The op's loop and its twin both make the lattice point the
// same way — LatticePoint.at_index(k mod 196560) — and only the op performs the
// operation. The subtraction removes the cost of making the point, leaving the op
// alone. min-over-reps excludes the one-time mmgroup table init (~200 ms on the
// first point / Arena.put), which a subprocess op/base harness at small N cannot
// subtract and which otherwise masquerades as a per-op cost.
//
// put is measured at four N to show it is O(1) in the arena's fill: yon_arena_put_repr
// is a perfect-hash index plus four slot writes (no resize, no probing, orbit sealed
// per point), so the per-op must be flat in N. get and the orbit comparison are
// measured at the largest N. The comparison reads TWO points' orbits (an orbit is a
// property of the point), so its twin makes two points.
//
// Stdout schema (6 ints, ns/op): put@2k, put@5k, put@10k, put@20k, get@20k,
// orbit(k) == orbit(k+1) @20k
