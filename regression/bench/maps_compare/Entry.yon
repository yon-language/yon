place Entry {
  fun mn(a: Number, b: Number): Number { return if a < b then a else b }
  fun hash_point_put(m: HashMap<LatticePoint, Number>, k: Number): HashMap<LatticePoint, Number> {
    return match LatticePoint.at_index(k % 196560) { LatticePoint as key => HashMap.set(m, key, k), DomainError as d => m }
  }
  fun hash_point_has(m: HashMap<LatticePoint, Number>, k: Number): Number {
    return match LatticePoint.at_index(k % 196560) { LatticePoint as key => (if HashMap.has(m, key) then 1 else 0), DomainError as d => 0 }
  }
  fun hash_point_add(s: HashSet<LatticePoint>, k: Number): HashSet<LatticePoint> {
    return match LatticePoint.at_index(k % 196560) { LatticePoint as key => HashSet.add(s, key), DomainError as d => s }
  }
  fun hash_point_twin(k: Number): Number {
    return match LatticePoint.at_index(k % 196560) { LatticePoint as key => 1, DomainError as d => 0 }
  }
  fun hash_point_build(n: Number): HashMap<LatticePoint, Number> {
    mut m := HashMap.empty()
    mut k := 0
    iter n do {
      m <- hash_point_put(m, k)
      k <- k + 1
    }
    return m
  }
  fun hash_point_t_build(n: Number): Number visits Output {
    t0 := Time.now_ns(0)
    m := hash_point_build(n)
    t1 := Time.now_ns(0)
    return (t1 - t0) + 0 * HashMap.size(m)
  }
  fun hash_point_t_twin(n: Number): Number visits Output {
    mut acc := 0
    mut k := 0
    t0 := Time.now_ns(0)
    iter n do {
      acc <- acc + hash_point_twin(k)
      k <- k + 1
    }
    return Time.now_ns(0) - t0 + 0 * acc
  }
  fun hash_point_t_get(m: HashMap<LatticePoint, Number>, n: Number): Number visits Output {
    mut acc := 0
    mut k := 0
    t0 := Time.now_ns(0)
    iter n do {
      acc <- acc + hash_point_has(m, k)
      k <- k + 1
    }
    return Time.now_ns(0) - t0 + 0 * acc
  }
  fun hash_point_set(start: Number, n: Number): HashSet<LatticePoint> {
    mut s := HashSet.empty()
    mut k := start
    iter n do {
      s <- hash_point_add(s, k)
      k <- k + 1
    }
    return s
  }
  fun hash_point_t_union(a: HashSet<LatticePoint>, b: HashSet<LatticePoint>): Number visits Output {
    t0 := Time.now_ns(0)
    u := HashSet.union(a, b)
    return Time.now_ns(0) - t0 + 0 * HashSet.size(u)
  }
  fun hash_point_t_inter(a: HashSet<LatticePoint>, b: HashSet<LatticePoint>): Number visits Output {
    t0 := Time.now_ns(0)
    u := HashSet.intersect(a, b)
    return Time.now_ns(0) - t0 + 0 * HashSet.size(u)
  }
  fun hash_point_count_has(m: HashMap<LatticePoint, Number>, n: Number): Number {
    mut acc := 0
    mut k := 0
    iter n do {
      acc <- acc + hash_point_has(m, k)
      k <- k + 1
    }
    return acc
  }
  fun hash_point_check(n: Number): Number visits Output {
    m := hash_point_build(n)
    a := hash_point_set(0, n)
    b := hash_point_set(n / 2, n)
    _0 := Output.print(String.from_int(HashMap.size(m)))
    _1 := Output.print(String.from_int(hash_point_count_has(m, n)))
    _2 := Output.print(String.from_int(0))
    _3 := Output.print(String.from_int(HashSet.size(HashSet.union(a, b))))
    _4 := Output.print(String.from_int(HashSet.size(HashSet.intersect(a, b))))
    return 0
  }
  fun hash_point_row(n: Number): Number visits Output {
    m := hash_point_build(n)
    a := hash_point_set(0, n)
    b := hash_point_set(n / 2, n)
    mut tb := hash_point_t_build(n)
    mut tw := hash_point_t_twin(n)
    mut tg := hash_point_t_get(m, n)
    tm := 0
    tmw := 0
    mut tu := hash_point_t_union(a, b)
    mut ti := hash_point_t_inter(a, b)
    iter 2 do {
      tb <- mn(tb, hash_point_t_build(n))
      tw <- mn(tw, hash_point_t_twin(n))
      tg <- mn(tg, hash_point_t_get(m, n))
      tu <- mn(tu, hash_point_t_union(a, b))
      ti <- mn(ti, hash_point_t_inter(a, b))
    }
    _0 := Output.print(String.from_int((tb - tw) / n))
    _1 := Output.print(String.from_int((tg - tw) / n))
    _2 := Output.print(String.from_int((tm - tmw) / n))
    _3 := Output.print(String.from_int(tu / n))
    _4 := Output.print(String.from_int(ti / n))
    return 0
  }
