    _0 := Output.print(String.from_int(XRelMap.size(m)))
    _1 := Output.print(String.from_int(xrel_number_count_has(m, n)))
    _2 := Output.print(String.from_int(xrel_number_count_miss(m, n)))
    _3 := Output.print(String.from_int(XRelSet.size(XRelSet.union(a, b))))
    _4 := Output.print(String.from_int(XRelSet.size(XRelSet.intersect(a, b))))
    return 0
  }
  fun xrel_number_row(n: Number): Number visits Output {
    m := xrel_number_build(n)
    a := xrel_number_set(0, n)
    b := xrel_number_set(n / 2, n)
    mut tb := xrel_number_t_build(n)
    mut tw := xrel_number_t_twin(n)
    mut tg := xrel_number_t_get(m, n)
    mut tm := xrel_number_t_miss(m, n)
    mut tmw := xrel_number_t_miss_twin(n)
    mut tu := xrel_number_t_union(a, b)
    mut ti := xrel_number_t_inter(a, b)
    iter 2 do {
      tb <- mn(tb, xrel_number_t_build(n))
      tw <- mn(tw, xrel_number_t_twin(n))
      tg <- mn(tg, xrel_number_t_get(m, n))
      tm <- mn(tm, xrel_number_t_miss(m, n))
      tmw <- mn(tmw, xrel_number_t_miss_twin(n))
      tu <- mn(tu, xrel_number_t_union(a, b))
      ti <- mn(ti, xrel_number_t_inter(a, b))
    }
    _0 := Output.print(String.from_int((tb - tw) / n))
    _1 := Output.print(String.from_int((tg - tw) / n))
    _2 := Output.print(String.from_int((tm - tmw) / n))
    _3 := Output.print(String.from_int(tu / n))
    _4 := Output.print(String.from_int(ti / n))
    return 0
  }
  fun xrel_text_put(m: XRelMap<String, Number>, k: Number): XRelMap<String, Number> { return XRelMap.set(m, String.from_int(k), k) }
  fun xrel_text_has(m: XRelMap<String, Number>, k: Number): Number { return if XRelMap.has(m, String.from_int(k)) then 1 else 0 }
  fun xrel_text_miss(m: XRelMap<String, Number>, k: Number): Number { return if XRelMap.has(m, String.concat(String.from_int(k), "x")) then 1 else 0 }
  fun xrel_text_add(s: XRelSet<String>, k: Number): XRelSet<String> { return XRelSet.add(s, String.from_int(k)) }
  fun xrel_text_twin(k: Number): Number {
    key := String.from_int(k)
    return 1
  }
  fun xrel_text_miss_twin(k: Number): Number {
    key := String.concat(String.from_int(k), "x")
    return 1
  }
  fun xrel_text_build(n: Number): XRelMap<String, Number> {
    mut m := XRelMap.empty()
    mut k := 0
    iter n do {
      m <- xrel_text_put(m, k)
      k <- k + 1
    }
    return m
  }
  fun xrel_text_t_build(n: Number): Number visits Output {
    t0 := Time.now_ns(0)
    m := xrel_text_build(n)
    t1 := Time.now_ns(0)
    return (t1 - t0) + 0 * XRelMap.size(m)
  }
