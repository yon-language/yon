  fun xrel_text_row(n: Number): Number visits Output {
    m := xrel_text_build(n)
    a := xrel_text_set(0, n)
    b := xrel_text_set(n / 2, n)
    mut tb := xrel_text_t_build(n)
    mut tw := xrel_text_t_twin(n)
    mut tg := xrel_text_t_get(m, n)
    mut tm := xrel_text_t_miss(m, n)
    mut tmw := xrel_text_t_miss_twin(n)
