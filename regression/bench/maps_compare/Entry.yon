      k = k + 1
    }
    return m
  }
  fun xrel_text_t_build(n: Number): Number visits Output {
    be t0 := Time.now_ns(0)
    be m := xrel_text_build(n)
    be t1 := Time.now_ns(0)
    return (t1 - t0) + 0 * XRelMap.size(m)
  }
  fun xrel_text_t_twin(n: Number): Number visits Output {
    be acc := 0
    be k := 0
    be t0 := Time.now_ns(0)
    iter n do {
      acc = acc + xrel_text_twin(k)
      k = k + 1
    }
    return Time.now_ns(0) - t0 + 0 * acc
  }
  fun xrel_text_t_get(m: XRelMap<String, Number>, n: Number): Number visits Output {
    be acc := 0
    be k := 0
    be t0 := Time.now_ns(0)
    iter n do {
      acc = acc + xrel_text_has(m, k)
      k = k + 1
    }
    return Time.now_ns(0) - t0 + 0 * acc
  }
  fun xrel_text_t_miss(m: XRelMap<String, Number>, n: Number): Number visits Output {
    be acc := 0
    be k := 0
    be t0 := Time.now_ns(0)
    iter n do {
      acc = acc + xrel_text_miss(m, k)
      k = k + 1
    }
    return Time.now_ns(0) - t0 + 0 * acc
  }
  fun xrel_text_t_miss_twin(n: Number): Number visits Output {
    be acc := 0
    be k := 0
    be t0 := Time.now_ns(0)
    iter n do {
      acc = acc + xrel_text_miss_twin(k)
      k = k + 1
    }
    return Time.now_ns(0) - t0 + 0 * acc
  }
  fun xrel_text_set(start: Number, n: Number): XRelSet<String> {
    be s := XRelSet.empty()
    be k := start
    iter n do {
      s = xrel_text_add(s, k)
      k = k + 1
    }
    return s
  }
  fun xrel_text_t_union(a: XRelSet<String>, b: XRelSet<String>): Number visits Output {
    be t0 := Time.now_ns(0)
    be u := XRelSet.union(a, b)
    return Time.now_ns(0) - t0 + 0 * XRelSet.size(u)
  }
  fun xrel_text_t_inter(a: XRelSet<String>, b: XRelSet<String>): Number visits Output {
    be t0 := Time.now_ns(0)
    be u := XRelSet.intersect(a, b)
    return Time.now_ns(0) - t0 + 0 * XRelSet.size(u)
  }
  fun xrel_text_row(n: Number): Number visits Output {
    be m := xrel_text_build(n)
    be a := xrel_text_set(0, n)
    be b := xrel_text_set(n / 2, n)
    be tb := xrel_text_t_build(n)
    be tw := xrel_text_t_twin(n)
    be tg := xrel_text_t_get(m, n)
    be tm := xrel_text_t_miss(m, n)
    be tmw := xrel_text_t_miss_twin(n)
    be tu := xrel_text_t_union(a, b)
    be ti := xrel_text_t_inter(a, b)
    iter 2 do {
      tb = mn(tb, xrel_text_t_build(n))
      tw = mn(tw, xrel_text_t_twin(n))
      tg = mn(tg, xrel_text_t_get(m, n))
      tm = mn(tm, xrel_text_t_miss(m, n))
      tmw = mn(tmw, xrel_text_t_miss_twin(n))
      tu = mn(tu, xrel_text_t_union(a, b))
      ti = mn(ti, xrel_text_t_inter(a, b))
    }
    be _0 := Output.print(String.from_int((tb - tw) / n))
    be _1 := Output.print(String.from_int((tg - tw) / n))
    be _2 := Output.print(String.from_int((tm - tmw) / n))
    be _3 := Output.print(String.from_int(tu / n))
    be _4 := Output.print(String.from_int(ti / n))
    return 0
  }
  fun arg(i: Number): Number { return String.parse_number(Args.get(i)) }
  fun smoke(n: Number): Number visits Output {
    be _hash_point := hash_point_row(n)
    be _hash_number := hash_number_row(n)
    be _hash_text := hash_text_row(n)
    be _xrel_point := xrel_point_row(n)
    be _xrel_number := xrel_number_row(n)
    be _xrel_text := xrel_text_row(n)
    return 0
  }
  fun main(): Number visits Output {
    be full := Args.count(0) >= 4
    be fam := if full then arg(1) else 0
    be kind := if full then arg(2) else 0
    be n := if full then arg(3) else 1000
    be _warm := hash_point_twin(0)
    return if full then (if fam == 0 and kind == 0 then hash_point_row(n) else (if fam == 0 and kind == 1 then hash_number_row(n) else (if fam == 0 and kind == 2 then hash_text_row(n) else (if fam == 1 and kind == 0 then xrel_point_row(n) else (if fam == 1 and kind == 1 then xrel_number_row(n) else (if fam == 1 and kind == 2 then xrel_text_row(n) else 1)))))) else smoke(n)
  }
}
