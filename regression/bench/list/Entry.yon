place Entry {
  fun timed_cons(n: Number): Number visits Output {
    mut lc := List.empty
    mut i := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                lc <- List.cons(k, lc)
                i <- k + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_cons_base(n: Number): Number visits Output {
    mut i := 0
    mut acc := 0
    t0 := Time.now_ns(0)
    iter n do { k := i
                acc <- k
                i <- k + 1 }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun build_list(n: Number): List<Number> {
    mut lc := List.empty
    mut i := 0
    iter n do { k := i
                lc <- List.cons(k, lc)
                i <- k + 1 }
    return lc
  }
  fun timed_head(l: List<Number>, m: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter m do { h := match List.head(l) { Found as v => v, Absent => 0 }
                acc <- acc + h }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun timed_head_base(m: Number, headv: Number): Number visits Output {
    mut acc := 0
    t0 := Time.now_ns(0)
    iter m do { acc <- acc + headv }
    t1 := Time.now_ns(0)
    return (t1 - t0)
  }
  fun min2(f0: Number, f1: Number): Number { return if f0 < f1 then f0 else f1 }
  fun main(): Number visits Output {
    n := 100000
    // cons throughput: min over a few reps, net of baseline
    mut cns := timed_cons(n)
    iter 4 do { cns <- min2(cns, timed_cons(n)) }
    mut cnsb := timed_cons_base(n)
    iter 4 do { cnsb <- min2(cnsb, timed_cons_base(n)) }
    l := build_list(n)
    len := List.length(l)
    hv := match List.head(l) { Found as v => v, Absent => 0 }
    m := 1000000
    mut hd := timed_head(l, m)
    iter 11 do { hd <- min2(hd, timed_head(l, m)) }
    mut hdb := timed_head_base(m, hv)
    iter 11 do { hdb <- min2(hdb, timed_head_base(m, hv)) }
    _1 := Output.print(Text.from_int(len))                                  // final_length = N
    _2 := Output.print(Text.from_int((cns - cnsb))) // cons net ns for N
    _3 := Output.print(Text.from_int(hv))                                   // head guard (= N-1)
    _4 := Output.print(Text.from_int((hd - hdb)))      // head net ns for M
    return 0
  }
}
// BENCHMARK — List (functional cons-list): cons throughput + head latency.
// CONS: thread the list handle through a Space cell, prepend N entries, time it net of
// a baseline loop (same cell-threading, no cons). HEAD: build a list of N once, then
// time M head() probes (min-of-K, baseline-subtracted) like the equality bench.
// DCE guard: final length / accumulated head-value are printed.
//
// Stdout schema (4 ints): final_length, cons_net_ns_per_N, head_acc, head_net_ns_per_M
//   cons: N = 100000 (net/N = ns/cons) ; head: M = 1000000, K = 11 reps (net/M = ns/head).
