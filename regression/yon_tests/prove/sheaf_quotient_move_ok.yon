// a move between two pure sheaves on the quotient world. Both places carry only
// the relation field (the class label); the move transports it through the
// quotient by the identity, which trivially factors -- accepted.
world User { Person is text }
world Anon = User / cohort

place Profile in Anon {
  cohort number
}

place PublicProfile in Anon {
  cohort number
}

fun identity(x: number): number { return x }

move Publish from Profile to PublicProfile {
  cohort maps to cohort by identity
}

fun main(): number { return 0 }
