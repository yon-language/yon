// Implicit-return tail: the body's value is its last statement. Here the tail
// `be y := "text"` has type text while the declared return type is number.
// check_implicit_tail_return infers the tail and rejects via Dispatcher.subtype
// (text is not a subtype of number) -> exit 3.
place Entry {
  fun h(): Number { y := "text" }
  fun main(): Number { return 0 }
}
