// A name is defined once per scope: `be x := e` says x equals e for the whole
// scope, so a second `be x :=` in the SAME scope is refused at compile time
// ('x' is already bound in this scope). The wildcard `_` is exempt; shadowing
// in a NESTED scope is allowed; this is a flat same-scope redefinition.
//
place Entry {
  fun main(): Number {
    x := 1
    x := 2
    return x
  }
}
