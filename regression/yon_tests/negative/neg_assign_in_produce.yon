// A produce is a value, identified by its content: a store into a cell declared
// outside it would fire when the stream is consumed, so it is rejected at
// type-check time, at any depth, and so is a read of one: the value would depend on
// when the stream is consumed. The cells a produce declares are its own, and it
// writes them freely.
place Entry {
  fun main(): Number {
    mut i := 0
    s := produce {
      iter 3 do { emit i  i <- i + 1 }
    }
    return 0
  }
}
