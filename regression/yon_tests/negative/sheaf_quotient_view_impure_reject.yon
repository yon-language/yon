// the place is a valid pure sheaf (only the relation field), so the rejection is
// NOT about a fine field: it is the impurity of the observation. `tap` visits
// Output, so the view's section is effectful and cannot be a sheaf section --
// rejected at compile time.
world User { Person is text }
world Anon = User / cohort

place Profile in Anon {
  cohort number
}

fun tap(x: number): number visits Output { return x }

view PublicProfile of Profile {
  show bucket = tap(cohort)
}

fun main(): number { return 0 }
