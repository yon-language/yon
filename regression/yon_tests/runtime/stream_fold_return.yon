// A fold over a produced stream has the same value in return and in nested-expression
// position. A `s.fold(...)` on a produce/emit stream lowers to statements (a Stream__recv
// drain); desugar.ml hoists it out of a return (the SReturn case in v1_lower_stmt) and out
// of a nested expression (v1_try_hoist_stmt / v1_hoist_expr), so it never reads the
// stream handle as a list. `folded` exercises the DIRECT return position; `nested`
// exercises a fold nested in an arithmetic expression. Each must equal 42; main returns
// (42-42) + (42-42) = 0 (exit 0 = pass); a fold that read the handle as a list would
// give 0, and main a non-zero exit.
place Entry {
  fun folded(): Number {
    s := produce { emit 41 emit 1 }
    return s.fold(0, fun(a: Number, v: Number) => a + v)
  }
  fun nested(): Number {
    s := produce { emit 10 emit 20 }
    return s.fold(0, fun(a: Number, v: Number) => a + v) + 12
  }
  fun main(): Number {
    return (folded() - 42) + (nested() - 42)
  }
}
