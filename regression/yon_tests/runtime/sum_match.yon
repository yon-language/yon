place Classi { this > inj Number  law quot ∀a : Number ∀b : Number, a = b → a ↪ inj = b ↪ inj }
place Entry {
  fun seven: Classi { return 7 ↪ inj }
  fun polo: Suspension<Number> { return south }
  fun main: Number {
    payload := match seven { inj as x => x, quot as (a, b, r) => r }
    side := match polo { north => 4, south => 4, merid as a => walk i => 4 }
    return payload + side - 11
  }
}
