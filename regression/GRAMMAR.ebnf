program ::= top_decl* EOF

top_decl ::= functor_decl
           | IMPORT STR_LIT
           | IMPORT QIDENT
           | IMPORT QIDENT AS IDENT
           | IMPORT QIDENT FROM IDENT
           | place_decl
           | fun_decl
           | move_decl
           | view_decl
           | reduction_decl
           | standalone_op
           | geom_morphism_decl
           | top_let
           | topos_decl
           | morph_decl
           | nat_transform_decl

topos_decl ::= TOPOS_KW WHERE LBRACE topos_morphisms_opt topos_prop_decl*
               RBRACE
             | TOPOS_KW IDENT WHERE LBRACE topos_morphisms_opt
               topos_prop_decl* RBRACE

quantifiers ::= quantifier+

quantifier ::= FORALL IDENT
             | EXISTS IDENT

law_quantifiers ::= law_quantifier+

law_quantifier ::= FORALL IDENT COLON type_expr
                 | EXISTS IDENT COLON type_expr

typed_quantifiers ::= typed_quantifier+

typed_quantifier ::= quantifier_kw IDENT COLON IDENT

quantifier_kw ::= FORALL
                | EXISTS

topos_prop_decl ::= PROP_KW IDENT LPAREN param_list RPAREN EQ expr
                  | PROP_KW IDENT LPAREN param_list RPAREN EQ
                    typed_quantifiers LPAREN expr RPAREN
                  | PROP_KW IDENT LPAREN param_list RPAREN

topos_morphisms_opt ::= morphism_decl+?

morph_decl ::= MORPH_KW IDENT FROM IDENT TO IDENT LBRACE morph_item* RBRACE

morph_item ::= IDENT IDENT LPAREN param_list RPAREN return_type_decl? LBRACE
               stmt_list RBRACE
             | IDENT IDENT COLON FUN LPAREN param_list RPAREN (COLON
               closed_type)? FATARROW expr
             | IDENT MORPHISM_KW IDENT VIA_KW IDENT
             | LAW IDENT

nat_transform_decl ::= NAT IDENT IDENT FROM IDENT TO IDENT (IS GIVEN)? LBRACE
                       nat_transform_binding* RBRACE

nat_transform_binding ::= FOR EACH IDENT BY IDENT

geom_morphism_decl ::= GEOM_MORPHISM IDENT FROM IDENT TO IDENT LBRACE
                       geom_morphism_item* RBRACE

geom_morphism_item ::= PULL LPAREN param_list RPAREN return_type_decl? LBRACE
                       stmt_list RBRACE
                     | PUSH LPAREN param_list RPAREN return_type_decl? LBRACE
                       stmt_list RBRACE
                     | EXACT_KW PUSH

top_let ::= IDENT COLONEQ expr

place_kw ::= PLACE
           | ERROR_KW

place_param ::= IDENT
              | IDENT COLON type_expr

last_place_param ::= IDENT
                   | IDENT COLON closed_type

place_param_list ::= last_place_param
                   | place_param COMMA place_param_list

place_params ::= 
               | LT NUM_LIT GT
               | LT place_param_list GT

carried_clause ::= CARRIED BY IDENT

carrier_and_is ::= 
                 | is_clause
                 | carried_clause
                 | carried_clause IS GIVEN
                 | carried_clause is_clause
                 | carried_clause IS GIVEN is_clause

is_clause ::= IS ALGEBRA
            | IS IDENT
            | IS INTERNAL IDENT

place_uses_clause ::= USES ALGEBRA IDENT (COMMA IDENT)*

place_decl ::= INTERNAL? place_kw IDENT place_params carrier_and_is
               place_uses_clause? over_clause? on_error_clause? LBRACE
               place_member_list RBRACE

over_clause ::= OVER IDENT

on_error_clause ::= ON_ERROR IDENT

field_or_cell ::= field_decl
                | cell_decl

place_member_list ::= member_items

variant_clause ::= THIS GT arm (COLON_U arm)* ARMS_END

member_items ::= 
               | place_member member_items
               | bare_operation members_after_bare

members_after_bare ::= 
                     | place_member_no_on_error member_items
                     | bare_operation members_after_bare

place_member ::= place_member_no_on_error
               | ON_ERROR IDENT

place_member_no_on_error ::= field_or_cell
                           | variant_clause
                           | operation_decl
                           | LAW IDENT
                           | LAW IDENT LAW_STATEMENT expr (IS GIVEN)?
                           | LAW IDENT law_quantifiers COMMA expr (IS GIVEN)?
                           | LAW IDENT quantifiers LPAREN expr RPAREN (IS
                             GIVEN)?
                           | LAW IDENT quantifiers COMMA expr (IS GIVEN)?
                           | OVER IDENT
                           | THIS LT IDENT
                           | CARRIED BY IDENT (IS GIVEN)?
                           | fun_decl
                           | move_decl
                           | functor_decl
                           | geom_morphism_decl
                           | view_decl
                           | reduction_decl
                           | morph_decl
                           | nat_transform_decl

field_decl ::= IDENT type_expr
             | IDENT COLONEQ type_expr

cell_decl ::= CELL IDENT FROM expr TO expr

operation_decl ::= OPERATION IDENT return_type_decl op_symbol?
                   uses_algebra_clause?
                 | OPERATION IDENT LPAREN param_list RPAREN operation_tail

operation_tail ::= on_error_clause return_type_decl? op_symbol?
                   uses_algebra_clause?
                 | return_type_decl op_symbol? uses_algebra_clause?
                 | op_symbol uses_algebra_clause?
                 | uses_algebra_clause

bare_operation ::= OPERATION IDENT LPAREN param_list RPAREN

morphism_decl ::= MORPHISM_KW IDENT LPAREN param_list RPAREN
                  return_type_decl?

op_symbol ::= AS STR_LIT

uses_algebra_clause ::= USES ALGEBRA IDENT

functor_decl ::= FUNCTOR IDENT LPAREN (lambda_param (COMMA lambda_param)*)?
                 RPAREN FROM IDENT TO IDENT functor_laws LBRACE RETURN expr
                 RBRACE

functor_law ::= LAW IDENT

functor_laws ::= functor_law*

standalone_op ::= operation_decl
                | bare_operation

return_type_decl ::= COLON type_expr

param_list ::= (param (COMMA param)*)?

param ::= IDENT COLON type_expr
        | IDENT

lambda_param ::= IDENT COLON type_expr
               | IDENT

type_expr ::= PATH_TYPE expr EQ expr
            | PATH_TYPE expr EQ expr EQ expr
            | PATH_TYPE path_meet
            | open_type
            | arrow_type

closed_type ::= PATH_TYPE path_meet
              | closed_open_type
              | closed_arrow_type

closed_open_type ::= PI IDENT COLON type_expr COMMA closed_type
                   | SIGMA IDENT COLON type_expr COMMA closed_type

closed_arrow_type ::= type_atom
                    | arrow_domain ARROW closed_arrow_codomain
                    | LPAREN type_expr COMMA type_expr (COMMA type_expr)*
                      RPAREN ARROW closed_arrow_codomain

closed_arrow_codomain ::= closed_arrow_type
                        | closed_open_type

open_type ::= PI IDENT COLON type_expr COMMA type_expr
            | SIGMA IDENT COLON type_expr COMMA type_expr

arrow_type ::= type_atom
             | arrow_domain ARROW arrow_codomain
             | LPAREN type_expr COMMA type_expr (COMMA type_expr)* RPAREN
               ARROW arrow_codomain

arrow_codomain ::= arrow_type
                 | open_type

path_meet ::= parenthesized_path AMPAMPQ parenthesized_path
            | path_meet AMPAMPQ parenthesized_path

parenthesized_path ::= LPAREN expr EQ expr RPAREN

named_type ::= IDENT DOT IDENT
             | IDENT LT type_argument_list GT
             | IDENT

type_argument ::= type_atom
                | open_type

last_type_argument ::= type_atom
                     | closed_open_type

type_argument_list ::= last_type_argument
                     | type_argument COMMA type_argument_list

type_atom ::= arrow_domain
            | LPAREN type_expr COMMA type_expr (COMMA type_expr)* RPAREN

arrow_domain ::= TYPE_KW
               | TYPE_LEVEL
               | PI LPAREN
               | SIGMA LPAREN
               | ID LPAREN type_expr COMMA expr COMMA expr RPAREN
               | SAME LPAREN expr COMMA expr RPAREN
               | PATHP LPAREN IDENT COMMA type_expr COMMA IDENT COMMA IDENT
                 RPAREN
               | EL LPAREN expr RPAREN
               | named_type
               | IDENT IN
               | IDENT PIPE variant (PIPE variant)*
               | IDENT LPAREN (type_expr (COMMA type_expr)*)? RPAREN PIPE
                 variant (PIPE variant)*
               | HEYT_INT_KW LT NUM_LIT GT
               | MOVE FROM IDENT TO IDENT
               | REDUCTION OF IDENT
               | MORPH_KW FROM IDENT TO IDENT
               | VIEW OF IDENT
               | LPAREN type_expr RPAREN
               | LBRACE IDENT COLON type_expr WHERE type_expr RBRACE

hit_branch ::= IDENT FATARROW expr
             | IDENT AS IDENT FATARROW expr
             | BOOL_LIT FATARROW expr
             | IDENT AS LPAREN IDENT (COMMA IDENT)* RPAREN FATARROW expr
             | IDENT LPAREN (IDENT (COMMA IDENT)*)? RPAREN FATARROW expr
             | IDENT LBRACE pat_field* RBRACE FATARROW expr

pat_field ::= IDENT
            | IDENT AS IDENT

variant ::= IDENT
          | BOOL_LIT
          | IDENT LPAREN (type_expr (COMMA type_expr)*)? RPAREN

arm ::= IDENT named_type*
      | BOOL_LIT
      | IDENT named_type* COLON PATH_TYPE expr EQ expr
      | IDENT LPAREN (type_expr (COMMA type_expr)*)? RPAREN

field_path ::= IDENT (DOT IDENT)*

ident_list ::= IDENT (COMMA IDENT)*

fun_decl ::= INTERNAL? PROOF? FUN IDENT type_params_opt LPAREN param_list
             RPAREN on_error_clause? return_type_decl? visits_clause IS GIVEN
           | INTERNAL? PROOF? FUN IDENT type_params_opt return_type_decl?
             visits_clause IS GIVEN
           | INTERNAL? PROOF? FUN IDENT type_params_opt return_type_decl?
             visits_clause LBRACE stmt_list RBRACE
           | INTERNAL? PROOF? FUN IDENT type_params_opt return_type_decl?
             visits_clause IS GIVEN LBRACE stmt_list RBRACE
           | INTERNAL? PROOF? FUN IDENT type_params_opt LPAREN param_list
             RPAREN on_error_clause? return_type_decl? visits_clause IS GIVEN
             LBRACE stmt_list RBRACE
           | INTERNAL? PROOF? FUN IDENT type_params_opt LPAREN param_list
             RPAREN on_error_clause? return_type_decl? visits_clause LBRACE
             stmt_list RBRACE

type_params_opt ::= 
                  | LT type_param (COMMA type_param)* GT
                  | LT_TYPE_ARGS IDENT (COMMA IDENT)* GT

type_param ::= IDENT
             | IDENT USES IDENT

visits_clause ::= (VISITS ident_list)?

move_decl ::= MOVE IDENT FROM IDENT TO IDENT optional_requires LBRACE
              mapping_decl* RBRACE
            | MOVE IDENT UNIFIES ident_list optional_requires LBRACE
              merge_body RBRACE

optional_requires ::= (REQUIRES IDENT (COMMA IDENT)*)?

mapping_decl ::= IDENT MAPS TO IDENT BY IDENT
               | IDENT CONVERTS TO IDENT BY IDENT
               | IDENT AGGREGATES TO IDENT BY IDENT
               | IDENT MAPS TO IDENT BY FUN LPAREN (lambda_param (COMMA
                 lambda_param)*)? RPAREN FATARROW expr
               | IDENT CONVERTS TO IDENT BY FUN LPAREN (lambda_param (COMMA
                 lambda_param)*)? RPAREN FATARROW expr
               | IDENT AGGREGATES TO IDENT BY FUN LPAREN (lambda_param (COMMA
                 lambda_param)*)? RPAREN FATARROW expr

merge_body ::= share_clause? conflict_clause*

share_clause ::= SHARE ident_list

conflict_clause ::= IDENT IDENT IDENT RESOLVES TO IDENT

view_decl ::= VIEW IDENT OF IDENT LBRACE view_item* RBRACE

view_item ::= SHOW IDENT
            | SHOW IDENT EQ expr
            | SHOW IDENT AS STR_LIT

reduction_decl ::= REDUCTION IDENT reduction_type_params? OF IDENT
                   WITH_MULTI_SHOT? fold_decl_opt LBRACE reduction_clause*
                   RBRACE

fold_decl_opt ::= (FOLD STR_LIT)?

reduction_type_params ::= LT IDENT (COMMA IDENT)* GT

WITH_MULTI_SHOT ::= WITH MULTI_SHOT

reduction_clause ::= on_clause
                   | IDENT COLONEQ expr

on_clause ::= IDENT IDENT LPAREN param_list RPAREN LBRACE stmt_list RBRACE

stmt_list ::= 
            | stmt stmt_list
            | closed_when stmt_list
            | open_when stmts_after_open_when

stmts_after_open_when ::= (stmt stmt_list)?

stmt ::= let_stmt
       | assign_stmt
       | return_stmt
       | call_or_new_stmt
       | for_stmt
       | in_seq_stmt
       | repeat_stmt
       | forever_stmt
       | scope_stmt
       | produce_stmt
       | emit_stmt
       | promote_stmt
       | DROP IDENT
       | IN IDENT
       | iter_stmt
       | while_stmt
       | forces_stmt

iter_stmt ::= ITER_KW expr DO_KW LBRACE stmt_list RBRACE

while_stmt ::= WHILE_KW expr DO_KW LBRACE stmt_list RBRACE

let_stmt ::= IDENT COLONEQ expr
           | MUT IDENT COLONEQ expr

assign_stmt ::= lvalue LARROW expr

lvalue ::= IDENT
         | IDENT DOT IDENT

return_stmt ::= RETURN expr
              | RETURN PATH_TYPE expr EQ expr

call_or_new_stmt ::= IDENT DOT IDENT LPAREN expr_list RPAREN
                   | IDENT DOT FOLD LPAREN expr_list RPAREN
                   | IDENT DOT PUSH LPAREN expr_list RPAREN
                   | IDENT LPAREN expr_list RPAREN
                   | QIDENT LPAREN expr_list RPAREN
                   | DOTARROW IDENT LBRACE field_assign_list RBRACE

forces_stmt ::= FORCES IDENT condition LBRACE stmt_list RBRACE

open_when ::= WHEN condition LBRACE stmt_list RBRACE open_chain

closed_when ::= WHEN condition LBRACE stmt_list RBRACE closed_chain

open_chain ::= (WHEN condition LBRACE stmt_list RBRACE)*

closed_chain ::= WHEN condition LBRACE stmt_list RBRACE closed_chain
               | OTHERWISE LBRACE stmt_list RBRACE

for_stmt ::= FOR EVERY IDENT IN expr WHEN HERE LBRACE stmt_list RBRACE
           | FOR EVERY IDENT IN expr LBRACE stmt_list RBRACE

in_seq_stmt ::= IN SEQUENCE OVER IDENT IN expr LBRACE stmt_list RBRACE

repeat_stmt ::= REPEAT AT MOST NUM_LIT TIMES LBRACE stmt_list RBRACE
                repeat_tail

repeat_tail ::= (OTHERWISE LBRACE stmt_list RBRACE)?

forever_stmt ::= FOREVER LBRACE stmt_list RBRACE

scope_stmt ::= SCOPE IDENT LBRACE stmt_list RBRACE
             | SCOPE LBRACE stmt_list RBRACE

produce_stmt ::= PRODUCE LBRACE stmt_list RBRACE

emit_stmt ::= EMIT expr

promote_stmt ::= PROMOTE expr

expr ::= open_form
       | bor_expr LRARROW operand_0 BY expr COMMA open_form
       | iff_expr

open_form ::= IF_KW expr THEN_KW expr ELSE_KW expr
            | FUN LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
              FATARROW expr
            | walk_kw IDENT FATARROW expr

open_in_operator ::= IF_KW
                   | walk_kw
                   | FUN LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
                     FATARROW chained_expr

iff_expr ::= imp_expr IFFQ operand_1
           | imp_expr

imp_expr ::= or_expr FATARROW operand_2
           | or_expr FATARROWQ operand_2
           | or_expr

or_expr ::= or_expr OR operand_3
          | or_expr PIPEPIPE operand_3
          | or_expr PIPEPIPEQ operand_3
          | and_expr

and_expr ::= and_expr AND operand_4
           | and_expr AMPAMP operand_4
           | and_expr AMPAMPQ operand_4
           | cmp_expr

cmp_expr ::= cmp_expr LT operand_5
           | cmp_expr GT operand_5
           | cmp_expr LEQ operand_5
           | cmp_expr GEQ operand_5
           | cmp_expr EQEQ operand_5
           | cmp_expr NEQ operand_5
           | at_expr

at_expr ::= path_point
          | path_point tighter_than_at
          | map_expr

path_point ::= at_expr ATSIGN I0
             | at_expr ATSIGN I1
             | at_expr ATSIGN IDENT

tighter_than_at ::= PIPEGT
                  | MAPSTO
                  | INJ
                  | LRARROW
                  | PIPE
                  | PIPEQ
                  | CARET
                  | CARETQ
                  | AMP
                  | AMPQ
                  | PLUS
                  | MINUS
                  | PLUSPLUS
                  | STAR
                  | SLASH
                  | PERCENT
                  | THROUGH

map_expr ::= map_expr MAPSTO operand_6
           | map_expr INJ operand_6
           | map_expr PIPEGT operand_6
           | equiv_expr

equiv_expr ::= bor_expr LRARROW operand_0
             | bor_expr LRARROW operand_0 BY expr COMMA bor_expr
             | bor_expr

bor_expr ::= bor_expr PIPE operand_7
           | bhor_expr

bhor_expr ::= bhor_expr PIPEQ operand_8
            | bxor_expr

bxor_expr ::= bxor_expr CARET operand_9
            | bxor_expr CARETQ operand_9
            | band_expr

band_expr ::= band_expr AMP operand_10
            | band_expr AMPQ operand_10
            | add_expr

add_expr ::= add_expr PLUS operand_11
           | add_expr MINUS operand_11
           | concat_expr

concat_expr ::= concat_expr PLUSPLUS operand_12
              | mul_expr

mul_expr ::= mul_expr STAR operand_13
           | mul_expr SLASH operand_13
           | mul_expr PERCENT operand_13
           | unary_expr

unary_expr ::= prefixed
             | through_expr

prefixed ::= NOT operand_13
           | BANG operand_13
           | ESCAPE operand_13
           | TILDE operand_13
           | BANGQ operand_13
           | TILDEQ operand_13
           | MINUS operand_13

through_expr ::= closed_through
               | closed_through THROUGH prefixed
               | closed_through THROUGH open_in_operator

closed_through ::= chained_expr (THROUGH chained_expr)*

chained_expr ::= name_ending
               | receiver

name_ending ::= name_atom
              | prefixed_atom_0

receiver ::= other_atom
           | receiver DOT IDENT LPAREN expr_list RPAREN
           | receiver DOT FOLD LPAREN expr_list RPAREN

expr_atom ::= name_ending
            | other_atom

name_atom ::= IDENT DOT field_path
            | IDENT

other_atom ::= prefixed_atom_1
             | literal
             | FUN LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
               FATARROW LBRACE stmt_list RBRACE
             | HEYT_INT_KW LPAREN expr COMMA expr RPAREN
             | HEYT_INT_KW LPAREN expr RPAREN
             | MOVE LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
               FATARROW expr FROM IDENT TO IDENT
             | REDUCTION LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
               FATARROW expr OF IDENT
             | MORPH_KW LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
               FATARROW expr FROM IDENT TO IDENT
             | FUNCTOR LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
               FATARROW expr FROM IDENT TO IDENT functor_laws
             | VIEW LPAREN (lambda_param (COMMA lambda_param)*)? RPAREN
               FATARROW expr OF IDENT
             | HCOMP IDENT LBRACKET (hcomp_side (COMMA hcomp_side)*)?
               RBRACKET hcomp_base
             | COMP LPAREN expr RPAREN LBRACKET (hcomp_side (COMMA
               hcomp_side)*)? RBRACKET hcomp_base
             | PRESENT
             | ABSENT
             | UNKNOWN
             | REFL LPAREN expr RPAREN
             | CLEAR
             | PAIR LPAREN expr COMMA expr RPAREN
             | LPAREN expr COMMA expr (COMMA expr)* RPAREN
             | FST LPAREN expr RPAREN
             | SND LPAREN expr RPAREN
             | INDUCT LPAREN expr COMMA expr RPAREN
             | IND_PATH LPAREN expr COMMA expr COMMA expr RPAREN
             | QUOTE LPAREN IDENT COMMA expr RPAREN
             | EL_MATCH LPAREN expr COMMA expr COMMA expr RPAREN
             | HIT_ELIM LPAREN expr COMMA LBRACKET (hit_branch (COMMA
               hit_branch)*)? RBRACKET COMMA expr RPAREN
             | MATCH_KW expr_atom LBRACE (hit_branch (COMMA hit_branch)*)?
               RBRACE
             | HIT_KW LPAREN IDENT RPAREN
             | HIT_KW LPAREN IDENT COMMA expr (COMMA expr)* RPAREN
             | IDENT DOT IDENT LPAREN expr_list RPAREN
             | IDENT LT_TYPE_ARGS IDENT (COMMA IDENT)* GT LPAREN expr_list
               RPAREN
             | IDENT DOT IDENT LT_TYPE_ARGS IDENT (COMMA IDENT)* GT LPAREN
               expr_list RPAREN
             | IDENT DOT FOLD LPAREN expr_list RPAREN
             | IDENT DOT PUSH LPAREN expr_list RPAREN
             | IDENT LPAREN expr_list RPAREN
             | QIDENT LPAREN expr_list RPAREN
             | IDENT DOT STREAM
             | QIDENT
             | DOTARROW IDENT LBRACE field_assign_list RBRACE
             | WIRE TO SPACE IDENT
             | PRODUCE LBRACE stmt_list RBRACE
             | SPAWN LBRACE stmt_list RBRACE
             | SPAWN IN expr PARALLEL LBRACE stmt_list RBRACE
             | LPAREN expr RPAREN

walk_kw ::= WALK
          | PLAM

hcomp_side ::= IDENT EQ I0 FATARROW walk_kw IDENT FATARROW expr
             | IDENT EQ I1 FATARROW walk_kw IDENT FATARROW expr

hcomp_base ::= literal
             | IDENT
             | LPAREN expr RPAREN

expr_list ::= (expr (COMMA expr)*)?

literal ::= NUM_LIT
          | STR_LIT
          | BOOL_LIT

field_assign_list ::= field_assign*

field_assign ::= IDENT expr

condition ::= cond_or

is_atom ::= expr IS pattern
          | expr IS NOT pattern

cond_and_closed ::= is_atom (AND is_atom)*

cond_and ::= cond_and_closed
           | cond_and_closed AND expr
           | expr

cond_or_closed ::= cond_and_closed (OR cond_and_closed)*

cond_or ::= cond_and
          | cond_or_closed OR cond_and

pattern ::= IDENT
          | literal
          | PRESENT
          | ABSENT
          | UNKNOWN

operand_1 ::= iff_expr
            | open_in_operator

operand_4 ::= cmp_expr
            | open_in_operator

operand_10 ::= add_expr
             | open_in_operator

operand_7 ::= bhor_expr
            | open_in_operator

operand_12 ::= mul_expr
             | open_in_operator

operand_11 ::= concat_expr
             | open_in_operator

operand_5 ::= at_expr
            | open_in_operator

prefixed_atom_1 ::= COMPOSE expr_atom WITH other_atom
                  | CLEAR other_atom
                  | BACK other_atom
                  | CARRY expr_atom ALONG other_atom

operand_9 ::= band_expr
            | open_in_operator

operand_3 ::= and_expr
            | open_in_operator

operand_6 ::= equiv_expr
            | open_in_operator

operand_8 ::= bxor_expr
            | open_in_operator

operand_2 ::= imp_expr
            | open_in_operator

operand_0 ::= bor_expr
            | open_in_operator

operand_13 ::= unary_expr
             | open_in_operator

prefixed_atom_0 ::= COMPOSE expr_atom WITH name_ending
                  | CLEAR name_ending
                  | BACK name_ending
                  | CARRY expr_atom ALONG name_ending


