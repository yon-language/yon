import meteo::samples from Meteo

world W { Code is X }
place Reading in W { temp number humidity number }

fun main(): number {
  be w holds wire to space Meteo
  be sub holds w.awaits(samples)
  be s holds sub.stream
  be total holds s.fold(0, fun(a: number, r: Reading) => a + r.temp)
  return total      // 10+11+15 = 36
}
