// Consumer: attaches, drains eight readings in a loop, exits with the sum.
place Entry {
  fun main(): Number {
    w := Wire.make_shm(9, 0)
    mut total := 0
    mut i := 0
    while i < 8 do {
      v := Wire.await_shm(w)
      total <- total + v
      i <- i + 1
    }
    return total          // 1+2+...+8 = 36
  }
}
