import nested_prod::pairs from Nested

world W { Code is X }
place Inner in W { a number b text }
place Outer in W { tag number inner Inner }

fun main(): number {
  be w holds wire to Nested
  be sub holds w.awaits(pairs)
  be s holds sub.stream
  be total holds s.fold(0, fun(acc: number, o: Outer) => acc + o.tag + o.inner.a + String.length(o.inner.b))
  return total      // (7+3+2) + (8+4+2) = 26
}
