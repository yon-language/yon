import weather::forecasts from Weather

world W { Code is X }
place Reading in W { temp number label text }

fun main(): number {
  be w holds wire to space Weather
  be sub holds w.awaits(forecasts)
  be s holds sub.stream
  be total holds s.fold(0, fun(a: number, r: Reading) => a + r.temp + String.length(r.label))
  return total      // (10+11+15) + length("ok")*3 = 36 + 6 = 42
}
