// Spawn-N scaling with a checked result (test fixture for test_spawn_scaling).
// The book's bench/spawn_scaling program (which stays as the book prints it), with
// each replica's result kept: replica i runs the same fixed CPU-bound task (heavy)
// seeded with 2^i, so the folded collection must be N * 56000000 + (2^N - 1).
// The 2^N - 1 part is the sum of N DISTINCT powers of two, which N powers of two
// from 2^0 .. 2^(N-1) reach only when every index 0..N-1 occurs exactly once: a
// lost, duplicated or re-run replica changes the total.
// Stdout, for N = 1, 2, 4, 8, 16: one line "wall_ms", then one line "total".
place Entry {
  fun pow2(i: Number): Number {
    be p := Space.make(1)
    iter i do { be _ := Space.set(p, Space.get(p) * 2) }
    return Space.get(p)
  }
  fun heavy(seed: Number): Number {
    be acc := Space.make(seed)
    iter 8000000 do { be _ := Space.set(acc, Space.get(acc) + 7) }
    return Space.get(acc)
  }
  fun run(n: Number): Number visits Output {
    be results := spawn in n parallel { promote heavy(pow2(spawn_index)) }
    return results.fold(0, fun(a: Number, v: Number) => a + v)
  }
  fun timed(n: Number): Number visits Output {
    be t0 := Time.now_ns(0)
    be total := run(n)
    be _w := Output.print(String.from_int((Time.now_ns(0) - t0) / 1000000))
    be _t := Output.print(String.from_int(total))
    return 0
  }
  fun main(): Number visits Output {
    be _1 := timed(1)
    be _2 := timed(2)
    be _4 := timed(4)
    be _8 := timed(8)
    be _16 := timed(16)
    return 0
  }
}
