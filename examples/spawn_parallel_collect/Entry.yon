place Entry {
// spawn { } end-to-end: fork 4 isolated replicas, each promotes its index+1
// onto the collection stream; the parent folds the stream by summing. The
// stream is unordered, but the sum is order-independent, so the result is
// deterministic: (0+1)+(1+1)+(2+1)+(3+1) = 1+2+3+4 = 10.
fun main(): Number {
  be results holds spawn in 4 parallel {
    promote spawn_index + 1
  }
  be total holds results.fold(0, fun(a: Number, v: Number) => a + v)
  return total
}
}
