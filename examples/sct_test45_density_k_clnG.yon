/* SCT Test 45 — §34.6 Density k = c·ln(G) regressione lineare runtime.
 *
 * Hypothesis paper §34.6: k (active groups) cresce come c·ln(G).
 * Se vero → polynomial bound |R| = G^(c·o_eff).
 *
 * Test: misuro <k> e ln(G) per n=6,8,10,12 (10-seed average each).
 * Fit lineare semplice: k = a*ln(G) + b. Output a (slope) e b (intercept).
 *
 * Se a > 0 e b ~ 0 → hypothesis supported.
 * Se trend NON-lineare → reject hypothesis. */

fun avg_k10(n: number): number {
  be k1 holds SAT.run_3sat_filtered(n, 100, 1, 2)
  be k2 holds SAT.run_3sat_filtered(n, 101, 1, 2)
  be k3 holds SAT.run_3sat_filtered(n, 102, 1, 2)
  be k4 holds SAT.run_3sat_filtered(n, 103, 1, 2)
  be k5 holds SAT.run_3sat_filtered(n, 104, 1, 2)
  be k6 holds SAT.run_3sat_filtered(n, 105, 1, 2)
  be k7 holds SAT.run_3sat_filtered(n, 106, 1, 2)
  be k8 holds SAT.run_3sat_filtered(n, 107, 1, 2)
  be k9 holds SAT.run_3sat_filtered(n, 108, 1, 2)
  be k10 holds SAT.run_3sat_filtered(n, 109, 1, 2)
  return (k1+k2+k3+k4+k5+k6+k7+k8+k9+k10) / 10
}

fun main(): number {
  be G6 holds SAT.run_3sat_filtered(6, 100, 1, 5)
  be k6 holds avg_k10(6)
  be lG6 holds Math.log(G6)

  be G8 holds SAT.run_3sat_filtered(8, 100, 1, 5)
  be k8 holds avg_k10(8)
  be lG8 holds Math.log(G8)

  be G10 holds SAT.run_3sat_filtered(10, 100, 1, 5)
  be k10 holds avg_k10(10)
  be lG10 holds Math.log(G10)

  be G12 holds SAT.run_3sat_filtered(12, 100, 1, 5)
  be k12 holds avg_k10(12)
  be lG12 holds Math.log(G12)

  /* Linear regression k = a*ln(G) + b via least squares.
   * a = (N*Σxy - Σx*Σy) / (N*Σx² - (Σx)²)
   * b = (Σy - a*Σx) / N
   * con x=ln(G), y=k, N=4 */
  be N holds 4
  be sx holds lG6 + lG8 + lG10 + lG12
  be sy holds k6 + k8 + k10 + k12
  be sxy holds lG6*k6 + lG8*k8 + lG10*k10 + lG12*k12
  be sxx holds lG6*lG6 + lG8*lG8 + lG10*lG10 + lG12*lG12

  be denom holds N * sxx - sx * sx
  be a holds (N * sxy - sx * sy) / denom
  be b holds (sy - a * sx) / N

  be _io1 holds IO.print_num(k6)
  be _io2 holds IO.print_num(k8)
  be _io3 holds IO.print_num(k10)
  be _io4 holds IO.print_num(k12)

  be _io5 holds IO.print_num(lG6)
  be _io6 holds IO.print_num(lG8)
  be _io7 holds IO.print_num(lG10)
  be _io8 holds IO.print_num(lG12)

  be _ioA holds IO.print_num(a)
  be _ioB holds IO.print_num(b)

  /* fit quality: R² */
  be mean_y holds sy / N
  be ssres holds (k6 - (a*lG6+b)) * (k6 - (a*lG6+b))
                + (k8 - (a*lG8+b)) * (k8 - (a*lG8+b))
                + (k10 - (a*lG10+b)) * (k10 - (a*lG10+b))
                + (k12 - (a*lG12+b)) * (k12 - (a*lG12+b))
  be sstot holds (k6 - mean_y)*(k6 - mean_y)
                + (k8 - mean_y)*(k8 - mean_y)
                + (k10 - mean_y)*(k10 - mean_y)
                + (k12 - mean_y)*(k12 - mean_y)
  be R2 holds 1 - ssres / sstot
  be _ioR2 holds IO.print_num(R2)

  return Math.floor(a * 100)
}
