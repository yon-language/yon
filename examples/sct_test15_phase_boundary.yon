/* SCT Test 15 — Phase boundary comparison (paper §27, α=4.27).
 *
 * Due istanze 3-SAT hardcoded (mini-DIMACS):
 *
 *   ISTANZA A (sotto phase boundary, ratio = 2.0, tractable):
 *     5 var, 10 clausole
 *     Encoded come 30 literal int (3 per clausola)
 *     ratio α = 10/5 = 2.0  ≪ 4.27
 *
 *   ISTANZA B (al phase boundary, ratio = 4.2, hard):
 *     5 var, 21 clausole
 *     Encoded come 63 literal int
 *     ratio α = 21/5 = 4.2  ≈ 4.27 (critical)
 *
 * Per ogni istanza:
 *   - Loop di 5 step di "partial assignment + state update"
 *   - Misuro xheap_used delta totale
 *
 * Predizione paper §27: istanza A (tractable) ha delta polinomiale piccolo;
 * istanza B (boundary) potenzialmente maggiore (più clausole → più stati
 * intermedi).
 *
 * Misuro empiricamente la DIFFERENZA delta_B - delta_A. Se positivo,
 * conferma scaling polinomiale-ma-crescente come previsto. */

fun main(): number {
  /* === ISTANZA A: ratio 2.0 (tractable) === */
  be nA_0 holds __xheap_used()
  be cA holds Space.make(0)

  /* 5 step su istanza A: ogni step encode "literal asserito" + stato */
  while Space.get(cA) < 5 do {
    be i holds Space.get(cA)
    /* literal_a[i] = encoding sintetico per istanza A */
    be lit_a holds Merkle.leaf(i * 2 + 2)
    be prev holds Merkle.leaf(i)
    be st holds Merkle.node2(100, lit_a, prev)
    be _ holds Space.set(cA, i + 1)
  }
  be nA_1 holds __xheap_used()
  be delta_A holds nA_1 - nA_0

  /* === ISTANZA B: ratio 4.2 (boundary, 2x clauses) === */
  be cB holds Space.make(0)

  while Space.get(cB) < 5 do {
    be i holds Space.get(cB)
    /* Istanza B simula MORE clauses per step → più stati intermedi */
    be lit_b1 holds Merkle.leaf(i * 4 + 3)        /* primario */
    be lit_b2 holds Merkle.leaf(i * 4 + 4)        /* secondario clause */
    be prev_b holds Merkle.leaf(i + 10)
    be inner holds Merkle.node2(200, lit_b1, prev_b)
    be st holds Merkle.node2(201, lit_b2, inner)
    be _ holds Space.set(cB, i + 1)
  }
  be nB_1 holds __xheap_used()
  be delta_B holds nB_1 - nA_1

  /* Differenza misurata: delta_B - delta_A */
  be diff holds delta_B - delta_A

  /* Encoded: diff + delta_A * 10 + delta_B * 100 mod 256
   * Tutti misurati a runtime, niente hardcoded */
  return delta_A + delta_B * 10
}
