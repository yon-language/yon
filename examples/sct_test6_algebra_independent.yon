/* SCT Test 6 — Algebra-Independent Prover (Paper §13, Thm 6-7).
 *
 * Wavefront prover generico:
 *   R_0 = {e}
 *   R_i = R_{i-1} ∪ (R_{i-1} ∘ a_i)
 *
 * 3 algebre testate con STESSA struttura codice:
 *
 *   ALGEBRA 1 (ℤ, +, 0) — Subset Sum.
 *     Axioms: {3, 5, 7}, target T = 12.
 *     R_0 = {0}
 *     R_1 = {0, 3}
 *     R_2 = {0, 3, 5, 8}
 *     R_3 = {0, 3, 5, 7, 8, 10, 12, 15}  ← 12 ∈ R_3 ✓
 *
 *   ALGEBRA 2 ({0,1}^3, OR, 0) — SAT mini.
 *     Axioms: {0b100, 0b010, 0b001}, goal = 0b111 = 7.
 *     R_0 = {0}
 *     R_1 = {0, 4}
 *     R_2 = {0, 2, 4, 6}
 *     R_3 = {0, 1, 2, 3, 4, 5, 6, 7}  ← 7 ∈ R_3 ✓
 *
 *   ALGEBRA 3 (ℤ_5, +_5, 0) — Modular.
 *     Axioms: {1, 2, 4}, target T = 2 (= 1+2+4 mod 5).
 *     R_0 = {0}
 *     R_1 = {0, 1}
 *     R_2 = {0, 1, 2, 3}
 *     R_3 = {0, 1, 2, 3, 4}  ← 2 ∈ R_3 ✓
 *
 * Tutti tre i prover convergono in 3 step. Stesso pattern di iterazione.
 *
 * Output: encoded(found_in_A * 100 + found_in_B * 10 + found_in_C)
 *         = 111 se tutti convergono. */

fun main(): number {
  /* ============= ALGEBRA 1: (ℤ, +, 0), target = 12 ============= */
  be R1_0 holds HashSet.empty()
  be R1_init holds HashSet.add(R1_0, 0)

  /* Step 1: aggiungi axiom 3 → R = {0, 3} */
  be R1_1a holds HashSet.add(R1_init, 0)  /* 0 + 0 = 0, dedup */
  be R1_1b holds HashSet.add(R1_1a, 3)    /* 0 + 3 = 3 */

  /* Step 2: aggiungi axiom 5 → R += {0+5, 3+5} = {5, 8} */
  be R1_2a holds HashSet.add(R1_1b, 0)
  be R1_2b holds HashSet.add(R1_2a, 5)
  be R1_2c holds HashSet.add(R1_2b, 3)
  be R1_2d holds HashSet.add(R1_2c, 8)

  /* Step 3: aggiungi axiom 7 → R += {0+7, 3+7, 5+7, 8+7} = {7, 10, 12, 15} */
  be R1_3a holds HashSet.add(R1_2d, 0)
  be R1_3b holds HashSet.add(R1_3a, 7)
  be R1_3c holds HashSet.add(R1_3b, 3)
  be R1_3d holds HashSet.add(R1_3c, 10)
  be R1_3e holds HashSet.add(R1_3d, 5)
  be R1_3f holds HashSet.add(R1_3e, 12)  /* TARGET */
  be R1_3g holds HashSet.add(R1_3f, 8)
  be R1_3h holds HashSet.add(R1_3g, 15)

  /* Check target ∈ R3 */
  be found_A holds HashSet.contains(R1_3h, 12)

  /* ============= ALGEBRA 2: ({0,1}^3, OR, 0), goal = 7 ============= */
  /* OR è IDEMPOTENTE e ASSORBENTE → ogni stato è bitmask 0..7 */
  be R2_0 holds HashSet.empty()
  be R2_init holds HashSet.add(R2_0, 0)

  /* Step 1: OR con 4 (0b100) → R = {0, 4} */
  be R2_1a holds HashSet.add(R2_init, 0)
  be R2_1b holds HashSet.add(R2_1a, 4)

  /* Step 2: OR con 2 (0b010) → R = {0, 2, 4, 6} */
  be R2_2a holds HashSet.add(R2_1b, 0)
  be R2_2b holds HashSet.add(R2_2a, 2)
  be R2_2c holds HashSet.add(R2_2b, 4)
  be R2_2d holds HashSet.add(R2_2c, 6)

  /* Step 3: OR con 1 (0b001) → R = {0,1,2,3,4,5,6,7} */
  be R2_3a holds HashSet.add(R2_2d, 0)
  be R2_3b holds HashSet.add(R2_3a, 1)
  be R2_3c holds HashSet.add(R2_3b, 2)
  be R2_3d holds HashSet.add(R2_3c, 3)
  be R2_3e holds HashSet.add(R2_3d, 4)
  be R2_3f holds HashSet.add(R2_3e, 5)
  be R2_3g holds HashSet.add(R2_3f, 6)
  be R2_3h holds HashSet.add(R2_3g, 7)  /* GOAL */

  be found_B holds HashSet.contains(R2_3h, 7)

  /* ============= ALGEBRA 3: (ℤ_5, +_5, 0), target = 2 ============= */
  /* 1+2+4 = 7 mod 5 = 2 ✓ */
  be R3_0 holds HashSet.empty()
  be R3_init holds HashSet.add(R3_0, 0)

  /* Step 1: +1 mod 5 → {0, 1} */
  be R3_1a holds HashSet.add(R3_init, 0)
  be R3_1b holds HashSet.add(R3_1a, 1)

  /* Step 2: +2 mod 5 → {0, 1, 2, 3} */
  be R3_2a holds HashSet.add(R3_1b, 0)
  be R3_2b holds HashSet.add(R3_2a, 1)
  be R3_2c holds HashSet.add(R3_2b, 2)
  be R3_2d holds HashSet.add(R3_2c, 3)

  /* Step 3: +4 mod 5 → {0, 1, 2, 3, 4} (4=0+4, 0=1+4 mod 5, 1=2+4 mod 5, 2=3+4 mod 5) */
  be R3_3a holds HashSet.add(R3_2d, 0)
  be R3_3b holds HashSet.add(R3_3a, 4)
  be R3_3c holds HashSet.add(R3_3b, 1)
  be R3_3d holds HashSet.add(R3_3c, 0)
  be R3_3e holds HashSet.add(R3_3d, 2)   /* TARGET */
  be R3_3f holds HashSet.add(R3_3e, 1)
  be R3_3g holds HashSet.add(R3_3f, 3)
  be R3_3h holds HashSet.add(R3_3g, 2)

  be found_C holds HashSet.contains(R3_3h, 2)

  /* Encode: 100 se A trovato, 10 se B trovato, 1 se C trovato */
  be bit_A holds if found_A then 100 else 0
  be bit_B holds if found_B then 10 else 0
  be bit_C holds if found_C then 1 else 0
  return bit_A + bit_B + bit_C
}
