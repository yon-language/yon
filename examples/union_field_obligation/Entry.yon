// SPECIMEN of the place refactor (stage 3, GREEN): place-arms + a field
// on the union. `balance` declared on the union Account is an OBLIGATION
// on every arm: Opened and Closed (in w/) both expose it. The negative
// twin (union_field_obligation_reject) pins the reject when an arm lacks it.
place Entry { }
place Account {
  this > Opened :U Closed
  balance Number
}
fun main(): Number { return 0 }
