// SPECIMEN del refactor place (stadio 3, VERDE): bracci-place + campo
// sull'unione. `balance` dichiarato sull'unione Account è un OBBLIGO su
// ogni braccio: Opened e Closed (in w/) lo espongono entrambi. Il gemello
// union_field_obligation_reject pinna il rifiuto quando un braccio manca.
place Entry { }
place Account {
  this > Opened :U Closed
  balance number
}
fun main(): number { return 0 }
