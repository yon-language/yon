/* SCT — 9 algebre commutative base native Yon (part 16, 2026-05-30).
 *
 * Tutte le 9 algebre base del paper SCT §29:
 *   1. ADD (ℤ, +)
 *   2. OR  ({0,1}^m, |)
 *   3. XOR ({0,1}^m, ⊕)
 *   4. AND ({0,1}^m, &)
 *   5. MOD_Q (ℤ_q, +)  con q=7
 *   6. MUL_P (ℤ_p*, ×) con p=11
 *   7. MIN (ℤ, min)
 *   8. MAX (ℤ, max)
 *   9. GCD (ℤ, gcd)
 *
 * Stesso pattern per ognuna: apply_*_axiom(R: Space, axiom: number) -> number.
 * Helper functions con param Space, niente workaround. */

fun apply_add(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), f + axiom, 0)))
  return 0
}

fun apply_or(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, axiom), 0)))
  return 0
}

fun apply_xor(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bxor(f, axiom), 0)))
  return 0
}

fun apply_and(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.band(f, axiom), 0)))
  return 0
}

fun apply_mod7(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.modulo(f + axiom, 7), 0)))
  return 0
}

fun apply_mul_mod11(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.modulo(f * axiom, 11), 0)))
  return 0
}

fun apply_min(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.min(f, axiom), 0)))
  return 0
}

fun apply_max(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.max(f, axiom), 0)))
  return 0
}

fun apply_gcd(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.gcd(f, axiom), 0)))
  return 0
}

fun main(): number {
  /* 1. ADD start=0, axioms 1,2,3,5 → {0,1,2,3,4,5,6,8,9,10,11} */
  be r0_1 holds HashSet.empty()
  be r1_1 holds HashSet.orbital_add_with(r0_1, 0, 0)
  be R_add holds Space.make(r1_1)
  be _a1 holds apply_add(R_add, 1)
  be _a2 holds apply_add(R_add, 2)
  be _a3 holds apply_add(R_add, 3)
  be _a4 holds apply_add(R_add, 5)
  be s_add holds HashSet.size(Space.get(R_add))

  /* 2. OR start=0, axioms 1,3,5,15 */
  be r0_2 holds HashSet.empty()
  be r1_2 holds HashSet.orbital_add_with(r0_2, 0, 0)
  be R_or holds Space.make(r1_2)
  be _o1 holds apply_or(R_or, 1)
  be _o2 holds apply_or(R_or, 3)
  be _o3 holds apply_or(R_or, 5)
  be _o4 holds apply_or(R_or, 15)
  be s_or holds HashSet.size(Space.get(R_or))

  /* 3. XOR start=0, axioms 1,3,5,15 */
  be r0_3 holds HashSet.empty()
  be r1_3 holds HashSet.orbital_add_with(r0_3, 0, 0)
  be R_xor holds Space.make(r1_3)
  be _x1 holds apply_xor(R_xor, 1)
  be _x2 holds apply_xor(R_xor, 3)
  be _x3 holds apply_xor(R_xor, 5)
  be _x4 holds apply_xor(R_xor, 15)
  be s_xor holds HashSet.size(Space.get(R_xor))

  /* 4. AND start=15, axioms 7,11,13,14 */
  be r0_4 holds HashSet.empty()
  be r1_4 holds HashSet.orbital_add_with(r0_4, 15, 0)
  be R_and holds Space.make(r1_4)
  be _n1 holds apply_and(R_and, 7)
  be _n2 holds apply_and(R_and, 11)
  be _n3 holds apply_and(R_and, 13)
  be _n4 holds apply_and(R_and, 14)
  be s_and holds HashSet.size(Space.get(R_and))

  /* 5. MOD_7 start=0, axioms 1,2,3,5 → orbita ℤ_7 */
  be r0_5 holds HashSet.empty()
  be r1_5 holds HashSet.orbital_add_with(r0_5, 0, 0)
  be R_mod7 holds Space.make(r1_5)
  be _m1 holds apply_mod7(R_mod7, 1)
  be _m2 holds apply_mod7(R_mod7, 2)
  be _m3 holds apply_mod7(R_mod7, 3)
  be _m4 holds apply_mod7(R_mod7, 5)
  be s_mod7 holds HashSet.size(Space.get(R_mod7))

  /* 6. MUL_mod11 start=1, axioms 2,3,5,7 → orbita ℤ_11* */
  be r0_6 holds HashSet.empty()
  be r1_6 holds HashSet.orbital_add_with(r0_6, 1, 0)
  be R_mul holds Space.make(r1_6)
  be _u1 holds apply_mul_mod11(R_mul, 2)
  be _u2 holds apply_mul_mod11(R_mul, 3)
  be _u3 holds apply_mul_mod11(R_mul, 5)
  be _u4 holds apply_mul_mod11(R_mul, 7)
  be s_mul holds HashSet.size(Space.get(R_mul))

  /* 7. MIN start=100, axioms 50,30,20,10 → {100,50,30,20,10} */
  be r0_7 holds HashSet.empty()
  be r1_7 holds HashSet.orbital_add_with(r0_7, 100, 0)
  be R_min holds Space.make(r1_7)
  be _i1 holds apply_min(R_min, 50)
  be _i2 holds apply_min(R_min, 30)
  be _i3 holds apply_min(R_min, 20)
  be _i4 holds apply_min(R_min, 10)
  be s_min holds HashSet.size(Space.get(R_min))

  /* 8. MAX start=0, axioms 3,7,5,12 */
  be r0_8 holds HashSet.empty()
  be r1_8 holds HashSet.orbital_add_with(r0_8, 0, 0)
  be R_max holds Space.make(r1_8)
  be _y1 holds apply_max(R_max, 3)
  be _y2 holds apply_max(R_max, 7)
  be _y3 holds apply_max(R_max, 5)
  be _y4 holds apply_max(R_max, 12)
  be s_max holds HashSet.size(Space.get(R_max))

  /* 9. GCD start=24, axioms 18,12,8,6 */
  be r0_9 holds HashSet.empty()
  be r1_9 holds HashSet.orbital_add_with(r0_9, 24, 0)
  be R_gcd holds Space.make(r1_9)
  be _g1 holds apply_gcd(R_gcd, 18)
  be _g2 holds apply_gcd(R_gcd, 12)
  be _g3 holds apply_gcd(R_gcd, 8)
  be _g4 holds apply_gcd(R_gcd, 6)
  be s_gcd holds HashSet.size(Space.get(R_gcd))

  be _p1 holds IO.print_num(s_add)
  be _p2 holds IO.print_num(s_or)
  be _p3 holds IO.print_num(s_xor)
  be _p4 holds IO.print_num(s_and)
  be _p5 holds IO.print_num(s_mod7)
  be _p6 holds IO.print_num(s_mul)
  be _p7 holds IO.print_num(s_min)
  be _p8 holds IO.print_num(s_max)
  be _p9 holds IO.print_num(s_gcd)

  return s_add + s_or + s_xor + s_and + s_mod7 + s_mul + s_min + s_max + s_gcd
}
