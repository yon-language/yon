/* SCT wavefront NATIVO Yon — 5 algebre commutative (part 15, 2026-05-30).
 *
 * Dimostra l'universalità del framework SCT: lo stesso pattern Yon
 * (HashSet.orbital_add_with + Space + Seq.fold + algebra_op) si applica
 * a qualsiasi algebra commutativa.
 *
 * Helpers parametrici via `R: Space` (post fix turno 33 part 15:
 * runtime user-types + fun-params nei locals iniziali per lambda capture). */

/* ===== Helper apply_*_axiom: applica 1 axiom alla wavefront R ===== */

fun apply_or_axiom(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, axiom), 5)))
  return 0
}

fun apply_z8_axiom(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.modulo(f + axiom, 8), 0)))
  return 0
}

fun apply_max_axiom(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.max(f, axiom), 0)))
  return 0
}

fun apply_gcd_axiom(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Math.gcd(f, axiom), 0)))
  return 0
}

fun apply_and_axiom(R: Space, axiom: number): number {
  be _ holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.band(f, axiom), 0)))
  return 0
}

fun main(): number {
  /* ========= 1. OR-semilattice (axioms 1,3,5,15) ========= */
  be r0a holds HashSet.empty()
  be r1a holds HashSet.orbital_add_with(r0a, 0, 5)
  be R_or holds Space.make(r1a)
  be _o1 holds apply_or_axiom(R_or, 1)
  be _o2 holds apply_or_axiom(R_or, 3)
  be _o3 holds apply_or_axiom(R_or, 5)
  be _o4 holds apply_or_axiom(R_or, 15)
  be size_or holds HashSet.size(Space.get(R_or))

  /* ========= 2. (ℤ_8, +) (axioms 1,2,3,5) ========= */
  be r0b holds HashSet.empty()
  be r1b holds HashSet.orbital_add_with(r0b, 0, 0)
  be R_z8 holds Space.make(r1b)
  be _z1 holds apply_z8_axiom(R_z8, 1)
  be _z2 holds apply_z8_axiom(R_z8, 2)
  be _z3 holds apply_z8_axiom(R_z8, 3)
  be _z4 holds apply_z8_axiom(R_z8, 5)
  be size_z8 holds HashSet.size(Space.get(R_z8))

  /* ========= 3. (ℕ, max, 0) (axioms 3,7,5,12) ========= */
  be r0c holds HashSet.empty()
  be r1c holds HashSet.orbital_add_with(r0c, 0, 0)
  be R_max holds Space.make(r1c)
  be _m1 holds apply_max_axiom(R_max, 3)
  be _m2 holds apply_max_axiom(R_max, 7)
  be _m3 holds apply_max_axiom(R_max, 5)
  be _m4 holds apply_max_axiom(R_max, 12)
  be size_max holds HashSet.size(Space.get(R_max))

  /* ========= 4. (ℕ⁺, gcd, 1) start=24 (axioms 18,12,8,6) ========= */
  be r0d holds HashSet.empty()
  be r1d holds HashSet.orbital_add_with(r0d, 24, 0)
  be R_gcd holds Space.make(r1d)
  be _g1 holds apply_gcd_axiom(R_gcd, 18)
  be _g2 holds apply_gcd_axiom(R_gcd, 12)
  be _g3 holds apply_gcd_axiom(R_gcd, 8)
  be _g4 holds apply_gcd_axiom(R_gcd, 6)
  be size_gcd holds HashSet.size(Space.get(R_gcd))

  /* ========= 5. (Bool^4, AND, 1111) start=15 (axioms 7,11,13,14) ========= */
  be r0e holds HashSet.empty()
  be r1e holds HashSet.orbital_add_with(r0e, 15, 0)
  be R_and holds Space.make(r1e)
  be _a1 holds apply_and_axiom(R_and, 7)
  be _a2 holds apply_and_axiom(R_and, 11)
  be _a3 holds apply_and_axiom(R_and, 13)
  be _a4 holds apply_and_axiom(R_and, 14)
  be size_and holds HashSet.size(Space.get(R_and))

  /* Print each |R_orb| */
  be _p1 holds IO.print_num(size_or)
  be _p2 holds IO.print_num(size_z8)
  be _p3 holds IO.print_num(size_max)
  be _p4 holds IO.print_num(size_gcd)
  be _p5 holds IO.print_num(size_and)
  
  return size_or + size_z8 + size_max + size_gcd + size_and
}
