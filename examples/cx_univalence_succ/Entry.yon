place Entry {
// COSA: univalenza OPERATIVA — transport lungo succ <=> pred, accettata dove serve un
// cammino fra tipi, applica il forward `succ` e COMPUTA su un valore (10 |-> 11).
// PERCHE': è il cuore di Yon — un'EQUIVALENZA di tipi (Int64 ≃ Int64 via succ/pred;
// su Int64, Z/2^64, sono inversi davvero, su Number (f64) no)
// diventa un cammino nei tipi, e trasportare lungo quel cammino ESEGUE la struttura.
fun succ(n: Int64): Int64 { return n + 1 }
fun pred(n: Int64): Int64 { return n - 1 }

fun main(): Number {
  y := transport(succ <=> pred, 10)
  return if y == 11 then 11 else 0     // y -> 11
}
}
