// Micro-example: `pullback` and `pushout`.
// Declarations `place P = pullback(f, g)` / `pushout(f, g)` are
// metadata for the topos kernel. The runtime form
// pullback(f, g, a, b) checks the compatibility f(a) == g(b) and
// packs the pair; __pullback_pi1/__pullback_pi2 project it.
world W { Code is X }
place A in W { v number }
place B in W { v number }
fun f(x: number): number { return x * 2 }
fun g(y: number): number { return y + 6 }
place P = pullback(f, g)
place Q = pushout(f, g)
fun main(): number {
  be p holds pullback(f, g, 6, 6)      // f(6)=12, g(6)=12: compatible
  be a holds __pullback_pi1(p)
  be b holds __pullback_pi2(p)
  return a + b                          // 12
}
