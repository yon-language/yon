place Entry {
/* Cluster A — AST commutative auto-quotient via MerkleTree.nodeN.
 *
 * AST commutative operations (and, or, +) hanno ordine non significativo.
 * Encoding tradizionale: AST con figli posizionali → and(a, b) ≠ and(b, a)
 * Encoding Merkle: and(a, b) = and(b, a) (sort children automatico)
 *
 * Setup: 3 AST equivalenti modulo commutativity:
 *   t1 = and(or(x, y), z)
 *   t2 = and(z, or(y, x))      ≡ t1 sotto commutativity
 *   t3 = and(or(y, x), z)      ≡ t1 sotto commutativity
 *
 * Con MerkleTree.node2 (S_2 auto-canonicalize): t1, t2, t3 → 1 SOLO slot.
 * Compiler hash-cons quotient pass = gratis.
 *
 * Misura: total slot allocati. */

fun main(): Number {
  n0 := __xheap_used()

  /* Variables (leaves) */
  x := MerkleTree.leaf(1)
  y := MerkleTree.leaf(2)
  z := MerkleTree.leaf(3)

  /* t1 = and(or(x, y), z) */
  or_xy := MerkleTree.node2_commutative(100, x, y)     /* label 100 = "or" */
  t1 := MerkleTree.node2_commutative(200, or_xy, z)     /* label 200 = "and" */

  /* t2 = and(z, or(y, x)) — swap arg ordering everywhere */
  or_yx := MerkleTree.node2_commutative(100, y, x)     /* canonical sort: same slot as or_xy */
  t2 := MerkleTree.node2_commutative(200, z, or_yx)     /* canonical: same slot as t1 */

  /* t3 = and(or(y, x), z) — alternative ordering */
  t3 := MerkleTree.node2_commutative(200, or_yx, z)     /* canonical: same as t1 */

  n1 := __xheap_used()
  delta := n1 - n0   /* expected: 3 leaf + 1 or + 1 and = 5 slot */

  /* Verifica iniettività: t1 == t2 == t3 (stesso slot) */
  eq12 := if t1 == t2 then 1 else 0
  eq13 := if t1 == t3 then 1 else 0

  _io1 := IO.print_num(delta)
  _io2 := IO.print_num(t1)
  _io3 := IO.print_num(t2)
  _io4 := IO.print_num(t3)

  /* Output: delta * 10 + eq12 * 100 + eq13 * 1000 */
  return delta + eq12 * 100 + eq13 * 1000
}
}
