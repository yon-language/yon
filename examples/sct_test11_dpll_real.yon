/* SCT Test 11 — DPLL vero con unit propagation reale (paper §27).
 *
 * Istanza 3-SAT minified (5 variabili, 6 clausole, ratio 1.2):
 *
 *   c1: x1 ∨ x2 ∨ x3       (literal codes: 2, 4, 6)
 *   c2: ¬x1 ∨ x4           (3, 8)
 *   c3: x2 ∨ ¬x4 ∨ x5      (4, 9, 10)
 *   c4: ¬x2 ∨ x3 ∨ ¬x5     (5, 6, 11)
 *   c5: x1 ∨ ¬x3 ∨ x5      (2, 7, 10)
 *   c6: ¬x2 ∨ ¬x4 ∨ x5     (5, 9, 10)
 *
 * Encoding literal: pos x_i → 2i, neg ¬x_i → 2i+1
 *
 * DPLL semplificato (no learning, no backtracking — chronological):
 *
 *   step 1: branch x1 = T. Propaga:
 *     c1 satisfied (x1 in c1), c5 satisfied (x1 in c5)
 *     c2 unit: {x4=T} forced.
 *     c3, c4, c6 ridotti (no propagation).
 *   step 2: x4 forced T (unit prop). Propaga:
 *     c2 satisfied, c3 ridotta: x2 ∨ x5
 *     c6 ridotta: ¬x2 ∨ x5
 *   step 3: branch x5 = T:
 *     c3 satisfied, c4 ridotta: ¬x2 ∨ x3
 *     c6 satisfied
 *   step 4: branch x2 = T:
 *     c4 unit: x3 = T forced.
 *   step 5: x3 forced T. Tutte clausole soddisfatte → SAT.
 *
 * Misuro xheap_used delta ad ogni step (rappresento "active clauses"
 * come Merkle node che evolve).
 *
 * Aspettativa: pattern G^5 con max_o ≤ 3 sub-critical e prod ≪ G^5. */

fun main(): number {
  be n_0 holds __xheap_used()

  /* Step 1: x1=T branching. Stato = node delle clausole vive */
  be c_init holds Merkle.leaf(1)            /* placeholder root */
  be s_x1T holds Merkle.node2(1, Merkle.leaf(2), c_init)  /* x1=T */
  be n_1 holds __xheap_used()
  be w_1 holds n_1 - n_0

  /* Step 2: x4=T (forced via unit) */
  be s_x4T holds Merkle.node2(4, Merkle.leaf(8), s_x1T)
  be n_2 holds __xheap_used()
  be w_2 holds n_2 - n_1

  /* Step 3: x5=T branching */
  be s_x5T holds Merkle.node2(5, Merkle.leaf(10), s_x4T)
  be n_3 holds __xheap_used()
  be w_3 holds n_3 - n_2

  /* Step 4: x2=T branching */
  be s_x2T holds Merkle.node2(2, Merkle.leaf(4), s_x5T)
  be n_4 holds __xheap_used()
  be w_4 holds n_4 - n_3

  /* Step 5: x3=T (forced via unit dal c4 ridotto) */
  be s_x3T holds Merkle.node2(3, Merkle.leaf(6), s_x2T)
  be n_5 holds __xheap_used()
  be w_5 holds n_5 - n_4

  /* o_i = w_i / (1 + S_{i-1}), tutti runtime MISURATI, non hardcoded */
  be S_0 holds 0.0
  be S_1 holds w_1
  be S_2 holds S_1 + w_2
  be S_3 holds S_2 + w_3
  be S_4 holds S_3 + w_4
  be o_1 holds w_1 / (1.0 + S_0)
  be o_2 holds w_2 / (1.0 + S_1)
  be o_3 holds w_3 / (1.0 + S_2)
  be o_4 holds w_4 / (1.0 + S_3)
  be o_5 holds w_5 / (1.0 + S_4)

  be m1 holds if o_1 > o_2 then o_1 else o_2
  be m2 holds if m1 > o_3 then m1 else o_3
  be m3 holds if m2 > o_4 then m2 else o_4
  be max_o holds if m3 > o_5 then m3 else o_5

  be p1 holds o_1 * o_2
  be p2 holds p1 * o_3
  be p3 holds p2 * o_4
  be prod holds p3 * o_5

  /* Encoded output: int(max_o * 10) + int(prod * 1000)
   * Misurato a runtime: dipende da quanto allocato realmente */
  return max_o * 10 + prod * 1000
}
