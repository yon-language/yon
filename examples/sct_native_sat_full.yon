/* SCT SAT-style wavefront 100% NATIVO Yon (turno 33 part 15, 2026-05-30).
 *
 * Mostra wavefront OR-saturation con trace o_i per round, ZERO codice C custom.
 * Problema: n=4 variabili, 3 clausole hardcoded (no DIMACS parser).
 *
 * Encoding 2n=8 bit: pos_mask (4 low) | neg_mask (4 high)
 *   clausola (x1 ∨ ¬x2 ∨ x3) = pos {x1,x3} bit 0,2 + neg {x2} bit 5 = 0b00100101 = 37
 *   clausola (¬x1 ∨ x2 ∨ x4) = pos {x2,x4} bit 1,3 + neg {x1} bit 4 = 0b00011010 = 26
 *   clausola (x2 ∨ ¬x3 ∨ ¬x4) = pos {x2} bit 1 + neg {x3,x4} bit 6,7 = 0b11000010 = 194
 *
 * Wavefront: R_i = R_{i-1} ∪ {r ∨ a_i : r ∈ R_{i-1}}
 * canon_id=5 (popcount): collassa stati con stesso numero di literal coperti */

fun main(): number {
  /* R_0 = {0}, canon=popcount */
  be r0 holds HashSet.empty()
  be r1 holds HashSet.orbital_add_with(r0, 0, 5)
  be R holds Space.make(r1)
  be prev_size holds Space.make(1)
  
  /* === Round 1: clausola 37 === */
  be _r1 holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 37), 5)))
  be R1 holds HashSet.size(Space.get(R))
  be prev1 holds Space.get(prev_size)
  be o1_x1k holds (R1 - prev1) * 1000 / (prev1 + 1)
  be _u1 holds Space.set(prev_size, R1)
  
  /* === Round 2: clausola 26 === */
  be _r2 holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 26), 5)))
  be R2 holds HashSet.size(Space.get(R))
  be prev2 holds Space.get(prev_size)
  be o2_x1k holds (R2 - prev2) * 1000 / (prev2 + 1)
  be _u2 holds Space.set(prev_size, R2)
  
  /* === Round 3: clausola 194 === */
  be _r3 holds HashSet.to_stream(Space.get(R)).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 194), 5)))
  be R3 holds HashSet.size(Space.get(R))
  be prev3 holds Space.get(prev_size)
  be o3_x1k holds (R3 - prev3) * 1000 / (prev3 + 1)
  
  /* Output: |R_orb|, o_1, o_2, o_3 (in milli units) */
  be _i1 holds IO.print_num(R3)
  be _i2 holds IO.print_num(o1_x1k)
  be _i3 holds IO.print_num(o2_x1k)
  be _i4 holds IO.print_num(o3_x1k)
  
  return R3
}
