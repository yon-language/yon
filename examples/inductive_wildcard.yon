// COSA: il ramo wildcard `_ =>` nell'eliminazione di un induttivo, mostrato
// FIANCO A FIANCO con la forma esaustiva equivalente. Le due funzioni calcolano
// la stessa cosa; il main prova che coincidono su ogni costruttore.
//
// PERCHE': l'esaustivita' e' imposta, ma elencare ogni ramo-stuck e' una sola
// intenzione ("solo Blue porta il valore, tutto il resto e' 0") scritta N volte.
// Il `_ =>` la dice una volta, canonica. Tenere entrambe qui documenta la feature
// e prova che il path SENZA wildcard continua a reggere. A runtime `_` diventa
// l'else finale del tag-switch; ogni costruttore esplicito resta un test sul tag.

inductive Color = Red | Green | Blue(number) | Gray(number)

fun mot(c: Color): number { return 0 }

// forma ESAUSTIVA: ogni costruttore elencato (il path senza wildcard)
fun weight_exhaustive(c: Color): number {
  return hit_elim(mot, [ Red => 0, Green => 0, Blue(n) => n, Gray(g) => 0 ], c)
}

// forma WILDCARD: la stessa intenzione, detta una volta
fun weight_wild(c: Color): number {
  return hit_elim(mot, [ Blue(n) => n, _ => 0 ], c)
}

// match-zucchero col wildcard
fun is_blue(c: Color): number { return match c { Blue(n) => 1, _ => 0 } }

fun main(): number {
  // le due forme coincidono su ogni costruttore -> ciascuna differenza e' 0
  be d1 holds weight_exhaustive(hit(Blue, 7))  - weight_wild(hit(Blue, 7))
  be d2 holds weight_exhaustive(hit(Red))      - weight_wild(hit(Red))
  be d3 holds weight_exhaustive(hit(Gray, 9))  - weight_wild(hit(Gray, 9))
  // (0 + 0 + 0) + 41 + 1 (is_blue su Blue) + 0 (is_blue su Green) = 42
  return d1 + d2 + d3 + weight_wild(hit(Blue, 41)) + is_blue(hit(Blue, 0)) + is_blue(hit(Green))
}
