/* Cluster A — HashSet.orbital_add/contains integrato (turno 33 part 5).
 *
 * Demo: 10 elementi, 5 coppie sotto G_24 orbit.
 *   - HashSet.add normale → size 10
 *   - HashSet.orbital_add → size 5 (collapse 2×)
 *
 * Verifica contains: orbital_contains su key flippata ritorna true. */

fun main(): number {
  /* SET A: 10 add normali */
  be s_norm holds HashSet.empty()
  be n1 holds HashSet.add(s_norm, 5263441)
  be n2 holds HashSet.add(n1, 8388609)
  be n3 holds HashSet.add(n2, 4194820)
  be n4 holds HashSet.add(n3, 12648465)
  be n5 holds HashSet.add(n4, 7733521)
  be n6 holds HashSet.add(n5, 5287854)
  be n7 holds HashSet.add(n6, 8454142)
  be n8 holds HashSet.add(n7, 4259323)
  be n9 holds HashSet.add(n8, 12713966)
  be n10 holds HashSet.add(n9, 7798510)
  be size_norm holds HashSet.size(n10)

  /* SET B: 10 orbital_add */
  be s_orb holds HashSet.empty()
  be o1 holds HashSet.orbital_add(s_orb, 5263441)
  be o2 holds HashSet.orbital_add(o1, 8388609)
  be o3 holds HashSet.orbital_add(o2, 4194820)
  be o4 holds HashSet.orbital_add(o3, 12648465)
  be o5 holds HashSet.orbital_add(o4, 7733521)
  be o6 holds HashSet.orbital_add(o5, 5287854)   /* DEDUP con o1 */
  be o7 holds HashSet.orbital_add(o6, 8454142)   /* DEDUP con o2 */
  be o8 holds HashSet.orbital_add(o7, 4259323)
  be o9 holds HashSet.orbital_add(o8, 12713966)
  be o10 holds HashSet.orbital_add(o9, 7798510)
  be size_orb holds HashSet.size(o10)

  /* Verifica contains: orbital_contains su flip key */
  be has_a holds if HashSet.orbital_contains(o10, 5263441) then 1 else 0
  be has_b holds if HashSet.orbital_contains(o10, 5287854) then 1 else 0
  be consistent holds if has_a == has_b then 1 else 0

  /* Output: size_norm * 1000 + size_orb * 100 + consistent * 10 + has_a */
  return size_norm * 1000 + size_orb * 100 + consistent * 10 + has_a
}
