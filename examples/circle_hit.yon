// S1 from source: build the base point and eliminate it with a recursor.
// hit_elim(motive, [base => 42, loop => plam i => 42], hit(base)) computes to 42.
fun motive(x: S1): number { return 0 }
fun circle_elim(): number {
  return hit_elim(motive, [base => 42, loop => plam i => 42], hit(base))
}
fun main(): number {
  return circle_elim()
}
