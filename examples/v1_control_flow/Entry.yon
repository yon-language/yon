place Entry {
/* for every / in sequence over / repeat..otherwise /
 * = / duration literals — lowered onto while, iter and Space cells.
 * (`forever` is exercised by a separate non-terminating probe.)
 * Expected exit: 42. */
fun main(): Number {
  mut acc := 0
  lst := List.cons(5, List.cons(7, List.cons(9, List.empty(0))))

  for every x in lst { acc <- acc + x }            // 21
  in sequence over y in lst { acc <- acc + 1 }     // 24
  repeat at most 3 times { acc <- acc + 2 }        // 30
  otherwise { acc <- acc + 1 }                     // 31

  d := 2000 + 500                                 // 2500 (a duration is a number of milliseconds)
  when d == 2500 { acc <- acc + 10 }               // 41

  mut i := 0
  while i < 1 do {
    acc <- acc + 1                                 // 42
    i <- i + 1
  }
  return acc
}
}
