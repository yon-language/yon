place Entry {
  fun main(): Number {
    be m1 := move(s: P) => .-> Q { v 1 } from P to Q
    be m2 := move(s: Q) => .-> R { v 2 } from Q to R
    be mm := compose m1 with m2
    be sp := .-> P { v 0 }
    be sr := mm(sp)
    be vw := view(s: P) => 40 of P
    be forty := vw(sp)
    return forty + 4
  }
}
