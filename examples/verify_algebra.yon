/* solve + AlgebraVerifier: a place declares a catalog algebra and its laws;
 * `solve` instantiates it as a Magma handle; the verifier checks the declared
 * laws against the certified catalog at compile time, then queries run on the
 * handle. */
world Alg { Code is X }

place OrPlace in Alg with effects {
  operation join(a: number, b: number): number uses algebra BooleanOr
  law commutative
  law associative
}

fun main(): number {
  be m holds verify OrPlace
  be m1 holds Magma.gen(m, 1)
  be m2 holds Magma.gen(m1, 2)
  return Magma.closure_size(m2)
}
