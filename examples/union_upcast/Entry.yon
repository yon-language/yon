// The value-level mono: an Opened section passed where Account (its union)
// is expected. The injection is IDENTITY on the handle (subtype_cast lowers
// to identity) — the upcast costs nothing, like a set inclusion.
place Entry { }
place Account {
  this > Opened :U Closed
}
fun accept(a: Account): number { return 7 }
fun main(): number {
  be o holds .-> Opened { initial 42 }
  return accept(o)
}
