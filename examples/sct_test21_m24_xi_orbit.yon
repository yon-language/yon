/* SCT Test 21 — pure M_24 orbits + xi Conway order 3 + Co_0 step.
 *
 * (1) Pure M_24 orbits (the exact orbit under the Mathieu group, from
 *     leech_orbits — 12 orbits over the type-2 shell). Four type-2 vectors in
 *     four DISTINCT orbits; m24_orbit dedups each orbit to a heap slot, so four
 *     distinct orbits => 4 distinct slots:
 *       1536      (0x600)      orbit 0
 *       16778752  (0x1000600)  orbit 1
 *       8390144   (0x800600)   orbit 2
 *       25167360  (0x1800600)  orbit 3
 *     (The earlier version passed non-type-2 inputs and relied on the spurious
 *     weight-based (w_g,w_c) invariant; replaced with real type-2 points and the
 *     genuine M_24 orbit.)
 *
 * (2) xi Conway has ORDER 3 in Co_0 (not an involution): xi^3(v0) == v0.
 *
 * (3) Co_0 step canonical: v0 and xi(v0) lie in the same <xi>.M_24 orbit, so
 *     co0_step collapses them to the same slot.
 *
 * Output: m24_distinct + xi_order3 * 10 + co0_collapse_01 * 100 + co0_collapse_02 * 1000
 *         observed = 4 + 10 = 14 */

fun main(): number {
  be n0 holds __xheap_used()

  /* (1) pure M_24 orbits: 4 type-2 vectors in 4 distinct orbits */
  be o_a holds Leech.m24_orbit(1536)
  be o_b holds Leech.m24_orbit(16778752)
  be o_c holds Leech.m24_orbit(8390144)
  be o_d holds Leech.m24_orbit(25167360)
  be n1 holds __xheap_used()
  be m24_distinct holds n1 - n0

  /* (2) xi order 3 verify */
  be v0 holds 4096   /* 0x1000 = (gcode_idx=1, cocode=0) in Leech2 */
  be v1 holds Leech.xi_apply(v0)
  be v2 holds Leech.xi_apply(v1)
  be v3 holds Leech.xi_apply(v2)
  be xi_order3 holds if v3 == v0 then 1 else 0

  /* (3) Co_0 step collapse: v0 and xi(v0) same orbit */
  be co0_v0 holds Leech.co0_step(v0)
  be co0_v1 holds Leech.co0_step(v1)
  be co0_v2 holds Leech.co0_step(v2)
  be co0_collapse_01 holds if co0_v0 == co0_v1 then 1 else 0
  be co0_collapse_02 holds if co0_v0 == co0_v2 then 1 else 0

  return m24_distinct + xi_order3 * 10 + co0_collapse_01 * 100 + co0_collapse_02 * 1000
}
