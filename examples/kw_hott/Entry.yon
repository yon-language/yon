place Entry {
// Micro-example: the HoTT pair surface. `Sigma(x: A). B` is the
// dependent pair type (lowered to the honest two-field struct);
// `pair`/`fst`/`snd` are its constructor and projections.
// (`Type` in parameter position and `refl` path values do not lower
// in these positions today.)
fun takes(p: Sigma(x: Number). Number): Number {
  return fst(p) + snd(p)
}
fun proj_sum(a: Number, b: Number): Number {
  be p holds pair(a, b)
  be x holds fst(p)
  be y holds snd(p)
  return x + y
}
fun main(): Number {
  be direct holds takes(pair(20, 10))
  return direct + proj_sum(7, 5)        // 30 + 12 = 42
}
}
