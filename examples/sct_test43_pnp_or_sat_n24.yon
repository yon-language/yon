/* SCT Test 43 — §34.6 OR/SAT n=24 (limit del prover: 2^24 = 16M bits = 2MB bitmap). */
fun main(): number {
  /* n=22 — al limite memoria/CPU del prover bitmap */
  be R_22 holds SAT.run_3sat(22, 42, 1)
  be G_22 holds SAT.run_3sat(22, 42, 6)
  be k_22 holds SAT.run_3sat(22, 42, 2)

  be R_24 holds SAT.run_3sat(24, 42, 1)
  be G_24 holds SAT.run_3sat(24, 42, 6)
  be k_24 holds SAT.run_3sat(24, 42, 2)

  be _0 holds IO.print_num(R_22)
  be _1 holds IO.print_num(G_22)
  be _2 holds IO.print_num(k_22)
  be _3 holds IO.print_num(R_24)
  be _4 holds IO.print_num(G_24)
  be _5 holds IO.print_num(k_24)

  /* log2(R)/G — verifico se rimane stabile a 0.22 o scende */
  be lr22 holds Math.log(R_22) / Math.log(2) / G_22
  be lr24 holds Math.log(R_24) / Math.log(2) / G_24
  be _6 holds IO.print_num(lr22)
  be _7 holds IO.print_num(lr24)

  return Math.floor(lr24 * 1000)
}
