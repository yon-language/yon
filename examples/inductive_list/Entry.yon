place List { this > Nil :U Cons(number, List) }

place Entry {
// COSA: una lista RICORSIVA con nome, ripiegata con lo zucchero `match`. E' la
// forma piu' idiomatica del place-oggetto: un caso base (Nil) e un caso
// ricorsivo (Cons porta la testa number e la coda List), esattamente come in ML.
//
// PERCHE': compone le tre parti dell'unificazione in un solo programma.
// La clausola `this >` da' il nome che permette a Cons di riferirsi a List
// (ricorsione, G2). Il `match` sintetizza il suo motive costante dal ramo base Nil (il cui
// corpo non legge un payload), poi ogni ramo e' ricontrollato nel suo binding. E
// il valore vive a runtime come nodo MerkleTree content-addressed: `sum` dispaccia
// sul tag, la testa e' proiettata con `label(child ..)` (number), la coda con
// `child ..` (handle) e ricorre. Nessun eliminatore esplicito: solo `match`, come
// ci si aspetta da un linguaggio con i dati algebrici.


fun sum(l: List): number {
  return match l {
    Nil => 0,
    Cons(h, t) => h + sum(t)
  }
}

fun main(): number {
  // Cons(10, Cons(15, Cons(17, Nil)))  ->  10 + 15 + 17 = 42
  return sum(.-> Cons { _1 10 _2 .-> Cons { _1 15 _2 .-> Cons { _1 17 _2 Nil } } })
}
}
