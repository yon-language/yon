/* Spettrometria di massa — subset-sum biologico.
 *
 * In MS/MS un peptide si frammenta; si osservano le masse dei frammenti.
 * Domanda: un peptide candidato (massa target) e' componibile come somma
 * esatta di un sottoinsieme dei frammenti osservati? (ogni frammento una volta)
 *
 * Masse nominali (Da, intere) di frammenti osservati:
 *   57(G) 71(A) 87(S) 99(V) 113(L/I) 128(K/Q) 147(F)
 *
 * Algebra: SubsetSum su massa additiva. Catalogo id 0 = Additive (monotona),
 * usata in modalita' subsetsum (ogni generatore una volta = no riuso).
 *
 * Target testati:
 *   298 = peptide AVK (71+99+128) -> raggiungibile (1)
 *   200 = S+L (87+113)            -> raggiungibile (1)
 *   500                            -> NON componibile (0)
 *   156                            -> G+V (57+99) raggiungibile (1)
 *
 * return = r298*1 + r200*10 + r500*100 + r156*1000 = 1 + 10 + 0 + 1000 = 1011.
 * (1011 mod 256 = 243) */
fun main(): number {
  be p0 holds Magma.from_catalog(0)        /* Additive, leggi certificate */
  be p1 holds Magma.gen(p0, 57)
  be p2 holds Magma.gen(p1, 71)
  be p3 holds Magma.gen(p2, 87)
  be p4 holds Magma.gen(p3, 99)
  be p5 holds Magma.gen(p4, 113)
  be p6 holds Magma.gen(p5, 128)
  be m  holds Magma.gen(p6, 147)

  be r298 holds if Magma.subsetsum(m, 298) then 1 else 0
  be r200 holds if Magma.subsetsum(m, 200) then 1 else 0
  be r500 holds if Magma.subsetsum(m, 500) then 1 else 0
  be r156 holds if Magma.subsetsum(m, 156) then 1 else 0

  return r298 + r200 * 10 + r500 * 100 + r156 * 1000
}
