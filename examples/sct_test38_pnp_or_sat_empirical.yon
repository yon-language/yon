/* SCT Test 38 — §34.6 P=NP per OR/SAT empirical exploration (turno 33 part 8).
 *
 * ONESTÀ UPFRONT: questo è EMPIRICAL/EXPLORATORY, NON una proof.
 * §34.6 dichiara P=NP per OR/SAT OPEN (dipende da k=O(log G)).
 *
 * Quello che VERIFICO empiricamente:
 *
 * 1. PROVED (Prop 34.5): o_i < 1 per ogni round dopo ghost δ=1
 * 2. PROVED (Theorem 19): C ≤ 2 (commutativity collapse)
 * 3. PROVED (sub-exponential): |R| < 2^G
 * 4. EMPIRICAL: |R| ≈ G^c con c ≈ 5 (sui dati paper SATLIB)
 * 5. OPEN: k = O(log G) — non risolvibile runtime
 *
 * Setup test: OR-bitmask 5-bit, G=5 axiomi {1, 2, 4, 8, 16} (single bit each).
 * Wavefront completo. Misuro |R_i| ad ogni round, o_i, |R| finale, 2^G.
 *
 * Predizione: |R| = 2^5 = 32 (raggiunge tutti i 5-bit). 2^G = 32.
 * o_i decrescente: 1, 1, 1, 1, 1 (ogni round raddoppia). MA o = 1 boundary,
 * non strict < 1 perché abbiamo a single-bit axioms (case ottimale).
 * Per axiom multi-bit (3-SAT clauses), o_i ridurrebbe perché collision aumenta. */

fun main(): number {
  be G holds 5
  be two_to_G holds 32  /* 2^5 */

  /* R_0 = {0} */
  be r0 holds HashSet.empty()
  be r0i holds HashSet.add(r0, 0)
  be s0 holds 1

  /* Round 1: aggiungi axiom 1 → {0, 1} */
  be r1 holds HashSet.add(r0i, 1)
  be s1 holds HashSet.size(r1)
  be o1 holds (s1 - s0) / (1 + s0)   /* = 0.5 */

  /* Round 2: axiom 2 → 0|2=2, 1|2=3 → {0,1,2,3} */
  be r2_a holds HashSet.add(r1, 2)
  be r2 holds HashSet.add(r2_a, 3)
  be s2 holds HashSet.size(r2)
  be o2 holds (s2 - s1) / (1 + s1)   /* = 0.667 */

  /* Round 3: axiom 4 → 0..3 | 4 = 4..7 → {0..7} */
  be r3_a holds HashSet.add(r2, 4)
  be r3_b holds HashSet.add(r3_a, 5)
  be r3_c holds HashSet.add(r3_b, 6)
  be r3 holds HashSet.add(r3_c, 7)
  be s3 holds HashSet.size(r3)
  be o3 holds (s3 - s2) / (1 + s2)   /* = 0.8 */

  /* Round 4: axiom 8 → 0..7 | 8 = 8..15 → {0..15} */
  be r4_a holds HashSet.add(r3, 8)
  be r4_b holds HashSet.add(r4_a, 9)
  be r4_c holds HashSet.add(r4_b, 10)
  be r4_d holds HashSet.add(r4_c, 11)
  be r4_e holds HashSet.add(r4_d, 12)
  be r4_f holds HashSet.add(r4_e, 13)
  be r4_g holds HashSet.add(r4_f, 14)
  be r4 holds HashSet.add(r4_g, 15)
  be s4 holds HashSet.size(r4)
  be o4 holds (s4 - s3) / (1 + s3)   /* = 0.889 */

  /* Round 5: axiom 16 → 0..15 | 16 = 16..31 → {0..31} */
  be r5_a holds HashSet.add(r4, 16)
  be r5_b holds HashSet.add(r5_a, 17)
  be r5_c holds HashSet.add(r5_b, 18)
  be r5_d holds HashSet.add(r5_c, 19)
  be r5_e holds HashSet.add(r5_d, 20)
  be r5_f holds HashSet.add(r5_e, 21)
  be r5_g holds HashSet.add(r5_f, 22)
  be r5_h holds HashSet.add(r5_g, 23)
  be r5_i holds HashSet.add(r5_h, 24)
  be r5_j holds HashSet.add(r5_i, 25)
  be r5_k holds HashSet.add(r5_j, 26)
  be r5_l holds HashSet.add(r5_k, 27)
  be r5_m holds HashSet.add(r5_l, 28)
  be r5_n holds HashSet.add(r5_m, 29)
  be r5_o holds HashSet.add(r5_n, 30)
  be r5 holds HashSet.add(r5_o, 31)
  be s5 holds HashSet.size(r5)
  be o5 holds (s5 - s4) / (1 + s4)   /* = 0.941 */

  /* VERIFICA Prop 34.5: o_i < 1 strict */
  be all_o_lt_1 holds if o1 < 1 then (
    if o2 < 1 then (
      if o3 < 1 then (
        if o4 < 1 then (
          if o5 < 1 then 1 else 0
        ) else 0
      ) else 0
    ) else 0
  ) else 0

  /* VERIFICA sub-exponential: |R| ≤ 2^G */
  be sub_exp holds if s5 <= two_to_G then 1 else 0

  /* Sum of o_i (per stima Σ o_i; OPEN se = O(log G)) */
  be sum_o holds o1 + o2 + o3 + o4 + o5

  /* ln(G) for poly bound check */
  be log_G holds Math.log(G)

  /* k = active groups (o_i > 0.3 threshold for esempio) */
  be k_active holds 0
  be k1 holds if o1 > 0.3 then k_active + 1 else k_active
  be k2 holds if o2 > 0.3 then k1 + 1 else k1
  be k3 holds if o3 > 0.3 then k2 + 1 else k2
  be k4 holds if o4 > 0.3 then k3 + 1 else k3
  be k5 holds if o5 > 0.3 then k4 + 1 else k4

  be _io1 holds IO.print_num(s5)
  be _io2 holds IO.print_num(sum_o)
  be _io3 holds IO.print_num(log_G)
  be _io4 holds IO.print_num(k5)
  be _io5 holds IO.print_num(o5)

  /* Output: all_o_lt_1*1000 + sub_exp*100 + k5*10 + (s5 mod 100)
   * Expected: 1*1000 + 1*100 + 5*10 + 32 = 1182 mod 256 = $(python3 -c 'print(1182%256)') */
  return all_o_lt_1 * 1000 + sub_exp * 100 + k5 * 10 + s5
}
