/* SCT wavefront NATIVO Yon (turno 33 part 14, 2026-05-30). */

fun main(): number {
  be r0 holds HashSet.empty()
  be r1 holds HashSet.orbital_add_with(r0, 0, 5)
  be R holds Space.make(r1)
  
  be _1 holds HashSet.to_stream(r1).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 1), 5)))
  
  be _2 holds HashSet.to_stream(r1).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 3), 5)))
  
  be _3 holds HashSet.to_stream(r1).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 5), 5)))
  
  be _4 holds HashSet.to_stream(r1).fold(0, fun(a: number, f: number) =>
    Space.set(R, HashSet.orbital_add_with(Space.get(R), Bits.bor(f, 15), 5)))
  
  return HashSet.size(Space.get(R))
}
