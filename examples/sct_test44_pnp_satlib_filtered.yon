/* SCT Test 44 — §34.6 P=NP OR/SAT con NOT literals + filtered satisfiable.
 * Multi-seed average per n=4,6,8,10,12 (max prover bitmap 2n bits = 24). */

fun avg_R_filt(n: number): number {
  be r1 holds SAT.run_3sat_filtered(n, 42, 1, 1)
  be r2 holds SAT.run_3sat_filtered(n, 43, 1, 1)
  be r3 holds SAT.run_3sat_filtered(n, 44, 1, 1)
  be r4 holds SAT.run_3sat_filtered(n, 45, 1, 1)
  be r5 holds SAT.run_3sat_filtered(n, 46, 1, 1)
  return (r1 + r2 + r3 + r4 + r5) / 5
}

fun avg_k_filt(n: number): number {
  be k1 holds SAT.run_3sat_filtered(n, 42, 1, 2)
  be k2 holds SAT.run_3sat_filtered(n, 43, 1, 2)
  be k3 holds SAT.run_3sat_filtered(n, 44, 1, 2)
  be k4 holds SAT.run_3sat_filtered(n, 45, 1, 2)
  be k5 holds SAT.run_3sat_filtered(n, 46, 1, 2)
  return (k1 + k2 + k3 + k4 + k5) / 5
}

fun main(): number {
  be R4 holds avg_R_filt(4)
  be G4 holds SAT.run_3sat_filtered(4, 42, 1, 5)
  be k4 holds avg_k_filt(4)

  be R6 holds avg_R_filt(6)
  be G6 holds SAT.run_3sat_filtered(6, 42, 1, 5)
  be k6 holds avg_k_filt(6)

  be R8 holds avg_R_filt(8)
  be G8 holds SAT.run_3sat_filtered(8, 42, 1, 5)
  be k8 holds avg_k_filt(8)

  be R10 holds avg_R_filt(10)
  be G10 holds SAT.run_3sat_filtered(10, 42, 1, 5)
  be k10 holds avg_k_filt(10)

  be R12 holds avg_R_filt(12)
  be G12 holds SAT.run_3sat_filtered(12, 42, 1, 5)
  be k12 holds avg_k_filt(12)

  be _01 holds IO.print_num(R4)
  be _02 holds IO.print_num(R6)
  be _03 holds IO.print_num(R8)
  be _04 holds IO.print_num(R10)
  be _05 holds IO.print_num(R12)
  be _11 holds IO.print_num(k4)
  be _12 holds IO.print_num(k6)
  be _13 holds IO.print_num(k8)
  be _14 holds IO.print_num(k10)
  be _15 holds IO.print_num(k12)
  be _16 holds IO.print_num(G4)
  be _17 holds IO.print_num(G6)
  be _18 holds IO.print_num(G8)
  be _19 holds IO.print_num(G10)
  be _20 holds IO.print_num(G12)

  /* Exponents */
  be c4 holds Math.log(R4) / Math.log(G4)
  be c6 holds Math.log(R6) / Math.log(G6)
  be c8 holds Math.log(R8) / Math.log(G8)
  be c10 holds Math.log(R10) / Math.log(G10)
  be c12 holds Math.log(R12) / Math.log(G12)

  be _21 holds IO.print_num(c4)
  be _22 holds IO.print_num(c6)
  be _23 holds IO.print_num(c8)
  be _24 holds IO.print_num(c10)
  be _25 holds IO.print_num(c12)

  return Math.floor(c12 * 100)
}
