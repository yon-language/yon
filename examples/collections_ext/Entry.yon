place Entry {
/* Set.union / Set.intersect. A={1,2,3}, B={2,3,4}.
 * union size=4, intersect size=2 -> 4*10+2 = 42. */
fun main(): Number {
  a0 := HashSet.empty()
  a1 := HashSet.add(a0, 1)
  a2 := HashSet.add(a1, 2)
  a3 := HashSet.add(a2, 3)
  b0 := HashSet.empty()
  b1 := HashSet.add(b0, 2)
  b2 := HashSet.add(b1, 3)
  b3 := HashSet.add(b2, 4)
  u := HashSet.union(a3, b3)
  i := HashSet.intersect(a3, b3)
  return HashSet.size(u) * 10 + HashSet.size(i)
}
}
