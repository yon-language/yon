/* SCT Test 1 — Cluster Collapse: variabili in equivalence class
 * condividono una memory cell tramite HashMap.
 *
 * Paper §3.2 (Mennillo 2026b): T_struct = id dopo costruzione iniziale.
 * inject_fact(v, a) → cluster_domains[class_of(v)] = {a}.
 * O(1) per inject, ZERO propagazione: tutte le variabili in [v]
 * vedono {a} istantaneamente via shared cell xheap.
 *
 * Setup (inline, vs funzioni helper che il type checker rifiuta per
 * HashMap come parametro):
 *
 *   Cluster A: variabili 100, 101, 102 in stessa classe → cid=1
 *   Cluster B: variabili 200, 201          in stessa classe → cid=2
 *
 * Test:
 *   inject_fact(100, 42)  → cluster_domains[1] = 42
 *   read(101) → 42 (visto via shared cell, zero propagazione)
 *   read(102) → 42 (idem)
 *   inject_fact(200, 99)  → cluster_domains[2] = 99
 *   read(201) → 99
 *
 * Atteso: 42+42+42+99+99 = 324, mod 256 = 68. */

fun main(): number {
  be d0 holds HashMap.empty()

  /* Inject su cluster A (cid=1). */
  be d1 holds HashMap.set(d0, 1, 42)

  /* Read variabili 100, 101, 102 — STESSE cluster, lookup HashMap O(1) */
  be r100 holds HashMap.get(d1, 1)
  be r101 holds HashMap.get(d1, 1)
  be r102 holds HashMap.get(d1, 1)

  /* Inject su cluster B (cid=2). */
  be d2 holds HashMap.set(d1, 2, 99)
  be r200 holds HashMap.get(d2, 2)
  be r201 holds HashMap.get(d2, 2)

  return r100 + r101 + r102 + r200 + r201
}
