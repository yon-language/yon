/* SCT Test 1b — T1 con metric __xheap_used aggiunta (turno 32).
 *
 * T1 originale: usa HashMap.set/get reali ma niente misurazione w.
 * T1b: misura xheap delta per ogni cluster inject + read = verifica
 *      empirica del Theorem 1 (cluster shared cell = O(1) memory).
 *
 * Setup:
 *   Cluster A: cid=1, 3 reads
 *   Cluster B: cid=2, 2 reads
 *
 * Predizione: delta per cluster = COSTANTE (1 cell condivisa), non
 * dipende dal numero di reads. */

fun main(): number {
  be n0 holds __xheap_used()

  /* Cluster A: 1 inject + 3 reads */
  be d0 holds HashMap.empty()
  be d1 holds HashMap.set(d0, 1, 42)
  be r100 holds HashMap.get(d1, 1)
  be r101 holds HashMap.get(d1, 1)
  be r102 holds HashMap.get(d1, 1)
  be n1 holds __xheap_used()
  be delta_A holds n1 - n0

  /* Cluster B: 1 inject + 2 reads */
  be d2 holds HashMap.set(d1, 2, 99)
  be r200 holds HashMap.get(d2, 2)
  be r201 holds HashMap.get(d2, 2)
  be n2 holds __xheap_used()
  be delta_B holds n2 - n1

  /* Predizione: delta_A e delta_B PICCOLI e SIMILI (numero reads
   * non influenza); dipende solo da inject (1 cell). */
  return delta_A * 10 + delta_B
}
