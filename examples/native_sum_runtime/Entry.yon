place Expr { this > Lit(Number) :U Neg(Number) :U Add(Number) }
place Entry {
// COSA: un tipo somma NATIVO eliminato su un valore a RUNTIME (un parametro),
// non su un costruttore noto staticamente. `eval` vede solo il parametro `e`:
// il suo costruttore e' opaco fino all'esecuzione, quindi l'eliminazione e' un
// vero dispatch a runtime, non un fold a compile-time.
//
// PERCHE': questo unifica le due facce dell'algebra iniziale. L'eliminatore
// dipendente type-theoretic (match su un costruttore statico) resta la regola
// beta del kernel; qui invece il valore somma ha un CARRIER a runtime: la sezione
// del place sintetico del braccio, sulla catena FNV, e l'eliminazione legge la
// radice della sezione e le proiezioni _1 .. _n.
// Prima di questo, un match su un valore somma a runtime era "stuck":
// nessun valore a runtime da lowerare.
//
fun eval(e: Expr): Number {
  return match e { Lit(n) => n, Neg(m) => 0 - m, Add(s) => s + s }
}

fun main(): Number {
  a := eval(.-> Lit { _1 5 })     // 5
  b := eval(.-> Neg { _1 3 })     // 0 - 3 = -3
  c := eval(.-> Add { _1 20 })    // 20 + 20 = 40
  return a + b + c                  // 5 + (0-3) + 40 = 42
}
}
