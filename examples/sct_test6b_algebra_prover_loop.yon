/* SCT Test 6b — Algebra prover con LOOP DINAMICO vero (turno 32).
 *
 * Algebra: (Z, +, 0), axiom = +1, target = 10.
 * Loop: applica +1 finché found o max_iter raggiunto.
 * Misuro xheap_used delta dei HashSet operations + iter count. */

fun main(): number {
  be n0 holds __xheap_used()
  be target holds 10
  be max_iter holds 20

  be s0 holds HashSet.empty()
  be s_init holds HashSet.add(s0, 0)

  be cur_set holds Space.make(s_init)
  be cur_max holds Space.make(0)
  be n_iter holds Space.make(0)
  be found holds Space.make(0)

  while Space.get(n_iter) < max_iter do {
    be i holds Space.get(n_iter)
    be cm holds Space.get(cur_max)
    be new_val holds cm + 1

    be s holds Space.get(cur_set)
    be s_new holds HashSet.add(s, new_val)
    be _0 holds Space.set(cur_set, s_new)
    be _1 holds Space.set(cur_max, new_val)
    be _2 holds Space.set(n_iter, i + 1)

    when new_val == target {
      be _3 holds Space.set(found, 1)
      be _4 holds Space.set(n_iter, max_iter)
    }
  }

  be n1 holds __xheap_used()
  be delta holds n1 - n0
  be found_val holds Space.get(found)
  be iter_val holds Space.get(n_iter)

  return found_val * 100 + iter_val + delta
}
