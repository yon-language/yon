/* Cluster A — HashMap.orbital_set/get integrato.
 *
 * Demo: 10 chiavi distinte byte-literali, ma 5 coppie nella stessa orbita
 * G_24 (via XOR codeword 0x00FFFF = 65535).
 *
 * Confronto:
 *   HashMap.set normale: 10 entries → byte-literal dedupli zero
 *   HashMap.orbital_set: 5 entries → G_24 orbita dedupli 2× collapse
 *
 * Misura empirica: confronto map.size dopo 10 set normali vs 10 set orbital. */

fun main(): number {
  /* MAP A: 10 set normali (byte-literal) */
  be m_norm holds HashMap.empty()
  be m1 holds HashMap.set(m_norm, 5263441, 1)
  be m2 holds HashMap.set(m1, 8388609, 2)
  be m3 holds HashMap.set(m2, 4194820, 3)
  be m4 holds HashMap.set(m3, 12648465, 4)
  be m5 holds HashMap.set(m4, 7733521, 5)
  /* XOR 65535: byte-diversi quindi entry distinti */
  be m6 holds HashMap.set(m5, 5287854, 6)   /* = m1 XOR 65535 */
  be m7 holds HashMap.set(m6, 8454142, 7)   /* = m2 XOR 65535 */
  be m8 holds HashMap.set(m7, 4259323, 8)
  be m9 holds HashMap.set(m8, 12713966, 9)
  be m10 holds HashMap.set(m9, 7798510, 10)
  be size_norm holds HashMap.size(m10)   /* expected 10 */

  /* MAP B: 10 orbital_set */
  be mo holds HashMap.empty()
  be o1 holds HashMap.orbital_set(mo, 5263441, 1)
  be o2 holds HashMap.orbital_set(o1, 8388609, 2)
  be o3 holds HashMap.orbital_set(o2, 4194820, 3)
  be o4 holds HashMap.orbital_set(o3, 12648465, 4)
  be o5 holds HashMap.orbital_set(o4, 7733521, 5)
  be o6 holds HashMap.orbital_set(o5, 5287854, 60)   /* COLLISIONE: stesso syndrome di o1 */
  be o7 holds HashMap.orbital_set(o6, 8454142, 70)   /* COLLISIONE con o2 */
  be o8 holds HashMap.orbital_set(o7, 4259323, 80)
  be o9 holds HashMap.orbital_set(o8, 12713966, 90)
  be o10 holds HashMap.orbital_set(o9, 7798510, 100)
  be size_orb holds HashMap.size(o10)    /* expected 5 (collapse 2×) */

  /* Verifica get: orbital_get(map, 5263441) e orbital_get(map, 5287854)
   * devono ritornare lo STESSO valore (= 60 = ultima scritta) */
  be v_a holds HashMap.orbital_get(o10, 5263441)
  be v_b holds HashMap.orbital_get(o10, 5287854)
  be consistent holds if v_a == v_b then 1 else 0

  /* Output: size_norm * 1000 + size_orb * 100 + consistent * 10 + v_a/10
   * Expected: 10*1000 + 5*100 + 10 + 6 = 10516 mod 256 = 20
   *           (v_a = 60 so v_a/10 = 6) */
  return size_norm * 1000 + size_orb * 100 + consistent * 10 + v_a / 10
}
