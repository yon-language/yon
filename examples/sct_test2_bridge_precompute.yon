/* SCT Test 2 — Bridge Precompute (Paper §5.3, Mennillo 2026b).
 *
 * Pre-apply implications whose conditions are already resolved,
 * single pass over C_comp BEFORE the worklist starts.
 *
 * Setup: facts in HashMap[var_id → value], implicazioni come 3 HashMap
 * parallele (cond, target, value) indexate da impl id.
 *
 * Test:
 *   Facts iniziali: var 1 = 10, var 5 = 50
 *   Implicazioni:
 *     1. cond=1 (resolved=10) → target=2 = 20  ✓ fire
 *     2. cond=2 (NOT resolved) → target=3 = 30  ✗ skip
 *     3. cond=5 (resolved=50) → target=7 = 70  ✓ fire
 *     4. cond=99 (NOT resolved) → target=4 = 40  ✗ skip
 *
 * Dopo bridge single pass:
 *   var 1=10, var 2=20, var 5=50, var 7=70
 *
 * Sum facts after bridge: 10+20+50+70 = 150. */

fun main(): number {
  be facts0 holds HashMap.empty()
  be facts1 holds HashMap.set(facts0, 1, 10)
  be facts2 holds HashMap.set(facts1, 5, 50)

  be conds0 holds HashMap.empty()
  be conds1 holds HashMap.set(conds0, 1, 1)
  be conds2 holds HashMap.set(conds1, 2, 2)
  be conds3 holds HashMap.set(conds2, 3, 5)
  be conds4 holds HashMap.set(conds3, 4, 99)

  be targets0 holds HashMap.empty()
  be targets1 holds HashMap.set(targets0, 1, 2)
  be targets2 holds HashMap.set(targets1, 2, 3)
  be targets3 holds HashMap.set(targets2, 3, 7)
  be targets4 holds HashMap.set(targets3, 4, 4)

  be values0 holds HashMap.empty()
  be values1 holds HashMap.set(values0, 1, 20)
  be values2 holds HashMap.set(values1, 2, 30)
  be values3 holds HashMap.set(values2, 3, 70)
  be values4 holds HashMap.set(values3, 4, 40)

  /* BRIDGE PRECOMPUTE: scan singolo delle 4 implicazioni inline. */

  /* impl 1 */
  be c1 holds HashMap.get(conds4, 1)
  be h1 holds HashMap.has(facts2, c1)
  be facts_after1 holds if h1 then
    HashMap.set(facts2, HashMap.get(targets4, 1), HashMap.get(values4, 1))
  else
    facts2

  /* impl 2 */
  be c2 holds HashMap.get(conds4, 2)
  be h2 holds HashMap.has(facts_after1, c2)
  be facts_after2 holds if h2 then
    HashMap.set(facts_after1, HashMap.get(targets4, 2), HashMap.get(values4, 2))
  else
    facts_after1

  /* impl 3 */
  be c3 holds HashMap.get(conds4, 3)
  be h3 holds HashMap.has(facts_after2, c3)
  be facts_after3 holds if h3 then
    HashMap.set(facts_after2, HashMap.get(targets4, 3), HashMap.get(values4, 3))
  else
    facts_after2

  /* impl 4 */
  be c4 holds HashMap.get(conds4, 4)
  be h4 holds HashMap.has(facts_after3, c4)
  be facts_after4 holds if h4 then
    HashMap.set(facts_after3, HashMap.get(targets4, 4), HashMap.get(values4, 4))
  else
    facts_after3

  /* Sum facts finali: 10+20+50+70 = 150. */
  be v1 holds HashMap.get(facts_after4, 1)
  be v2 holds HashMap.get(facts_after4, 2)
  be v5 holds HashMap.get(facts_after4, 5)
  be v7 holds HashMap.get(facts_after4, 7)
  return v1 + v2 + v5 + v7
}
