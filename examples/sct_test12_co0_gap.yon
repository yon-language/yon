/* SCT Test 12 — Co₀ collapse PREVIEW VIA S_2 CANONICALIZATION (turno 32).
 *
 * Runtime aggiornato turno 32: `yon_rt_merkle_node2` ora applica
 * canonicalize-by-sort sui due children prima di hash.
 *   node2(L, a, b) e node2(L, b, a) → STESSO slot xheap.
 *
 * Questo è orbit hash sotto S_2 (caso più semplice di canonicalization
 * sotto gruppo). Co₀ pieno (M_24 + ξ Conway) richiede sub-progetto
 * separato; S_2 è il primo step concreto.
 *
 * Setup: due Merkle node con stessi figli ma ordine diverso.
 *   p1 = node2(99, leaf(3), leaf(5))      → slot S
 *   p2 = node2(99, leaf(5), leaf(3))      → slot S (DEDUP via sort)
 *
 * Allocazioni:
 *   - 2 leaf (3 e 5): 2 slot
 *   - 1 node canonicalizzato (children ordinati 3,5): 1 slot
 *   - p2 dedup completo (stesso canonical) → 0 slot nuovi
 *
 * Atteso EXIT: 3 (era 4 prima del fix turno 32). */

fun main(): number {
  be n_before holds __xheap_used()

  /* p1 = node2(99, leaf(3), leaf(5)) */
  be l3a holds Merkle.leaf(3)
  be l5a holds Merkle.leaf(5)
  be p1 holds Merkle.node2_commutative(99, l3a, l5a)

  /* p2 = node2(99, leaf(5), leaf(3))
   * Sort canonicalization runtime: children ordinati (3, 5) → DEDUP con p1 */
  be l3b holds Merkle.leaf(3)   /* DEDUP con l3a */
  be l5b holds Merkle.leaf(5)   /* DEDUP con l5a */
  be p2 holds Merkle.node2_commutative(99, l5b, l3b)  /* canonicalize → DEDUP con p1 */

  be n_after holds __xheap_used()
  return n_after - n_before
}
