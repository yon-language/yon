/* SCT wavefront NATIVO Yon — full demo (part 15-bis, 2026-05-30).
 *
 * 4 algebre commutative, ognuna con wavefront 100% Yon:
 *   1. (OR, {0,1}^4)        canon=popcount(5)
 *   2. (ℤ_8, +)              canon=identity(0)
 *   3. (ℕ, max)              canon=identity(0)
 *   4. (ℕ⁺, gcd)             canon=identity(0)
 *
 * Per algebra 1, traccia o_i per ogni round via HashMap accumulator.
 * Zero codice C custom — solo primitive Yon. */

fun main(): number {
  /* ====== Algebra 1: OR-semilattice + trace o_i ====== */
  be trace holds HashMap.empty()
  be R_size_prev holds Space.make(1)  /* |R_0| = 1 */
  
  be r0 holds HashSet.empty()
  be r1 holds HashSet.orbital_add_with(r0, 0, 5)
  be R_or holds Space.make(r1)
  
  /* Round 1: axiom=1 */
  be _o1 holds HashSet.to_stream(r1).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 1), 5)))
  be R1 holds HashSet.size(Space.get(R_or))
  be o1 holds (R1 - 1) * 1000 / R1   /* o_1 * 1000 */
  be _t1 holds Space.set(R_size_prev, R1)
  be _io1 holds IO.print_num(o1)
  
  /* Round 2: axiom=3 */
  be _o2 holds HashSet.to_stream(Space.get(R_or)).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 3), 5)))
  be R2 holds HashSet.size(Space.get(R_or))
  be R1_prev holds Space.get(R_size_prev)
  be o2 holds (R2 - R1_prev) * 1000 / (R1_prev + 1)
  be _t2 holds Space.set(R_size_prev, R2)
  be _io2 holds IO.print_num(o2)
  
  /* Round 3: axiom=5 */
  be _o3 holds HashSet.to_stream(Space.get(R_or)).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 5), 5)))
  be R3 holds HashSet.size(Space.get(R_or))
  be R2_prev holds Space.get(R_size_prev)
  be o3 holds (R3 - R2_prev) * 1000 / (R2_prev + 1)
  be _t3 holds Space.set(R_size_prev, R3)
  be _io3 holds IO.print_num(o3)
  
  /* Round 4: axiom=15 */
  be _o4 holds HashSet.to_stream(Space.get(R_or)).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 15), 5)))
  be R4 holds HashSet.size(Space.get(R_or))
  be R3_prev holds Space.get(R_size_prev)
  be o4 holds (R4 - R3_prev) * 1000 / (R3_prev + 1)
  be _io4 holds IO.print_num(o4)

  be size_or holds R4

  /* ====== Algebra 4: (ℕ⁺, gcd) — completamente nuovo ====== */
  be r0g holds HashSet.empty()
  be r1g holds HashSet.orbital_add_with(r0g, 24, 0)  /* start 24 */
  be R_gcd holds Space.make(r1g)
  be _g1 holds HashSet.to_stream(Space.get(R_gcd)).fold(0, fun(a: number, f: number) =>
    Space.set(R_gcd, HashSet.orbital_add_with(Space.get(R_gcd), Math.gcd(f, 18), 0)))
  be _g2 holds HashSet.to_stream(Space.get(R_gcd)).fold(0, fun(a: number, f: number) =>
    Space.set(R_gcd, HashSet.orbital_add_with(Space.get(R_gcd), Math.gcd(f, 12), 0)))
  be _g3 holds HashSet.to_stream(Space.get(R_gcd)).fold(0, fun(a: number, f: number) =>
    Space.set(R_gcd, HashSet.orbital_add_with(Space.get(R_gcd), Math.gcd(f, 8), 0)))
  be size_gcd holds HashSet.size(Space.get(R_gcd))
  be _iog holds IO.print_num(size_gcd)
  
  return size_or + size_gcd
}
