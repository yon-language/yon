/* HSH — verifica congiunta di membership (hash) e witness (voyager).
 * Subset Sum [2,3,7]. Targets: 5={2,3} bitmask 3; 9={2,7} bitmask 5; 12=tutti bitmask 7.
 * Controlli: 5∈H3, 9∈H3, 12∈H3, 4∉H3 (nessun subset=4).
 * return = (5∈H3)+(9∈H3)+(12∈H3)+(4∉H3 ? 0:1...) codificato:
 *   m5*1 + m9*2 + m12*4 + has4*8  con m=membership(1/0), has4 atteso 0
 *   atteso = 1 + 2 + 4 + 0 = 7. */
fun main(): number {
  be s0 holds HSH.empty(0)
  be s1 holds HSH.step(s0, 2, 0)
  be s2 holds HSH.step(s1, 3, 0)
  be s3 holds HSH.step(s2, 7, 0)
  be m5  holds if HSH.contains(s3, 3, 5) then 1 else 0
  be m9  holds if HSH.contains(s3, 3, 9) then 1 else 0
  be m12 holds if HSH.contains(s3, 3, 12) then 1 else 0
  be h4  holds if HSH.contains(s3, 3, 4) then 1 else 0
  return m5 * 1 + m9 * 2 + m12 * 4 + h4 * 8
}
