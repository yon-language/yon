/* Sintassi surface: l'utente dichiara un'algebra come place con leggi.
 * Additive e' commutativa/associativa/monotona per teorema del catalogo,
 * quindi MagmaSolve verifica e PASSA. */
world Alg {
  Code is X
}

place AddPlace in Alg with effects {
  operation add(a: number, b: number): number uses algebra Additive
  law commutative
  law associative
  law monotone
}

fun main(): number {
  return 0
}
