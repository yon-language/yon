// COSA: univalenza con l'equivalenza NOMINATA — si lega il ponte succ<->pred a un
// nome (`bridge`), poi si trasporta lungo di esso (10 |-> 11).
// PERCHE': dare un nome al ponte prima di attraversarlo e' leggibilita' senza
// perdere il calcolo; l'intermedio legato viene inlineato prima del desugar cosi'
// la macchina di univalenza resta chiusa e computa.
fun succ(n: number): number { return n + 1 }
fun pred(n: number): number { return n - 1 }

fun main(): number {
  be bridge holds equiv(succ, pred, fun(a) => refl(a), fun(b) => refl(b))
  be y holds transport(ua(bridge), 10)
  return y     // -> 11
}
