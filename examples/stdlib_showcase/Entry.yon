place Entry {
/* stdlib_showcase.yon
 *
 * Showcase di tutti gli moduli stdlib introdotti:
 *   - Math (sqrt, abs, floor, ceil, round, min, max, pow, log, exp, sin, cos, pi, e)
 *   - Bits (band, bor, bxor, bnot, shl, shr, popcount)
 *   - Cap (grant, check, revoke)
 *   - MoveRegistry (register_version, current_version)
 *   - IO (print_num)
 *   - Sequence (map, filter, fold via stream backbone)
 *   - Leech (sign_canonical, syndrome, orbit_id, ecc.)
 *
 * Output esempio: solo un numero composito che dimostra che tutto compila e gira. */

fun main(): Number {
  /* Math */
  m1 := Math.floor(3.7)         /* = 3 */
  m2 := Math.ceil(3.2)          /* = 4 */
  m3 := Math.pow(2, 8)          /* = 256 */
  m4 := Math.min(50, 100)       /* = 50 */

  /* Bits */
  b1 := Bits.popcount(255)      /* = 8 */
  b2 := Bits.shl(1, 5)          /* = 32 */
  b3 := Bits.band(255, 15)      /* = 15 */

  /* Cap registry */
  cap1 := Cap.grant(1001)
  cap_present := Cap.check(1001)    /* = 1 */
  cap_absent := Cap.check(9999)     /* = 0 */

  /* MoveRegistry */
  _ := MoveRegistry.register_version(100, 3)
  mv := MoveRegistry.current_version(100)   /* = 3 */

  /* Leech sign canonical */
  l1 := Leech.syndrome(255)     /* = 0 (255 codeword) */
  l2 := Leech.syndrome(1)       /* = 1 */

  /* Output composite tutto in un unico int (per check) */
  total := m1 + m2 * 10 + b1 * 100 + b3 * 1000 + cap_present * 10000

  _o := IO.print_num(total)
  return total + l1 + l2
}
}
