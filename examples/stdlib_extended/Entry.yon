place Entry {
/* Stdlib estesa: String, Time, Random, Crypto. */

fun main(): Number {
  /* String */
  s_42 := String.from_int(42)
  s_99 := String.from_int(99)
  s_cat := String.concat(s_42, s_99)        /* "4299" */
  len := String.length(s_cat)               /* = 4 */
  _io1 := String.print(s_cat)
  char0 := String.char_at(s_cat, 0)         /* '4' = 52 */

  /* Time */
  t1 := Time.now_ms(0)
  t2 := Time.now_ms(0)
  dt := t2 - t1                             /* small positive */
  time_ok := if dt >= 0 then 1 else 0

  /* Random */
  _seed := Random.seed(42)
  r1 := Random.range(0, 100)
  r2 := Random.range(0, 100)
  _io2 := IO.print_num(r1)
  _io3 := IO.print_num(r2)
  rand_in_range := if r1 >= 0 then (if r1 < 100 then 1 else 0) else 0

  /* Crypto */
  s_hello := String.from_int(12345)
  h := Crypto.fnv1a(s_hello)
  h_int := Crypto.hash_int(42)
  _io4 := IO.print_num(h)
  _io5 := IO.print_num(h_int)
  /* hash deterministic */
  h_again := Crypto.hash_int(42)
  hash_det := if h_int == h_again then 1 else 0

  /* Output: len(4) + time_ok*10 + rand_in_range*100 + hash_det*1000 */
  return len + time_ok * 10 + rand_in_range * 100 + hash_det * 1000
}
}
