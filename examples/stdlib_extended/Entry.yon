place Entry {
/* Stdlib estesa: String, Time, Random, Crypto. */

fun main(): Number {
  /* String */
  be s_42 := String.from_int(42)
  be s_99 := String.from_int(99)
  be s_cat := String.concat(s_42, s_99)        /* "4299" */
  be len := String.length(s_cat)               /* = 4 */
  be _io1 := String.print(s_cat)
  be char0 := String.char_at(s_cat, 0)         /* '4' = 52 */

  /* Time */
  be t1 := Time.now_ms(0)
  be t2 := Time.now_ms(0)
  be dt := t2 - t1                             /* small positive */
  be time_ok := if dt >= 0 then 1 else 0

  /* Random */
  be _seed := Random.seed(42)
  be r1 := Random.range(0, 100)
  be r2 := Random.range(0, 100)
  be _io2 := IO.print_num(r1)
  be _io3 := IO.print_num(r2)
  be rand_in_range := if r1 >= 0 then (if r1 < 100 then 1 else 0) else 0

  /* Crypto */
  be s_hello := String.from_int(12345)
  be h := Crypto.fnv1a(s_hello)
  be h_int := Crypto.hash_int(42)
  be _io4 := IO.print_num(h)
  be _io5 := IO.print_num(h_int)
  /* hash deterministic */
  be h_again := Crypto.hash_int(42)
  be hash_det := if h_int == h_again then 1 else 0

  /* Output: len(4) + time_ok*10 + rand_in_range*100 + hash_det*1000 */
  return len + time_ok * 10 + rand_in_range * 100 + hash_det * 1000
}
}
