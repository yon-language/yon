place Entry {
// COSA: algebra dei cammini nella voce del VIAGGIO — back (indietro), ++ (poi),
// through (attraverso f). Riducono e compongono su cammini chiusi, ora in nativo.
// PERCHE': un cammino e' un viaggio; invertirlo (back), comporlo (++) e portarlo
// attraverso una funzione (through) e' calcolo vero, non decorazione.
fun dbl(n: Number): Number { return n + n }

fun main(): Number {
  be reversed holds back clear 5           // inv(clear 5)        = clear 5
  be joined holds clear 7 ++ clear 7       // concat(clear 7, clear 7) = clear 7
  be shadow holds clear 5 through dbl       // ap(dbl, clear 5)    = clear 10
  return (reversed @ I0) + (joined @ I0) + (shadow @ I0)    // 5 + 7 + 10 = 22
}
}
