/* SCT Test 42 — §34.6 OR/SAT scaling con AVERAGE su 5 seed (turno 33 part 9).
 *
 * Per estrarre scaling exponent stabile, media su 5 seed diversi per
 * ogni n. Ritorna c_avg, k_avg, ratio_avg per n=10, 14, 18, 20. */

fun avg_R(n: number): number {
  be r1 holds SAT.run_3sat(n, 42, 1)
  be r2 holds SAT.run_3sat(n, 43, 1)
  be r3 holds SAT.run_3sat(n, 44, 1)
  be r4 holds SAT.run_3sat(n, 45, 1)
  be r5 holds SAT.run_3sat(n, 46, 1)
  return (r1 + r2 + r3 + r4 + r5) / 5
}

fun avg_k(n: number): number {
  be k1 holds SAT.run_3sat(n, 42, 2)
  be k2 holds SAT.run_3sat(n, 43, 2)
  be k3 holds SAT.run_3sat(n, 44, 2)
  be k4 holds SAT.run_3sat(n, 45, 2)
  be k5 holds SAT.run_3sat(n, 46, 2)
  return (k1 + k2 + k3 + k4 + k5) / 5
}

fun avg_max_o(n: number): number {
  be o1 holds SAT.run_3sat(n, 42, 3)
  be o2 holds SAT.run_3sat(n, 43, 3)
  be o3 holds SAT.run_3sat(n, 44, 3)
  be o4 holds SAT.run_3sat(n, 45, 3)
  be o5 holds SAT.run_3sat(n, 46, 3)
  return (o1 + o2 + o3 + o4 + o5) / 5 / 1000
}

fun main(): number {
  /* n = 10, 14, 18, 20 — multi-seed average */
  be R_10 holds avg_R(10)
  be G_10 holds SAT.run_3sat(10, 42, 6)
  be k_10 holds avg_k(10)
  be c_10 holds Math.log(R_10) / Math.log(G_10)
  be r_10 holds k_10 / Math.log(G_10)
  be mo_10 holds avg_max_o(10)

  be R_14 holds avg_R(14)
  be G_14 holds SAT.run_3sat(14, 42, 6)
  be k_14 holds avg_k(14)
  be c_14 holds Math.log(R_14) / Math.log(G_14)
  be r_14 holds k_14 / Math.log(G_14)
  be mo_14 holds avg_max_o(14)

  be R_18 holds avg_R(18)
  be G_18 holds SAT.run_3sat(18, 42, 6)
  be k_18 holds avg_k(18)
  be c_18 holds Math.log(R_18) / Math.log(G_18)
  be r_18 holds k_18 / Math.log(G_18)
  be mo_18 holds avg_max_o(18)

  be R_20 holds avg_R(20)
  be G_20 holds SAT.run_3sat(20, 42, 6)
  be k_20 holds avg_k(20)
  be c_20 holds Math.log(R_20) / Math.log(G_20)
  be r_20 holds k_20 / Math.log(G_20)
  be mo_20 holds avg_max_o(20)

  /* Print: R, c, k, r, mo per ogni n */
  be _01 holds IO.print_num(R_10)
  be _02 holds IO.print_num(c_10)
  be _03 holds IO.print_num(k_10)
  be _04 holds IO.print_num(r_10)
  be _05 holds IO.print_num(mo_10)

  be _11 holds IO.print_num(R_14)
  be _12 holds IO.print_num(c_14)
  be _13 holds IO.print_num(k_14)
  be _14 holds IO.print_num(r_14)
  be _15 holds IO.print_num(mo_14)

  be _21 holds IO.print_num(R_18)
  be _22 holds IO.print_num(c_18)
  be _23 holds IO.print_num(k_18)
  be _24 holds IO.print_num(r_18)
  be _25 holds IO.print_num(mo_18)

  be _31 holds IO.print_num(R_20)
  be _32 holds IO.print_num(c_20)
  be _33 holds IO.print_num(k_20)
  be _34 holds IO.print_num(r_20)
  be _35 holds IO.print_num(mo_20)

  /* Δc tra n=10 e n=20: se piccola → c stabile (poly hint) */
  be delta_c holds c_20 - c_10
  be _delta holds IO.print_num(delta_c)

  /* Δ(k/ln(G)) tra n=10 e n=20: se piccola → k = O(log G) hint */
  be delta_r holds r_20 - r_10
  be _deltar holds IO.print_num(delta_r)

  return Math.floor(c_20 * 100)
}
