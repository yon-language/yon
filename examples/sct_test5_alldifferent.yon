/* SCT Test 5 — All-Different O(1) Removal (Paper §5.2, Mennillo 2026b).
 *
 * All-Different constraint: n variabili devono assumere valori DISTINCT
 * da un dominio comune. Classico SAT/CSP, O(n²) per arc consistency.
 *
 * Cluster collapse (paper §5.2):
 *   - Shared pool dei valori disponibili (HashSet)
 *   - inject_fact(v, x) → marca x come "used" via HashSet.add
 *   - available(y) = !used.contains(y)
 *   - O(1) per check; ALL unresolved vars vedono pool ridotto istantaneo
 *
 * Test concreto:
 *   Dominio: {10, 20, 30, 40, 50}
 *   Variabili da risolvere: v_A, v_B, v_C, v_D, v_E
 *
 *   inject(v_A, 30) → used = {30}
 *   inject(v_B, 10) → used = {10, 30}
 *   inject(v_C, 50) → used = {10, 30, 50}
 *
 *   Check disponibilita' di ogni valore del dominio dopo 3 inject:
 *     available(10) = false (used)
 *     available(20) = true
 *     available(30) = false (used)
 *     available(40) = true
 *     available(50) = false (used)
 *
 *   Count available: 2 (= 20 e 40)
 *
 * Return: count_available * 100 + 3 (= # used)
 *         = 200 + 3 = 203. */

fun main(): number {
  /* Pool dei valori usati (resolved). HashSet. */
  be used0 holds HashSet.empty()

  /* inject sequenziali */
  be used1 holds HashSet.add(used0, 30)
  be used2 holds HashSet.add(used1, 10)
  be used3 holds HashSet.add(used2, 50)

  /* Size deve essere 3 */
  be n_used holds HashSet.size(used3)

  /* Check ogni valore del dominio: available iff NOT in used */
  be c10 holds HashSet.contains(used3, 10)  /* true */
  be c20 holds HashSet.contains(used3, 20)  /* false */
  be c30 holds HashSet.contains(used3, 30)  /* true */
  be c40 holds HashSet.contains(used3, 40)  /* false */
  be c50 holds HashSet.contains(used3, 50)  /* true */

  /* count_available = # values NOT in used */
  be av10 holds if c10 then 0 else 1
  be av20 holds if c20 then 0 else 1
  be av30 holds if c30 then 0 else 1
  be av40 holds if c40 then 0 else 1
  be av50 holds if c50 then 0 else 1
  be n_available holds av10 + av20 + av30 + av40 + av50

  return n_available * 100 + n_used
}
