/* SCT Test 41 — §34.6 OR/SAT scaling extended n=14..20 (turno 33 part 9). */

fun main(): number {
  be seed holds 42

  /* n=14, 16, 18, 20 */
  be R14 holds SAT.run_3sat(14, seed, 1)
  be G14 holds SAT.run_3sat(14, seed, 6)
  be k14 holds SAT.run_3sat(14, seed, 2)
  be c14 holds Math.log(R14) / Math.log(G14)
  be r14 holds k14 / Math.log(G14)

  be R16 holds SAT.run_3sat(16, seed, 1)
  be G16 holds SAT.run_3sat(16, seed, 6)
  be k16 holds SAT.run_3sat(16, seed, 2)
  be c16 holds Math.log(R16) / Math.log(G16)
  be r16 holds k16 / Math.log(G16)

  be R18 holds SAT.run_3sat(18, seed, 1)
  be G18 holds SAT.run_3sat(18, seed, 6)
  be k18 holds SAT.run_3sat(18, seed, 2)
  be c18 holds Math.log(R18) / Math.log(G18)
  be r18 holds k18 / Math.log(G18)

  be R20 holds SAT.run_3sat(20, seed, 1)
  be G20 holds SAT.run_3sat(20, seed, 6)
  be k20 holds SAT.run_3sat(20, seed, 2)
  be c20 holds Math.log(R20) / Math.log(G20)
  be r20 holds k20 / Math.log(G20)

  be _0 holds IO.print_num(R14)
  be _1 holds IO.print_num(R16)
  be _2 holds IO.print_num(R18)
  be _3 holds IO.print_num(R20)
  be _4 holds IO.print_num(c14)
  be _5 holds IO.print_num(c16)
  be _6 holds IO.print_num(c18)
  be _7 holds IO.print_num(c20)
  be _8 holds IO.print_num(k14)
  be _9 holds IO.print_num(k16)
  be _10 holds IO.print_num(k18)
  be _11 holds IO.print_num(k20)
  be _12 holds IO.print_num(r14)
  be _13 holds IO.print_num(r16)
  be _14 holds IO.print_num(r18)
  be _15 holds IO.print_num(r20)

  return Math.floor(c20 * 100)
}
