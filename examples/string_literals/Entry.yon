place Entry {
/* Text fusion: "..." literals ARE Text values — sections of
 * the builtin Text place, interned to xheap handles (content-addressed:
 * same literal, same slot). Expected exit: 1+2+4+8+16 = 31. */

fun greet(who: Text): Text {
  return Text.concat("ciao ", who)
}

fun main(): Number {
  lit := "yon"
  ok_len := if Text.length(lit) == 3 then 1 else 0

  /* literals flow into Text.* and user functions transparently (text = Text) */
  msg := greet("mondo")
  ok_msg := if Text.length(msg) == 10 then 1 else 0

  /* content-addressing: same literal, same slot -> equal as values */
  ok_eq := if Text.equal("yon", lit) then 1 else 0

  /* the file path is finally a literal */
  _wr := File.write_text("/tmp/yon_lit.txt", msg)
  readback := File.read_text("/tmp/yon_lit.txt")
  ok_io := if Text.equal(readback, msg) then 1 else 0

  ok_env := if Env.has("PATH") then 1 else 0

  _p := Text.print(msg)
  return ok_len + ok_msg * 2 + ok_eq * 4 + ok_io * 8 + ok_env * 16
}
}
