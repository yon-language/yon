/* SCT Test 36 — Theorem 14 (Parallel Wavefront, §24) (turno 33 part 6).
 *
 * Wavefront step: per ogni fact in R_{j-1}, compose con axiom group_j.
 * Le compose sono INDIPENDENTI → naturally parallelizable.
 *
 * Test: simulo wavefront sequenziale e verifico che il risultato sia
 * INVARIANTE rispetto all'ordine di composizione (proprietà che giustifica parallelism).
 *
 * Setup: R_init = {0, 5, 10}, axiom = 3.
 * Comporre 3 con ciascun fact: {3, 8, 13}.
 * Unione finale: R = {0, 3, 5, 8, 10, 13}.
 *
 * Test ordine: applico in 2 ordini diversi (forward + reversed), verifico
 * che HashSet.size sia uguale (commutativity di OR set union). */

fun main(): number {
  /* R_init = {0, 5, 10}, axiom = 3 */
  be r_init_a holds HashSet.empty()
  be r_init_b holds HashSet.add(r_init_a, 0)
  be r_init_c holds HashSet.add(r_init_b, 5)
  be r_init holds HashSet.add(r_init_c, 10)

  /* Forward wavefront: compose 3 in order */
  be wf_a holds HashSet.add(r_init, 3)      /* 0+3 */
  be wf_b holds HashSet.add(wf_a, 8)        /* 5+3 */
  be wf_fwd holds HashSet.add(wf_b, 13)     /* 10+3 */
  be size_fwd holds HashSet.size(wf_fwd)    /* expected 6 */

  /* Reversed wavefront: stesso compose, ordine inverso */
  be wf_r_a holds HashSet.add(r_init, 13)
  be wf_r_b holds HashSet.add(wf_r_a, 8)
  be wf_rev holds HashSet.add(wf_r_b, 3)
  be size_rev holds HashSet.size(wf_rev)

  /* Order invariance: |R_fwd| == |R_rev| → parallelizable */
  be order_invariant holds if size_fwd == size_rev then 1 else 0

  be _io1 holds IO.print_num(size_fwd)
  be _io2 holds IO.print_num(size_rev)

  return order_invariant * 100 + size_fwd   /* expected 106 */
}
