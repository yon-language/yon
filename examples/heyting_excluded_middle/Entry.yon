place Entry {
// Il terzo escluso (p or not p) FALLISCE su `unknown`: la firma di una logica
// intuizionista (Heyting) vera, non un tri-valued ad-hoc ne' un null travestito.
fun main(): Number {
  be p := unknown
  be lem := p ||? (!? p)      // "p or not p": classicamente SEMPRE vero
  // su unknown, in Heyting, resta unknown: non e' present, e non e' absent
  be dec := match decide(lem) { Present => 100, Absent => 0, Unknown => 0 }

  be q := present
  be lem_q := q ||? (!? q)    // su un valore NOTO il terzo escluso vale
  be dec_q := match decide(lem_q) { Present => 1, Absent => 0, Unknown => 0 }

  // logica classica darebbe 101; Heyting da' 1 (LEM cade su unknown, tiene su present)
  return dec + dec_q
}
}
