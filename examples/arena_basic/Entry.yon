place Entry {
/* Arena, the Leech type-2 arena, as a first-class language structure.
 *
 * A slot is addressed by a LatticePoint, made only where it is one
 * (LatticePoint.of_coordinate answers a point or a DomainError). Exercises
 * the API end to end:
 *   put/get  : store a value at a point and read it back (get answers
 *              Found(value) or Absent)
 *   occupied : the slot is taken (a Boolean)
 *   orbit    : the pure M24 orbit of the point (1536 is in orbit 0); it
 *              belongs to the point, not to the arena
 *   1536 and 1280 share an orbit; 1536 and 16778752 do not
 *   fuse/fusion_count: record one sigma-certified fusion
 *
 * Each of the six checks contributes 1; the program returns 6 when all hold. */

fun orbit_at(n: Number): Number {
  return match LatticePoint.of_coordinate(n) {
    LatticePoint as q => LatticePoint.orbit(q), DomainError as d => 0 - 1 }
}

fun checks(p: LatticePoint): Number {
  be a0 := Arena.empty()
  be a1 := Arena.put(a0, p, 42)
  be v := match Arena.get(a1, p) { Found(x) => x, Absent => 0 }
  be occ := Arena.occupied(a1, p)
  be o0 := LatticePoint.orbit(p)
  be a2 := Arena.fuse(a1, p, 99, 7)
  be fc := Arena.fusion_count(a2, p)

  be c_v := if v == 42 then 1 else 0
  be c_occ := if occ then 1 else 0
  be c_o0 := if o0 == 0 then 1 else 0
  be c_same := if o0 == orbit_at(1280) then 1 else 0
  be c_diff := if o0 != orbit_at(16778752) then 1 else 0
  be c_fc := if fc == 1 then 1 else 0
  return c_v + c_occ + c_o0 + c_same + c_diff + c_fc
}

fun main(): Number {
  return match LatticePoint.of_coordinate(1536) {
    LatticePoint as p => checks(p), DomainError as d => 0 }
}
}
