place Entry {
/* Arena, the Leech type-2 arena, as a first-class language structure.
 *
 * Exercises the handle-based API end to end:
 *   put/get  : store a value at a type-2 point and read it back (get answers
 *              Found(value) or Absent)
 *   occupied : the slot is taken (a Boolean)
 *   orbit    : the pure M24 orbit id of the point (1536 is in orbit 0)
 *   same_orbit: 1536 and 1280 share orbit 0 (yes); 1536 vs 16778752 differ (no)
 *   fuse/fusion_count: record one sigma-certified fusion
 *
 * Each of the six checks contributes 1; the program returns 6 when all hold. */

fun main(): Number {
  be a0 := Arena.empty()
  be a1 := Arena.put(a0, 1536, 42)
  be v := match Arena.get(a1, 1536) { Found(x) => x, Absent => 0 }
  be occ := Arena.occupied(a1, 1536)
  be o0 := Arena.orbit(a1, 1536)
  be so_same := Arena.same_orbit(a1, 1536, 1280)
  be so_diff := Arena.same_orbit(a1, 1536, 16778752)
  be a2 := Arena.fuse(a1, 1536, 99, 7)
  be fc := Arena.fusion_count(a2, 1536)

  be c_v := if v == 42 then 1 else 0
  be c_occ := if occ then 1 else 0
  be c_o0 := if o0 == 0 then 1 else 0
  be c_same := if so_same == 1 then 1 else 0
  be c_diff := if so_diff == 0 then 1 else 0
  be c_fc := if fc == 1 then 1 else 0
  return c_v + c_occ + c_o0 + c_same + c_diff + c_fc
}
}
