/* SCT Test 19 — G_24 collapse strutturale su orbit multipla (turno 32).
 *
 * Verifico empiricamente che signs nella stessa orbita G_24 collassano
 * tutti su UN SOLO slot xheap. Risparmio strutturale paper §3.2.
 *
 * Setup: 5 codeword G_24 distinti (verified via libmmgroup):
 *   0x000000 (gcode 0, peso 0)
 *   0x00ff00 (gcode 3, peso 8)
 *   0xff0000 (gcode 12, peso 8)
 *   0x00ffff (XOR di due codeword 0x00ff00 ⊕ 0x0000ff??): provo numeri
 *
 * Tutti hanno syndrome = 0 → stesso slot canonicalizzato.
 *
 * Misuro delta_xheap per 5 sign_canonical(label, codeword_i):
 *   Predizione: delta = 1 (un solo slot canonicalizzato)
 *   Naive senza canonicalization: delta = 5 (1 per ciascun codeword).
 *
 * Confronto con 5 valori NON in G_24:
 *   1, 2, 4, 8, 16 (peso 1, tutti syndrome diversi) → delta = 5
 *
 * Ratio: 1/5 = 5× collapse strutturale per questa orbita. */

fun main(): number {
  be n0 holds __xheap_used()

  /* 5 codeword G_24 distinti — TUTTI con syndrome 0 → DEDUP totale */
  be c0 holds Leech.sign_canonical(42, 0)         /* codeword zero */
  be c1 holds Leech.sign_canonical(42, 65280)     /* 0x00FF00, gcode 3 */
  be c2 holds Leech.sign_canonical(42, 16711680)  /* 0xFF0000, gcode 12 */
  be c3 holds Leech.sign_canonical(42, 16776960)  /* 0xFFFF00, gcode 15 (peso 16) */
  be c4 holds Leech.sign_canonical(42, 255)       /* 0x0000FF - VERIFICATO codeword */

  be n1 holds __xheap_used()
  be delta_collapse holds n1 - n0   /* expected: 1 (tutti collassano) */

  /* 5 sign-pattern NON codeword (peso 1, syndrome diversi) */
  be d0 holds Leech.sign_canonical(42, 1)    /* bit 0 */
  be d1 holds Leech.sign_canonical(42, 2)    /* bit 1 */
  be d2 holds Leech.sign_canonical(42, 4)    /* bit 2 */
  be d3 holds Leech.sign_canonical(42, 8)    /* bit 3 */
  be d4 holds Leech.sign_canonical(42, 16)   /* bit 4 */

  be n2 holds __xheap_used()
  be delta_no_collapse holds n2 - n1  /* expected: 5 (tutti distinct) */

  /* Output: delta_collapse * 100 + delta_no_collapse */
  return delta_collapse * 100 + delta_no_collapse
}
