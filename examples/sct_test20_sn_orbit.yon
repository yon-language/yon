/* SCT Test 20 — S_n children sort + Leech orbit_id + same_orbit (turno 32).
 *
 * Verifico in un colpo solo:
 *   - S_3: node3(L, a, b, c) collassa con ogni permutazione (6 totali)
 *   - S_4: node4(L, a, b, c, d) collassa con ogni permutazione (24 totali)
 *   - Leech.orbit_id label-invariant
 *   - Leech.same_orbit boolean check
 *
 * Setup S_3:
 *   Costruisco 6 permutazioni di node3(99, leaf3, leaf5, leaf7).
 *   Predizione: tutti collassano → 1 solo slot per il node + 3 leaf
 *
 * Setup S_4: 3 permutazioni di node4(99, l3, l5, l7, l11) (non testo tutte 24,
 * basta che alcune divergenti collassino).
 *
 * Setup Leech: orbit_id(0) e orbit_id(255) collassano (entrambi syndrome 0).
 *
 * same_orbit(0, 255) deve essere TRUE.
 * same_orbit(0, 1) deve essere FALSE. */

fun main(): number {
  be n0 holds __xheap_used()

  /* 3 leaves comuni */
  be l3 holds Merkle.leaf(3)
  be l5 holds Merkle.leaf(5)
  be l7 holds Merkle.leaf(7)
  be l11 holds Merkle.leaf(11)

  /* S_3 test: 6 permutazioni di node3(99, l3, l5, l7) */
  be p1 holds Merkle.node3(99, l3, l5, l7)   /* primo */
  be p2 holds Merkle.node3(99, l3, l7, l5)   /* swap 1,2 */
  be p3 holds Merkle.node3(99, l5, l3, l7)
  be p4 holds Merkle.node3(99, l5, l7, l3)
  be p5 holds Merkle.node3(99, l7, l3, l5)
  be p6 holds Merkle.node3(99, l7, l5, l3)

  be n_after_s3 holds __xheap_used()
  be delta_s3 holds n_after_s3 - n0  /* expected: 4 leaf + 1 node = 5 */

  /* S_4 test: 3 permutazioni di node4(88, l3, l5, l7, l11) */
  be q1 holds Merkle.node4(88, l3, l5, l7, l11)
  be q2 holds Merkle.node4(88, l11, l7, l5, l3)  /* reverse */
  be q3 holds Merkle.node4(88, l5, l3, l11, l7)  /* random perm */

  be n_after_s4 holds __xheap_used()
  be delta_s4 holds n_after_s4 - n_after_s3  /* expected: 1 (solo node4 nuovo) */

  /* Leech orbit_id label-invariant */
  be oid_0 holds Leech.orbit_id(0)
  be oid_255 holds Leech.orbit_id(255)
  be oid_1 holds Leech.orbit_id(1)

  be orbit_match holds if oid_0 == oid_255 then 1 else 0
  be orbit_diff holds if oid_0 == oid_1 then 0 else 1

  /* same_orbit bool check */
  be sm holds if Leech.same_orbit(0, 255) then 1 else 0
  be sd holds if Leech.same_orbit(0, 1) then 0 else 1

  /* Output encoded:
   *   delta_s3 (5) + delta_s4 (1) * 10 + orbit_match (1) * 100 
   *   + orbit_diff (1) * 1000 + sm (1) * 10000 + sd (1) * 100000
   *   = 5 + 10 + 100 + 1000 + 10000 + 100000 = 111115 mod 256 */
  return delta_s3 + delta_s4 * 10 + orbit_match * 100 + orbit_diff * 1000 + sm * 10000 + sd * 100000
}
