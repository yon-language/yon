/* SCT Test 23 — Co_0 canonicalizzazione ESATTA (turno 33 part 26).
 * Riscritto: il vecchio test usava co0_canonical(v, max_iter) + co0_orbit_size,
 * entrambi BFS-bounded parametrici, RIMOSSI. Ora la canonicalizzazione e'
 * esatta (reduce_type2, zero parametri).
 *
 * Test iniettività esatta: v, ξ(v), ξ²(v) sono nella stessa orbita Co_0,
 * quindi co0_canonical deve dare lo STESSO valore per tutti e tre.
 * Output: eq_xi*10 + eq_xi2*100 + 1  (atteso 1+10+100 = 111 se iniettivo). */
fun main(): number {
  be v1 holds 8388609

  be can_1 holds Leech.co0_canonical(v1)
  be v1_xi holds Leech.xi_apply(v1)
  be can_1_xi holds Leech.co0_canonical(v1_xi)
  be v1_xi2 holds Leech.xi_apply(v1_xi)
  be can_1_xi2 holds Leech.co0_canonical(v1_xi2)

  be eq_xi holds if can_1 == can_1_xi then 1 else 0
  be eq_xi2 holds if can_1 == can_1_xi2 then 1 else 0

  return 1 + eq_xi * 10 + eq_xi2 * 100
}
