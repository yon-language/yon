// Generic functions: one definition, reused at any type. `identity` hands back
// its argument unchanged; `first` keeps the first of two, whatever their types.
fun identity<T>(x: T): T { return x }
fun first<A, B>(x: A, y: B): A { return x }

fun main(): number {
  be n holds identity(42)          // T = number
  be t holds first("ok", 0)        // A = text, B = number
  return n + String.length(t)      // 42 + 2 = 44
}
