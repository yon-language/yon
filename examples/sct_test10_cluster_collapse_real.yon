/* SCT Test 10 — Cluster Collapse (Theorem 1) come MISURA RUNTIME VERA.
 *
 * Rifacimento onesto di T1: T1 originale era replay aritmetico.
 * Qui misuro DAVVERO il cluster collapse via __xheap_used().
 *
 * Setup: simulo union-find di 8 elementi {0..7} con 4 equivalence classes:
 *   class A = {0, 4} → cluster representative = 0
 *   class B = {1, 5} → cluster representative = 1
 *   class C = {2, 6} → cluster representative = 2
 *   class D = {3, 7} → cluster representative = 3
 *
 * Naive (NON content-addressed): 8 elementi → 8 stati in memoria
 * Con cluster collapse: 4 classi → 4 nodi DAG distinti
 *
 * Yon realizza via Merkle DAG content-addressed:
 *   union-find equiv = stesso Merkle node per stessa orbita.
 *
 * Predizione Theorem 1: delta_xheap deve essere proporzionale al
 * numero di CLASSI (4), non al numero di ELEMENTI (8).
 *
 * Test:
 *   - 8 chiamate Merkle.leaf(class_rep_of_i) → solo 4 distinti
 *   - dedup naturale dovrebbe dare delta = 4 slot, non 8
 *
 * Atteso EXIT: 4. */

fun main(): number {
  be n_before holds __xheap_used()

  /* 8 inserzioni: ognuna mappa all'identità della classe */
  /* class_rep(0)=0, class_rep(4)=0 → stesso slot */
  be n_0 holds Merkle.leaf(0)   /* class A */
  be n_1 holds Merkle.leaf(1)   /* class B */
  be n_2 holds Merkle.leaf(2)   /* class C */
  be n_3 holds Merkle.leaf(3)   /* class D */
  be n_4 holds Merkle.leaf(0)   /* class A — DEDUP */
  be n_5 holds Merkle.leaf(1)   /* class B — DEDUP */
  be n_6 holds Merkle.leaf(2)   /* class C — DEDUP */
  be n_7 holds Merkle.leaf(3)   /* class D — DEDUP */

  be n_after holds __xheap_used()
  return n_after - n_before
}
