/* SCT wavefront NATIVO Yon — 2 algebre commutative (part 15, 2026-05-30).
 *
 * Dimostra che lo stesso pattern Yon (HashSet.orbital_add_with + Space + 
 * Seq.fold + algebra_op) si applica a algebre diverse.
 * 
 * Algebra 1: OR-semilattice ({0,1}^4, ∨, 0), canon=popcount
 * Algebra 2: (ℤ_8, +, 0), canon=identity
 *
 * Codice 100% Yon, nessun helper C. */

fun main(): number {
  /* ============================================= */
  /*  Algebra 1: OR-semilattice                   */
  /* ============================================= */
  be r0a holds HashSet.empty()
  be r1a holds HashSet.orbital_add_with(r0a, 0, 5)
  be R_or holds Space.make(r1a)
  
  be _or1 holds HashSet.to_stream(r1a).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 1), 5)))
  be _or2 holds HashSet.to_stream(r1a).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 3), 5)))
  be _or3 holds HashSet.to_stream(r1a).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 5), 5)))
  be _or4 holds HashSet.to_stream(r1a).fold(0, fun(a: number, f: number) =>
    Space.set(R_or, HashSet.orbital_add_with(Space.get(R_or), Bits.bor(f, 15), 5)))
  
  be size_or holds HashSet.size(Space.get(R_or))

  /* ============================================= */
  /*  Algebra 2: (ℤ_8, +, 0)                      */
  /* ============================================= */
  be r0b holds HashSet.empty()
  be r1b holds HashSet.orbital_add_with(r0b, 0, 0)
  be R_z8 holds Space.make(r1b)
  
  be _z1 holds HashSet.to_stream(r1b).fold(0, fun(a: number, f: number) =>
    Space.set(R_z8, HashSet.orbital_add_with(Space.get(R_z8), Math.modulo(f + 1, 8), 0)))
  be _z2 holds HashSet.to_stream(r1b).fold(0, fun(a: number, f: number) =>
    Space.set(R_z8, HashSet.orbital_add_with(Space.get(R_z8), Math.modulo(f + 2, 8), 0)))
  be _z3 holds HashSet.to_stream(r1b).fold(0, fun(a: number, f: number) =>
    Space.set(R_z8, HashSet.orbital_add_with(Space.get(R_z8), Math.modulo(f + 3, 8), 0)))
  be _z4 holds HashSet.to_stream(r1b).fold(0, fun(a: number, f: number) =>
    Space.set(R_z8, HashSet.orbital_add_with(Space.get(R_z8), Math.modulo(f + 5, 8), 0)))

  be size_z8 holds HashSet.size(Space.get(R_z8))
  
  be _p1 holds IO.print_num(size_or)
  be _p2 holds IO.print_num(size_z8)
  return size_or + size_z8
}
