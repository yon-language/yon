place Entry {
// Micro-example: `heyting` (Heyting integers with an Unknown mask) and
// the present/unknown literals through the Omega connectives.
// heyting(v) has no unknown trits; heyting(v, mask) marks the masked
// ones; `&?` is trit-wise with mask propagation. The Omega connectives
// (`&&?`, `=>?`) follow the intuitionistic rules, and `decide` gives the
// three values of a proposition as three arms, each answered.
fun main(): Number {
  u := unknown
  p := present
  both := p &&? u            // unknown: conjunction with the undecided
  imp := u =>? p             // present: anything implies the present
  h1 := heyting(5)           // trits 101, all certain
  h2 := heyting(5, 2)        // middle trit unknown
  hand := h1 &? h2           // trit-wise, the unknown propagates
  return match decide(imp) { Present => 42, Absent => 0, Unknown => 1 }
}
}
