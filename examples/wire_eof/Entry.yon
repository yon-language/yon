place Entry {
// Structural close: the produce wire closes itself when the block
// ends, so the for-every drain stops on its own. No count is known
// in advance anywhere in this program.
fun main(): Number {
  be s := produce { emit 7 }
  be total := 0
  for every v in s {
    total = total + v
  }
  return total      // 7
}
}
