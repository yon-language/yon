/* Stdlib estesa turno 33 part 7: String, Time, Random, Crypto. */

fun main(): number {
  /* String */
  be s_42 holds String.from_int(42)
  be s_99 holds String.from_int(99)
  be s_cat holds String.concat(s_42, s_99)        /* "4299" */
  be len holds String.length(s_cat)               /* = 4 */
  be _io1 holds String.print(s_cat)
  be char0 holds String.char_at(s_cat, 0)         /* '4' = 52 */

  /* Time */
  be t1 holds Time.now_ms(0)
  be t2 holds Time.now_ms(0)
  be dt holds t2 - t1                             /* small positive */
  be time_ok holds if dt >= 0 then 1 else 0

  /* Random */
  be _seed holds Random.seed(42)
  be r1 holds Random.range(0, 100)
  be r2 holds Random.range(0, 100)
  be _io2 holds IO.print_num(r1)
  be _io3 holds IO.print_num(r2)
  be rand_in_range holds if r1 >= 0 then (if r1 < 100 then 1 else 0) else 0

  /* Crypto */
  be s_hello holds String.from_int(12345)
  be h holds Crypto.fnv1a(s_hello)
  be h_int holds Crypto.hash_int(42)
  be _io4 holds IO.print_num(h)
  be _io5 holds IO.print_num(h_int)
  /* hash deterministic */
  be h_again holds Crypto.hash_int(42)
  be hash_det holds if h_int == h_again then 1 else 0

  /* Output: len(4) + time_ok*10 + rand_in_range*100 + hash_det*1000 */
  return len + time_ok * 10 + rand_in_range * 100 + hash_det * 1000
}
