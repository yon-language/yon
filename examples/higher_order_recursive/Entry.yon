place IntList { this > Nil :U Cons(number, IntList) }

place Entry {
// A recursive higher-order function over a native place-object. map_list takes a
// function f and threads it through the recursion, applying it to every element.
// This is the shape a compiler-in-Yon is built from (visitors, fold_tree,
// map_ast), and the case that used to run the frontend out of memory: the emit
// inlined the higher-order call, and a recursive callee re-inlined its own
// self-call forever. Now f is a first-class value, a function pointer passed by
// value (func.constant) and called via call_indirect, so the recursive call is a
// plain func.call and never re-inlines. Works for a named function or a lambda,
// direct or mutual recursion.


fun map_list(f: number -> number, xs: IntList): IntList {
  return match xs {
    Nil => Nil,
    Cons(h, t) => .-> Cons { _1 (f(h)) _2 (map_list(f, t)) }
  }
}

fun sum(xs: IntList): number {
  return match xs {
    Nil => 0,
    Cons(h, t) => h + sum(t)
  }
}

fun main(): number {
  // [20, 20] -- map (y => y + 1) --> [21, 21] -- sum --> 42
  be xs holds .-> Cons { _1 20 _2 .-> Cons { _1 20 _2 Nil } }
  return sum(map_list(fun(y: number) => y + 1, xs))
}
}
