/* Closed-morphism discipline (block 6). A move/functor/view body must be
 * CLOSED: it may use only its own parameters and top-level definitions, never
 * a local from the enclosing scope. Here the move body captures the enclosing
 * local `base`; this is rejected at TYPE-CHECK with a clear message, instead
 * of crashing later at emit ("variable not in scope"). A morphism escapes its
 * definition site (composed/applied elsewhere, possibly across a Space
 * boundary) and is not closure-converted, so it cannot carry a captured
 * environment by reference. Expected: EMITFAIL (type error, exit 3). */
world W { Code is X }
place P in W { v number }
place Q in W { v number }
fun main(): number {
  be base holds 7
  be m holds move(s: P) => new Q { v base } from P to Q
  be sp holds new P { v 0 }
  be sq holds m(sp)
  return sq.v
}
