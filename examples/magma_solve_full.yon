/* Linguaggio completo: dichiarazione + verifica + esecuzione, tutto in Yon.
 * Il place e' dichiarato con algebra del catalogo e leggi; solve lo istanzia
 * come handle Magma; le query del solver girano sull'handle. Niente C esterno. */
world Alg { Code is X }

place AddPlace in Alg with effects {
  operation add(a: number, b: number): number uses algebra Additive
  law commutative
  law associative
  law monotone
}

fun main(): number {
  be m holds solve AddPlace
  be m1 holds Magma.gen(m, 3)
  be m2 holds Magma.gen(m1, 5)
  be m3 holds Magma.gen(m2, 11)
  /* subset-sum: 8 = 3+5 raggiungibile -> maschera 3 */
  return Magma.subsetsum_mask(m3, 8)
}
