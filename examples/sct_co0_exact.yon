/* Co_0 ESATTO (canon_id=7, reduce_type2, zero parametri liberi).
 * 3 vettori della stessa orbita Co_0 collassano a size 1.
 * Confronto: G_24 syndrome (id=1) li lascia a 3.
 * return = co0_size*10 + g24_size = 1*10 + 3 = 13. */
fun main(): number {
  be s0 holds HashSet.empty()
  be a holds HashSet.orbital_add_with(s0, 8388609, 7)
  be b holds HashSet.orbital_add_with(a, 16835585, 7)
  be c holds HashSet.orbital_add_with(b, 25244160, 7)
  be co0_size holds HashSet.size(c)

  be t0 holds HashSet.empty()
  be x holds HashSet.orbital_add_with(t0, 8388609, 1)
  be y holds HashSet.orbital_add_with(x, 16835585, 1)
  be z holds HashSet.orbital_add_with(y, 25244160, 1)
  be g24_size holds HashSet.size(z)

  return co0_size * 10 + g24_size
}
