/* Magma normal_form: parola sotto OR. [1,2,4] -> normal form 7.
 * Commutativita' verificata -> [4,2,1] da' la stessa normal form.
 * return = nf1 * 1 + (if nf1==nf2 then 1000 else 0)
 *        = 7 + 1000 = 1007 (mod 256 = 239). */
fun main(): number {
  be m0 holds Magma.empty(4)
  be m1 holds Magma.gen(m0, 1)
  be m2 holds Magma.gen(m1, 2)
  be m holds Magma.gen(m2, 4)

  be w1a holds Magma.word_push(m, 1)
  be w1b holds Magma.word_push(w1a, 2)
  be w1c holds Magma.word_push(w1b, 4)
  be nf1 holds Magma.normal_form(w1c)

  be w2a holds Magma.word_push(m, 4)
  be w2b holds Magma.word_push(w2a, 2)
  be w2c holds Magma.word_push(w2b, 1)
  be nf2 holds Magma.normal_form(w2c)

  be same holds if nf1 == nf2 then 1000 else 0
  return nf1 + same
}
