place Entry {
// Hermetic scope, formal layer. The `scope` block becomes a
// topos.scope_with_yield region: IsolatedFromAbove forces `base` to enter
// as an EXPLICIT capture; an implicit outer reference would be rejected by
// the MLIR verifier. A scope gives no value of its own: the result leaves
// through a cell declared outside it, captured too. There is no arena: the
// region inlines at zero runtime cost.
fun main(): Number {
  base := 40
  mut result := 0
  scope Hermetic {
    sealed := base + 2
    result <- sealed
  }
  return result
}
}
