place Entry {
// Hermetic scope, formal layer. The `scope` block becomes a
// topos.scope_with_yield region: IsolatedFromAbove forces `base` to enter
// as an EXPLICIT capture; an implicit outer reference would be rejected by
// the MLIR verifier. There is no arena: the region inlines at zero
// runtime cost.
fun main(): Number {
  be base := 40
  scope Hermetic {
    be sealed := base + 2
  }
  return base + 2
}
}
