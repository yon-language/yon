/* Int32 — the declared face of the primitive code i32, in the Num32 site.
 *
 * Int32, not Int: the house gives the qualified name (Int32__widen_pos)
 * and the world does not enter it — two twins with the same house would
 * produce two identical symbols. The world stays the site (Num32 and
 * Num64 are distinct categories, Widen is a functor between them); the
 * name carries the precision, because the name is what travels in the
 * symbols.
 *
 * The runtime transport is the uniform f64, exact over the whole i32
 * range: the i32 face is the declared intent of the site, and the native
 * specialization belongs to the recognizer, not to this file.
 *
 * Markers: [T] total, written here
 */
place Int32 is i32 {

  /* ─── Widening without intrinsics ────────────────────────── [T] ───
   *
   * The signatures tell the truth: source Int32, target Int64 — the arrow
   * crosses the worlds, like the functor that will use it.
   *
   * The key: an integral literal is a point of every integer face, so the
   * number decomposes into digits on the 32 side and recomposes as
   * literals on the 64 side. It costs O(digits) instead of a single sext:
   * truth first, speed later — the optimization will be a recognition,
   * not a magic trick.
   *
   * Termination: `n / 10` strictly decreases, and SCT sees it. */

  /* the digit as a literal: on the left an Int32 comparison, on the right
     a literal return — and a literal is a point of every integer face */
  fun digit64(d: Int32): Int64 {
    return if d == 0 then 0
      else if d == 1 then 1
      else if d == 2 then 2
      else if d == 3 then 3
      else if d == 4 then 4
      else if d == 5 then 5
      else if d == 6 then 6
      else if d == 7 then 7
      else if d == 8 then 8
      else 9
  }

  fun widen_pos(n: Int32): Int64 {
    return if n == 0 then 0
           else widen_pos(n / 10) * 10 + digit64(n % 10)
  }

  fun widen_i32_i64(n: Int32): Int64 {
    return if n < 0 then 0 - widen_pos(0 - n) else widen_pos(n)
  }
}
