/* TropicalMax — the max-plus semiring's sum: the larger of two, associative,
 * commutative and idempotent, with bottom (below everything) as its neutral
 * element. */
place TropicalMax is algebra {
  operation max(a: TropicalMax, b: TropicalMax): TropicalMax
  operation bottom(): TropicalMax
  law associative ∀a : TropicalMax ∀b : TropicalMax ∀c : TropicalMax, max(max(a, b), c) = max(a, max(b, c))
  law commutative ∀a : TropicalMax ∀b : TropicalMax, max(a, b) = max(b, a)
  law idempotent ∀a : TropicalMax, max(a, a) = a
  law neutral ∀a : TropicalMax, max(a, bottom()) = a
}
