/* TropicalMax — an instance of Monoid, the max-plus semiring's sum: the larger of
 * two, commutative and idempotent, with bottom (below everything) as its unit. */
place TropicalMax is algebra {
  this < Monoid
  operation op(a: TropicalMax, b: TropicalMax): TropicalMax
  operation unit: TropicalMax
  law commutative ∀a : TropicalMax ∀b : TropicalMax, op(a, b) = op(b, a)
  law idempotent ∀a : TropicalMax, op(a, a) = a
}
