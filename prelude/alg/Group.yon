/* Group — a monoid where each element has an inverse on both sides. The last law
 * follows from the others: it is proved here, on the signature, once, and every
 * instance below inherits it. */
place Group is algebra {
  this < Monoid
  operation inv(a: Group): Group
  law inverse ∀a : Group, op(a, inv(a)) = unit ∧ op(inv(a), a) = unit
  law inverse_of_unit inv(unit) = unit
}
