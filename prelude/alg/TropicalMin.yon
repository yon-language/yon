/* TropicalMin — an instance of Monoid, the min-plus semiring's sum: the smaller
 * of two, commutative and idempotent, with top (above everything) as its unit. */
place TropicalMin {
  this < Monoid
  operation op(a: TropicalMin, b: TropicalMin): TropicalMin
  operation unit: TropicalMin
  law commutative ∀a : TropicalMin ∀b : TropicalMin, op(a, b) = op(b, a)
  law idempotent ∀a : TropicalMin, op(a, a) = a
}
