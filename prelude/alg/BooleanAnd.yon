/* BooleanAnd — an instance of Monoid: a meet semilattice with a top. The meet of
 * two is commutative and idempotent, and the top is its unit. */
place BooleanAnd {
  this < Monoid
  operation op(a: BooleanAnd, b: BooleanAnd): BooleanAnd
  operation unit: BooleanAnd
  law commutative ∀a : BooleanAnd ∀b : BooleanAnd, op(a, b) = op(b, a)
  law idempotent ∀a : BooleanAnd, op(a, a) = a
}
