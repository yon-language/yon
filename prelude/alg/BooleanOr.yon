/* BooleanOr — a join semilattice with a bottom: the join of two is
 * associative, commutative and idempotent, and bottom is its neutral element. */
place BooleanOr is algebra {
  operation join(a: BooleanOr, b: BooleanOr): BooleanOr
  operation bottom(): BooleanOr
  law associative ∀a : BooleanOr ∀b : BooleanOr ∀c : BooleanOr, join(join(a, b), c) = join(a, join(b, c))
  law commutative ∀a : BooleanOr ∀b : BooleanOr, join(a, b) = join(b, a)
  law idempotent ∀a : BooleanOr, join(a, a) = a
  law neutral ∀a : BooleanOr, join(a, bottom()) = a
}
