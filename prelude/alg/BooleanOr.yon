/* BooleanOr — an instance of Monoid: a join semilattice with a bottom. The join
 * of two is commutative and idempotent, and the bottom is its unit. */
place BooleanOr is algebra {
  this < Monoid
  operation op(a: BooleanOr, b: BooleanOr): BooleanOr
  operation unit: BooleanOr
  law commutative ∀a : BooleanOr ∀b : BooleanOr, op(a, b) = op(b, a)
  law idempotent ∀a : BooleanOr, op(a, a) = a
}
