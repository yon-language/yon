/* Int64 — the declared face of the primitive integer code.
 *
 * `is i64` declares the axiomatic carrier: the leaf of the carrier
 * functor's recursion, not a way around it. Int64 is Number's brother:
 * same treatment, different carrier, and exact arithmetic — no rounding,
 * no epsilon.
 *
 * Int64 is what Number could not be: `number` is f64, so Integer's whole
 * bit family had no home. Now it has one.
 *
 * The bit family uses no bitwise operators. Yon has no & | << >>, and they
 * are not needed here: on an integer carrier `/ 2` is a right shift, `* 2`
 * a left shift, `% 2` is the low bit. Everything below is three arithmetic
 * operators, recursively. It is not a workaround: shifting is halving, and
 * saying it this way is more honest than a glyph.
 *
 * Markers
 *   [T] total       written here, no dependency
 *   [E] partial     dressed with `on error`
 */
place Int64 is i64 {

  /* ─── Sign and magnitude ─────────────────────────────────── [T] ─── */

  fun abs(n: Int64): Int64    { return if n < 0 then 0 - n else n }
  fun signum(n: Int64): Int64 { return if n > 0 then 1 else if n < 0 then 0 - 1 else 0 }

  /* The endomorphism declared as such: it carries true laws.
   * The others stay `fun` — floor/max/gcd preserve no interesting
   * algebraic structure, and calling them morph would be noise.
   * The seven arrow forms are encouraged, not mandatory. */
  morph Negate from Int64 to Int64 {
    on object(n: Int64): Int64 { return 0 - n }
    law involutive          /* negate(negate(n)) == n                     */
    law additive            /* negate(a + b) == negate(a) + negate(b)     */
  }

  /* ─── Comparison ─────────────────────────────────────────── [T] ─── */

  fun max(a: Int64, b: Int64): Int64 { return if a > b then a else b }
  fun min(a: Int64, b: Int64): Int64 { return if a < b then a else b }
  fun compare(a: Int64, b: Int64): Int64 {
    return if a < b then 0 - 1 else if a > b then 1 else 0
  }
  fun clamp(n: Int64, lo: Int64, hi: Int64): Int64 {
    return if n < lo then lo else if n > hi then hi else n
  }

  /* ─── Predicates ─────────────────────────────────────────── [T] ─── */

  fun is_zero(n: Int64): Boolean     { return n == 0 }
  fun is_positive(n: Int64): Boolean { return n > 0 }
  fun is_negative(n: Int64): Boolean { return n < 0 }
  fun is_even(n: Int64): Boolean     { return n % 2 == 0 }
  fun is_odd(n: Int64): Boolean      { return n % 2 != 0 }

  /* ─── Exact arithmetic ───────────────────────────────────── [T] ───
   * `/` and `%` on an integer carrier are the truncating operations:
   * div(7, 2) is 3, not 3.5. The tycheck records those sites and routes
   * them to __idiv/__imod, which lower to signed divsi/remsi — probed,
   * and every function from here down (the whole bit family) rests on it. */

  fun gcd(a: Int64, b: Int64): Int64 {
    be x holds abs(a)
    be y holds abs(b)
    return if y == 0 then x else gcd(y, x % y)
  }

  fun lcm(a: Int64, b: Int64): Int64 {
    be g holds gcd(a, b)
    return if g == 0 then 0 else abs(a * b) / g
  }

  /* exact power by squaring — the total core */
  fun ipow_ok(base: Int64, e: Int64): Int64 {
    return if e == 0 then 1
           else if e % 2 == 0 then ipow_ok(base * base, e / 2)
           else base * ipow_ok(base * base, (e - 1) / 2)
  }

  /* [E] a negative exponent has no integer answer */
  fun ipow(base: Int64, e: Int64) on error DomainError: Int64 {
    return if e < 0 then .-> DomainError { message "ipow: negative exponent has no integer value" }
           else ipow_ok(base, e)
  }

  /* [E] division and remainder by zero are undefined */
  fun div(a: Int64, b: Int64) on error DomainError: Int64 {
    return if b == 0 then .-> DomainError { message "div: division by zero" }
           else a / b
  }

  fun rem(a: Int64, b: Int64) on error DomainError: Int64 {
    return if b == 0 then .-> DomainError { message "rem: modulo by zero" }
           else a % b
  }

  /* ─── The bit family: all of it via / 2, % 2, * 2 ────────── [T] ─── */

  fun bit_count(n: Int64): Int64 {
    be x holds abs(n)
    return if x == 0 then 0 else x % 2 + bit_count(x / 2)
  }

  fun bit_length(n: Int64): Int64 {
    be x holds abs(n)
    return if x == 0 then 0 else 1 + bit_length(x / 2)
  }

  fun highest_one_bit(n: Int64): Int64 {
    be l holds bit_length(n)
    return if l == 0 then 0 else ipow_ok(2, l - 1)
  }

  fun lowest_one_bit(n: Int64): Int64 {
    be x holds abs(n)
    return if x == 0 then 0
           else if x % 2 == 1 then 1
           else 2 * lowest_one_bit(x / 2)
  }

  fun leading_zeros(n: Int64): Int64 { return 64 - bit_length(n) }

  fun trailing_zeros(n: Int64): Int64 {
    be x holds abs(n)
    return if x == 0 then 64
           else if x % 2 == 1 then 0
           else 1 + trailing_zeros(x / 2)
  }

  fun shift_left(n: Int64, k: Int64): Int64  { return n * ipow_ok(2, k) }
  fun shift_right(n: Int64, k: Int64): Int64 { return n / ipow_ok(2, k) }

  fun reverse_step(n: Int64, acc: Int64, k: Int64): Int64 {
    return if k == 0 then acc
           else reverse_step(n / 2, acc * 2 + n % 2, k - 1)
  }
  fun reverse_bits(n: Int64): Int64 { return reverse_step(n, 0, 64) }

  fun rotate_left(n: Int64, k: Int64): Int64 {
    be s holds k % 64
    return shift_left(n, s) % ipow_ok(2, 64) + shift_right(n, 64 - s)
  }
  fun rotate_right(n: Int64, k: Int64): Int64 {
    return rotate_left(n, 64 - k % 64)
  }

  /* ─── The site knows its width ───────────────────────────────────────
   * width() died with the `<64>` parameter: precision is the world
   * (Num64), not a type parameter, and the literal 64 above is the site's
   * own fact, written once per leg. The 32-bit twin writes 32. */

  /* ─── The site's generators, implemented ─────────────────────────────
   * num64.yon declares `morphism plus/mul`; these are the targets the
   * Widen functor will name in its `on morphism … via …` clauses. */
  fun plus_i64(a: Int64, b: Int64): Int64  { return a + b }
  fun mul_i64(a: Int64, b: Int64): Int64  { return a * b }
}

/* ═══════════════════════════════════════════════════════════════════
 * What is not here, and why
 *
 * Suspended (Antonio's decision): `widen : Int64 → Number` and
 *     `narrow : Number → Int64`, the adjunction between the two types.
 *     They are irreducible — they reinterpret an i64 as an f64 and back,
 *     touching the representation — so they have no body writable in Yon.
 *     They need either the intrinsic mechanism (the brother of `is <prim>`
 *     for bodies) or nothing at all: a body that pretends to convert would
 *     lie. When it arrives: `widen` goes in Number.yon, `narrow` here — the
 *     house is given by the target.
 *
 * MAX/MIN: they want the larger i64 literals, which want exponent or
 *     hexadecimal notation in the lexer — unverified. Not declared, rather
 *     than written wrong.
 *
 * Wants `Text`: to_text, to_text_radix (Java's toBinaryString family),
 *     from_text/parse [E]. They belong here; the return type lives in the
 *     sibling place.
 *
 * Unsigned: divideUnsigned, remainderUnsigned, compareUnsigned. They want
 *     an unsigned reading of the carrier — a design decision (a UInt place?
 *     a flag?). Not invented here.
 *
 * The algebras: `+` and `*` stay operators; their declared face is the
 *     algebra (`operation add(a, b) uses Additive`), which waits for the
 *     algebra cantiere. Int64 is a richer model than Number: it is a
 *     genuine ring, so it will carry Additive and Multiplicative with
 *     distributivity.
 * ═══════════════════════════════════════════════════════════════════ */
