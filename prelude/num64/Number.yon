/* Number — the declared face of the primitive code `number`.
 *
 * `is number` declares the axiomatic carrier: the leaf of the carrier functor
 * recursion, not a bypass of it.
 *
 * The library lives here, in Yon, not in the compiler. The arithmetic
 * Operators (+ - * / %) stay primitive — as `+` on int stays a jvm bytecode in
 * Java while `Integer` carries the library. What this place declares is
 * everything else: sign, comparison, rounding, roots, transcendentals,
 * predicates.
 *
 * The bodies written here are Yon (Euclid, rounding derived from floor,
 * the defended partial functions). The transcendentals and floor are `is
 * given`: their body is the platform's libm, correctly rounded where libm
 * is, the same function `Math.*` names — `Math.exp` is the primitive's
 * name, `Number.exp` the name its house gives it. A body of a fixed number
 * of Newton or Taylor steps would be a second, wrong, mechanism for the
 * same function.
 *
 * Markers
 *   [T] total     — written here, no dependency
 *   [G] given     — the body is the libm primitive the compiler wires
 *   [E] partial   — carries `on error`, so a failure is a value of its coproduct
 */
place Number is number {

  /* ─── Sign and magnitude ─────────────────────────────────── [T] ─── */

  fun abs(n: Number): Number {
    return if n < 0 then 0 - n else n
  }

  fun negate(n: Number): Number {
    return 0 - n
  }

  fun signum(n: Number): Number {
    return if n > 0 then 1 else if n < 0 then 0 - 1 else 0
  }

  /* ─── Comparison ─────────────────────────────────────────── [T] ─── */

  fun max(a: Number, b: Number): Number {
    return if a > b then a else b
  }

  fun min(a: Number, b: Number): Number {
    return if a < b then a else b
  }

  /* three-way: -1 if a < b, 0 if equal, 1 if a > b */
  fun compare(a: Number, b: Number): Number {
    return if a < b then 0 - 1 else if a > b then 1 else 0
  }

  fun clamp(n: Number, lo: Number, hi: Number): Number {
    return if n < lo then lo else if n > hi then hi else n
  }

  /* ─── Predicates ─────────────────────────────────────────── [T] ─── */

  fun is_zero(n: Number): Boolean     { return n == 0 }
  fun is_positive(n: Number): Boolean { return n > 0 }
  fun is_negative(n: Number): Boolean { return n < 0 }

  /* ─── Rounding ───────────────────────────────────────────────────── */
  /* [G] `floor` is the irreducible one: it drops the fractional part toward
   *     minus infinity, which means touching the f64 representation.
   *     Everything else in this group is derived from it. */

  fun floor(n: Number): Number is given

  fun truncate(n: Number): Number {
    return if n < 0 then 0 - floor(0 - n) else floor(n)
  }

  fun ceil(n: Number): Number {
    be t := truncate(n)
    return if n > 0 and t != n then t + 1 else t
  }

  fun round(n: Number): Number {
    return if n < 0 then 0 - floor(0 - n + 0.5) else floor(n + 0.5)
  }

  fun fract(n: Number): Number {
    return n - truncate(n)
  }

  fun is_integer(n: Number): Boolean {
    return truncate(n) == n
  }

  /* ─── Integer arithmetic (Euclid) ────────────────────────── [T] ─── */

  fun gcd(a: Number, b: Number): Number {
    be x := abs(a)
    be y := abs(b)
    return if y == 0 then x else gcd(y, x % y)
  }

  fun lcm(a: Number, b: Number): Number {
    be g := gcd(a, b)
    return if g == 0 then 0 else abs(a * b) / g
  }

  /* integer exponent, by squaring */
  fun ipow(base: Number, e: Number): Number {
    return if e == 0 then 1
           else if e < 0 then 1 / ipow(base, 0 - e)
           else if e % 2 == 0 then ipow(base * base, e / 2)
           else base * ipow(base * base, (e - 1) / 2)
  }

  /* ─── Square root ─────────────────────────────────────────── [E] ─── */
  /* a negative argument is a DomainError; on its domain sqrt is the libm
   * square root (-0 included: the root of -0 is -0). */

  fun sqrt(x: Number) on error DomainError: Number {
    return if x < 0 then .-> DomainError { message "sqrt of a negative" }
           else Math.sqrt(x)
  }

  /* ─── Exponential and logarithm ────────────────────────── [G] [E] ─── */

  fun exp(x: Number): Number is given

  /* on its domain, ln is the libm logarithm */
  fun ln(x: Number) on error DomainError: Number {
    return if x <= 0 then .-> DomainError { message "ln of a non-positive" }
           else Math.log(x)
  }

  /* general power: b^e = exp(e * ln b); integer exponents go by repeated
     squaring (for an integer base and a non-negative exponent, exact
     while every intermediate stays below 2^53).
     ln can fail, so pow propagates: the witness of the error arm is returned
     as-is and the injection rule lifts it into pow's own coproduct. */
  fun pow(base: Number, e: Number) on error DomainError: Number {
    return if is_integer(e) then ipow(base, e)
           else match ln(base) {
             Number as l       => exp(e * l),
             DomainError as d  => d
           }
  }

  /* ─── Trigonometry ───────────────────────────────────────── [G] ─── */

  fun sin(x: Number): Number is given
  fun cos(x: Number): Number is given

  fun tan(x: Number) on error DomainError: Number {
    be c := cos(x)
    return if c == 0 then .-> DomainError { message "tan at a pole of cos" }
           else sin(x) / c
  }

  /* ─── Division, defended ─────────────────────────────────── [E] ─── */

  fun divide(a: Number, b: Number) on error DomainError: Number {
    return if b == 0 then .-> DomainError { message "division by zero" }
           else a / b
  }

  /* ─── Constants ──────────────────────────────────────────── [T] ─── */

  fun pi(): Number      { return 3.14159265358979 }
  fun e(): Number       { return 2.71828182845905 }
  fun epsilon(): Number { return 0.000000000000000222 }

  /* Negate — additive (negate(a+b) = negate(a)+negate(b)) and an
   * involution: apply it twice and you are home. No law is declared on it.
   * The house gives the name. */
  morph Negate from Number to Number {
    on object(n: Number): Number { return 0 - n }
  }

  morph Reciprocal from Number to Number {
    on object(n: Number): Number { return 1 / n }
  }
}

/* ═══════════════════════════════════════════════════════════════════
 * What is not here, and why
 *
 * [G] the rounding group has one irreducible: `floor`, which is `is given`.
 *     `truncate`, `ceil`, `round`, `fract`, `is_integer` are all derived
 *     from it — the primitive surface of the whole group is one function,
 *     not five.
 *
 * [E] partial — sqrt, ln, tan and divide carry `on error DomainError`
 *     (prelude/err/DomainError.yon, message by composition); pow propagates
 *     ln's failure through its own coproduct via match + witness.
 *
 * Conversions to and from text live in String (the house is given by the
 *     target): String.from_int is Number → String, String.parse and
 *     String.parse_number are String → Number.
 *
 * The bit family (bit_count, bit_length, shifts, rotations…) lives on
 *     Int64: on an f64 face it would be a lie.
 *
 * Constants not declared: MAX_VALUE / MIN_VALUE. The lexer has no exponent
 *     notation (1.797…e308), so MAX_VALUE has no exact literal; left out
 *     rather than written wrong.
 *
 * On the algebras: `+` and `*` stay operators. Their declared face is an
 *     algebra, attached by `operation … uses algebra Additive` on a place;
 *     Number declares no such operation. f64 addition is not associative,
 *     so Number is not a ring.
 * ═══════════════════════════════════════════════════════════════════ */
