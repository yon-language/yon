/* Arena<V> — the Leech type-2 arena: one slot per point of the type-2 shell
 * (the kissing number of slots, indexed by the verified MPHF bijection), each
 * holding a value inline, as its bits, and a list of sigma-certified fusions.
 * A slot is addressed by a LatticePoint, never by a number. Which values fit
 * a slot is derived from their carrier, never listed here. The orbit of a
 * point belongs to the point (LatticePoint.orbit), not to the arena.
 *
 * Markers: [G] given, the runtime primitive · [T] total, written here */
place Arena<V> {

  /* ─── The primitives ─────────────────────────────────────── [G] ─── */

  fun empty<V>(): Arena<V> is given
  fun put<V>(a: Arena<V>, p: LatticePoint, v: V): Arena<V> is given
  fun occupied<V>(a: Arena<V>, p: LatticePoint): Boolean is given
  /* the value at an occupied point; at an empty one it stops the program
     (call it after `occupied`, as `get` does) */
  internal fun value<V>(a: Arena<V>, p: LatticePoint): V is given
  fun fuse<V>(a: Arena<V>, p: LatticePoint, v: V, sigma: Number): Arena<V> is given
  fun fusion_count<V>(a: Arena<V>, p: LatticePoint): Number is given

  /* ─── Reading ────────────────────────────────────────────── [T] ─── */

  fun get<V>(a: Arena<V>, p: LatticePoint): Lookup<V> {
    return if occupied(a, p) then hit(Found, value(a, p)) else Absent
  }
}
