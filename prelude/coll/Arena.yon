/* Arena<V> — the Leech type-2 arena: one slot per type-2 lattice point (the
 * kissing number of slots, indexed by the verified MPHF bijection), each
 * holding a value inline, as its bits, with the M24 orbit of its point and
 * a list of sigma-certified fusions. Which values fit a slot is derived from
 * their carrier, never listed here.
 *
 * Markers: [G] given, the runtime primitive · [T] total, written here */
place Arena<V> {

  /* ─── The primitives ─────────────────────────────────────── [G] ─── */

  fun empty<V>(): Arena<V> is given
  fun put<V>(a: Arena<V>, p: Number, v: V): Arena<V> is given
  fun occupied<V>(a: Arena<V>, p: Number): Boolean is given
  /* the value at an occupied point; at an empty one it stops the program
     (call it after `occupied`, as `get` does) */
  fun value<V>(a: Arena<V>, p: Number): V is given
  fun orbit<V>(a: Arena<V>, p: Number): Number is given
  fun same_orbit<V>(a: Arena<V>, p: Number, q: Number): Number is given
  fun fuse<V>(a: Arena<V>, p: Number, v: V, sigma: Number): Arena<V> is given
  fun fusion_count<V>(a: Arena<V>, p: Number): Number is given

  /* ─── Reading ────────────────────────────────────────────── [T] ─── */

  fun get<V>(a: Arena<V>, p: Number): Lookup<V> {
    return if occupied(a, p) then hit(Found, value(a, p)) else Absent
  }
}
