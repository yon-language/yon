/* FnvHeap — identity by content: a value is put once, by its bytes, and the
 * same bytes answer the same slot. It lives in a Region, whose words only
 * this house reads and writes.
 *
 * Markers: [G] given, the runtime primitive */
place FnvHeap is internal i64 {

  /* ─── The words of its region ────────────────────────────── [G] ─── */

  internal fun read_word(r: Region, index: Int64): Word64 is given
  internal fun write_word(r: Region, index: Int64, w: Word64): Unit is given
}
