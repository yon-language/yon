/* LeechHeap — identity by point: a slot is written once, and its name is the
 * pair (generation, point of the shell). It lives in a Region, whose words
 * only this house reads and writes.
 *
 * Markers: [G] given, the runtime primitive */
internal place LeechHeap carried by i64 {

  /* ─── The words of its region ────────────────────────────── [G] ─── */

  internal fun read_word(r: Region, index: Int64): Word64 is given
  internal fun write_word(r: Region, index: Int64, w: Word64): Unit is given
}
