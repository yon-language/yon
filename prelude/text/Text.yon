/* Text — the place of the texts, carried by `text`.
 *
 * `is text` declares the axiomatic carrier: the leaf of the carrier
 * functor's recursion. The carrier of `text` is a handle into the
 * content-addressed heap (an interned rope: same literal, same slot) — but
 * the prelude does not say so, because the fusion names the code, not the
 * layout.
 *
 * The core declares itself: `is given` is the axiomatic body (Java's
 * `native`). It is not a mute promise — the compiler verifies that the
 * wired implementation exists and that the declared signature is the wired
 * one: a missing name, a different arity or a different type are errors.
 * The boundary with the silicon is a line of Yon.
 *
 * Markers: [G] given, wired body · [T] total, written here ·
 *          [E] partial, dressed with on error
 */
place Text carried by text uses algebra Monoid {

  /* the monoid of the texts: the concatenation and the empty text */
  fun op(a: Text, b: Text): Text { return concat(a, b) }
  fun unit: Text { return "" }

  /* ─── The axiomatic core ─────────────────────────────────────── [G] ───
   *
   * The only ones that touch the rope: measure, index, allocate. All the
   * rest of this file is derived from these — the boundary with the
   * silicon is small, and that is the point.
   *
   * `equal` is O(1), not a character-by-character comparison: two equal
   * strings have the same handle under content-addressing. This is where
   * identity-by-content pays: nothing is scanned.
   *
   * substring/find_char are wired too, and that is a machine fact: emit
   * recognizes those names by pattern, so a redefinition in Yon would be
   * silently ignored. Declaring them here makes them visible instead of
   * invisible; the honest two-argument derivative is `index_of`. */

  fun length(s: Text): Number is given
  fun char_at(s: Text, i: Number): Number is given
  fun concat(a: Text, b: Text): Text is given
  fun from_char(c: Number): Text is given
  fun equal(a: Text, b: Text): Boolean is given
  fun substring(s: Text, start: Number, len: Number): Text is given
  /* `pos`, not `from` nor `at`: both are keywords (the from/to clauses of
     the arrows, `repeat at most`). The language lexicon takes precedence
     over prelude names — the fourth collision, after mul/times, skip/drop
     and replicate/repeat. */
  fun find_char(s: Text, c: Number, pos: Number): Number is given
  fun parse_number(s: Text): Number is given
  fun from_int(n: Number): Text is given
  fun print(s: Text): Number is given

  /* ─── Predicates ─────────────────────────────────────────────── [T] ─── */

  fun is_empty(s: Text): Boolean { return Text.length(s) == 0 }

  fun starts_with(s: Text, p: Text): Boolean {
    return if Text.length(p) > Text.length(s) then false
           else Text.equal(Text.substring(s, 0, Text.length(p)), p)
  }

  fun ends_with(s: Text, p: Text): Boolean {
    return if Text.length(p) > Text.length(s) then false
           else Text.equal(
             Text.substring(s, Text.length(s) - Text.length(p),
                            Text.length(p)), p)
  }

  /* ─── Extraction ─────────────────────────────────────────────── [T] ─── */

  fun take(s: Text, n: Number): Text {
    return Text.substring(s, 0, n)
  }
  /* `skip`, not `drop`: drop is a keyword (releasing a Space). Same
     reason as mul/times — the language lexicon takes precedence. */
  fun skip(s: Text, n: Number): Text {
    return Text.substring(s, n, Text.length(s) - n)
  }

  /* ─── Search: Java's indexOf contract (-1 when absent) ───────── [T] ───
   * `index_of` under its own name: the wired Text.find_char takes three
   * arguments (s, c, pos) — this is the two-argument contract, derived
   * honestly. */

  fun index_of_step(s: Text, c: Number, i: Number): Number {
    return if i >= Text.length(s) then 0 - 1
           else if Text.char_at(s, i) == c then i
           else index_of_step(s, c, i + 1)
  }

  fun index_of(s: Text, c: Number): Number { return index_of_step(s, c, 0) }

  fun contains_char(s: Text, c: Number): Boolean { return index_of(s, c) >= 0 }

  /* ─── Transformation ─────────────────────────────────────────── [T] ───
   * Derived character by character: the honest definition first, the
   * pattern recognition later, if the profile asks for it. "" is the
   * monoid's neutral, and a literal is a point of the face — so the
   * accumulator is legitimate. */

  fun reverse_step(s: Text, i: Number, acc: Text): Text {
    return if i < 0 then acc
           else reverse_step(s, i - 1,
                  Text.concat(acc, Text.from_char(Text.char_at(s, i))))
  }

  fun reverse(s: Text): Text {
    return reverse_step(s, Text.length(s) - 1, "")
  }

  /* `replicate`, not `repeat`: repeat is a keyword (repeat at most N times). */
  fun replicate(s: Text, n: Number): Text {
    return if n <= 0 then "" else Text.concat(s, replicate(s, n - 1))
  }

  /* ─── Case ───────────────────────────────────────────────────── [T] ───
   * `char_at` returns the character code, so the ASCII block A–Z is the
   * interval 65–90 and the lowercase twin is the same code plus 32.
   * Outside that block the code is returned unchanged: the rope can be read
   * as bytes or as codepoints, and this function claims only the part on
   * which the two readings agree. */

  fun lower_char(c: Number): Number {
    return if c >= 65 && c <= 90 then c + 32 else c
  }

  fun lower_step(s: Text, i: Number, acc: Text): Text {
    return if i < 0 then acc
           else lower_step(s, i - 1,
                  Text.concat(Text.from_char(lower_char(Text.char_at(s, i))),
                              acc))
  }

  fun lower(s: Text): Text {
    return lower_step(s, Text.length(s) - 1, "")
  }

  /* ─── The endomorphism, declared as such ─────────────────────────────
   * Reverse carries a true law: it is an involution. The others stay
   * `fun` — take/skip/index_of preserve no interesting structure, and
   * calling them morph would be noise. The arrows are encouraged, not
   * mandatory. */

  morph Reverse from Text to Text {
    on object(s: Text): Text { return reverse(s) }
    law involutive        /* reverse(reverse(s)) == s */
  }

  /* ─── Toward the numbers — the incoming arrow ────────────────── [E] ───
   * `parse` is Text -> Number: the container appears as the source,
   * which the containment rule admits — and it is where Java puts it
   * (Integer.parseInt takes a String). The core is wired
   * (Text.parse_number); here the partiality gets dressed. */

  fun parse(s: Text) on error DomainError: Number {
    return if is_empty(s) then .-> DomainError { message "parse: empty string" }
           else Text.parse_number(s)
  }
}
