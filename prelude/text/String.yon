/* String — the declared face of the primitive code `text`.
 *
 * `is text` declares the axiomatic carrier: the leaf of the carrier
 * functor's recursion. The carrier of `text` is a handle into the
 * content-addressed heap (an interned rope: same literal, same slot) — but
 * the prelude does not say so, because the fusion names the code, not the
 * layout.
 *
 * The core now declares itself: `is given` is the axiomatic body (Java's
 * `native`). It is not a mute promise — the compiler verifies that the
 * wired implementation exists and that the declared signature is the wired
 * one: a missing name, a different arity or a different type are errors.
 * The boundary with the silicon stops being invisible and becomes a line
 * of Yon.
 *
 * Markers: [G] given, wired body · [T] total, written here ·
 *          [E] partial, dressed with on error
 */
place String is text {

  /* ─── The axiomatic core ─────────────────────────────────────── [G] ───
   *
   * The only ones that touch the rope: measure, index, allocate. All the
   * rest of this file is derived from these — the boundary with the
   * silicon is small, and that is the point.
   *
   * `equal` is O(1), not a character-by-character comparison: two equal
   * strings have the same handle under content-addressing. This is where
   * identity-by-content pays: nothing is scanned.
   *
   * substring/find_char are wired too, and that is a machine fact: emit
   * recognizes those names by pattern, so a redefinition in Yon would be
   * silently ignored. Declaring them here makes them visible instead of
   * invisible; the honest two-argument derivative is `index_of`. */

  fun length(s: String): Number is given
  fun char_at(s: String, i: Number): Number is given
  fun concat(a: String, b: String): String is given
  fun from_char(c: Number): String is given
  fun equal(a: String, b: String): Boolean is given
  fun substring(s: String, start: Number, len: Number): String is given
  /* `pos`, not `from` nor `at`: both are keywords (the from/to clauses of
     the arrows, `repeat at most`). The language lexicon takes precedence
     over prelude names — the fourth collision, after mul/times, skip/drop
     and replicate/repeat. */
  fun find_char(s: String, c: Number, pos: Number): Number is given
  fun parse_number(s: String): Number is given
  fun from_int(n: Number): String is given
  fun print(s: String): Number is given

  /* ─── Predicates ─────────────────────────────────────────────── [T] ─── */

  fun is_empty(s: String): Boolean { return String.length(s) == 0 }

  fun starts_with(s: String, p: String): Boolean {
    return if String.length(p) > String.length(s) then false
           else String.equal(String.substring(s, 0, String.length(p)), p)
  }

  fun ends_with(s: String, p: String): Boolean {
    return if String.length(p) > String.length(s) then false
           else String.equal(
             String.substring(s, String.length(s) - String.length(p),
                              String.length(p)), p)
  }

  /* ─── Extraction ─────────────────────────────────────────────── [T] ─── */

  fun take(s: String, n: Number): String {
    return String.substring(s, 0, n)
  }
  /* `skip`, not `drop`: drop is a keyword (releasing a Space). Same
     reason as mul/times — the language lexicon takes precedence. */
  fun skip(s: String, n: Number): String {
    return String.substring(s, n, String.length(s) - n)
  }

  /* ─── Search: Java's indexOf contract (-1 when absent) ───────── [T] ───
   * `index_of` under its own name: the wired String.find_char takes three
   * arguments (s, c, pos) — this is the two-argument contract, derived
   * honestly. */

  fun index_of_step(s: String, c: Number, i: Number): Number {
    return if i >= String.length(s) then 0 - 1
           else if String.char_at(s, i) == c then i
           else index_of_step(s, c, i + 1)
  }

  fun index_of(s: String, c: Number): Number { return index_of_step(s, c, 0) }

  fun contains_char(s: String, c: Number): Boolean { return index_of(s, c) >= 0 }

  /* ─── Transformation ─────────────────────────────────────────── [T] ───
   * Derived character by character: the honest definition first, the
   * pattern recognition later, if the profile asks for it (this is sqrt
   * with Newton). "" is the monoid's neutral, and a literal is a point of
   * the face — so the accumulator is legitimate. */

  fun reverse_step(s: String, i: Number, acc: String): String {
    return if i < 0 then acc
           else reverse_step(s, i - 1,
                  String.concat(acc, String.from_char(String.char_at(s, i))))
  }

  fun reverse(s: String): String {
    return reverse_step(s, String.length(s) - 1, "")
  }

  /* `replicate`, not `repeat`: repeat is a keyword (repeat at most N times). */
  fun replicate(s: String, n: Number): String {
    return if n <= 0 then "" else String.concat(s, replicate(s, n - 1))
  }

  /* ─── The endomorphism, declared as such ─────────────────────────────
   * Reverse carries a true law: it is an involution. The others stay
   * `fun` — take/skip/index_of preserve no interesting structure, and
   * calling them morph would be noise. The arrows are encouraged, not
   * mandatory. */

  morph Reverse from String to String {
    on object(s: String): String { return reverse(s) }
    law involutive        /* reverse(reverse(s)) == s */
  }

  /* ─── Toward the numbers — the incoming arrow ────────────────── [E] ───
   * `parse` is String -> Number: the container appears as the source,
   * which the containment rule admits — and it is where Java puts it
   * (Integer.parseInt takes a String). The core is wired
   * (String.parse_number); here the partiality gets dressed. */

  fun parse(s: String) on error DomainError: Number {
    return if is_empty(s) then .-> DomainError { message "parse: empty string" }
           else String.parse_number(s)
  }
}
