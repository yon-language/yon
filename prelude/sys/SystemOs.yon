/* SystemOs — the operating system, the only place whose primitives reach the
 * kernel. Each face says what it does, never how one kernel does it: the
 * same face is realized on every system Yon runs on. What the language can
 * see is wrong before asking (a size, an index, a name, a timeout, a process
 * id) is a DomainError, decided here; what the kernel itself refuses (memory
 * it will not map, a write that fails) stops the program with a sentence and
 * exit code 3, as every refusal of the runtime does.
 *
 * Markers: [G] given, the kernel's primitive · [E] partial, `on error` */
place SystemOs {

  /* ─── Memory ─────────────────────────────────────────────── [G] ─── */

  internal fun unchecked_map(words: Int64): Region is given
  /* how many words the region holds */
  fun words(r: Region): Int64 is given
  /* gives the region back to the kernel; the handle names nothing after it */
  fun unmap(r: Region): Unit is given

  /* ─── Shared memory ──────────────────────────────────────── [G] ─── */

  /* a name for shared memory: 1 to 30 letters, digits, '_' or '-'; the
     runtime gives it the form its kernel asks */
  internal fun is_shared_name(name: Text): Boolean is given
  internal fun unchecked_shared_map(name: Text, words: Int64): Region is given
  internal fun unchecked_shared_remove(name: Text): Boolean is given

  /* ─── The wait on a word ─────────────────────────────────── [G] ─── */

  /* the kernel compares the low 32 bits of the word: the expected value is
     kept inside them */
  internal fun unchecked_wait(r: Region, index: Int64, expected: Int64): Number is given
  internal fun unchecked_wait_for(r: Region, index: Int64, expected: Int64, timeout_ns: Int64): Number is given
  internal fun unchecked_wake(r: Region, index: Int64): Number is given

  /* ─── Clocks, arguments, the standard streams, processes ── [G] ─── */

  /* nanoseconds on a clock that never goes back */
  fun monotonic_ns(): Int64 is given
  /* nanoseconds since 1970-01-01 UTC, on the clock of the wall */
  fun wall_ns(): Int64 is given
  fun arg_count(): Number is given
  internal fun unchecked_arg(i: Number): Text is given
  /* writes the text, whole, on the standard output / the standard error; the
     answer is the bytes written */
  fun write_output(t: Text): Number is given
  fun write_error(t: Text): Number is given
  fun process_id(): Number is given
  internal fun unchecked_process_exists(pid: Number): Boolean is given
  internal fun unchecked_terminate(pid: Number): Boolean is given

  /* ─── Making and naming ──────────────────────────────────── [E] ─── */

  fun map(words: Int64) on error DomainError: Region {
    return if words > 0 then unchecked_map(words)
           else .-> DomainError { message "a region holds at least one word" }
  }

  /* the region shared under the name: made by the first to ask, the same
     region for every process that asks after */
  fun shared_map(name: Text, words: Int64) on error DomainError: Region {
    return if not is_shared_name(name)
           then .-> DomainError { message "a shared-memory name is 1 to 30 letters, digits, '_' or '-'" }
           else if words > 0 then unchecked_shared_map(name, words)
           else .-> DomainError { message "a region holds at least one word" }
  }

  /* takes the name away, so no process can ask for the region by it again;
     the answer is whether the name was there */
  fun shared_remove(name: Text) on error DomainError: Boolean {
    return if is_shared_name(name) then unchecked_shared_remove(name)
           else .-> DomainError { message "a shared-memory name is 1 to 30 letters, digits, '_' or '-'" }
  }

  /* ─── Waiting ────────────────────────────────────────────── [E] ─── */

  fun wait(r: Region, index: Int64, expected: Int64) on error DomainError: WaitResult {
    return if index < 0 or index >= words(r)
           then .-> DomainError { message "not a word of the region" }
           else if expected < 0 or expected > 4294967295
           then .-> DomainError { message "the kernel compares 32 bits: the expected value is in [0, 2^32)" }
           else ended(unchecked_wait(r, index, expected))
  }

  fun wait_for(r: Region, index: Int64, expected: Int64, timeout_ns: Int64) on error DomainError: WaitResult {
    return if index < 0 or index >= words(r)
           then .-> DomainError { message "not a word of the region" }
           else if expected < 0 or expected > 4294967295
           then .-> DomainError { message "the kernel compares 32 bits: the expected value is in [0, 2^32)" }
           else if timeout_ns <= 0 or timeout_ns > 4294967295000
           then .-> DomainError { message "a timeout is in (0, 4294967295000] nanoseconds" }
           else ended(unchecked_wait_for(r, index, expected, timeout_ns))
  }

  /* how many waiters the kernel woke (macOS reports only whether one was
     there: 1 or 0) */
  fun wake(r: Region, index: Int64) on error DomainError: Number {
    return if index < 0 or index >= words(r)
           then .-> DomainError { message "not a word of the region" }
           else unchecked_wake(r, index)
  }

  internal fun ended(code: Number): WaitResult {
    return if code == 0 then Woken else if code == 1 then NotExpected else TimedOut
  }

  /* ─── Arguments, processes ───────────────────────────────── [E] ─── */

  fun arg(i: Number) on error DomainError: Text {
    return if Number.is_integer(i) and i >= 0 and i < arg_count() then unchecked_arg(i)
           else .-> DomainError { message "not the index of an argument" }
  }

  /* whether a process with this id is running */
  fun process_exists(pid: Number) on error DomainError: Boolean {
    return if Number.is_integer(pid) and pid > 0 then unchecked_process_exists(pid)
           else .-> DomainError { message "a process id is an integer > 0" }
  }

  /* ends the process now, without asking it; the answer is whether the
     kernel ended it */
  fun terminate(pid: Number) on error DomainError: Boolean {
    return if Number.is_integer(pid) and pid > 0 then unchecked_terminate(pid)
           else .-> DomainError { message "a process id is an integer > 0" }
  }
}
