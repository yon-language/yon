// Cloudflare Worker for the Yon site: static Docusaurus assets from
// website/build, plus a tiny Worker (worker.js) that serves /install.sh
// straight from the repo so `curl https://yon-lang.org/install.sh | bash` works.
{
  "name": "yon",
  "compatibility_date": "2026-06-04",
  "main": "worker.js",
  // `wrangler deploy` builds the book first, so a deploy never ships a stale
  // website/build. Connected to Workers Builds, every push to main does both.
  "build": {
    "command": "npm ci --prefix website && npm run build --prefix website"
  },
  "assets": {
    "directory": "./website/build",
    "binding": "ASSETS",
    // Without this, matching assets are served BEFORE the worker runs, so the
    // security/cache headers in worker.js would never be applied.
    "run_worker_first": true
  }
}
